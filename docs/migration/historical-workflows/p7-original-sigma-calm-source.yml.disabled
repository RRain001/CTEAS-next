name: P7 CALPUFF original SIGTY SIGTZ calm-source inspection
on:
  pull_request:
    paths:
      - '.github/workflows/p7-original-sigma-calm-source.yml'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: p7-original-sigma-calm-${{ github.sha }}
  cancel-in-progress: false
jobs:
  original-sigma-calm-source:
    runs-on: ubuntu-22.04
    timeout-minutes: 12
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
          filter: blob:none
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /native_cpp/modules/p7_calpuff/reference/sigma_source_anchor.py
            /native_cpp/modules/p7_calpuff/reference/sigma_source_anchor.json
            /engine/vendor/src/CALPUFF_v7.2.1_L150618/**
      - name: Audit original IDOPTYS and IDOPTZS 1 branches, source pinned
        shell: bash
        run: |
          set -euo pipefail
          python3 native_cpp/modules/p7_calpuff/reference/sigma_source_anchor.py \
            --check native_cpp/modules/p7_calpuff/reference/sigma_source_anchor.json
          python3 - <<'PY'
          from pathlib import Path
          import re
          source=Path('engine/vendor/src/CALPUFF_v7.2.1_L150618/calpuff.for')
          lines=source.read_bytes().decode('latin-1').splitlines()
          for name,lo,hi in [('SIGTY',50797,51215),('SIGTZ',51263,51752)]:
              sub=lines[lo-1:hi]
              hits=[i for i,s in enumerate(sub) if re.search(
                  r'IDOPTY|IDOPTZ|TSIGV|TSIGW|TYIDR|LAGRANG|CALM|BVFS|^\s*\d{2,5}\s+CONTINUE',s,re.I)]
              selected=set(range(min(65,len(sub))))
              for i in hits:
                  selected.update(range(max(0,i-12),min(len(sub),i+24)))
              print(f'P7_VENDOR_CALM_SOURCE_START {name} lines={lo}-{hi} matches={len(hits)}')
              previous=-10
              for i in sorted(selected):
                  if i>previous+1: print('... omitted ...')
                  print(f'[{lo+i:05d}] {sub[i]}')
                  previous=i
              print(f'P7_VENDOR_CALM_SOURCE_END {name}')
          print('P7_VENDOR_CALM_PARAMETER_SOURCE_START')
          for lo,hi in [(50912,50936),(51495,51559),(52504,52619)]:
              print(f'P7_EXACT_SPAN {lo}-{hi}')
              for i in range(lo-1,hi):
                  print(f'[{i+1:05d}] {lines[i]}')
          pattern=re.compile(r'(?<![a-z0-9_])(tyidr|tzidr|tzisdr)\\s*=',re.I)
          assignments=[(i+1,s) for i,s in enumerate(lines) if pattern.search(s) and not s.lstrip().lower().startswith('c')]
          print('P7_TURBULENCE_INVERSE_TIME_ASSIGNMENTS',len(assignments))
          for i,s in assignments[:100]:
              for k in range(max(0,i-4),min(len(lines),i+3)):
                  print(f'[{k+1:05d}] {lines[k]}')
          print('P7_VENDOR_BLOCK_DATA_TIME_SCALES_START')
          for i,line in enumerate(lines):
              if 1999<=i+1<=2424 and re.search(r'tyidr|tzidr|tzisdr|ayt',line,re.I):
                  for k in range(max(0,i-3),min(len(lines),i+4)):
                      print(f'[{k+1:05d}] {lines[k]}')
          print('P7_VENDOR_BLOCK_DATA_TIME_SCALES_END')
          # Isolate original JDSTAB/EL/TSIGW authorities at the genuine
          # Hefei H9 /CSIGMA/ discrepancy (0.03 vs native PGT3 0.08).
          # This is SOURCE INSPECTION ONLY and must not feed the solver.
          for label,lo,hi in [('H9_COMP_HTMET',10464,10503),
                              ('H9_COMP_STABILITY',10680,10735),
                              ('H9_COMP_SETCSIG',10800,10890),
                              ('H9_TURBSET',52030,52190),
                              ('H9_SETCSIG',52500,52620)]:
              print(f'P7_H9_ORIGINAL_SOURCE_BEGIN LABEL={label}')
              for line_number in range(lo,hi+1):
                  line=lines[line_number-1]
                  if line.strip() and (line[:1].lower()!='c' or
                      re.search(r'jdstab|swmin|minimum|stability|sigw',line,re.I)):
                      print(f'P7_H9_ORIGINAL_SOURCE LINE={line_number} TEXT={line!r}')
              print(f'P7_H9_ORIGINAL_SOURCE_END LABEL={label}')
          print('P7_CALM_UPSTREAM_MET_PROVENANCE_START')
          for label,lo,hi in [('COMP',10000,11100),
                              ('POINTS1',15700,16300),
                              ('SETPUF',48000,48800),
                              ('SETCSIG',52504,52619)]:
              sub=lines[lo-1:hi]
              matches=[i for i,s in enumerate(sub) if
                       re.search(r'tsigv|tsigw|sigv0|sigw0|setcsig|lcalm|wscalm|tyidr|tzisdr',s,re.I)
                       and not s.lstrip().lower().startswith('c')]
              print(f'P7_CALM_UPSTREAM {label} MATCHES={len(matches)}')
              keys=set()
              for i in matches[:50]:
                  keys.update(range(max(0,i-4),min(len(sub),i+7)))
              last=-100
              for i in sorted(keys):
                  if i>last+1: print('... omitted ...')
                  print(f'[{lo+i:05d}] {sub[i]}')
                  last=i
          print('P7_CALM_UPSTREAM_MET_PROVENANCE_END')
          header=re.compile(r'^      subroutine turbset\b',re.I)
          starts=[i for i,line in enumerate(lines) if header.match(line)]
          if len(starts)!=1:
              raise RuntimeError(f'exact TURBSET source header expected, got {len(starts)}')
          start=starts[0]
          stops=[i for i in range(start+1,len(lines)) if
                 re.match(r'^      end\s*'+'$',lines[i],re.I)]
          if not stops:
              raise RuntimeError('TURBSET end not found')
          end=stops[0]
          src=lines[start:end+1]
          pattern=re.compile(r'tsigv|tsigw|sigv|sigw|ustar|wstar|svmin|swmin|mdisp|idopty|idoptz|el|zi|mix|metfm',re.I)
          chosen=set(range(min(65,len(src))))
          for n,line in enumerate(src):
              if not line.lstrip().lower().startswith('c') and pattern.search(line):
                  chosen.update(range(max(0,n-4),min(len(src),n+7)))
          print(f'P7_ORIGINAL_TURBSET_SOURCE_START LINES={start+1}-{end+1}')
          old=-10
          for n in sorted(chosen):
              if n>old+1: print('... omitted ...')
              print(f'[{start+n+1:05d}] {src[n]}')
              old=n
          print('P7_ORIGINAL_TURBSET_SOURCE_END')
          print('P7_ORIGINAL_COMP_ILW_MAPPING_START')
          for lo,hi in [(9700,11200),(18000,18580),(52000,52190)]:
              sub=lines[lo-1:hi]
              found=[i for i,s in enumerate(sub)
                     if re.search(r'\\bilw\\b|\\bwater\\b|landu|iwat',s,re.I)
                     and not s.lstrip().lower().startswith('c')]
              keys=set()
              for i in found[:60]:
                  keys.update(range(max(0,i-4),min(len(sub),i+7)))
              old=-10
              for i in sorted(keys):
                  if i>old+1: print('... omitted ...')
                  print(f'[{lo+i:05d}] {sub[i]}')
                  old=i
          print('P7_ORIGINAL_COMP_RISEWIND_CONDITION_START')
          for lo,hi in [(10470,10534),(10540,10586)]:
              print(f'P7_EXACT_COMP_RISEWIND {lo}-{hi}')
              for n in range(lo-1,hi):
                  print(f'[{n+1:05d}] {lines[n]}')
          print('P7_ORIGINAL_COMP_RISEWIND_CONDITION_END')
          print('P7_ORIGINAL_COMP_ILW_MAPPING_END')
          print('P7_VENDOR_CALM_PARAMETER_SOURCE_END')
          PY
