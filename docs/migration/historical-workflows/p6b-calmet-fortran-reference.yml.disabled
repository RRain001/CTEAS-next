name: P6B pinned ORIGINAL CALMET 2022 100m baseline
concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true
on:
  pull_request:
    paths:
      - 'engine/templates/calmet.inp'
      - 'project/cases/**'
      - 'native_cpp/modules/p4_read62/**'
      - 'native_cpp/modules/p5_smerge/**'
      - 'docs/reconstruction_cpp/CI_FULL_REGRESSION_REQUEST.md'
      - '.github/workflows/p6b-calmet-fortran-reference.yml'
  workflow_dispatch:
jobs:
  original-calmet:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 45
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - name: Provision GitHub-hosted GCC12 and Fortran12
        shell: bash
        run: |
          set -euo pipefail
          sudo apt-get update -qq
          sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq g++-12 gfortran-12
      - name: Select isolated C++20 and Fortran compilers
        uses: ./.github/actions/cteas-linux-toolchain
      - name: Verify coherent PR checkout and record historical source provenance
        shell: bash
        run: |
          set -euo pipefail
          # The historical P6B workflow previously restored P3/P4/P5 from
          # three older commits into the PR checkout. That created a hybrid
          # tree: newer P6 station-contract tests imported symbols absent in
          # the restored historical P5 module. Never overlay the PR's sources.
          test -s project/cases/smoke5d_coldstart_20260701/case.yaml
          test -s native_cpp/modules/p4_read62/data_prep/run_cpp_pipeline.py
          test -s native_cpp/modules/p5_smerge/data_prep/download_isd_by_grid.py
          test -s native_cpp/reference/capture_p3_makegeo.py
          mkdir -p integration-evidence
          git rev-parse HEAD > integration-evidence/checkout-head.sha
          for p in native_cpp/modules/p4_read62 native_cpp/modules/p5_smerge native_cpp/reference/capture_p3_makegeo.py project/cases/smoke5d_coldstart_20260701/case.yaml; do
            git rev-parse "HEAD:$p" >> integration-evidence/coherent-source-trees.sha
          done
          # Keep historical parent SHAs as provenance, never as an overlay.
          printf '%s\n' dc4e3f042e5668358fc43f2f2ae98d7a554ecfd3 > integration-evidence/p4-historical-source.sha
          printf '%s\n' dd473cede495bb04b312dc31d6bdef8afabe26c2 > integration-evidence/p5-historical-source.sha
          printf '%s\n' 5b1013baea10c0b3c3946e62ab77428dff05455e > integration-evidence/p3-historical-source.sha
          printf '%s\n' 2908293f061af93e754bc9fe1f00d857d1d6a0d8 > integration-evidence/historical-case-provenance.sha
          test -z "$(git status --porcelain -- native_cpp/modules/p4_read62 native_cpp/modules/p5_smerge native_cpp/reference/capture_p3_makegeo.py project/cases/smoke5d_coldstart_20260701/case.yaml)"
          echo "P6B_SOURCE_TREE=COHERENT_CHECKOUT_HEAD historical_sha_provenance=retained"
      - name: Toolchains
        shell: bash
        run: |
          set -euo pipefail
          if ! pkg-config --exists gdal; then
            sudo -n apt-get update -qq
            sudo -n DEBIAN_FRONTEND=noninteractive apt-get install -y -qq libgdal-dev
          fi
          python3 -m venv "$RUNNER_TEMP/cteas-p6b-venv"
          "$RUNNER_TEMP/cteas-p6b-venv/bin/python" -m pip install --disable-pip-version-check PyYAML numpy pandas
          echo "$RUNNER_TEMP/cteas-p6b-venv/bin" >> "$GITHUB_PATH"
          gfortran --version | head -1 | tee integration-evidence/compiler.txt
      - name: Original unchanged P1-P2-P3 100m GEO.DAT
        shell: bash
        run: |
          set -euo pipefail
          python3 native_cpp/reference/capture_p1_p2.py --output /tmp/p4p5-original-geo
          python3 native_cpp/reference/capture_p3_makegeo.py --output /tmp/p4p5-original-geo
          test -s /tmp/p4p5-original-geo/p3/geo.dat
          sha256sum /tmp/p4p5-original-geo/p3/geo.dat | tee integration-evidence/geo.sha256
      - name: New isolated 2022 case with ORIGINAL CTEAS control renderer
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY'
          from pathlib import Path
          import yaml,shutil
          from engine.core.case_manager import set_current_case
          case="ci_original_calmet_p4_p5_2022"
          path=Path("project/cases")/case
          (path/"grid").mkdir(parents=True,exist_ok=True)
          (path/"geo/makegeo").mkdir(parents=True,exist_ok=True)
          (path/"run/smerge").mkdir(parents=True,exist_ok=True)
          cfg=yaml.safe_load(Path("project/cases/smoke5d_coldstart_20260701/case.yaml").read_text())
          cfg["case_name"]=case
          cfg["preprocess"]["grid"]["domain"]={"length_km":5,"width_km":5}
          cfg["preprocess"]["grid"]["resolution_km"]=0.1
          cfg["preprocess"]["research_time"]={"begin":"20220101-000000","end":"20220106-230000"}
          (path/"case.yaml").write_text(yaml.safe_dump(cfg,sort_keys=False))
          set_current_case(case)
          shutil.copy2("/tmp/p4p5-original-geo/grid.cmn",path/"grid/grid.cmn")
          shutil.copy2("/tmp/p4p5-original-geo/p3/geo.dat",path/"geo/makegeo/geo.dat")
          (path/"grid/center_location").write_text("latitude: 31.939774444\nlongitude: 117.141610855\n")
          (path/"grid/stack_location").write_text("latitude: 31.939774444\nlongitude: 117.141610855\n")
          (path/"grid/research_time").write_text("BEGIN: 20220101-000000\nEND: 20220106-230000\n")
          shutil.copy2("engine/templates/smerge.inp",path/"run/smerge/smerge.inp")
          print("INTEGRATION_CASE",path.resolve())
          PY
      - name: P4 C++ build / real 2022 IGRA FSL / final UP.DAT
        shell: bash
        run: |
          set -euo pipefail
          cmake -S native_cpp/modules/p4_read62 -B /tmp/p4p5-p4-build -DCMAKE_BUILD_TYPE=Release
          cmake --build /tmp/p4p5-p4-build -j2
          ctest --test-dir /tmp/p4p5-p4-build --output-on-failure
          python3 -m native_cpp.modules.p4_read62.data_prep.prepare_inputs --year 2022 --pstop 500 --execute
          python3 -m native_cpp.modules.p4_read62.data_prep.run_cpp_pipeline \
            --cpp-bin /tmp/p4p5-p4-build/cteas_p4_read62 \
            --year 2022 --pstop 500 --skip-inputs --merge-final --execute \
            2>&1 | tee integration-evidence/p4-run.log
          test -s project/current/met/upperair/final/up_58424.dat
          cp project/current/met/upperair/final/stations.csv integration-evidence/p4-stations.csv
      - name: P6C original RDHDU/RDUPN upper air v2.1 native Fortran vs C++ numeric parity
        shell: bash
        run: |
          set -euo pipefail
          cmake -S native_cpp/modules/p6_calmet -B /tmp/p6c-up-build -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_FLAGS=-fno-strict-aliasing
          cmake --build /tmp/p6c-up-build --parallel 2
          ctest --test-dir /tmp/p6c-up-build --output-on-failure
          python3 native_cpp/modules/p6_calmet/reference/compare_fortran_upper_rdupn.py \
            --vendor engine/vendor/src/CALMET_v6.5.0_L150223 \
            --up project/current/met/upperair/final/up_58424.dat \
            --cpp /tmp/p6c-up-build/cteas_p6_read_upper \
            --station 58424 \
            --out integration-evidence/p6c-upper-rdupn-reference
      - name: P6C original VERbatim VERTAV layer winds vs C++ on 13 real 2022 soundings
        shell: bash
        run: |
          set -euo pipefail
          python3 native_cpp/modules/p6_calmet/reference/compare_original_vertav.py \
            --vendor engine/vendor/src/CALMET_v6.5.0_L150223 \
            --up project/current/met/upperair/final/up_58424.dat \
            --cpp-level /tmp/p6c-up-build/cteas_p6_read_upper \
            --cpp-vertav /tmp/p6c-up-build/cteas_p6_vertav \
            --station 58424 \
            --out integration-evidence/p6c-vertav-reference
      - name: P6C original PREPDI source-exact 143 hourly time/vertical winds parity
        shell: bash
        run: |
          set -euo pipefail
          /tmp/p6c-up-build/cteas_p6_upper_hourly \
            project/current/met/upperair/final/up_58424.dat \
            integration-evidence/p6c-hourly-prepdi.csv \
            58424
          python3 native_cpp/modules/p6_calmet/reference/compare_original_prepdi_time.py \
            --vendor engine/vendor/src/CALMET_v6.5.0_L150223 \
            --up project/current/met/upperair/final/up_58424.dat \
            --original-vertav integration-evidence/p6c-vertav-reference/original_vertav_result.txt \
            --modern-hourly integration-evidence/p6c-hourly-prepdi.csv \
            --out integration-evidence/p6c-prepdi-time-reference
      - name: P6C original FACET and INTP full-source face temperatures vs C++
        shell: bash
        run: |
          set -euo pipefail
          python3 native_cpp/modules/p6_calmet/reference/compare_original_facet.py \
            --vendor engine/vendor/src/CALMET_v6.5.0_L150223 \
            --up project/current/met/upperair/final/up_58424.dat \
            --cpp-level /tmp/p6c-up-build/cteas_p6_read_upper \
            --cpp-facet /tmp/p6c-up-build/cteas_p6_facet \
            --station 58424 \
            --out integration-evidence/p6c-facet-reference
      - name: P5 real 2022 ISD + Lite / two-stage wind / GENERIC
        shell: bash
        run: |
          set -euo pipefail
          python3 -m native_cpp.modules.p5_smerge.data_prep.prepare_inputs \
            --expected-year 2022 --stack-lat 31.939774444 --stack-lon 117.141610855 \
            --write-legacy-control --execute 2>&1 | tee integration-evidence/p5-run.log
          python3 -m native_cpp.modules.p5_smerge.data_prep.validate_scheme_c_capture \
            --case-root project/current --expected-hours 144 \
            --report integration-evidence/p5-v2-source-calm-evidence.json
          test -s project/current/run/smerge/smerge.inp
          test -s project/current/met/surface/isd2smerge_ready/583210-99999.csv
      - name: Build UNCHANGED original SMERGE and CALMET Fortran on Linux
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p bin/linux-x86_64 /tmp/p4p5-smerge-include /tmp/p4p5-calmet-include
          for item in engine/vendor/src/SMERGE_v5.7.0_L121203/*; do
            test -f "$item" || continue
            name=$(basename "$item" | tr '[:upper:]' '[:lower:]')
            if [ ! -e "/tmp/p4p5-smerge-include/$name" ]; then
              ln -s "$GITHUB_WORKSPACE/$item" "/tmp/p4p5-smerge-include/$name"
            fi
          done
          for item in engine/vendor/src/CALMET_v6.5.0_L150223/*; do
            test -f "$item" || continue
            name=$(basename "$item" | tr '[:upper:]' '[:lower:]')
            if [ ! -e "/tmp/p4p5-calmet-include/$name" ]; then
              ln -s "$GITHUB_WORKSPACE/$item" "/tmp/p4p5-calmet-include/$name"
            fi
          done
          flags="-O0 -std=legacy -fno-automatic -fno-align-commons -fallow-argument-mismatch -ffixed-line-length-none"
          gfortran $flags -I/tmp/p4p5-smerge-include \
            engine/vendor/src/SMERGE_v5.7.0_L121203/SMERGE.FOR \
            -o bin/linux-x86_64/smerge.x 2>&1 | tee integration-evidence/smerge-build.log
          gfortran $flags -I/tmp/p4p5-calmet-include \
            engine/vendor/src/CALMET_v6.5.0_L150223/calmet.for \
            -o bin/linux-x86_64/met.x 2>&1 | tee integration-evidence/calmet-build.log
          test -x bin/linux-x86_64/smerge.x
          test -x bin/linux-x86_64/met.x
          sha256sum engine/vendor/src/SMERGE_v5.7.0_L121203/SMERGE.FOR \
            engine/vendor/src/CALMET_v6.5.0_L150223/calmet.for \
            > integration-evidence/untouched-fortran-source.sha256
      - name: Execute untouched original SMERGE on NEW P5 GENERIC
        shell: bash
        run: |
          set -euo pipefail
          python3 -m native_cpp.modules.p5_smerge.data_prep.run_smerge_and_monitor \
            2>&1 | tee integration-evidence/original-smerge-wrapper.log
          test -s project/current/met/surface/final/surf.dat
          test -s project/current/met/surface/final/stations.csv
          sha256sum project/current/met/surface/final/surf.dat > integration-evidence/surf.sha256
          cp project/current/run/smerge/smerge.lst integration-evidence/original-smerge.lst
      - name: P6C strict new 2022 SURF.DAT one-hour records vs native Fortran
        shell: bash
        run: |
          set -euo pipefail
          cmake -S native_cpp/modules/p6_calmet -B /tmp/p6c-surface-build -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_FLAGS=-fno-strict-aliasing
          cmake --build /tmp/p6c-surface-build --parallel 2
          ctest --test-dir /tmp/p6c-surface-build --output-on-failure
          python3 native_cpp/modules/p6_calmet/reference/compare_fortran_surface.py \
            --vendor engine/vendor/src/CALMET_v6.5.0_L150223 \
            --surf project/current/met/surface/final/surf.dat \
            --cpp /tmp/p6c-surface-build/cteas_p6_read_surface \
            --out integration-evidence/p6c-surf-reference
      - name: Execute UNCHANGED original CTEAS CALMET Python flow and original Fortran binary
        shell: bash
        run: |
          set -euo pipefail
          python3 -m engine.run_met.run_met --case ci_original_calmet_p4_p5_2022 \
            2>&1 | tee integration-evidence/cteas-original-calmet-run.log
          test -s project/current/run/met/met.lst
          test -s project/current/run/met/met.dat
          cp project/current/run/met/met.inp integration-evidence/original-rendered-met.inp
          cp project/current/run/met/met_runtime.log integration-evidence/met-runtime.log
          cp project/current/run/met/met.lst integration-evidence/met.lst
          sha256sum project/current/run/met/met.dat > integration-evidence/calmet-output.sha256
          python3 - <<'PY'
          import json,pathlib,re
          root=pathlib.Path("project/current")
          lst=(root/"run/met/met.lst").read_text(errors="replace")
          runtime=(root/"run/met/met_runtime.log").read_text(errors="replace")
          errors=re.findall(r'(?im)^\s*ERROR IN SUBR\.|\bFATAL\b|\bABORT\b|segmentation fault|forrtl:\s*severe|cannot open',lst+"\n"+runtime)
          met=root/"run/met/met.dat"
          if errors or not met.is_file() or met.stat().st_size==0:
              raise SystemExit(f"Original CALMET failed: errors={errors} output={met}")
          result={"status":"ORIGINAL_CALMET_PIPELINE_PASS",
                  "case":"ci_original_calmet_p4_p5_2022",
                  "start":"2022-01-01T00:00Z","end":"2022-01-06T23:00Z",
                  "grid":[50,50],"spacing_m":100,
                  "original_fortran_versions":["SMERGE_v5.7.0_L121203","CALMET_v6.5.0_L150223"],
                  "met_dat_bytes":met.stat().st_size,
                  "met_lst_bytes":len(lst.encode()),"error_keywords":errors}
          pathlib.Path("integration-evidence/final-status.json").write_text(json.dumps(result,indent=2)+"\n")
          print("P4_P5_ORIGINAL_CALMET_END_TO_END=PASS",json.dumps(result))
          PY
      - name: P6C real 143-hour triple input joint observation crosscheck (1h 6h 143h)
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY'
          from pathlib import Path
          from native_cpp.modules.p6_calmet.reference.inspect_calmet_control import parse
          import re
          met=Path("project/current/run/met/met.inp")
          c=parse(met)
          required=["XORIGKM","YORIGKM","NSECDT"]
          if any(k not in c for k in required):
              raise SystemExit("CALMET original controls missing SW grid or timestep")
          source=Path("engine/vendor/src/CALMET_v6.5.0_L150223/calmet.for")
          matches=re.findall(r"(?im)^\s*data\s+maxsep\s*/\s*(\d+)\s*/\s*$",source.read_text())
          if matches!=["14"]:
              raise SystemExit("Original fixed CALMET COMP DATA MAXSEP/14/ drifted")
          Path("integration-evidence/p6c-grid-origin.txt").write_text(
              " ".join([c["XORIGKM"],c["YORIGKM"],c["NSECDT"],matches[0]])+"\n")
          PY
          read -r ORIGIN_X ORIGIN_Y NSECDT MAXSEP < integration-evidence/p6c-grid-origin.txt
          python3 native_cpp/modules/p6_calmet/reference/compare_fortran_readge.py \
            --vendor engine/vendor/src/CALMET_v6.5.0_L150223 \
            --geo project/current/geo/makegeo/geo.dat \
            --cpp /tmp/p6c-up-build/cteas_p6_read_geo \
            --origin-x "$ORIGIN_X" --origin-y "$ORIGIN_Y" \
            --out integration-evidence/p6c-joint-geo-original
          /tmp/p6c-up-build/cteas_p6_comp_joint \
            project/current/geo/makegeo/geo.dat \
            project/current/met/surface/final/surf.dat \
            project/current/met/upperair/final/up_58424.dat \
            integration-evidence/p6c-joint-observation.csv \
            58424 "$ORIGIN_X" "$ORIGIN_Y" "$NSECDT" "$MAXSEP"
          python3 native_cpp/modules/p6_calmet/reference/check_joint_observation_2022.py \
            --joint integration-evidence/p6c-joint-observation.csv \
            --original-geo integration-evidence/p6c-joint-geo-original/reference_fortran_fields.txt \
            --original-surf integration-evidence/p6c-surf-reference/original_surface.txt \
            --original-prepdi integration-evidence/p6c-prepdi-time-reference/original_prepdi_143h.txt \
            --original-facet integration-evidence/p6c-facet-reference/original_face_temperature.txt \
            --up project/current/met/upperair/final/up_58424.dat \
            --out integration-evidence/p6c-joint-143-hour-crosscheck.json
      - name: Audit actual CALMET.DAT unformatted record framing and freeze source hashes
        shell: bash
        run: |
          set -euo pipefail
          python3 native_cpp/modules/p6_calmet/reference/audit_calmet_records.py \
            project/current/run/met/met.dat \
            --manifest integration-evidence/p6b-original-binary-records.json
          python3 native_cpp/modules/p6_calmet/reference/decode_calmet_hourly.py \
            project/current/run/met/met.dat \
            --report integration-evidence/p6b-original-hourly-layout.json
          sha256sum \
            project/current/geo/makegeo/geo.dat \
            project/current/met/upperair/final/up_58424.dat \
            project/current/met/surface/final/surf.dat \
            project/current/run/met/met.inp \
            project/current/run/met/met.dat \
            > integration-evidence/p6b-input-control-output.sha256
          cp project/current/met/surface/final/stations.csv integration-evidence/p5-stations.csv
          cp project/current/met/upperair/final/stations.csv integration-evidence/p4-stations.csv
          cp project/current/run/met/met.inp integration-evidence/frozen-calmet-controls.inp
      - name: P6C independently execute original COMP with write-only AA BB runtime trace
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p /tmp/p6c-original-comp
          python3 native_cpp/modules/p6_calmet/reference/original_comp_runtime_trace.py instrument \
            --vendor engine/vendor/src/CALMET_v6.5.0_L150223/calmet.for \
            --out /tmp/p6c-original-comp/calmet.for
          cp /tmp/p6c-original-comp/p6c-comp-trace-instrumentation.json \
            integration-evidence/p6c-comp-trace-instrumentation.json
          flags="-O0 -std=legacy -fno-automatic -fno-align-commons -fallow-argument-mismatch -ffixed-line-length-none"
          gfortran $flags -I/tmp/p4p5-calmet-include \
            /tmp/p6c-original-comp/calmet.for \
            -o /tmp/p6c-original-comp/met-trace.x \
            > integration-evidence/p6c-comp-trace-build.log 2>&1
          baseline_sha=$(sha256sum project/current/run/met/met.dat | cut -d' ' -f1)
          cp bin/linux-x86_64/met.x /tmp/p6c-original-comp/met-untouched.x
          trap 'cp /tmp/p6c-original-comp/met-untouched.x bin/linux-x86_64/met.x' EXIT
          cp /tmp/p6c-original-comp/met-trace.x bin/linux-x86_64/met.x
          python3 -m engine.run_met.run_met --case ci_original_calmet_p4_p5_2022 \
            > integration-evidence/p6c-original-comp-run.log 2>&1
          instrumented_sha=$(sha256sum project/current/run/met/met.dat | cut -d' ' -f1)
          printf 'untouched=%s\\nwrite_only_trace=%s\\n' "$baseline_sha" "$instrumented_sha" \
            > integration-evidence/p6c-comp-output-equivalence.txt
          test "$baseline_sha" = "$instrumented_sha"
          cp project/current/run/met/met_runtime.log \
            integration-evidence/p6c-original-comp-runtime.log
          python3 native_cpp/modules/p6_calmet/reference/original_comp_runtime_trace.py compare \
            --runtime integration-evidence/p6c-original-comp-runtime.log \
            --joint integration-evidence/p6c-joint-observation.csv \
            --up project/current/met/upperair/final/up_58424.dat \
            --out integration-evidence/p6c-original-comp-vs-cpp-143h.json
          python3 native_cpp/modules/p6_calmet/reference/compare_original_cgamma_2022.py \
            --runtime integration-evidence/p6c-original-comp-runtime.log \
            --up project/current/met/upperair/final/up_58424.dat \
            --cpp /tmp/p6c-up-build/cteas_p6_cgamma \
            --out integration-evidence/p6c-cgamma-original-reference
      - name: Retain diagnostics even on failure
        if: always()
        shell: bash
        run: |
          mkdir -p integration-evidence
          for pair in \
            "project/current/run/smerge/smerge.lst original-smerge.lst" \
            "project/current/run/smerge/smerge_runtime.log original-smerge-runtime.log" \
            "project/current/run/met/met.lst original-calmet.lst" \
            "project/current/run/met/met_runtime.log original-calmet-runtime.log"; do
            set -- $pair
            if [ -f "$1" ]; then cp "$1" "integration-evidence/$2"; fi
          done
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: p6b-original-calmet-hefei-2022-100m
          path: integration-evidence/
          retention-days: 7
          if-no-files-found: warn
