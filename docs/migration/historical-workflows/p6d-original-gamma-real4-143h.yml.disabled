name: P6D original GAMMA REAL4 source oracle 143-hour diagnostic

on:
  pull_request:
    paths:
      - 'scripts/p6d_trace_original_gamma.py'
      - 'scripts/p6d_compare_original_gamma_diagnostic.py'
      - 'scripts/run_p6_end_to_end.py'
      - '.github/workflows/p6d-original-gamma-real4-143h.yml'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: p6d-gamma-oracle-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

jobs:
  source-gamma-143h:
    name: CALMET original write-only GAMMA with byte-identical MET.DAT
    runs-on: ubuntu-22.04
    timeout-minutes: 45
    defaults:
      run:
        working-directory: p6d_gamma_checkout
    steps:
      - uses: actions/checkout@v4
        with:
          path: p6d_gamma_checkout
      - uses: ./p6d_gamma_checkout/.github/actions/cteas-linux-toolchain
      - name: Restore source-pinned GEO SURF UP and CALMET deck
        run: python3 native_cpp/modules/p6_calmet/reference/restore_frozen_case_from_git.py --mode grid
      - name: Run unchanged Fortran and write-only GAMMA instrumented CALMET
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/p6d_trace_original_gamma.py \
            --vendor engine/vendor/src/CALMET_v6.5.0_L150223 \
            --case project/cases/hefei5km_2022_reference_case_20261011 \
            --compiler gfortran-11 --hours 143 \
            --out "$RUNNER_TEMP/p6d-original-gamma-${{ github.run_id }}-${{ github.run_attempt }}"
      - name: Preserve exact REAL4 reference forcing and unchanged-CALMET proof
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: p6d-original-gamma-source-real4
          path: |
            ${{ runner.temp }}/p6d-original-gamma-${{ github.run_id }}-${{ github.run_attempt }}/gamma/*.f32
            ${{ runner.temp }}/p6d-original-gamma-${{ github.run_id }}-${{ github.run_attempt }}/gamma_source_manifest.json
          if-no-files-found: warn
          retention-days: 7

  full-143h-forensic-diff:
    name: 143-hour P6D original GAMMA vs native baseline diagnostic
    needs: [source-gamma-143h]
    runs-on: ubuntu-22.04
    timeout-minutes: 75
    defaults:
      run:
        working-directory: p6d_gamma_compare_checkout
    steps:
      - uses: actions/checkout@v4
        with:
          path: p6d_gamma_compare_checkout
      - uses: ./p6d_gamma_compare_checkout/.github/actions/cteas-linux-toolchain
      - uses: actions/download-artifact@v4
        with:
          name: p6d-original-gamma-source-real4
          path: ${{ runner.temp }}/p6d-reference-gamma-${{ github.run_id }}
      - name: Restore case and prove original GAMMA files intact
        shell: bash
        run: |
          set -euo pipefail
          python3 native_cpp/modules/p6_calmet/reference/restore_frozen_case_from_git.py --mode grid
          test -s "$RUNNER_TEMP/p6d-reference-gamma-${{ github.run_id }}/gamma_source_manifest.json"
          test -s "$RUNNER_TEMP/p6d-reference-gamma-${{ github.run_id }}/gamma/gamma_2022-01-01_01.f32"
      - name: Run both 143-hour variants with identical C++ binaries and strict numeric gates
        shell: bash
        run: |
          set -euo pipefail
          evidence="$RUNNER_TEMP/p6d-gamma-diff-${{ github.run_id }}-${{ github.run_attempt }}"
          build="$evidence/build"
          mkdir -p "$evidence"
          # Return code 1 means a genuine field-comparison FAIL: record it,
          # preserve its evidence, and do not rebrand it as a scientific PASS.
          set +e
          python3 scripts/run_p6_end_to_end.py \
            --build-dir "$build" --jobs 2 --hours 143 \
            --work "$evidence/baseline" > "$evidence/baseline.log" 2>&1
          base_code=$?
          set -e
          if [[ ! -s "$evidence/baseline/p6g_report.json" ]]; then
            tail -100 "$evidence/baseline.log"
            echo "::error::Baseline run did not complete original numeric comparisons"
            exit 1
          fi
          if [[ "$base_code" != 0 && "$base_code" != 1 ]]; then
            tail -100 "$evidence/baseline.log"
            exit "$base_code"
          fi
          set +e
          python3 scripts/run_p6_end_to_end.py \
            --build-dir "$build" --jobs 2 --hours 143 \
            --work "$evidence/original_gamma" \
            --original-gamma-dir "$RUNNER_TEMP/p6d-reference-gamma-${{ github.run_id }}/gamma" \
            --original-gamma-manifest "$RUNNER_TEMP/p6d-reference-gamma-${{ github.run_id }}/gamma_source_manifest.json" \
            > "$evidence/original_gamma.log" 2>&1
          gamma_code=$?
          set -e
          if [[ ! -s "$evidence/original_gamma/p6g_report.json" ]]; then
            tail -100 "$evidence/original_gamma.log"
            echo "::error::Original-GAMMA Fortran intervention could not be compared"
            exit 1
          fi
          if [[ "$gamma_code" != 0 && "$gamma_code" != 1 ]]; then
            tail -100 "$evidence/original_gamma.log"
            exit "$gamma_code"
          fi
          python3 scripts/p6d_compare_original_gamma_diagnostic.py \
            --baseline "$evidence/baseline/p6g_report.json" \
            --gamma "$evidence/original_gamma/p6g_report.json" \
            --out "$evidence/27-uvw-field-gamma-delta.json"
          cat "$evidence/27-uvw-field-gamma-delta.json"
      - name: Preserve BOTH per-field scientific verdicts and intervened state
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: p6d-143h-oracle-gamma-effect
          path: |
            ${{ runner.temp }}/p6d-gamma-diff-${{ github.run_id }}-${{ github.run_attempt }}/27-uvw-field-gamma-delta.json
            ${{ runner.temp }}/p6d-gamma-diff-${{ github.run_id }}-${{ github.run_attempt }}/baseline/p6g_report.json
            ${{ runner.temp }}/p6d-gamma-diff-${{ github.run_id }}-${{ github.run_attempt }}/original_gamma/p6g_report.json
            ${{ runner.temp }}/p6d-gamma-diff-${{ github.run_id }}-${{ github.run_attempt }}/baseline.log
            ${{ runner.temp }}/p6d-gamma-diff-${{ github.run_id }}-${{ github.run_attempt }}/original_gamma.log
          if-no-files-found: warn
          retention-days: 7