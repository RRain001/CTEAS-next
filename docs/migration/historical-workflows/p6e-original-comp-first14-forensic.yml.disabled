name: P6E original COMP first 14 hours stage forensic

on:
  push:
    branches: [codex/p6-hourly-stateful-scheduler-20261013]
    paths:
      - scripts/p6e_compare_original_dgm_comp_first14.py
      - .github/workflows/p6e-original-comp-first14-forensic.yml
  workflow_dispatch:

permissions:
  contents: read

jobs:
  frozen-original-vs-native:
    name: "First 14h source COMP stages vs native P6D-P6E: QH USTAR EL MIXHT WSTAR"
    runs-on: ubuntu-22.04
    timeout-minutes: 90
    steps:
      - uses: actions/checkout@v4
        with:
          filter: blob:none
          sparse-checkout: |
            native_cpp/modules/p6_calmet
            scripts/p6e_compare_original_dgm_comp_first14.py
      - uses: actions/checkout@v4
        with:
          ref: 3b94cdbfbb5f44146ba51a4ef112114f199d28b9
          path: original_locked_case
          filter: blob:none
          sparse-checkout: |
            project/cases/hefei5km_2022_reference_case_20261011
      - name: Verify the committed write-only Fortran original COMP trace
        shell: bash
        run: |
          set -euo pipefail
          echo "SOURCE_DGM_STATE_IS_FROZEN"
          printf '%s  %s\n' \
            e6b8ab309f81ddc3015dc750272eeb2ee8289a2d34563b364884d9e443be6ece \
            native_cpp/modules/p6_calmet/reference/dgm_internal_state_2022/dgm_state.bin |
            sha256sum -c -
      - name: Build unchanged C++ physical kernels and selected-case clock
        shell: bash
        run: |
          set -euo pipefail
          cmake -S native_cpp/modules/p6_calmet \
            -B "$RUNNER_TEMP/p6d" -DCMAKE_BUILD_TYPE=Release \
            -DCMAKE_CXX_COMPILER=g++-12
          cmake --build "$RUNNER_TEMP/p6d" --parallel 2 \
            --target cteas_p6_realcase_wind_field cteas_p6_native_cgamma_grid_143h \
                     cteas_p6_native_hourly_driver
          cmake -S native_cpp/modules/p6_calmet/p6e \
            -B "$RUNNER_TEMP/p6e" -DCMAKE_BUILD_TYPE=Release \
            -DCMAKE_CXX_COMPILER=g++-12
          cmake --build "$RUNNER_TEMP/p6e" --parallel 2 \
            --target p6e_calmet_dat21 p6e_p6c_hourly_bridge
      - name: Run 14 consecutive causal hours with no frozen wind input
        shell: bash
        run: |
          set -euo pipefail
          "$RUNNER_TEMP/p6d/cteas_p6_native_hourly_driver" \
            --case "$GITHUB_WORKSPACE/original_locked_case/project/cases/hefei5km_2022_reference_case_20261011" \
            --p6d "$RUNNER_TEMP/p6d/cteas_p6_realcase_wind_field" \
            --p6e "$RUNNER_TEMP/p6e/p6e_calmet_dat21" \
            --cgamma "$RUNNER_TEMP/p6d/cteas_p6_native_cgamma_grid_143h" \
            --bridge "$RUNNER_TEMP/p6e/p6e_p6c_hourly_bridge" \
            --hours 14 --work "$RUNNER_TEMP/p6e-original-comp-first14/native" \
            > "$RUNNER_TEMP/causal-14h.log"
          test -s "$RUNNER_TEMP/p6e-original-comp-first14/native/hour_013/comp.wstar.f32"
          test -s "$RUNNER_TEMP/p6e-original-comp-first14/native/hour_013/comp.q_flux.f32"
      - name: Identify first source-vs-native differences through ELUSTR and WSTARR
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/p6e_compare_original_dgm_comp_first14.py \
            --source native_cpp/modules/p6_calmet/reference/dgm_internal_state_2022/dgm_state.bin \
            --source-meta native_cpp/modules/p6_calmet/reference/dgm_internal_state_2022/dgm_state.meta.json \
            --native-work "$RUNNER_TEMP/p6e-original-comp-first14/native" --hours 14 \
            --out "$RUNNER_TEMP/p6e-original-comp-first14/source_vs_native_14h.json" \
            | tee "$RUNNER_TEMP/p6e-original-comp-first14/summary.log"
      - name: Archive unchanged-tolerance first difference evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: p6e-original-comp-first14-source-diff
          path: |
            ${{ runner.temp }}/p6e-original-comp-first14/source_vs_native_14h.json
            ${{ runner.temp }}/p6e-original-comp-first14/summary.log
            ${{ runner.temp }}/causal-14h.log
          retention-days: 14
          if-no-files-found: warn
