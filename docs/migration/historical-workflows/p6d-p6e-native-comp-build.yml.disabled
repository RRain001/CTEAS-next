name: P6D P6E station COMP coupling C++ strict build

on:
  push:
    branches: [audit/p6d-source-slope-drivers-143h-20261012]
    paths:
      - '.github/workflows/p6d-p6e-native-comp-build.yml'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: p6d-p6e-native-comp-build-${{ github.ref }}
  cancel-in-progress: true

jobs:
  independent-strict-compile:
    name: C++20 -Werror P6D P6E station source coupling and P6E original kernel tests
    runs-on: ubuntu-22.04
    timeout-minutes: 35
    steps:
      - uses: actions/checkout@v4
        with:
          filter: blob:none
          sparse-checkout: |
            .github/actions/cteas-linux-toolchain
            native_cpp/modules/p6_calmet
            scripts
      - uses: ./.github/actions/cteas-linux-toolchain
      - name: Compile physically coupled autonomous P6D producer and station oracle bisection
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-native-comp-compile-$GITHUB_RUN_ID"
          cmake -S native_cpp/modules/p6_calmet -B "$root/p6d" -DCMAKE_BUILD_TYPE=Release
          cmake --build "$root/p6d" \
            --target cteas_p6_realcase_wind_field cteas_p6_station_mixhtst_probe \
            --parallel 2
      - name: Compile P6E source-state-mutation stage and MIXHT physical regression
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-native-comp-compile-$GITHUB_RUN_ID"
          cmake -S native_cpp/modules/p6_calmet/p6e -B "$root/p6e" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$root/p6e" \
            --target p6e_calmet_dat21 p6e_mixht_observed_mc_tests p6e_mixhmc_tests p6e_mixdt_tests \
            --parallel 2
          ctest --test-dir "$root/p6e" \
            -R '^p6e_(mixht_observed_mc|mixhmc|mixdt)_software$' \
            --no-tests=error --output-on-failure
      - name: Confirm Python 143-hour provenance and workflow scripts parse
        run: |
          python3 -m py_compile scripts/p6d_compare_native_comp_station_143h.py
          python3 -m py_compile scripts/p6d_station_mixhtst_source_precursor_143h.py
          python3 -m py_compile scripts/run_p6_end_to_end.py