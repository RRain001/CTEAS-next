name: P7 native vertical state to wind production integration
on:
  pull_request:
    paths:
      - 'native_cpp/modules/p7_calpuff/**'
      - '.github/workflows/p7-native-vertical-state.yml'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: p7-native-vertical-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
jobs:
  native-vertical-state:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
          filter: blob:none
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /native_cpp/modules/p7_calpuff/**
            /project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat
      - name: Build native persisted POINTS1 INJECT SIGZ PUFFDZ ADVECT state
        shell: bash
        run: |
          set -euo pipefail
          met=project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat
          dgm=native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/dgm_puffstep_hour202200100.bin
          test -s "$met" && test -s "$dgm"
          echo 'b1823cda92280888d70b00961ab39486036a3086e18637fff21efb4f4b237d30  '${met} | sha256sum -c -
          echo 'b51d20d3cd1085902342d5b6d6b2f34c4a84c96d4966b63a2b1231c126087c89  '${dgm} | sha256sum -c -
          if command -v g++-12 >/dev/null 2>&1; then cpp="$(command -v g++-12)";
          elif command -v g++-11 >/dev/null 2>&1; then cpp="$(command -v g++-11)";
          else cpp="$(command -v c++)"; fi
          build="${RUNNER_TEMP}/p7-vertical-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          cmake -S native_cpp/modules/p7_calpuff -B "$build" \
            -DCMAKE_CXX_COMPILER="$cpp" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$build" --parallel 2 --target cteas_p7_native_vertical_tests cteas_p7_vmass_tests
          ctest --test-dir "$build" -R '^cteas_p7_native_vertical_' -N |
            grep -q 'cteas_p7_native_vertical_original_first_step_real4' || {
              echo "::error::Original native vertical integration acceptance missing"; exit 1;
            }
          ctest --test-dir "$build" -R '^cteas_p7_native_vertical_' --output-on-failure
          ctest --test-dir "$build" -R '^cteas_p7_native_vmass_source_branch_mass_contract$' --output-on-failure
          echo "P7_NATIVE_VMASS_SOURCE_BRANCH_CONTRACT=PASS"
          echo 'P7_NATIVE_POINT_SOURCE_VERTICAL_STATE=PASS'
          echo 'P7_COMPLETE_COMP_AND_CONCENTRATION=NOT_YET_VALIDATED'
