name: P6D original post-SLOPE WINDBC lateral-input 143h forensic

on:
  push:
    branches: [audit/p6d-original-boundary-143h-20261012]
    paths:
      - 'scripts/p6d_compare_original_windbc_input_143h.py'
      - '.github/workflows/p6d-original-windbc-input-143h.yml'
  pull_request:
    paths:
      - 'scripts/p6d_compare_original_windbc_input_143h.py'
      - '.github/workflows/p6d-original-windbc-input-143h.yml'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: p6d-windbc-original-stage-${{ github.ref }}
  cancel-in-progress: true

jobs:
  original-stage-boundary-143h:
    name: Original Fortran DGM kpt9 vs autonomous C++ post-SLOPE edges
    runs-on: ubuntu-22.04
    timeout-minutes: 70
    steps:
      - uses: actions/checkout@v4
        with:
          filter: blob:none
          sparse-checkout: |
            .github/actions/cteas-linux-toolchain
            native_cpp/modules/p6_calmet
            scripts
            engine/vendor/src/CALMET_v6.5.0_L150223
      - uses: ./.github/actions/cteas-linux-toolchain
      - name: Materialize and SHA-check all frozen original case inputs
        run: python3 native_cpp/modules/p6_calmet/reference/restore_frozen_case_from_git.py --mode grid
      - name: Build and run original untouched and source-instrumented CALMET
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-winbc-original-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          python3 native_cpp/modules/p6_calmet/reference/original_internal_state_dump.py audit \
            --vendor engine/vendor/src/CALMET_v6.5.0_L150223 \
            --case project/cases/hefei5km_2022_reference_case_20261011 \
            --out "$root/original" --compiler gfortran-11
      - name: Build and run unassisted C++ 143-hour post-SLOPE producer
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-winbc-original-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          cmake -S native_cpp/modules/p6_calmet -B "$root/build" -DCMAKE_BUILD_TYPE=Release
          cmake --build "$root/build" --target cteas_p6_realcase_wind_field --parallel 1
          mkdir -p "$root/candidate"
          "$root/build/cteas_p6_realcase_wind_field" \
            --case project/cases/hefei5km_2022_reference_case_20261011 \
            --hours 143 --out "$root/candidate"
      - name: Numerically locate post-SLOPE WINDBC edge input mismatches
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-winbc-original-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          python3 scripts/p6d_compare_original_windbc_input_143h.py \
            --original-dir "$root/original" --candidate "$root/candidate" \
            --out "$root/windbc_original_edge_143h.json"
      - name: Identify earliest original FRADJ vs SLOPE divergence across 143h full 3D fields
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-winbc-original-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          python3 scripts/p6d_diagnose_original_fradj_slope_143h.py \
            --original-dir "$root/original" --candidate "$root/candidate" \
            --out "$root/fradj_slope_original_143h.json"
      - name: Trace unmodified original 143h GAMMA forcing immediately before FRADJ
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-winbc-original-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          python3 scripts/p6d_trace_original_gamma.py \
            --vendor engine/vendor/src/CALMET_v6.5.0_L150223 \
            --case project/cases/hefei5km_2022_reference_case_20261011 \
            --out "$root/gamma-oracle" --compiler gfortran-11 --hours 143
      - name: Run original-GAMMA-forced C++ FRADJ without changing the native physics
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-winbc-original-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          mkdir -p "$root/forensic-gamma-candidate"
          "$root/build/cteas_p6_realcase_wind_field" \
            --case project/cases/hefei5km_2022_reference_case_20261011 \
            --hours 143 --gamma "$root/gamma-oracle/gamma" \
            --out "$root/forensic-gamma-candidate"
      - name: Locate residual FRADJ versus SLOPE errors after exact original GAMMA injection
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-winbc-original-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          python3 scripts/p6d_diagnose_original_fradj_slope_143h.py \
            --original-dir "$root/original" \
            --candidate "$root/forensic-gamma-candidate" \
            --pre-slope-prefix fradj_corrected \
            --out "$root/fradj_slope_original_gamma_forensic_143h.json"
      - name: Archive provenance-locked source-boundary evidence
        if: always()
        uses: actions/upload-artifact@v4
        continue-on-error: true
        with:
          name: p6d-original-windbc-input-143h
          path: |
            ${{ runner.temp }}/p6d-winbc-original-${{ github.run_id }}-${{ github.run_attempt }}/windbc_original_edge_143h.json
            ${{ runner.temp }}/p6d-winbc-original-${{ github.run_id }}-${{ github.run_attempt }}/fradj_slope_original_143h.json
            ${{ runner.temp }}/p6d-winbc-original-${{ github.run_id }}-${{ github.run_attempt }}/fradj_slope_original_gamma_forensic_143h.json
            ${{ runner.temp }}/p6d-winbc-original-${{ github.run_id }}-${{ github.run_attempt }}/gamma-oracle/gamma_source_manifest.json
            ${{ runner.temp }}/p6d-winbc-original-${{ github.run_id }}-${{ github.run_attempt }}/original/dgm-audit.json
          if-no-files-found: warn
          retention-days: 7