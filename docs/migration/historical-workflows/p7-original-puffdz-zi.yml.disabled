name: P7 original historical PUFFDZ ZI oracle
on:
  pull_request:
    paths:
      - 'native_cpp/modules/p7_calpuff/tests/puffdz_state_trace.cpp'
      - 'native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/puffdz_history_oracle.py'
      - '.github/workflows/p7-original-puffdz-zi.yml'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: p7-puffdz-zi-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
jobs:
  native-puffdz-all-143h:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 45
    steps:
      - name: Ensure exact original Fortran 11 compiler on GitHub-hosted Ubuntu
        shell: bash
        run: |
          set -euo pipefail
          if ! command -v gfortran-11 >/dev/null 2>&1; then
            sudo apt-get update -qq
            sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq gfortran-11
          fi
          gfortran-11 --version | head -n 1
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
          filter: blob:none
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /native_cpp/modules/p7_calpuff/**
            /engine/vendor/src/CALPUFF_v7.2.1_L150618/**
            /project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp
            /project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat
      - name: Check original 2022 input and compiler
        shell: bash
        run: |
          set -euo pipefail
          command -v gfortran-11
          test -s engine/vendor/src/CALPUFF_v7.2.1_L150618/calpuff.for
          test -s project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat
          test -s project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp
          echo "P7_PUFFDZ_ZI_RUNNER=${RUNNER_NAME} HOST=$(hostname)"
      - name: Rebuild unchanged Fortran and independent extra ZI instrumented copy
        shell: bash
        run: |
          set -euo pipefail
          root="${RUNNER_TEMP}/p7-zi-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          mkdir -p "$root/frozen/run/puff" "$root/frozen/deliverables/met"
          cp project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp \
             "$root/frozen/run/puff/puff.inp"
          ln -s "${GITHUB_WORKSPACE}/project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat" \
            "$root/frozen/deliverables/met/met.dat"
          python3 native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/puffdz_history_oracle.py \
            --vendor engine/vendor/src/CALPUFF_v7.2.1_L150618 \
            --case "$root/frozen" --out "$root/reference" \
            --compiler "$(command -v gfortran-11)" \
            --metadata native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/dgm_puffstep.json
          if command -v g++-12 >/dev/null 2>&1; then cpp="$(command -v g++-12)";
          elif command -v g++-11 >/dev/null 2>&1; then cpp="$(command -v g++-11)";
          else cpp="$(command -v c++)"; fi
          cmake -S native_cpp/modules/p7_calpuff -B "$root/cpp" \
            -DCMAKE_CXX_COMPILER="$cpp" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$root/cpp" --parallel 2 --target cteas_p7_puffdz_state_trace
          "$root/cpp/cteas_p7_puffdz_state_trace" \
            "$root/reference/case/run/puff/dgm_puffstep.bin" 143 \
            "$root/reference/case/run/puff/dgm_puffdz_zi.bin"
          echo "P7_143H_PUFFDZ_WITH_TRUE_HISTORICAL_ZI=PASS ORIGINAL_INPUT_FED=YES"
          python3 native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/puffdz_zi_history_audit.py \
            --dgm "$root/reference/case/run/puff/dgm_puffstep.bin" \
            --zi "$root/reference/case/run/puff/dgm_puffdz_zi.bin" \
            --output "$root/reference/zi-history-audit.json"
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: p7-puffdz-history-provenance
          path: |
            ${{ runner.temp }}/p7-zi-${{ github.run_id }}-${{ github.run_attempt }}/reference/puffdz-zi-provenance.json
            ${{ runner.temp }}/p7-zi-${{ github.run_id }}-${{ github.run_attempt }}/reference/zi-history-audit.json
          if-no-files-found: warn
          retention-days: 7
