name: P7 native VMASS original Fortran REAL4 parity
on:
  pull_request:
    paths:
      - 'native_cpp/modules/p7_calpuff/**'
      - '.github/workflows/p7-vmass-original-parity.yml'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: p7-vmass-parity-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
jobs:
  original-branch-matrix:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 18
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
          filter: blob:none
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /native_cpp/modules/p7_calpuff/**
            /engine/vendor/src/CALPUFF_v7.2.1_L150618/**
      - name: Build native standalone VMASS and compare original gfortran source
        shell: bash
        run: |
          set -euo pipefail
          command -v gfortran-11
          if command -v g++-12 >/dev/null 2>&1; then cpp=$(command -v g++-12);
          elif command -v g++-11 >/dev/null 2>&1; then cpp=$(command -v g++-11);
          else cpp=$(command -v c++); fi
          build="${RUNNER_TEMP}/p7-vmass-parity-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          cmake -S native_cpp/modules/p7_calpuff -B "$build" \
            -DCMAKE_CXX_COMPILER="$cpp" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$build" --parallel 2 --target cteas_p7_vmass_probe cteas_p7_vmass_tests
          ctest --test-dir "$build" -R '^cteas_p7_native_vmass_source_branch_mass_contract$' --output-on-failure
          python3 native_cpp/modules/p7_calpuff/tests/p7_vmass_original_parity.py \
            --native "$build/cteas_p7_vmass_probe" \
            --vendor engine/vendor/src/CALPUFF_v7.2.1_L150618 \
            --fortran gfortran-11
