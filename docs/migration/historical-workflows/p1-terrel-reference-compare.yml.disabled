name: P1 terrain Fortran numerical comparison
concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true
on:
  pull_request:
# Do NOT use workflow-level paths: skipped workflows can leave required checks
# pending indefinitely. A GitHub-hosted scope job always determines whether
# original Fortran/C++ comparison is genuinely relevant to this PR.
jobs:
  scope:
    name: p1-source-scope
    runs-on: ubuntu-22.04
    permissions:
      pull-requests: read
    outputs:
      relevant: ${{ steps.filter.outputs.relevant }}
    steps:
      - name: Check changed PR files without self-hosted runner
        id: filter
        uses: actions/github-script@v7
        with:
          script: |
            const prefixes = ["native_cpp/p1/","native_cpp/src/geo/","native_cpp/include/","calpuff_terrain_and_landuse_data_crop/hefei_5km/","engine/vendor/src/TERREL","engine/vendor/src/CTGPROC",".github/actions/cteas-linux-toolchain/"];
            const exact = new Set(["native_cpp/CMakeLists.txt","native_cpp/reference/capture_p1_p2.py","native_cpp/reference/compare_p1_terrain.py",".github/workflows/p1-terrel-reference-compare.yml"]);
            const isRelevant = (name) => Boolean(name) && (exact.has(name) || prefixes.some((prefix) => name.startsWith(prefix)));
            const changed = await github.paginate(github.rest.pulls.listFiles, {
              owner: context.repo.owner, repo: context.repo.repo,
              pull_number: context.issue.number, per_page: 100
            });
            if (changed.length >= 3000) {
              core.setFailed('Changed-file list reached the GitHub API 3000-file limit; do not skip original numerical parity');
              return;
            }
            const matched = changed.filter((item) => isRelevant(item.filename) || isRelevant(item.previous_filename));
            core.setOutput('relevant', matched.length ? 'true' : 'false');
            core.info('P1 TERREL SOURCE_SCOPE=' + (matched.length ? 'REQUIRES_SELF_HOSTED_NUMERIC_COMPARISON' : 'UNRELATED_CHANGE_SKIP_SELF_HOSTED')
              + ' FILES=' + changed.length + ' MATCHED=' + matched.map((item) => item.filename).join(','));
  
  compare:
    needs: scope
    if: >-
      needs.scope.outputs.relevant == 'true' &&
      (github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS')
    runs-on: ubuntu-22.04
    timeout-minutes: 16
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4
      - name: Install GitHub-hosted C++20 and Fortran toolchains
        shell: bash
        run: |
          set -euo pipefail
          sudo apt-get update -qq
          sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq g++-12 gfortran-12
      - name: Select C++20 and original Fortran compilers
        uses: ./.github/actions/cteas-linux-toolchain
      - name: Reset job-local scratch directories
        shell: bash
        run: |
          rm -rf ${{ runner.temp }}/cteas-p1-build ${{ runner.temp }}/p1-reference
      - name: Install C++ GDAL and original Fortran toolchains
        run: |
          if ! pkg-config --exists gdal; then
            sudo -n apt-get update -qq
            sudo -n DEBIAN_FRONTEND=noninteractive apt-get install -y -qq libgdal-dev
          fi
          gfortran --version | head -1
      - name: Configure P1 only (shared foundations unchanged)
        run: cmake -S native_cpp/p1 -B ${{ runner.temp }}/cteas-p1-build -DCMAKE_BUILD_TYPE=Debug
      - name: Compile modern C++ P1
        run: cmake --build ${{ runner.temp }}/cteas-p1-build -j2
      - name: CTest scoped P1 cell indexing
        run: ctest --test-dir ${{ runner.temp }}/cteas-p1-build --output-on-failure
      - name: Rebuild/run immutable original reference
        run: python3 native_cpp/reference/capture_p1_p2.py --output ${{ runner.temp }}/p1-reference
      - name: Generate independent C++ P1 terrain
        shell: bash
        run: |
          set -euo pipefail
          read -r X Y < <(python3 - <<'PY'
          import json
          m=json.load(open('${{ runner.temp }}/p1-reference/manifest.json'))
          print(m['grid']['x0_km'],m['grid']['y0_km'])
          PY
          )
          ${{ runner.temp }}/cteas-p1-build/cteas_p1_terrain calpuff_terrain_and_landuse_data_crop/hefei_5km/china_srtm/srtm_60_06_hefei_5km.tif "$X" "$Y" ${{ runner.temp }}/p1-reference/p1_cpp_terrain.csv
      - name: Compare original field heights and actual integer hit counts
        run: python3 native_cpp/reference/compare_p1_terrain.py --reference-dir ${{ runner.temp }}/p1-reference --cpp ${{ runner.temp }}/p1-reference/p1_cpp_terrain.csv --report ${{ runner.temp }}/p1-reference/p1_terrain_comparison.json
      - name: Archive independent evidence including failures
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: p1-terrel-reference-evidence
          path: ${{ runner.temp }}/p1-reference
          if-no-files-found: warn
          retention-days: 7
