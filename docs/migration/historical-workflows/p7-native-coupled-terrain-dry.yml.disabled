name: P7 native coupled CTADJ2 DRY PUFRECS CALCPF
on:
  pull_request:
    paths:
      - 'native_cpp/modules/p7_calpuff/**'
      - '.github/workflows/p7-native-coupled-terrain-dry.yml'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: p7-native-coupled-terrain-dry-${{ github.sha }}
  cancel-in-progress: false
jobs:
  coupled-physical-hour:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 18
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
          filter: blob:none
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /native_cpp/modules/p7_calpuff/**
      - name: Require native joint CTADJ2 plus MDRY1 receptor gate
        shell: bash
        run: |
          set -euo pipefail
          build="${RUNNER_TEMP}/p7-coupled-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          cmake -S native_cpp/modules/p7_calpuff -B "$build" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$build" --parallel 2 --target cteas_p7_original_comp_mxsam99_unsplit_tests
          ctest --test-dir "$build" -N -R '^cteas_p7_native_comp_mxsam99_unsplit$' |
            grep -E 'Test[[:space:]]*#[0-9]+: cteas_p7_native_comp_mxsam99_unsplit'
          "$build/cteas_p7_original_comp_mxsam99_unsplit_tests" | tee "$build/joint-physics.log"
          grep -F 'P7_NATIVE_MCTADJ2_MDRY1_PUFRECS_CALCPF_1H=PASS' "$build/joint-physics.log"
          echo 'P7_COMBINED_PHYSICS=PASS SYNTHETIC_ONLY=YES ORIGINAL_HEFEI=NOT_ACCEPTED'
