name: P7 original-versus-native puff200 full dry mass history
on:
  pull_request:
    paths:
      - 'native_cpp/modules/p7_calpuff/**'
      - '.github/workflows/p7-hefei-puff200-original-mass-history.yml'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: p7-puff200-source-mass-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
jobs:
  original-native-puff200:
    runs-on: ubuntu-22.04
    timeout-minutes: 55
    steps:
      - name: Ensure original Fortran 11 exists
        shell: bash
        run: |
          set -euo pipefail
          if ! command -v gfortran-11 >/dev/null 2>&1; then
            sudo apt-get update -qq
            sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq gfortran-11
          fi
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
          filter: blob:none
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /native_cpp/modules/p7_calpuff/**
            /engine/vendor/src/CALPUFF_v7.2.1_L150618/**
            /project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat
            /project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp
            /project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.con
      - name: Audit original VDCOMP REAL4 stomatal and RF expressions
        shell: bash
        run: |
          set -euo pipefail
          vendor=engine/vendor/src/CALPUFF_v7.2.1_L150618/calpuff.for
          test "$(sha256sum "$vendor" | cut -d' ' -f1)" = da40372cab1c181158d0ee5faac16f678e876fc14415073c38c8e3bdabfbc568
          echo 'P7_VENDOR_VDCOMP_RF_SOURCE_BEGIN line=26350'
          sed -n '26350,26555p' "$vendor"
          echo 'P7_VENDOR_VDCOMP_RF_SOURCE_END (read-only, original immutable)'
      - name: Pin original Fortran 143h and capture original puff200 mass every substep
        shell: bash
        run: |
          set -euo pipefail
          root="${RUNNER_TEMP}/p7-puff200-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          mkdir -p "$root/frozen/run/puff" "$root/frozen/deliverables/met"
          cp project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp \
            "$root/frozen/run/puff/puff.inp"
          ln -s "${GITHUB_WORKSPACE}/project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat" \
            "$root/frozen/deliverables/met/met.dat"
          python3 native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/original_hour4_mass_oracle.py \
            --vendor engine/vendor/src/CALPUFF_v7.2.1_L150618 \
            --case "$root/frozen" --out "$root/vendor" \
            --compiler "$(command -v gfortran-11)"
          python3 native_cpp/modules/p7_calpuff/reference/extract_original_six_hours.py \
            --full "$root/vendor/case/run/puff/dgm_puffstep.bin" \
            --metadata native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/dgm_puffstep.json \
            --out "$root/original-sixhour-dgm.bin"
      - name: Run actual native sixhour history with strict first3h H3 and 11458 DGM gate
        shell: bash
        run: |
          set -euo pipefail
          root="${RUNNER_TEMP}/p7-puff200-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          cmake -S native_cpp/modules/p7_calpuff -B "$root/build" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$root/build" --parallel 2 \
            --target cteas_p7_hefei_sixhour_native_h3_receptors_tests
          "$root/build/cteas_p7_hefei_sixhour_native_h3_receptors_tests" \
            project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat \
            project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp \
            project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.con \
            "$root/original-sixhour-dgm.bin" \
            "$root/hour2-25-28.tsv" "$root/hour4-47-13.tsv" \
            "$root/native-puff200-mass.tsv"
          python3 native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/compare_puff200_mass.py \
            --original "$root/vendor/case/run/puff/dgm_mass_puff200.bin" \
            --native "$root/native-puff200-mass.tsv" \
            --out "$root/first-puff200-mass-divergence.json" \
            --require-bitwise
          echo "P7_PUFF200_REAL4_MASS_HISTORY=PASS SCIENTIFIC_SIXHOUR_H3_PARITY=PASS"
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: p7-hefei-real-puff200-original-mass-first-divergence
          path: |
            ${{ runner.temp }}/p7-puff200-${{ github.run_id }}-${{ github.run_attempt }}/first-puff200-mass-divergence.json
            ${{ runner.temp }}/p7-puff200-${{ github.run_id }}-${{ github.run_attempt }}/native-puff200-mass.tsv
            ${{ runner.temp }}/p7-puff200-${{ github.run_id }}-${{ github.run_attempt }}/vendor/case/run/puff/dgm_mass_puff200.bin
          retention-days: 7
          if-no-files-found: warn
