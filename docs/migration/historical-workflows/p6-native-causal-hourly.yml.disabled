name: P6 native causal DIAGNO COMP hourly integration

on:
  push:
    branches: [codex/p6-hourly-stateful-scheduler-20261013]
    paths:
      - .github/workflows/p6-native-causal-hourly.yml
      - scripts/p6_run_native_causal_hourly.py
      - native_cpp/modules/p6_calmet/src/native_hourly_driver_main.cpp
      - native_cpp/modules/p6_calmet/CMakeLists.txt
      - native_cpp/modules/p6_calmet/include/cteas/p6/native_comp_history.hpp
      - native_cpp/modules/p6_calmet/tests/p6_native_comp_history_tests.cpp
      - scripts/p6_diagnose_p6e_three_fields.py
      - scripts/p6_diagnose_wind_quantization.py
      - native_cpp/modules/p6_calmet/src/cgamma_from_p6e_143h_main.cpp
      - native_cpp/modules/p6_calmet/src/realcase_wind_field_main.cpp
      - native_cpp/modules/p6_calmet/include/cteas/p6/inter2_selected.hpp
      - native_cpp/modules/p6_calmet/p6e/src/calmet_dat21_tool_main.cpp
      - native_cpp/modules/p6_calmet/p6f/src/p6f_geo_static_provenance_main.cpp
      - native_cpp/modules/p6_calmet/p6f/src/calmet_dat21_writer.cpp
      - native_cpp/modules/p6_calmet/p6f/include/cteas/p6f/calmet_dat21_writer.hpp
      - native_cpp/modules/p6_calmet/p6e/include/cteas/p6e/native_hourly_comp_steps.hpp
  pull_request:
    paths:
      - .github/workflows/p6-native-causal-hourly.yml
      - scripts/p6_run_native_causal_hourly.py
      - native_cpp/modules/p6_calmet/src/native_hourly_driver_main.cpp
      - native_cpp/modules/p6_calmet/CMakeLists.txt
      - native_cpp/modules/p6_calmet/include/cteas/p6/native_comp_history.hpp
      - native_cpp/modules/p6_calmet/tests/p6_native_comp_history_tests.cpp
      - scripts/p6_diagnose_p6e_three_fields.py
      - scripts/p6_diagnose_wind_quantization.py
      - native_cpp/modules/p6_calmet/src/cgamma_from_p6e_143h_main.cpp
      - native_cpp/modules/p6_calmet/src/realcase_wind_field_main.cpp
      - native_cpp/modules/p6_calmet/include/cteas/p6/inter2_selected.hpp
      - native_cpp/modules/p6_calmet/p6e/src/calmet_dat21_tool_main.cpp
      - native_cpp/modules/p6_calmet/p6f/src/p6f_geo_static_provenance_main.cpp
      - native_cpp/modules/p6_calmet/p6f/src/calmet_dat21_writer.cpp
      - native_cpp/modules/p6_calmet/p6f/include/cteas/p6f/calmet_dat21_writer.hpp
  workflow_dispatch:

permissions:
  contents: read

jobs:
  real-hefei-causal-six-hours:
    name: Hefei first six native P6D→P6E hours, no frozen wind
    runs-on: ubuntu-22.04
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@v4
        with:
          filter: blob:none
          sparse-checkout: |
            native_cpp/modules/p6_calmet
            scripts/p6_run_native_causal_hourly.py
            scripts/p6_diagnose_p6e_three_fields.py
      - uses: actions/checkout@v4
        with:
          ref: 3b94cdbfbb5f44146ba51a4ef112114f199d28b9
          filter: blob:none
          path: original_locked_case
          sparse-checkout: |
            project/cases/hefei5km_2022_reference_case_20261011
      - name: Build actual C++ P6D and P6E executables (GCC 12)
        shell: bash
        run: |
          set -euo pipefail
          cmake -S native_cpp/modules/p6_calmet \
             -B "$RUNNER_TEMP/native-p6d" -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_COMPILER=g++-12
          cmake --build "$RUNNER_TEMP/native-p6d" \
             --target cteas_p6_realcase_wind_field cteas_p6_native_cgamma_grid_143h cteas_p6_native_hourly_driver cteas_p6_native_comp_history_tests --parallel 2
          cmake -S native_cpp/modules/p6_calmet/p6e \
             -B "$RUNNER_TEMP/native-p6e" -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_COMPILER=g++-12
          cmake --build "$RUNNER_TEMP/native-p6e" \
             --target p6e_calmet_dat21 p6e_p6c_hourly_bridge --parallel 2
      - name: Verify fail-closed C++ history owner and input rejection
        shell: bash
        run: |
          set -euo pipefail
          ctest --test-dir "$RUNNER_TEMP/native-p6d" --output-on-failure \
            -R '^p6_native_cpp_(hourly_driver_fail_closed_missing_case|comp_history_state_and_rollback)$'
      - name: Execute 6 real hours in original one-pass causal order
        shell: bash
        run: |
          set -euo pipefail
          "$RUNNER_TEMP/native-p6d/cteas_p6_native_hourly_driver" \
            --case "$GITHUB_WORKSPACE/original_locked_case/project/cases/hefei5km_2022_reference_case_20261011" \
            --p6d "$RUNNER_TEMP/native-p6d/cteas_p6_realcase_wind_field" \
            --p6e "$RUNNER_TEMP/native-p6e/p6e_calmet_dat21" \
            --bridge "$RUNNER_TEMP/native-p6e/p6e_p6c_hourly_bridge" \
            --cgamma "$RUNNER_TEMP/native-p6d/cteas_p6_native_cgamma_grid_143h" \
            --work "$RUNNER_TEMP/p6-native-causal-6h" --hours 6
      - name: Archive actual P6D/P6E hour-by-hour evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: p6-causal-original-case-6h
          path: ${{ runner.temp }}/p6-native-causal-6h/
          retention-days: 7
          if-no-files-found: warn

  real-hefei-causal-143-hours:
    needs: real-hefei-causal-six-hours
    name: Hefei 143 native hourly P6D→P6E production run and 45-field candidate
    runs-on: ubuntu-22.04
    timeout-minutes: 95
    steps:
      - uses: actions/checkout@v4
        with:
          filter: blob:none
          sparse-checkout: |
            native_cpp/modules/p6_calmet
            native_cpp/modules/p7_calpuff/reference/original_decode_calmet_hourly.py
            scripts/p6_run_native_causal_hourly.py
            scripts/p6_diagnose_p6e_three_fields.py
      - uses: actions/checkout@v4
        with:
          ref: 3b94cdbfbb5f44146ba51a4ef112114f199d28b9
          filter: blob:none
          path: original_locked_case
          sparse-checkout: |
            project/cases/hefei5km_2022_reference_case_20261011
      - name: Build actual C++ P6D and P6E executables (GCC 12)
        shell: bash
        run: |
          set -euo pipefail
          cmake -S native_cpp/modules/p6_calmet \
             -B "$RUNNER_TEMP/native-p6d" -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_COMPILER=g++-12
          cmake --build "$RUNNER_TEMP/native-p6d" \
             --target cteas_p6_realcase_wind_field cteas_p6_native_cgamma_grid_143h cteas_p6_native_hourly_driver cteas_p6_native_comp_history_tests --parallel 2
          cmake -S native_cpp/modules/p6_calmet/p6e \
             -B "$RUNNER_TEMP/native-p6e" -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_COMPILER=g++-12
          cmake --build "$RUNNER_TEMP/native-p6e" \
             --target p6e_calmet_dat21 p6e_p6c_hourly_bridge --parallel 2
      - name: Build source-independent P6F selected-case OUTHD writer
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p project/cases
          ln -s "$GITHUB_WORKSPACE/original_locked_case/project/cases/hefei5km_2022_reference_case_20261011" \
            project/cases/hefei5km_2022_reference_case_20261011
          cmake -S native_cpp/modules/p6_calmet/p6f \
            -B "$RUNNER_TEMP/native-p6f" -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_COMPILER=g++-12 \
            -DP6F_REPO_ROOT="$GITHUB_WORKSPACE/original_locked_case"
          cmake --build "$RUNNER_TEMP/native-p6f" \
            --target cteas_p6f_geo_static_provenance \
                     cteas_p6f_p6e_source_metadata --parallel 2
      - name: Execute 143h native source-only P6D/P6E/P6F with frozen met.dat physically absent
        shell: bash
        run: |
          set -euo pipefail
          # Not merely a manifest claim: make the original Fortran MET.DAT
          # inaccessible at its known path during the WHOLE 143h native run.
          # The locked input is restored on failure for subsequent independent
          # numerical/source comparison steps.
          frozen="$GITHUB_WORKSPACE/original_locked_case/project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat"
          withheld="$RUNNER_TEMP/p6-fortran-met-withheld-from-native-run.dat"
          test -s "$frozen"
          test ! -e "$withheld"
          mv "$frozen" "$withheld"
          restore_frozen() {
            if test -f "$withheld"; then mv "$withheld" "$frozen"; fi
          }
          trap restore_frozen EXIT
          test ! -e "$frozen"
          "$RUNNER_TEMP/native-p6d/cteas_p6_native_hourly_driver" \
            --case "$GITHUB_WORKSPACE/original_locked_case/project/cases/hefei5km_2022_reference_case_20261011" \
            --p6d "$RUNNER_TEMP/native-p6d/cteas_p6_realcase_wind_field" \
            --p6e "$RUNNER_TEMP/native-p6e/p6e_calmet_dat21" \
            --bridge "$RUNNER_TEMP/native-p6e/p6e_p6c_hourly_bridge" \
            --cgamma "$RUNNER_TEMP/native-p6d/cteas_p6_native_cgamma_grid_143h" \
            --work "$RUNNER_TEMP/p6-native-causal-143h" --hours 143 --emit-source-stage-trace \
            --p6f-writer "$RUNNER_TEMP/native-p6f/cteas_p6f_geo_static_provenance" \
            --p6e-source-builder "$RUNNER_TEMP/native-p6f/cteas_p6f_p6e_source_metadata" \
            --p6f-direct-hourly
          # Provenance gate: original file must still be absent AFTER native
          # P6D, P6E, P6F complete. Restore it only for the later comparator.
          test ! -e "$frozen"
          test -s "$withheld"
          restore_frozen
          trap - EXIT
          printf '%s  %s\n' \
            b1823cda92280888d70b00961ab39486036a3086e18637fff21efb4f4b237d30 \
            "$frozen" | sha256sum -c -
          echo "PASS_P6_ORIGINAL_MET_PHYSICALLY_ABSENT_THROUGH_143H_NATIVE_EXECUTION"
          independent="$RUNNER_TEMP/p6-native-causal-143h/native_causal_independent_header_calmet.dat"
          test -s "$independent"
          grep -q '"independent_p6f_source_header_written": true' \
            "$RUNNER_TEMP/p6-native-causal-143h/native_cpp_hourly_manifest.json"
          grep -q '"p6e_reference_is_geo_deck_metadata_only": true' \
            "$RUNNER_TEMP/p6-native-causal-143h/native_cpp_hourly_manifest.json"
          grep -q '"p6f_header_from_native_hour_manifest": true' \
            "$RUNNER_TEMP/p6-native-causal-143h/native_cpp_hourly_manifest.json"
          grep -q '"original_met_role": "NOT_REQUIRED_NOT_OPENED_BY_NATIVE_EXECUTION"' \
            "$RUNNER_TEMP/p6-native-causal-143h/native_cpp_hourly_manifest.json"
          "$RUNNER_TEMP/native-p6e/p6e_calmet_dat21" compare \
            --reference "$GITHUB_WORKSPACE/original_locked_case/project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat" \
            --candidate "$independent" \
            --out "$RUNNER_TEMP/p6-native-causal-143h/p6f-independent-direct-45field.json"
          echo "PASS_P6_NATIVE_COORDINATOR_ORIGINAL_FREE_P6E_AND_DIRECT_P6F_143H"
      - name: P6F direct GEO+deck+143 hourly payload assembly and failure isolation
        shell: bash
        run: |
          set -euo pipefail
          work="$RUNNER_TEMP/p6-native-causal-143h"
          case_root="$GITHUB_WORKSPACE/original_locked_case/project/cases/hefei5km_2022_reference_case_20261011"
          tool="$RUNNER_TEMP/native-p6f/cteas_p6f_geo_static_provenance"
          "$tool" --geo "$case_root/geo/makegeo/geo.dat" \
            --deck "$case_root/run/met/met.inp" \
            --source-metadata "$work/p6e_geo_deck_metadata_only.dat" \
            --hour-manifest "$work/native_hourly_files.txt" \
            --emit-native-header "$work/native_causal_direct_manifest_calmet.dat" \
            | tee "$work/p6f-direct-143h-report.json"
          cmp "$work/native_causal_direct_manifest_calmet.dat" \
              "$work/native_causal_independent_header_calmet.dat"
          sha256sum "$work/native_causal_direct_manifest_calmet.dat"
          # The former assembled-carrier P6F path remains an independent
          # byte-control. The official coordinator uses single-hour files.
          "$tool" --geo "$case_root/geo/makegeo/geo.dat" \
            --deck "$case_root/run/met/met.inp" \
            --candidate "$work/native_causal_calmet.dat" \
            --emit-native-header "$work/native_causal_legacy_envelope_header.dat" \
            > "$work/p6f-legacy-envelope-control-report.json"
          cmp "$work/native_causal_legacy_envelope_header.dat" \
              "$work/native_causal_independent_header_calmet.dat"
          # Fault injection 1: a duplicated first native hour must NOT be
          # accepted in hour 2 even if all its 45 grid fields are finite.
          python3 - <<'PY'
          import os,pathlib
          w=pathlib.Path(os.environ['RUNNER_TEMP'])/'p6-native-causal-143h'
          files=(w/'native_hourly_files.txt').read_text().splitlines()
          assert len(files)==143
          files[1]=files[0]
          (w/'p6f-corrupted-hour-manifest.txt').write_text('\n'.join(files)+'\n')
          PY
          if "$tool" --geo "$case_root/geo/makegeo/geo.dat" \
            --deck "$case_root/run/met/met.inp" \
            --source-metadata "$work/p6e_geo_deck_metadata_only.dat" \
            --hour-manifest "$work/p6f-corrupted-hour-manifest.txt" \
            --emit-native-header "$work/INVALID-duplicate-hour.dat" \
            > "$work/p6f-corrupt-hour-rejection.log" 2>&1; then
            echo "::error::P6F accepted duplicated hour 0 in slot 1"
            exit 1
          fi
          test ! -e "$work/INVALID-duplicate-hour.dat"
          # Fault injection 2: original-free input MUST have all its
          # 143*45 hour fields at the metadata-only missing sentinel.
          if "$tool" --geo "$case_root/geo/makegeo/geo.dat" \
            --deck "$case_root/run/met/met.inp" \
            --source-metadata "$work/native_causal_calmet.dat" \
            --hour-manifest "$work/native_hourly_files.txt" \
            --emit-native-header "$work/INVALID-live-reference.dat" \
            > "$work/p6f-live-metadata-rejection.log" 2>&1; then
            echo "::error::P6F accepted live weather as source-only metadata"
            exit 1
          fi
          test ! -e "$work/INVALID-live-reference.dat"
          echo "PASS_P6F_DIRECT_SOURCE_ONLY_143_NATIVE_HOURS_BYTE_PARITY_AND_FAULT_REJECTION"
      - name: Original-wind P6E three-field control with SAME native station flux
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/p6_diagnose_p6e_three_fields.py \
            --case "$GITHUB_WORKSPACE/original_locked_case/project/cases/hefei5km_2022_reference_case_20261011" \
            --p6e "$RUNNER_TEMP/native-p6e/p6e_calmet_dat21" \
            --native "$RUNNER_TEMP/p6-native-causal-143h/native_causal_calmet.dat" \
            --observations "$RUNNER_TEMP/p6-native-causal-143h/observations.csv" \
            --station-flux "$RUNNER_TEMP/p6-native-causal-143h/native_station_flux.csv" \
            --work "$RUNNER_TEMP/p6-native-causal-143h/three_field_control"
      - name: Archive actual P6D/P6E hour-by-hour evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: p6-causal-original-case-143h
          path: |
            ${{ runner.temp }}/p6-native-causal-143h/native_cpp_hourly_manifest.json
            ${{ runner.temp }}/p6-native-causal-143h/native_causal_calmet.dat
            ${{ runner.temp }}/p6-native-causal-143h/native_causal_independent_header_calmet.dat
            ${{ runner.temp }}/p6-native-causal-143h/p6f-independent-direct-45field.json
            ${{ runner.temp }}/p6-native-causal-143h/p6f-native-header.log
            ${{ runner.temp }}/p6-native-causal-143h/p6f-direct-143h-report.json
            ${{ runner.temp }}/p6-native-causal-143h/p6f-corrupt-hour-rejection.log
            ${{ runner.temp }}/p6-native-causal-143h/p6f-live-metadata-rejection.log
            ${{ runner.temp }}/p6-native-causal-143h/writer.log
            ${{ runner.temp }}/p6-native-causal-143h/three_field_control/p6e_three_field_wind_control.json
            ${{ runner.temp }}/p6-native-causal-143h/native_source_stage_143h/
          retention-days: 7
          if-no-files-found: warn

  strict-original-45-field-parity:
    name: SCIENCE G3/G4 original 143h 45-field parity (strict PASS required)
    needs: real-hefei-causal-143-hours
    runs-on: ubuntu-22.04
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
        with:
          filter: blob:none
          sparse-checkout: |
            native_cpp/modules/p6_calmet/include
            native_cpp/modules/p6_calmet/p6e
      - uses: actions/checkout@v4
        with:
          ref: 3b94cdbfbb5f44146ba51a4ef112114f199d28b9
          path: original_locked_case
          filter: blob:none
          sparse-checkout: |
            project/cases/hefei5km_2022_reference_case_20261011
      - uses: actions/download-artifact@v4
        with:
          name: p6-causal-original-case-143h
          path: ${{ runner.temp }}/p6-native-143h-candidate
      - name: Compile unchanged-tolerance original-source numeric comparator
        shell: bash
        run: |
          set -euo pipefail
          cmake -S native_cpp/modules/p6_calmet/p6e \
            -B "$RUNNER_TEMP/p6e-comparator" -DCMAKE_BUILD_TYPE=Release \
            -DCMAKE_CXX_COMPILER=g++-12
          cmake --build "$RUNNER_TEMP/p6e-comparator" \
            --target p6e_calmet_dat21 --parallel 2
      - name: Strict original numeric parity on every 45-field hourly value
        shell: bash
        run: |
          set -euo pipefail
          candidate="$RUNNER_TEMP/p6-native-143h-candidate/native_causal_calmet.dat"
          original="$GITHUB_WORKSPACE/original_locked_case/project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat"
          test -s "$candidate"
          printf '%s  %s\n' b1823cda92280888d70b00961ab39486036a3086e18637fff21efb4f4b237d30 "$original" | sha256sum -c -
          "$RUNNER_TEMP/p6e-comparator/p6e_calmet_dat21" compare \
            --reference "$original" --candidate "$candidate" \
            --out "$RUNNER_TEMP/p6-native-143h-candidate/original_45_field_numeric_verdict.json"
          # A nonzero comparator status is REAL SCIENTIFIC FAIL, not a skip.
      - name: Archive strict 143h scientific verdict even on mismatch
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: p6-native-143h-scientific-original-verdict
          path: ${{ runner.temp }}/p6-native-143h-candidate/original_45_field_numeric_verdict.json
          if-no-files-found: warn
          retention-days: 14

  analyze-first-level-wind-quantization:
    name: Diagnose AVETMP source INT displacement vs USTAR EL WSTAR residual
    needs: real-hefei-causal-143-hours
    runs-on: ubuntu-22.04
    timeout-minutes: 35
    steps:
      - uses: actions/checkout@v4
        with:
          filter: blob:none
          sparse-checkout: |
            native_cpp/modules/p6_calmet/include
            native_cpp/modules/p6_calmet/p6e
            scripts/p6_diagnose_wind_quantization.py
      - uses: actions/checkout@v4
        with:
          ref: 3b94cdbfbb5f44146ba51a4ef112114f199d28b9
          path: original_locked_case
          filter: blob:none
          sparse-checkout: |
            project/cases/hefei5km_2022_reference_case_20261011
      - uses: actions/download-artifact@v4
        with:
          name: p6-causal-original-case-143h
          path: ${{ runner.temp }}/p6-wind-quantization
      - name: Build source-tolerance-aware C++ CALMET.DAT field extractor
        shell: bash
        run: |
          set -euo pipefail
          cmake -S native_cpp/modules/p6_calmet/p6e \
            -B "$RUNNER_TEMP/p6e-quant-tools" \
            -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_COMPILER=g++-12
          cmake --build "$RUNNER_TEMP/p6e-quant-tools" \
            --target p6e_calmet_dat21 --parallel 2
      - name: Test native-vs-original U/V INT displacement branch changes
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/p6_diagnose_wind_quantization.py \
            --tool "$RUNNER_TEMP/p6e-quant-tools/p6e_calmet_dat21" \
            --original "$GITHUB_WORKSPACE/original_locked_case/project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat" \
            --native "$RUNNER_TEMP/p6-wind-quantization/native_causal_calmet.dat" \
            --work "$RUNNER_TEMP/p6-wind-quantization/forensic"
      - name: Archive exact micro-wind and ELUSTR sensitivity evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: p6-source-wind-quantization-forensic
          path: ${{ runner.temp }}/p6-wind-quantization/forensic/p6e_source_quantization_diagnostic.json
          if-no-files-found: warn
          retention-days: 14

