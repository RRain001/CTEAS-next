name: P5 strict UTM and P6 three-part input acceptance

on:
  pull_request:
    paths:
      - 'native_cpp/modules/p5_smerge/data_prep/**'
      - 'native_cpp/modules/p6_calmet/tests/check_case_station_contract.py'
      - '.github/workflows/p5-utm-p6-input-acceptance.yml'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: p5-utm-p6-input-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

jobs:
  p5-projected-boundaries:
    name: P5 strict projected-grid selection regression
    runs-on: ubuntu-22.04
    timeout-minutes: 20
    defaults:
      run:
        working-directory: p5_utm_contract_checkout
    steps:
      - uses: actions/checkout@v4
        with:
          path: p5_utm_contract_checkout
      - name: Inspect checked-out input and tests
        shell: bash
        run: |
          set -euo pipefail
          git rev-parse HEAD
          git ls-files --error-unmatch native_cpp/modules/p5_smerge/data_prep/tests/test_p5_rules.py
          test -s native_cpp/modules/p5_smerge/data_prep/tests/test_p5_rules.py
          test -f native_cpp/modules/p5_smerge/data_prep/tests/__init__.py
      - name: Ensure Python scientific dependencies
        run: python3 -m pip install --disable-pip-version-check PyYAML pandas numpy
      - name: P5 source selection tests including all UTM edges and corners
        shell: bash
        run: |
          set -euo pipefail
          python3 -m unittest discover -s native_cpp/modules/p5_smerge/data_prep/tests -p 'test_p5_rules.py' -v
      - name: Check P5 strict UTM geometry source
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY'
          from pathlib import Path
          import ast
          source=Path('native_cpp/modules/p5_smerge/data_prep/download_isd_by_grid.py').read_text()
          tree=ast.parse(source)
          names={n.name for n in ast.walk(tree) if isinstance(n, (ast.FunctionDef,ast.AsyncFunctionDef))}
          assert {'load_utm_grid','utm_bounds_km','station_in_utm_grid',
                  'contains_projected_utm_km'}.issubset(names)
          assert 'inside_bbox' not in names and 'build_bbox' not in names
          print('PASS_P5_NO_LEGACY_GEOGRAPHIC_BOX')
          PY

  p6-input-contract:
    name: P3 GEO plus P4 US1 plus P5 UTM-to-SS1 and frozen impact
    runs-on: ubuntu-22.04
    timeout-minutes: 25
    defaults:
      run:
        working-directory: p5_utm_contract_checkout
    steps:
      - uses: actions/checkout@v4
        with:
          path: p5_utm_contract_checkout
      - name: Inspect checked-out P6 input contracts
        shell: bash
        run: |
          set -euo pipefail
          git rev-parse HEAD
          for file in \
            native_cpp/modules/p6_calmet/reference/restore_frozen_case_from_git.py \
            native_cpp/modules/p6_calmet/tests/check_case_grid_source_contract.py \
            native_cpp/modules/p6_calmet/tests/check_case_station_contract.py \
            native_cpp/modules/p5_smerge/data_prep/tests/audit_hefei_utm_handoff.py; do
            git ls-files --error-unmatch "$file"
            test -s "$file" || { echo "::error::missing checked-out $file"; exit 1; }
          done
      - name: Ensure metadata and projection dependencies
        run: python3 -m pip install --disable-pip-version-check PyYAML
      - name: Restore and verify pinned Hefei 2022 input records
        run: python3 native_cpp/modules/p6_calmet/reference/restore_frozen_case_from_git.py --mode grid
      - name: Verify full GEO.DAT to met.inp grid geometry
        run: python3 native_cpp/modules/p6_calmet/tests/check_case_grid_source_contract.py project/cases/hefei5km_2022_reference_case_20261011
      - name: Verify P4 effective US1 and P5 strict-UTM SS1 provenance
        run: python3 native_cpp/modules/p6_calmet/tests/check_case_station_contract.py project/cases/hefei5km_2022_reference_case_20261011
      - name: Prove NOAA candidate-set equivalence and frozen source hashes
        shell: bash
        run: |
          set -euo pipefail
          python3 native_cpp/modules/p5_smerge/data_prep/tests/audit_hefei_utm_handoff.py \
            --case project/cases/hefei5km_2022_reference_case_20261011 \
            --report "${RUNNER_TEMP}/p5-utm-hefei-migration.json"
      - name: Preserve migration decision, even if input changed
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: p5-utm-hefei-migration
          path: ${{ runner.temp }}/p5-utm-hefei-migration.json
          if-no-files-found: warn
