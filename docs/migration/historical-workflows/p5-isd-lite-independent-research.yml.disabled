name: NOAA ISD-Lite independent 2022 comparison input
concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true
on:
  pull_request:
    paths:
      - '.github/workflows/p5-isd-lite-independent-research.yml'
jobs:
  lite-reference:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 8
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4
      - name: Fetch official source, validate gzip and identify same station/year
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p evidence
          python3 - <<'PY'
          import urllib.request, urllib.error, gzip, json, hashlib, pathlib, xml.etree.ElementTree as ET
          key="isd-lite/2022/583210-99999-2022.gz"
          base="https://noaa-isd-pds.s3.amazonaws.com/"
          candidates=[base+key,
                      "https://www.ncei.noaa.gov/pub/data/noaa/isd-lite/2022/583210-99999-2022.gz"]
          attempts=[]
          for url in candidates:
              try:
                  req=urllib.request.Request(url,headers={'User-Agent':'CTEAS-independent-ISDLite-reference-check/1.0'})
                  with urllib.request.urlopen(req,timeout=35) as resp:
                      data=resp.read()
                      content_type=resp.headers.get('Content-Type')
                      status=resp.status
                  if not data.startswith(b'\x1f\x8b'):
                      raise ValueError(f"not gzip: first 72 bytes={data[:72]!r}")
                  raw=gzip.decompress(data)
                  lines=raw.decode("ascii").splitlines()
                  if not (len(lines)>100 and all(len(line.split())==12 for line in lines[:20])):
                      raise ValueError("unexpected ISD-Lite 12-field fixed-width records")
                  if not all(line.split()[0]=="2022" for line in lines[:20]):
                      raise ValueError("year mismatch")
                  path=pathlib.Path("evidence/583210-99999-2022.gz")
                  path.write_bytes(data)
                  result={
                    'status':'PASS','station_usaf':'583210','station_wban':'99999',
                    'year':2022,'source_url':url,'content_type':content_type,
                    'http_status':status,'bytes':len(data),
                    'sha256':hashlib.sha256(data).hexdigest(),'lite_rows':len(lines),
                    'first_three_rows':lines[:3],
                  }
                  pathlib.Path('evidence/lite-source-manifest.json').write_text(json.dumps(result,indent=2)+"\n")
                  print('OFFICIAL_ISD_LITE_CAPTURE',json.dumps(result))
                  break
              except Exception as e:
                  attempts.append({'url':url,'error':str(e)})
                  print('CANDIDATE_FAILED',url,str(e),flush=True)
          else:
              # Diagnosis: public object prefix listing (do not upload giant inventories).
              for query in ('?list-type=2&prefix=isd-lite%2F2022%2F583210',
                            '?list-type=2&prefix=2022%2F583210'):
                  try:
                      with urllib.request.urlopen(base+query,timeout=20) as resp:
                          xml=resp.read(12000).decode('utf-8',errors='replace')
                      print('S3_LISTING_DIAG',query,xml[:1800])
                  except Exception as e: print('S3_LISTING_ERROR',str(e))
              pathlib.Path('evidence/download-failures.json').write_text(json.dumps(attempts,indent=2)+"\n")
              raise SystemExit("No official ISD-Lite 2022 gzip downloaded; see evidence")
          PY
      - name: Retain source and sha256 evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: isd-lite-583210-2022-reference
          path: evidence/
          if-no-files-found: warn
          retention-days: 7
