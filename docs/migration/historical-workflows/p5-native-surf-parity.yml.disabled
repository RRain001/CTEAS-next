name: P5 native SURF.DAT original SMERGE synthetic byte parity
concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true
on:
  pull_request:
    paths:
      - "native_cpp/modules/p5_smerge/**"
      - "native_cpp/include/cteas/met_input/p5_smerge.hpp"
      - ".github/workflows/p5-native-surf-parity.yml"
jobs:
  synthetic-parity:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 18
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4
      - name: Provision GitHub-hosted GCC12 and Fortran12
        shell: bash
        run: |
          set -euo pipefail
          sudo apt-get update -qq
          sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq g++-12 gfortran-12
      - name: Select isolated C++20 and Fortran compilers
        uses: ./.github/actions/cteas-linux-toolchain
      - name: Reset self-hosted scratch directories
        shell: bash
        run: |
          rm -rf ${{ runner.temp }}/cteas-p5-build ${{ runner.temp }}/cteas-p5-synthetic ${{ runner.temp }}/p5-smg-includes
      - name: Build original SMERGE v5.7.0 and native C++20 writer
        shell: bash
        run: |
          set -euo pipefail
          gfortran --version | head -1
          mkdir -p evidence ${{ runner.temp }}/cteas-p5-synthetic
          SRC=engine/vendor/src/SMERGE_v5.7.0_L121203
          mkdir -p ${{ runner.temp }}/p5-smg-includes
          for item in "$SRC"/*; do
            name=$(basename "$item" | tr '[:upper:]' '[:lower:]')
            if [ ! -e "${{ runner.temp }}/p5-smg-includes/$name" ]; then
              ln -s "$GITHUB_WORKSPACE/$item" "${{ runner.temp }}/p5-smg-includes/$name"
            fi
          done
          gfortran -O0 -std=legacy -fno-automatic -fno-align-commons \
            -fallow-argument-mismatch -ffixed-line-length-none \
            -I${{ runner.temp }}/p5-smg-includes "$SRC/SMERGE.FOR" \
            -o ${{ runner.temp }}/cteas-p5-synthetic/smerge-original
          cmake -S native_cpp/modules/p5_smerge -B ${{ runner.temp }}/cteas-p5-build -DCMAKE_BUILD_TYPE=Debug
          cmake --build ${{ runner.temp }}/cteas-p5-build -j2
          ctest --test-dir ${{ runner.temp }}/cteas-p5-build --output-on-failure
          sha256sum "$SRC/SMERGE.FOR" > evidence/fortran.sha256
      - name: Deterministic 2-station GENERIC with arbitrary missing hour, calm, fractional RH, rain and missing temperature
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY'
          from pathlib import Path
          import re
          w=Path("${{ runner.temp }}/cteas-p5-synthetic")
          data=[
              (58321,[
                  [1,1,2022,0,20.55,0,1010.22,40.5,360,1.25,3.8,10.5],
                  [1,1,2022,100,9999,1.5,9999,9999,9999,9999,9999,9999],
                  [1,1,2022,200,0,1,1000,0,0,0,9999,9999],
                  [1,1,2022,300,-5,1,990,80,180,3,5,20],
                  [1,1,2022,400,20,0,1001,50,80,3,3,14],
              ]),
              (58314,[
                  [1,1,2022,0,17,0,1005,45,45,2.5,2,8],
                  # 01:00 absent, never create a row in source.
                  [1,1,2022,200,15,0,9999,40,360,0,9999,9999],
                  [1,1,2022,300,9999,2,990,44,9999,9999,9999,9999],
                  [1,1,2022,400,12,0,9999,30,60,4,2,8],
              ])
          ]
          for id,rows in data:
              p=w/f"{id}.csv"
              with p.open("w") as f:
                  f.write("GENERIC,Version,'2.0',Manuallygenerated,Timeasendinghour,\n")
                  f.write(f"Station,ID,=',{id},Temp,Precip,Pressure,RH,Wdir10m,Wspeed10m,Ccover,Cheight\n")
                  f.write("Month,Day,Year,Hour,DegC,mm,mb,%,deg,ms-1,tenths,hundreds_of_feet\n")
                  for row in rows:f.write(",".join(map(str,row))+"\n")
          orig=Path("engine/templates/smerge.inp").read_text()
          a=orig.index("Subgroup (0b)")
          b=orig.index("INPUT GROUP: 1",a)
          orig=orig[:a]+"""Subgroup (0b)
          !SFCMET = 58321.csv !
          !IFSTN = 58321 !
          !XELEV = 20 !
          !ASTZ = UTC+0000 !   !END!
          !SFCMET = 58314.csv !
          !IFSTN = 58314 !
          !XELEV = 25 !
          !ASTZ = UTC+0000 !   !END!
          """+orig[b:]
          controls={"NFF":"2","SURFDAT":"original.dat","RUNLST":"original.lst",
                    "IBYR":"2022","IBMO":"1","IBDY":"1","IBHR":"0","IBSEC":"0",
                    "IEYR":"2022","IEMO":"1","IEDY":"1","IEHR":"3","IESEC":"0",
                    "ABTZ":"UTC+0000","JDAT":"8","LPREV":"F","LPCALC":"F",
                    "IOFORM":"2","IOPACK":"0"}
          for key,val in controls.items():
              orig,count=re.subn(r"(!\s*"+key+r"\s*=\s*)[^!]*!",
                                 lambda m:m.group(1)+val+" !",orig,count=1)
              if count!=1:raise RuntimeError(f"control missing {key}")
          (w/"original.inp").write_text(orig)
          (w/"native.inp").write_text(orig.replace("original.dat","native.dat"))
          print("P5_SYNTHETIC_SOURCE=PASS",w)
          PY
      - name: Independent original SMERGE vs native C++20 byte parity
        shell: bash
        run: |
          set -euo pipefail
          cd ${{ runner.temp }}/cteas-p5-synthetic
          ./smerge-original original.inp 2>&1 | tee "$GITHUB_WORKSPACE/evidence/fortran-run.log"
          test -s original.dat
          ${{ runner.temp }}/cteas-p5-build/cteas_p5_smerge native.inp \
            2>&1 | tee "$GITHUB_WORKSPACE/evidence/native-run.log"
          test -s native.dat
          python3 - <<'PY'
          import json
          from pathlib import Path
          a=Path("original.dat").read_bytes()
          b=Path("native.dat").read_bytes()
          x=a.decode().splitlines()
          y=b.decode().splitlines()
          differences=[(i+1,u,v) for i,(u,v) in enumerate(zip(x,y)) if u!=v]
          result={"original_bytes":len(a),"native_bytes":len(b),
                  "original_lines":len(x),"native_lines":len(y),
                  "different_lines":len(differences),
                  "first_differences":differences[:20],"byte_parity":a==b}
          Path("parity.json").write_text(json.dumps(result,indent=2)+"\n")
          print("P5_SYNTHETIC_BYTE_PARITY",json.dumps(result))
          if a!=b:raise SystemExit("P5 synthetic native SURF.DAT does not match original")
          print("P5_NATIVE_SURFDAT_SYNTHETIC_BYTE_PARITY=PASS")
          PY
      - name: Native writer fail-closed for unsupported legacy control modes
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY'
          import subprocess,re
          from pathlib import Path
          root=Path("${{ runner.temp }}/cteas-p5-synthetic")
          original=(root/"native.inp").read_text()
          executable="${{ runner.temp }}/cteas-p5-build/cteas_p5_smerge"
          for key,value in (("JDAT","5"),("IOFORM","1"),("IOPACK","1"),
                            ("LPREV","T"),("LPCALC","T"),("ABTZ","UTC+0900")):
              changed,count=re.subn(r"(!\s*"+key+r"\s*=\s*)[^!]+!",
                                    lambda m:m.group(1)+value+" !",original,count=1)
              assert count==1,key
              path=root/f"reject_{key}.inp"
              path.write_text(changed)
              proc=subprocess.run([executable,str(path)],capture_output=True,text=True)
              if proc.returncode==0 or "P5_CPP_SURFDAT_ERROR" not in proc.stderr:
                  raise AssertionError(f"unsupported {key}={value} wrongly accepted: {proc.stderr}")
              print("P5_CPP_FAIL_CLOSED=PASS",key,value,proc.returncode)
          PY
      - name: Preserve independent reference on failure or success
        if: always()
        shell: bash
        run: |
          for f in original.dat native.dat original.lst parity.json original.inp native.inp; do
            if [ -f "${{ runner.temp }}/cteas-p5-synthetic/$f" ]; then
              cp "${{ runner.temp }}/cteas-p5-synthetic/$f" "evidence/$f"
            fi
          done
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: p5-native-surf-synthetic-reference
          path: evidence/
          retention-days: 7
          if-no-files-found: warn
