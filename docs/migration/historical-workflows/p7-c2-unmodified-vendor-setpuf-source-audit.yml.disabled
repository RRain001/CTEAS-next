name: P7 C2 unmodified CALPUFF SETPUF / PUFFCT2 source branch audit
on:
  push:
    branches: [codex/p7-c2-multistation-vendor-weather-20261015]
    paths:
      - '.github/workflows/p7-c2-unmodified-vendor-setpuf-source-audit.yml'
  workflow_dispatch:
permissions:
  contents: read
jobs:
  unmodified-vendor-setpuf-branches:
    runs-on: ubuntu-22.04
    timeout-minutes: 8
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - name: Inspect true original SETPUF ICODE/CTADJ2 and CALCPF receptor flags without physics edits
        shell: bash
        run: |
          python3 - <<'PY'
          from pathlib import Path
          import hashlib
          p=Path("engine/vendor/src/CALPUFF_v7.2.1_L150618/calpuff.for")
          raw=p.read_bytes()
          print("P7_C2_VENDOR_CALPUFF_SHA256="+hashlib.sha256(raw).hexdigest())
          lines=raw.decode("latin-1").splitlines()
          print("SOURCE_LINES="+str(len(lines)))
          for a,b in [(48350,48505),(48595,48685),(20995,21105),(5285,5325)]:
              print(f"==== UNMODIFIED CALPUFF FORTRAN {a}-{b} ====")
              for i in range(a-1,min(b,len(lines))):
                  print(f"VENDOR_SOURCE_L{i+1}: {lines[i]}")
          PY
