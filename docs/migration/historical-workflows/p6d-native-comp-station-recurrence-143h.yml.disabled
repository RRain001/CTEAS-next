name: P6D 143h native COMP recurrence to STHEOR

on:
  push:
    branches: [audit/p6d-source-slope-drivers-143h-20261012]
    paths:
      - 'scripts/p6d_compare_native_comp_station_143h.py'
      - 'scripts/p6d_trace_original_inter2_first_layer_143h.py'
      - 'scripts/p6d_trace_original_inter2_first_layer_143h.py'
      - 'scripts/p6d_bisect_original_diagno_stage_boundaries.py'
      - 'scripts/p6d_compare_original_comp_dptt_143h.py'
      - 'scripts/run_p6_end_to_end.py'
      - 'native_cpp/modules/p6_calmet/src/realcase_wind_field_main.cpp'
      - 'native_cpp/modules/p6_calmet/p6e/src/calmet_dat21_tool_main.cpp'
      - 'native_cpp/modules/p6_calmet/p6e/CMakeLists.txt'
      - 'native_cpp/modules/p6_calmet/include/cteas/p6/station_mixhtst.hpp'
      - '.github/workflows/p6d-native-comp-station-recurrence-143h.yml'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: p6d-native-comp-station-${{ github.ref }}
  cancel-in-progress: true

jobs:
  native-143h-station-comp-closure:
    name: Original CALMET 143h vs native P6D wind to P6E COMP to P6D station MIXHTST
    runs-on: ubuntu-22.04
    timeout-minutes: 90
    steps:
      - uses: actions/checkout@v4
        with:
          filter: blob:none
          sparse-checkout: |
            .github/actions/cteas-linux-toolchain
            native_cpp/modules/p6_calmet
            native_cpp/modules/p7_calpuff/reference
            engine/vendor/src/CALMET_v6.5.0_L150223
            scripts
      - uses: actions/checkout@v4
        with:
          ref: 3b94cdbfbb5f44146ba51a4ef112114f199d28b9
          path: frozen_original_checkout
          filter: blob:none
          sparse-checkout: |
            project/cases/hefei5km_2022_reference_case_20261011
      - uses: ./.github/actions/cteas-linux-toolchain
      - name: Verify frozen 143h source case and U V W reference (never injected into native wind)
        shell: bash
        run: |
          set -euo pipefail
          case_dir="frozen_original_checkout/project/cases/hefei5km_2022_reference_case_20261011"
          test -s "$case_dir/run/met/met.dat"
          printf '%s  %s\n' b1823cda92280888d70b00961ab39486036a3086e18637fff21efb4f4b237d30 "$case_dir/run/met/met.dat" | sha256sum --check
      - name: Build and produce unassisted wind plus native P6E 143h COMP history
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-native-comp-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          mkdir -p "$root"
          case_dir="frozen_original_checkout/project/cases/hefei5km_2022_reference_case_20261011"
          # P6F CMake needs the reference MET.DAT at its fixed repository
          # path. Link ONLY the independently SHA-verified reference file.
          # Do not try to replace an existing case directory with ln -sfn:
          # ln follows that directory, leaving the required file missing.
          source_met="$PWD/$case_dir/run/met/met.dat"
          target_met="project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat"
          mkdir -p "$(dirname "$target_met")"
          if [[ -e "$target_met" && ! -L "$target_met" ]]; then
            printf '%s  %s\n' b1823cda92280888d70b00961ab39486036a3086e18637fff21efb4f4b237d30 "$target_met" | sha256sum --check
          else
            ln -sfnT "$source_met" "$target_met"
          fi
          test -s "$target_met" || { echo "::error::P6F original reference path unresolved"; ls -la "$(dirname "$target_met")"; exit 2; }
          printf '%s  %s\n' b1823cda92280888d70b00961ab39486036a3086e18637fff21efb4f4b237d30 "$target_met" | sha256sum --check
          set +e
          python3 scripts/run_p6_end_to_end.py \
            --case "$case_dir" --build-dir "$root/build" \
            --build-type Release --jobs 3 --hours 143 \
            --work "$root/base" --export-native-comp-state >"$root/baseline.log" 2>&1
          rc=$?
          set -e
          echo "Native baseline scientific status expected still FAIL, exit=$rc"
          test -s "$root/base/A/native_comp.state.json" || { tail -100 "$root/baseline.log"; exit 2; }
          for name in zi ziconv dptt; do
            test "$(stat -c %s "$root/base/A/native_comp.$name.f32")" = 1430000
          done
          test -x "$root/build/p6d/cteas_p6_realcase_wind_field"
      - name: Diagnose source COMP DPTT field before and after gridded MIXHT
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-native-comp-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          python3 scripts/p6d_compare_original_comp_dptt_143h.py \
            --source native_cpp/modules/p6_calmet/reference/dgm_internal_state_2022/dgm_state.bin \
            --native-prefix "$root/base/A/native_comp" \
            --out "$root/comp_dptt_143h.json"
      - name: Compute 143h station ELUSTR2 MIXHTST SIMILT using only native previous-hour COMP state
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-native-comp-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          case_dir="frozen_original_checkout/project/cases/hefei5km_2022_reference_case_20261011"
          "$root/build/p6d/cteas_p6_realcase_wind_field" \
            --case "$case_dir" --hours 143 \
            --comp-state-prefix "$root/base/A/native_comp" \
            --out "$root/coupled"
          test "$(wc -l < "$root/coupled/station_mixhtst.csv")" -eq 144
          test "$(wc -l < "$root/coupled/station_inter2_layer1.csv")" -eq 144
      - name: Source-pinned six-hour DIAGNO first-divergence diagnosis (WIND1, SLOPE, final U/V/W)
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-native-comp-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          python3 scripts/p6d_bisect_original_diagno_stage_boundaries.py \
            --source native_cpp/modules/p6_calmet/reference/dgm_p6d_requests_2022/dgm_fields_hours.bin \
            --candidate "$root/coupled" \
            --out "$root/diango_stages_six_source_hours.json"
      - name: Original CALMET write-only first-layer INTER2 station and grid trace for hour-12 divergence
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-native-comp-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          case_dir="frozen_original_checkout/project/cases/hefei5km_2022_reference_case_20261011"
          python3 scripts/p6d_trace_original_inter2_first_layer_143h.py \
            --vendor engine/vendor/src/CALMET_v6.5.0_L150223 \
            --case "$case_dir" --candidate "$root/coupled" \
            --compiler gfortran-11 \
            --out "$root/inter2_first_layer_143h.json"
          test -s "$root/inter2_first_layer_143h.json"
      - name: Independently compare 143h reconstructed 3D U V W records with frozen original
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-native-comp-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          case_dir="frozen_original_checkout/project/cases/hefei5km_2022_reference_case_20261011"
          "$root/build/p6f/cteas_p6f_calmet_dat21_writer" write-from-p6d \
            --fields "$root/coupled" --variant blend --w-field w_face \
            --statics-from "$case_dir/run/met/met.dat" \
            --met-fields-from "$case_dir/run/met/met.dat" \
            --irtype 1 --out "$root/coupled_wind.dat" \
            --report "$root/coupled_wind_output.json"
          # Scientific FAIL is expected until U/V/W closure, but do not skip
          # the independent station-error localization step after this.
          set +e
          "$root/build/p6e/p6e_calmet_dat21" compare \
            --reference "$case_dir/run/met/met.dat" \
            --candidate "$root/coupled_wind.dat" \
            --out "$root/coupled_uvw_reference.json" \
            >"$root/coupled_uvw_stdout.log" 2>&1
          numeric_rc=$?
          set -e
          echo "Independent frozen CALMET 143h U/V/W numeric comparator exit=$numeric_rc"
          test -s "$root/coupled_uvw_reference.json"
      - name: Read-only original station ZII and native previous-COMP history first-divergence gate
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-native-comp-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          python3 scripts/p6d_compare_native_comp_station_143h.py \
            --cell-json native_cpp/modules/p6_calmet/reference/dgm_p6d_requests_2022/dgm_cell.json \
            --cell-bin native_cpp/modules/p6_calmet/reference/dgm_p6d_requests_2022/dgm_cell.bin \
            --state-bin native_cpp/modules/p6_calmet/reference/dgm_internal_state_2022/dgm_state.bin \
            --comp-prefix "$root/base/A/native_comp" \
            --station-csv "$root/coupled/station_mixhtst.csv" \
            --out "$root/native_comp_station_143h.json" --require-parity
      - name: Retain every native COMP and source-locked scientific diagnostic
        if: always()
        uses: actions/upload-artifact@v4
        continue-on-error: true
        with:
          name: p6d-native-comp-station-143h
          path: |
            ${{ runner.temp }}/p6d-native-comp-${{ github.run_id }}-${{ github.run_attempt }}/native_comp_station_143h.json
            ${{ runner.temp }}/p6d-native-comp-${{ github.run_id }}-${{ github.run_attempt }}/comp_dptt_143h.json
            ${{ runner.temp }}/p6d-native-comp-${{ github.run_id }}-${{ github.run_attempt }}/diango_stages_six_source_hours.json
            ${{ runner.temp }}/p6d-native-comp-${{ github.run_id }}-${{ github.run_attempt }}/inter2_first_layer_143h.json
            ${{ runner.temp }}/p6d-native-comp-${{ github.run_id }}-${{ github.run_attempt }}/coupled/station_inter2_layer1.csv
            ${{ runner.temp }}/p6d-native-comp-${{ github.run_id }}-${{ github.run_attempt }}/coupled_uvw_reference.json
            ${{ runner.temp }}/p6d-native-comp-${{ github.run_id }}-${{ github.run_attempt }}/coupled_wind_output.json
            ${{ runner.temp }}/p6d-native-comp-${{ github.run_id }}-${{ github.run_attempt }}/coupled/station_mixhtst.csv
            ${{ runner.temp }}/p6d-native-comp-${{ github.run_id }}-${{ github.run_attempt }}/base/A/native_comp.state.json
            ${{ runner.temp }}/p6d-native-comp-${{ github.run_id }}-${{ github.run_attempt }}/baseline.log
          if-no-files-found: warn
          retention-days: 14
      - name: Enforce independent 143h U V W scientific parity (not merely workflow completion)
        if: always()
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-native-comp-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          python3 - "$root/coupled_uvw_reference.json" <<'PY'
          import json,sys
          from pathlib import Path
          path=Path(sys.argv[1])
          if not path.is_file():
              raise SystemExit("P6D full 143h U/V/W: NO SCIENTIFIC REPORT; FAIL")
          report=json.loads(path.read_text())
          fields=[f for f in report.get("fields",[])
                  if f.get("label","").startswith(("U-LEV","V-LEV","WFACE"))]
          failures={f["label"]:f["exceedances"] for f in fields
                    if f.get("exceedances",0)!=0}
          if len(fields)!=27 or report.get("intervals")!=143:
              raise SystemExit("P6D full 143h U/V/W: wrong coverage; FAIL")
          if failures:
              print("P6D_FULL_UVW=FAIL_NUMERIC",failures)
              raise SystemExit(1)
          print("P6D_FULL_UVW=PASS_ORIGINAL_143H_ALL_27_FIELDS")
          PY