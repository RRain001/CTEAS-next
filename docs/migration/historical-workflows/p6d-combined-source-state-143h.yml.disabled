name: P6D combined original WINDBC ZII EL GAMMA forensic 143h

on:
  pull_request:
    paths:
      - 'native_cpp/modules/p6_calmet/src/realcase_wind_field_main.cpp'
      - 'native_cpp/modules/p6_calmet/p6d_original_rebuild/reference/verify_diagno_call_order.py'
      - 'scripts/p6d_compare_combined_state_diagnostic.py'
      - '.github/workflows/p6d-combined-source-state-143h.yml'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: p6d-combined-source-state-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

jobs:
  source-station-zii-el:
    name: Independent immutable CALMET 143h station ZII EL trace
    runs-on: ubuntu-22.04
    timeout-minutes: 60
    defaults:
      run:
        working-directory: p6d_combined_station_checkout
    steps:
      - uses: actions/checkout@v4
        with:
          path: p6d_combined_station_checkout
      - uses: ./p6d_combined_station_checkout/.github/actions/cteas-linux-toolchain
      - name: Restore original station and input provenance
        run: python3 native_cpp/modules/p6_calmet/reference/restore_frozen_case_from_git.py --mode grid
      - name: Verify original Fortran remains unchanged under write-only source trace
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/p6d_trace_original_similt_station_state.py \
            --vendor engine/vendor/src/CALMET_v6.5.0_L150223 \
            --case project/cases/hefei5km_2022_reference_case_20261011 \
            --compiler gfortran-11 --hours 143 \
            --out "$RUNNER_TEMP/p6d-combined-zii-el-${{ github.run_id }}-${{ github.run_attempt }}"
      - name: Preserve source ZII EL and immutable MET.DAT evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: p6d-combined-original-station-143h
          path: |
            ${{ runner.temp }}/p6d-combined-zii-el-${{ github.run_id }}-${{ github.run_attempt }}/source_original_station_zii_143h.f32
            ${{ runner.temp }}/p6d-combined-zii-el-${{ github.run_id }}-${{ github.run_attempt }}/source_original_station_el_143h.f32
            ${{ runner.temp }}/p6d-combined-zii-el-${{ github.run_id }}-${{ github.run_attempt }}/source_original_similt_station_manifest.json
          if-no-files-found: warn
          retention-days: 7

  source-grid-gamma:
    name: Independent immutable CALMET 143h gridded pre-FRADJ GAMMA trace
    runs-on: ubuntu-22.04
    timeout-minutes: 60
    defaults:
      run:
        working-directory: p6d_combined_gamma_checkout
    steps:
      - uses: actions/checkout@v4
        with:
          path: p6d_combined_gamma_checkout
      - uses: ./p6d_combined_gamma_checkout/.github/actions/cteas-linux-toolchain
      - name: Restore original gridded scientific case inputs
        run: python3 native_cpp/modules/p6_calmet/reference/restore_frozen_case_from_git.py --mode grid
      - name: Verify write-only original Fortran GAMMA source trace
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/p6d_trace_original_gamma.py \
            --vendor engine/vendor/src/CALMET_v6.5.0_L150223 \
            --case project/cases/hefei5km_2022_reference_case_20261011 \
            --compiler gfortran-11 --hours 143 \
            --out "$RUNNER_TEMP/p6d-combined-gamma-${{ github.run_id }}-${{ github.run_attempt }}"
      - name: Preserve original exact GAMMA grid and original output invariants
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: p6d-combined-original-gamma-143h
          path: |
            ${{ runner.temp }}/p6d-combined-gamma-${{ github.run_id }}-${{ github.run_attempt }}/gamma/*.f32
            ${{ runner.temp }}/p6d-combined-gamma-${{ github.run_id }}-${{ github.run_attempt }}/gamma_source_manifest.json
          if-no-files-found: warn
          retention-days: 7

  source-boundary-contract:
    name: Independent original WINDBC pre-INTER2 source-order gate
    runs-on: ubuntu-22.04
    timeout-minutes: 15
    defaults:
      run:
        working-directory: p6d_combined_order_checkout
    steps:
      - uses: actions/checkout@v4
        with:
          path: p6d_combined_order_checkout
      - name: Immutable CALMET source vs corrected C++ lateral snapshot
        run: |
          python3 native_cpp/modules/p6_calmet/p6d_original_rebuild/reference/verify_diagno_call_order.py \
            --vendor engine/vendor/src/CALMET_v6.5.0_L150223/calmet.for \
            --producer native_cpp/modules/p6_calmet/src/realcase_wind_field_main.cpp

  three-arm-combined-143h:
    name: Full 143h corrected WINDBC three-state original U V W comparison
    needs: [source-station-zii-el, source-grid-gamma, source-boundary-contract]
    runs-on: ubuntu-22.04
    timeout-minutes: 90
    defaults:
      run:
        working-directory: p6d_combined_effect_checkout
    steps:
      - uses: actions/checkout@v4
        with:
          path: p6d_combined_effect_checkout
      - uses: ./p6d_combined_effect_checkout/.github/actions/cteas-linux-toolchain
      - uses: actions/download-artifact@v4
        with:
          name: p6d-combined-original-station-143h
          path: ${{ runner.temp }}/p6d-combined-station-${{ github.run_id }}
      - uses: actions/download-artifact@v4
        with:
          name: p6d-combined-original-gamma-143h
          path: ${{ runner.temp }}/p6d-combined-gamma-ref-${{ github.run_id }}
      - name: Restore the same frozen case for all three diagnostic arms
        run: python3 native_cpp/modules/p6_calmet/reference/restore_frozen_case_from_git.py --mode grid
      - name: Run a single source-ordered C++ build and three full 143h strict comparisons
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-combined-delta-${{ github.run_id }}-${{ github.run_attempt }}"
          orig_station="$RUNNER_TEMP/p6d-combined-station-${{ github.run_id }}"
          orig_gamma="$RUNNER_TEMP/p6d-combined-gamma-ref-${{ github.run_id }}"
          mkdir -p "$root"
          set +e
          python3 scripts/run_p6_end_to_end.py \
            --build-dir "$root/build" --jobs 2 --hours 143 \
            --work "$root/native" > "$root/native.log" 2>&1
          native_rc=$?
          set -e
          if [[ ! -s "$root/native/p6g_report.json" ]]; then
            tail -100 "$root/native.log";exit 2
          fi
          bins=(
            --p6d-bin "$root/build/p6d/cteas_p6_realcase_wind_field"
            --p6f-bin "$root/build/p6f/cteas_p6f_calmet_dat21_writer"
            --p6e-bin "$root/build/p6e/p6e_calmet_dat21"
            --bridge-bin "$root/build/p6e/p6e_p6c_hourly_bridge"
          )
          set +e
          python3 scripts/run_p6_end_to_end.py \
            "${bins[@]}" --jobs 2 --hours 143 \
            --work "$root/zii_el" \
            --original-similt-station-dir "$orig_station" \
            --original-similt-station-manifest "$orig_station/source_original_similt_station_manifest.json" \
            > "$root/zii_el.log" 2>&1
          zii_rc=$?
          set -e
          if [[ ! -s "$root/zii_el/p6g_report.json" ]]; then
            tail -100 "$root/zii_el.log";exit 2
          fi
          set +e
          python3 scripts/run_p6_end_to_end.py \
            "${bins[@]}" --jobs 2 --hours 143 \
            --work "$root/zii_el_gamma" \
            --original-similt-station-dir "$orig_station" \
            --original-similt-station-manifest "$orig_station/source_original_similt_station_manifest.json" \
            --original-gamma-dir "$orig_gamma/gamma" \
            --original-gamma-manifest "$orig_gamma/gamma_source_manifest.json" \
            > "$root/zii_el_gamma.log" 2>&1
          gamma_rc=$?
          set -e
          if [[ ! -s "$root/zii_el_gamma/p6g_report.json" ]]; then
            tail -100 "$root/zii_el_gamma.log";exit 2
          fi
          python3 scripts/p6d_compare_combined_state_diagnostic.py \
            --baseline "$root/native/p6g_report.json" \
            --zii-el "$root/zii_el/p6g_report.json" \
            --zii-el-gamma "$root/zii_el_gamma/p6g_report.json" \
            --out "$root/three-arm-27-uvw-verdict.json"
          echo "numeric comparisons (1=expected non-native diagnostic FAIL) native=$native_rc zii=$zii_rc gamma=$gamma_rc"
          cat "$root/three-arm-27-uvw-verdict.json"
      - name: Archive three real 143-hour verdicts and full original-state proof
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: p6d-original-zii-el-gamma-windbc-triple-verdict
          path: |
            ${{ runner.temp }}/p6d-combined-delta-${{ github.run_id }}-${{ github.run_attempt }}/three-arm-27-uvw-verdict.json
            ${{ runner.temp }}/p6d-combined-delta-${{ github.run_id }}-${{ github.run_attempt }}/native/p6g_report.json
            ${{ runner.temp }}/p6d-combined-delta-${{ github.run_id }}-${{ github.run_attempt }}/zii_el/p6g_report.json
            ${{ runner.temp }}/p6d-combined-delta-${{ github.run_id }}-${{ github.run_attempt }}/zii_el_gamma/p6g_report.json
            ${{ runner.temp }}/p6d-combined-delta-${{ github.run_id }}-${{ github.run_attempt }}/*.log
          if-no-files-found: warn
          retention-days: 7