name: C++ input contracts
concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true
on:
  pull_request:
    paths:
      - 'native_cpp/**'
      - '.github/workflows/cpp-input-contracts.yml'
      - 'calpuff_terrain_and_landuse_data_crop/hefei_5km/**'
  push:
    branches:
      - 'codex/cpp20-p1-p2-foundation-20261010'
    paths:
      - 'native_cpp/**'
      - '.github/workflows/cpp-input-contracts.yml'
jobs:
  build-test:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 20
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - name: Select isolated C++20 and Fortran tools on GitHub-hosted Ubuntu
        uses: ./.github/actions/cteas-linux-toolchain
      - name: Record GitHub-hosted execution context
        shell: bash
        run: |
          echo 'CTEAS_CI_SELF_HOSTED=0' >> "$GITHUB_ENV"
          echo "CTEAS_INPUT_CONTRACT_HOSTED_RUNNER=$RUNNER_NAME"
      - name: Reset self-hosted scratch directories
        shell: bash
        run: |
          rm -rf ${{ runner.temp }}/cteas-cpp-build ${{ runner.temp }}/terrain.txt ${{ runner.temp }}/landuse.txt
      - name: Install GDAL headers
        run: |
          if ! pkg-config --exists gdal; then
            sudo -n apt-get update -qq
            sudo -n DEBIAN_FRONTEND=noninteractive apt-get install -y -qq libgdal-dev
          fi
      - name: Configure
        run: cmake -S native_cpp -B ${{ runner.temp }}/cteas-cpp-build -DCMAKE_BUILD_TYPE=Debug
      - name: Build
        run: cmake --build ${{ runner.temp }}/cteas-cpp-build -j2
      - name: Unit tests
        run: ctest --test-dir ${{ runner.temp }}/cteas-cpp-build --output-on-failure
      - name: Read immutable cropped source inputs
        shell: bash
        run: |
          set -euo pipefail
          ${{ runner.temp }}/cteas-cpp-build/cteas_geo_inspect terrain calpuff_terrain_and_landuse_data_crop/hefei_5km/china_srtm/srtm_60_06_hefei_5km.tif | tee ${{ runner.temp }}/terrain.txt
          ${{ runner.temp }}/cteas-cpp-build/cteas_geo_inspect landuse calpuff_terrain_and_landuse_data_crop/hefei_5km/eurasia_asia_landuse/eausgs2_0la_hefei_5km.generic.txt | tee ${{ runner.temp }}/landuse.txt
          grep -q 'width=90 height=77' ${{ runner.temp }}/terrain.txt
          grep -q 'datum=ESR-S categories=38 points=57600' ${{ runner.temp }}/landuse.txt
      - name: Independently verify crop SHA-256
        shell: bash
        run: |
          python3 - <<'PY'
          import hashlib,json,pathlib
          root=pathlib.Path('calpuff_terrain_and_landuse_data_crop/hefei_5km')
          info=json.loads((root/'crop_info.json').read_text())
          for item in [info['terrain'][0],info['landuse']['generic']]:
              p=pathlib.Path(item['output'])
              digest=hashlib.sha256(p.read_bytes()).hexdigest()
              assert digest==item['sha256'],(p,digest,item['sha256'])
              print(f'INPUT_SHA256_PASS {p.name}: {digest}')
          PY
