name: P7 frozen Hefei first-hour native H-3 receptors
on:
  pull_request:
    paths:
      - 'native_cpp/modules/p7_calpuff/**'
      - '.github/workflows/p7-hefei-real-firsthour-h3-receptors.yml'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: p7-real-hefei-h3-${{ github.sha }}
  cancel-in-progress: false
jobs:
  native-2022-firsthour-h3:
    runs-on: ubuntu-22.04
    timeout-minutes: 25
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
          filter: blob:none
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /native_cpp/modules/p7_calpuff/**
            /engine/vendor/src/CALPUFF_v7.2.1_L150618/calpuff.for
            /project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat
            /project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp
            /project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.con
      - name: Audit original source CALL CALCPF and DRY mass timeline
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY'
          import pathlib,hashlib
          path=pathlib.Path('engine/vendor/src/CALPUFF_v7.2.1_L150618/calpuff.for')
          raw=path.read_bytes()
          assert hashlib.sha256(raw).hexdigest()=='da40372cab1c181158d0ee5faac16f678e876fc14415073c38c8e3bdabfbc568'
          lines=raw.decode('latin-1').splitlines()
          terms=('QOLD','QNEW','Q01DRY','QM(','QU(','FRACT','TFRACT','CALCPF','PFSAMP','PUFRECS','DRY','VCOUP','MTRANS','MDRY','VDPVD','FRACDRY','SFC')
          for lo,hi in ((4165,4325),(11045,11230)):
              shown_in_span=set()
              for idx in range(lo-1,hi):
                  if not any(term in lines[idx].upper() for term in terms):continue
                  a=max(lo-1,idx-1);b=min(hi,idx+3)
                  for j in range(a,b):
                      if j not in shown_in_span:
                          print(f'P7_VENDOR_H3_RECEIVER {j+1:6d} {lines[j]}')
                          shown_in_span.add(j)
          # Inspect initial QOLD snapshot before VMASS/CHEM/DRY and the
          # source-ordered construction of QNEW at the CALCPF boundary.
          shown=set()
          for idx in range(9900,11045):
              if 'qold(' not in lines[idx].lower() and 'qnew(' not in lines[idx].lower():
                  continue
              for j in range(max(9900,idx-3),min(11045,idx+5)):
                  if j not in shown:
                      print(f'P7_VENDOR_OLD_NEW_MASS {j+1:6d} {lines[j]}')
                      shown.add(j)
          # Source-first isolation for the final 137 non-equal H-3 receptor
          # words: expose the exact vendor horizontal integral and floating
          # operation order, without changing the native solver or reference.
          for a,b in ((4188,4233),(4280,4313),(4680,4755)):
              for i in range(a-1,b):
                  print(f'P7_VENDOR_PFSAMP_CALCPF_REAL {i+1:6d} {lines[i]}')
          assert any('subroutine pfsamp' in lines[i].lower() for i in range(4675,4710))
          print('P7_VENDOR_PFSAMP_CALCPF_SOURCE_ANCHOR=PASS')
          for a,b in ((4945,5009),(5140,5204),(5205,5276),(5277,5379)):
              for i in range(a-1,b):
                  line=lines[i]
                  if line.lstrip().lower().startswith('c '):continue
                  print(f'P7_VENDOR_PUFRECS_REAL {i+1:6d} {line}')
          print('P7_VENDOR_H3_RECEIVER_SOURCE_PIN=PASS')
          PY
      - name: Verify immutable original inputs, compile independent native solver and compare
        shell: bash
        run: |
          set -euo pipefail
          met=project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat
          con=project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.con
          inp=project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp
          test -s "$met" && test -s "$con" && test -s "$inp"
          echo 'b1823cda92280888d70b00961ab39486036a3086e18637fff21efb4f4b237d30  '${met} | sha256sum -c -
          echo '0d51bdb68ff1a5798048bc41067107d3ffe10dc6222f25336df856bcbf48ba10  '${con} | sha256sum -c -
          build="${RUNNER_TEMP}/p7-frozen-h3-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          cmake -S native_cpp/modules/p7_calpuff -B "$build" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$build" --parallel 2 --target cteas_p7_hefei_firsthour_native_h3_receptors_tests
          ctest --test-dir "$build" -R '^cteas_p7_hefei_real_firsthour_h3_receptor_diagnostic$' --output-on-failure -V
          echo 'P7_2022_H3_NATIVE_RECEPTOR_DIAGNOSTIC_RAN=YES P7_ORIGINAL_NUMERIC_PARITY=NOT_CLAIMED'
