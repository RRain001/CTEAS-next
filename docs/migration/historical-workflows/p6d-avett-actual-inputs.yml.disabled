name: P6D AVETMP original DIAGNO actual-input provenance

on:
  pull_request:
    paths:
      - scripts/p6d_avetmp_source_input_audit.py
      - .github/workflows/p6d-avett-actual-inputs.yml
  workflow_dispatch:

permissions:
  contents: read

jobs:
  trace-source-input:
    name: Original SURFVAR pre/post AVETMP vs C++ WIND1/TEMP2D 143h
    runs-on: ubuntu-22.04
    timeout-minutes: 75
    steps:
      - uses: actions/checkout@v4
        with:
          filter: blob:none
          sparse-checkout: |
            .github/actions/cteas-linux-toolchain
            native_cpp/modules/p6_calmet
            scripts/p6d_avetmp_source_input_audit.py
            engine/vendor/src/CALMET_v6.5.0_L150223
      - uses: ./.github/actions/cteas-linux-toolchain
      - name: Materialize immutable original real case
        run: python3 native_cpp/modules/p6_calmet/reference/restore_frozen_case_from_git.py --mode grid
      - name: Verify untouched original meteorology against pinned full 143h reference
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-avetmp-input-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          python3 native_cpp/modules/p6_calmet/reference/original_internal_state_dump.py audit \
            --vendor engine/vendor/src/CALMET_v6.5.0_L150223 \
            --case project/cases/hefei5km_2022_reference_case_20261011 \
            --out "$root/original" --compiler gfortran-11
      - name: Build and run unmodified autonomous C++ real-case WIND1 and SURFVAR
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-avetmp-input-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          cmake -S native_cpp/modules/p6_calmet -B "$root/build" -DCMAKE_BUILD_TYPE=Release
          cmake --build "$root/build" --target cteas_p6_realcase_wind_field --parallel 2
          "$root/build/cteas_p6_realcase_wind_field" \
            --case project/cases/hefei5km_2022_reference_case_20261011 \
            --hours 143 --out "$root/candidate"
      - name: Isolate first differing original SURFVAR inputs vs C++ for same hour and cell
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-avetmp-input-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          python3 scripts/p6d_avetmp_source_input_audit.py \
            --original-dir "$root/original" \
            --vendor engine/vendor/src/CALMET_v6.5.0_L150223 \
            --case project/cases/hefei5km_2022_reference_case_20261011 \
            --candidate "$root/candidate" --compiler gfortran-11 \
            --out "$root/p6d_avetmp_first_divergence_143h.json"
      - name: Archive provenance and numerical differences
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: p6d-avett-original-inputs-143h
          path: |
            ${{ runner.temp }}/p6d-avetmp-input-${{ github.run_id }}-${{ github.run_attempt }}/p6d_avetmp_first_divergence_143h.json
            ${{ runner.temp }}/p6d-avetmp-input-${{ github.run_id }}-${{ github.run_attempt }}/original/dgm-audit.json
          if-no-files-found: warn
          retention-days: 14
