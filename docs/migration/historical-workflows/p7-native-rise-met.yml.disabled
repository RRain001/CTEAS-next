name: P7 native GRISE RISEWIND METFM1 production bridge
on:
  pull_request:
    paths:
      - 'native_cpp/modules/p7_calpuff/**'
      - '.github/workflows/p7-native-rise-met.yml'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: p7-native-rise-met-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
jobs:
  rise-met-bridge:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
          filter: blob:none
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /native_cpp/modules/p7_calpuff/**
      - name: Compile GRISE RISEWIND from original CALMET native bridge
        shell: bash
        run: |
          set -euo pipefail
          if command -v g++-12 >/dev/null 2>&1; then cpp=$(command -v g++-12);
          elif command -v g++-11 >/dev/null 2>&1; then cpp=$(command -v g++-11);
          else cpp=$(command -v c++); fi
          build="${RUNNER_TEMP}/p7-rise-met-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          cmake -S native_cpp/modules/p7_calpuff -B "$build" \
            -DCMAKE_CXX_COMPILER="$cpp" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$build" --parallel 2 --target cteas_p7_original_rise_met_tests
          ctest --test-dir "$build" -R '^cteas_p7_native_metfm1_grise_risewind$' --output-on-failure
          echo 'P7_NATIVE_GRISE_RISEWIND_METFM1=PASS'
          echo 'P7_FROZEN_HEFEI_143H_COMP=NOT_YET_VALIDATED'
