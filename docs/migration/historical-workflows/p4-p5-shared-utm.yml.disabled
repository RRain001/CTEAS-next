name: P6G G5 shared P4-P5 strict UTM station geometry

on:
  pull_request:
    paths:
      - 'engine/run_met/station_grid.py'
      - 'native_cpp/modules/p4_read62/data_prep/download_igra.py'
      - 'native_cpp/modules/p4_read62/data_prep/tests/**'
      - 'native_cpp/modules/p5_smerge/data_prep/download_isd_by_grid.py'
      - '.github/workflows/p4-p5-shared-utm.yml'
  push:
    branches:
      - codex/p6g-multistation-on-accepted-p6a-p6f-20261014
  workflow_dispatch:

permissions:
  contents: read

jobs:
  shared-utm-regression:
    runs-on: ubuntu-22.04
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
      - name: Install test dependencies
        run: python3 -m pip install --disable-pip-version-check PyYAML pandas numpy
      - name: Compile changed Python modules
        run: |
          python3 -m compileall -q engine/run_met/station_grid.py \
            native_cpp/modules/p4_read62/data_prep/download_igra.py \
            native_cpp/modules/p5_smerge/data_prep/download_isd_by_grid.py
      - name: P4 annual station selection, integration and strict UTM tests
        run: python3 -m unittest discover -s native_cpp/modules/p4_read62/data_prep/tests -p 'test_*.py' -v
      - name: P5 strict UTM grid boundary and source policy tests
        run: python3 -m unittest native_cpp.modules.p5_smerge.data_prep.tests.test_p5_rules -v
      - name: Confirm NATIVE selector does not use legacy geographic-bbox approximation
        run: |
          python3 - <<'PY'
          from pathlib import Path
          import ast
          for filename in (
              "native_cpp/modules/p4_read62/data_prep/download_igra.py",
              "native_cpp/modules/p5_smerge/data_prep/download_isd_by_grid.py",
          ):
              tree = ast.parse(Path(filename).read_text())
              fns = {n.name for n in ast.walk(tree) if isinstance(n, ast.FunctionDef)}
              assert "build_bbox" not in fns and "signed_offsets_km" not in fns and "inside_bbox" not in fns, filename
              print("PASS_NO_APPROXIMATE_GEOGRAPHIC_STATION_SELECTOR", filename)
          PY
