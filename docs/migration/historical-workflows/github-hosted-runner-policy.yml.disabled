name: CTEAS GitHub-hosted runner policy
on:
  pull_request:
    paths:
      - '.github/workflows/**'
      - '.github/scripts/assert_github_hosted_runners.py'
  push:
    branches:
      - 'codex/cteas-p7-calpuff-20261011'
    paths:
      - '.github/workflows/**'
      - '.github/scripts/assert_github_hosted_runners.py'
  workflow_dispatch:
permissions:
  contents: read
jobs:
  all-workflows-use-github-hosted:
    runs-on: ubuntu-22.04
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v4
      - name: Install YAML decoder
        run: python3 -m pip install --disable-pip-version-check PyYAML
      - name: Reject every retired self-hosted runner label and unknown scheduling target
        run: python3 .github/scripts/assert_github_hosted_runners.py
