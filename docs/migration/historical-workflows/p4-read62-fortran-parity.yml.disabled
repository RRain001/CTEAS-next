name: P4 READ62 original Fortran reference / UP.DAT parity
concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true
on:
  pull_request:
    paths:
      - 'native_cpp/modules/p4_read62/**'
      - 'native_cpp/include/cteas/met_input/p4_read62.hpp'
      - '.github/workflows/p4-read62-fortran-parity.yml'
jobs:
  original-fortran:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 25
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4
      - name: Select self-hosted C++20 and Fortran tools
        uses: ./.github/actions/cteas-linux-toolchain
      - name: Reset self-hosted scratch directories
        shell: bash
        run: |
          rm -rf ${{ runner.temp }}/cteas-p4-reference ${{ runner.temp }}/cteas-p4-refsource ${{ runner.temp }}/cteas-p4-cpp
      - name: Fortran compiler
        run: gfortran --version | head -1
      - name: Build original READ62 unchanged
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p ${{ runner.temp }}/cteas-p4-reference reference-evidence
          SRC=engine/vendor/src/READ62_v5.661_L110225
          mkdir -p ${{ runner.temp }}/cteas-p4-refsource
          cp -a "$SRC"/. ${{ runner.temp }}/cteas-p4-refsource/
          # Upstream Windows case-insensitive include files: Linux temp aliases only.
          for file in ${{ runner.temp }}/cteas-p4-refsource/*; do
            base=$(basename "$file")
            lower=$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]')
            if [ "$base" != "$lower" ] && [ ! -e "${{ runner.temp }}/cteas-p4-refsource/$lower" ]; then
              ln -s "$base" "${{ runner.temp }}/cteas-p4-refsource/$lower"
            fi
          done
          gfortran -O0 -std=legacy -ffixed-line-length-72 -fallow-argument-mismatch -fno-automatic \
            -I${{ runner.temp }}/cteas-p4-refsource -o ${{ runner.temp }}/cteas-p4-reference/read62 \
            ${{ runner.temp }}/cteas-p4-refsource/READ62.FOR 2>&1 | tee reference-evidence/fortran-build.log
          sha256sum "$SRC/READ62.FOR" > reference-evidence/fortran-source.sha256
      - name: Prepare same isolated Hefei input
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p project/current/grid
          cat > project/current/grid/center_location <<'EOF'
          latitude: 31.939774444
          longitude: 117.141610855
          EOF
          # Strict P4/P5 station selection now reads the complete WGS-84
          # grid.cmn contract. This is an isolated P4-only 5km fixture;
          # NZ/ZFACE are parse-contract fields, not P6 physics inputs.
          python3 - <<'PY'
          from pathlib import Path
          from engine.run_met.common import lon_lat_to_utm_km
          from engine.run_met.station_grid import load_strict_utm_grid, lon_lat_in_utm_grid
          lat, lon = 31.939774444, 117.141610855
          x_km, y_km = lon_lat_to_utm_km(lon, lat, 50, True)
          path = Path("project/current/grid/grid.cmn")
          path.write_text(
              f"! IMAP = UTM !\n! IUTMZN = 50 !\n! LSOHEM = N !\n"
              f"! DATUM = WGS-84 !\n"
              f"! XREFKM = {x_km - 2.5:.9f} !\n"
              f"! YREFKM = {y_km - 2.5:.9f} !\n"
              "! DGRIDKM = 0.1 !\n! NX = 50 !\n! NY = 50 !\n"
              "! NZ = 1 !\n! ZFACE = 0.0 !\n! ZFACE = 20.0 !\n",
              encoding="utf-8")
          grid = load_strict_utm_grid(path, context="P4_FORTRAN_PARITY")
          if not lon_lat_in_utm_grid(lon, lat, grid):
              raise RuntimeError("P4 original-reference fixture excludes chimney")
          print("P4_REFERENCE_STRICT_UTM_GRID=PASS")
          PY
          cat > project/current/grid/research_time <<'EOF'
          BEGIN: 20220101-000000
          END: 20220106-230000
          EOF
          python3 -m native_cpp.modules.p4_read62.data_prep.prepare_inputs \
            --year 2022 --pstop 500 --execute 2>&1 | tee reference-evidence/prepare.log
          cp project/current/met/upperair/2022/igra2fsl/58424.txt ${{ runner.temp }}/cteas-p4-reference/58424.fsl
          cp project/current/met/upperair/2022/upperair_station_used_list.txt reference-evidence/
          cp project/current/met/upperair/2022/p4_station_selection_audit.json reference-evidence/
          sha256sum ${{ runner.temp }}/cteas-p4-reference/58424.fsl > reference-evidence/fsl.sha256
      - name: Stage original READ62.INP with isolated output paths
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY'
          import pathlib,re
          inp=pathlib.Path("engine/vendor/src/READ62_v5.661_L110225/read62.inp").read_text()
          replacements={
              "INDAT":"58424.fsl",
              "UPDAT":"reference_up.dat",
              "RUNLST":"reference_read62.lst",
              "IBYR":"2022","IBMO":"1","IBDY":"1","IBHR":"0","IBSEC":"0",
              "IEYR":"2022","IEMO":"1","IEDY":"6","IEHR":"23","IESEC":"0",
              "PSTOP":"500.0","IFMT":"1","JDAT":"2"
          }
          for k,v in replacements.items():
              inp,n=re.subn(r'(!\s*'+k+r'\s*=\s*)[^!]*!',lambda m:m.group(1)+v+" !",inp,count=1)
              if n!=1: raise RuntimeError("READ62.INP missing "+k)
          out=pathlib.Path("${{ runner.temp }}/cteas-p4-reference/read62.inp")
          out.write_text(inp)
          print(out)
          PY
      - name: Execute original Fortran READ62
        shell: bash
        run: |
          set -euo pipefail
          cd ${{ runner.temp }}/cteas-p4-reference
          ./read62 read62.inp 2>&1 | tee "$GITHUB_WORKSPACE/reference-evidence/fortran-run.log"
          ls -lah
          test -s reference_up.dat
          sha256sum reference_up.dat >> "$GITHUB_WORKSPACE/reference-evidence/fortran-source.sha256"
          cp reference_up.dat "$GITHUB_WORKSPACE/reference-evidence/reference_up.dat"
          cp reference_read62.lst "$GITHUB_WORKSPACE/reference-evidence/reference_read62.lst"
          cp read62.inp "$GITHUB_WORKSPACE/reference-evidence/reference_read62.inp"
      - name: Compile and execute independent C++ P4
        shell: bash
        run: |
          set -euo pipefail
          cmake -S native_cpp/modules/p4_read62 -B ${{ runner.temp }}/cteas-p4-cpp -DCMAKE_BUILD_TYPE=Debug
          cmake --build ${{ runner.temp }}/cteas-p4-cpp -j2
          ctest --test-dir ${{ runner.temp }}/cteas-p4-cpp --output-on-failure
          ${{ runner.temp }}/cteas-p4-cpp/cteas_p4_read62 \
            ${{ runner.temp }}/cteas-p4-reference/58424.fsl reference-evidence/cpp_up.dat \
            2022-01-01T00:00Z 2022-01-06T23:00Z 500 58424 2>&1 | tee reference-evidence/cpp-run.log
      - name: Independently verify every original and C++ UP.DAT numerical field
        shell: bash
        run: |
          set -euo pipefail
          python3 -m native_cpp.modules.p4_read62.verify_updat_parity \
            --reference reference-evidence/reference_up.dat \
            --candidate reference-evidence/cpp_up.dat \
            --report reference-evidence/numerical-parity.json
          cmp reference-evidence/reference_up.dat reference-evidence/cpp_up.dat
          echo P4_UPDAT_BYTES_IDENTICAL_6D=PASS
      - name: Test coordinate suffix precision 3-6 decimals without moving legacy fields
        shell: bash
        run: |
          set -euo pipefail
          python3 -m native_cpp.modules.p4_read62.precision_probe \
            --fsl ${{ runner.temp }}/cteas-p4-reference/58424.fsl \
            --fortran ${{ runner.temp }}/cteas-p4-reference/read62 \
            --template-inp ${{ runner.temp }}/cteas-p4-reference/read62.inp \
            --baseline-updat reference-evidence/reference_up.dat \
            --cpp ${{ runner.temp }}/cteas-p4-cpp/cteas_p4_read62 \
            --outdir reference-evidence/coord-precision \
            --lat 31.939774444 --lon 117.141610855
      - name: Verify complete 2022 year (730 soundings)
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY'
          from pathlib import Path
          import re
          control=Path("${{ runner.temp }}/cteas-p4-reference/read62.inp").read_text()
          for key,value in {"IEMO":"12","IEDY":"31","IEHR":"23",
                            "UPDAT":"reference_full_year_up.dat",
                            "RUNLST":"reference_full_year.lst"}.items():
              control,n=re.subn(r"(!\s*"+key+r"\s*=\s*)[^!]*!",
                                lambda m:m.group(1)+value+" !",control,count=1)
              if n!=1:raise RuntimeError("Missing "+key)
          Path("${{ runner.temp }}/cteas-p4-reference/read62-annual.inp").write_text(control)
          PY
          (
            cd ${{ runner.temp }}/cteas-p4-reference
            ./read62 read62-annual.inp
            test -s reference_full_year_up.dat
          ) 2>&1 | tee reference-evidence/fortran-full-year.log
          cp ${{ runner.temp }}/cteas-p4-reference/reference_full_year_up.dat reference-evidence/
          cp ${{ runner.temp }}/cteas-p4-reference/reference_full_year.lst reference-evidence/
          ${{ runner.temp }}/cteas-p4-cpp/cteas_p4_read62 \
            ${{ runner.temp }}/cteas-p4-reference/58424.fsl reference-evidence/cpp_full_year_up.dat \
            2022-01-01T00:00Z 2022-12-31T23:00Z 500 58424 \
            | tee reference-evidence/cpp-full-year.log
          python3 -m native_cpp.modules.p4_read62.verify_updat_parity \
            --reference reference-evidence/reference_full_year_up.dat \
            --candidate reference-evidence/cpp_full_year_up.dat \
            --report reference-evidence/numerical-full-year-parity.json
          cmp reference-evidence/reference_full_year_up.dat reference-evidence/cpp_full_year_up.dat
          echo P4_UPDAT_BYTES_IDENTICAL_2022=PASS
      - name: End-to-end C++ P4 publishing into case met/upperair/final
        shell: bash
        run: |
          set -euo pipefail
          python3 -m native_cpp.modules.p4_read62.data_prep.run_cpp_pipeline \
            --cpp-bin ${{ runner.temp }}/cteas-p4-cpp/cteas_p4_read62 \
            --year 2022 --pstop 500 --skip-inputs --merge-final --execute \
            | tee reference-evidence/cpp-final-pipeline.log
          cp project/current/met/upperair/final/up_58424.dat reference-evidence/merged_final_up_58424.dat
          cp project/current/met/upperair/final/stations.csv reference-evidence/final_stations.csv
          cp project/current/met/upperair/final/p4_cpp_execution_manifest.json reference-evidence/
          test -s reference-evidence/merged_final_up_58424.dat
      - name: Capture available parity outputs
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: p4-original-fortran-updat-2022-jan1-6
          path: reference-evidence/
          retention-days: 7
          if-no-files-found: warn
