name: P6D original MIXHTST 143h source-precursor physical test

on:
  push:
    branches: [audit/p6d-source-slope-drivers-143h-20261012]
    paths:
      - 'native_cpp/modules/p6_calmet/include/cteas/p6/station_mixhtst.hpp'
      - 'native_cpp/modules/p6_calmet/src/station_mixhtst_probe_main.cpp'
      - 'native_cpp/modules/p6_calmet/CMakeLists.txt'
      - 'scripts/p6d_station_mixhtst_source_precursor_143h.py'
      - '.github/workflows/p6d-original-mixhtst-143h.yml'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: p6d-station-mixhtst-source-${{ github.ref }}
  cancel-in-progress: true

jobs:
  original-mixhtst-143h:
    name: Native MIXHTST vs original ZII, ZICONV and DPTT, original entering COMP state
    runs-on: ubuntu-22.04
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
        with:
          filter: blob:none
          sparse-checkout: |
            .github/actions/cteas-linux-toolchain
            native_cpp/modules/p6_calmet
            scripts
      - uses: ./.github/actions/cteas-linux-toolchain
      - name: Restore frozen UP.DAT and prepare original precursor fixture
        shell: bash
        run: |
          set -euo pipefail
          python3 native_cpp/modules/p6_calmet/reference/restore_frozen_case_from_git.py --mode grid
          root="$RUNNER_TEMP/p6d-station-mixhtst-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          mkdir -p "$root"
          python3 scripts/p6d_station_mixhtst_source_precursor_143h.py \
            --mode prepare \
            --cell-json native_cpp/modules/p6_calmet/reference/dgm_p6d_requests_2022/dgm_cell.json \
            --cell-bin native_cpp/modules/p6_calmet/reference/dgm_p6d_requests_2022/dgm_cell.bin \
            --state-bin native_cpp/modules/p6_calmet/reference/dgm_internal_state_2022/dgm_state.bin \
            --out "$root/source_precursor.tsv"
      - name: Build source-ordered C++ MIXHTST transition and run full 143h
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-station-mixhtst-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          cmake -S native_cpp/modules/p6_calmet -B "$root/build" -DCMAKE_BUILD_TYPE=Release
          cmake --build "$root/build" --target cteas_p6_station_mixhtst_probe --parallel 1
          "$root/build/cteas_p6_station_mixhtst_probe" \
            project/cases/hefei5km_2022_reference_case_20261011/met/upperair/final/up_58424.dat \
            "$root/source_precursor.tsv" "$root/prediction.csv"
      - name: Strict original 143h ZII/ZICONV/DPTT scientific comparison
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-station-mixhtst-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          python3 scripts/p6d_station_mixhtst_source_precursor_143h.py \
            --mode compare \
            --cell-json native_cpp/modules/p6_calmet/reference/dgm_p6d_requests_2022/dgm_cell.json \
            --cell-bin native_cpp/modules/p6_calmet/reference/dgm_p6d_requests_2022/dgm_cell.bin \
            --state-bin native_cpp/modules/p6_calmet/reference/dgm_internal_state_2022/dgm_state.bin \
            --native "$root/prediction.csv" \
            --out "$root/mixhtst_original_143h_report.json" --require-parity
      - name: Preserve failing first divergence evidence
        if: always()
        uses: actions/upload-artifact@v4
        continue-on-error: true
        with:
          name: p6d-original-mixhtst-143h
          path: |
            ${{ runner.temp }}/p6d-station-mixhtst-${{ github.run_id }}-${{ github.run_attempt }}/mixhtst_original_143h_report.json
            ${{ runner.temp }}/p6d-station-mixhtst-${{ github.run_id }}-${{ github.run_attempt }}/prediction.csv
          if-no-files-found: warn
          retention-days: 14