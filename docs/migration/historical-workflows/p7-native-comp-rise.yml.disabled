name: P7 native rising COMP 1h 6h 143h integration
on:
  pull_request:
    paths:
      - 'native_cpp/modules/p7_calpuff/**'
      - '.github/workflows/p7-native-comp-rise.yml'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: p7-native-comp-rise-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
jobs:
  rise-phys-bridge:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
          filter: blob:none
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /native_cpp/modules/p7_calpuff/**
      - name: Native GRISE RISEWIND and PG COMP over actual native puff states
        shell: bash
        run: |
          set -euo pipefail
          if command -v g++-12 >/dev/null 2>&1; then cpp=$(command -v g++-12);
          elif command -v g++-11 >/dev/null 2>&1; then cpp=$(command -v g++-11);
          else cpp=$(command -v c++); fi
          build="${RUNNER_TEMP}/p7-comp-rise-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          cmake -S native_cpp/modules/p7_calpuff -B "$build" \
            -DCMAKE_CXX_COMPILER="$cpp" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$build" --parallel 2 --target cteas_p7_original_comp_rise_tests
          ctest --test-dir "$build" -R '^cteas_p7_native_rise_comp_pg_(1|6|143)h$' --output-on-failure
          echo 'P7_NATIVE_RISING_PG_COMP=PASS NO_DGM_SOLVER_INPUT=TRUE'
          echo 'P7_FROZEN_HEFEI_WROUT1_CONCENTRATION=NOT_YET_VALIDATED'
