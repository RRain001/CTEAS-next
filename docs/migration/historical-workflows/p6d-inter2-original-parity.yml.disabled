name: P6D original INTER2 selected 3D obs blend parity
on:
  pull_request:
    paths:
      - '.github/scripts/p6d_verified_checkout.py'
      - 'native_cpp/modules/p6_calmet/CMakeLists.txt'
      - 'native_cpp/modules/p6_calmet/include/cteas/p6/inter2_selected.hpp'
      - 'native_cpp/modules/p6_calmet/src/inter2_selected_main.cpp'
      - 'native_cpp/modules/p6_calmet/tests/p6_inter2_selected_tests.cpp'
      - 'native_cpp/modules/p6_calmet/reference/compare_original_inter2.py'
      - '.github/workflows/p6d-inter2-original-parity.yml'
      - 'docs/reconstruction_cpp/CI_FULL_REGRESSION_REQUEST.md'
  workflow_dispatch:
permissions:
  contents: read
jobs:
  original-inter2:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 15
    concurrency:
      group: p6d-inter2-${{ github.event.pull_request.number || github.ref }}
      cancel-in-progress: true
    steps:
      - name: Verify GitHub-hosted P6D environment
        shell: bash
        run: |
          echo "P6D runner=$RUNNER_NAME os=$RUNNER_OS arch=$RUNNER_ARCH"
          if [[ "$RUNNER_OS" != "Linux" || "$RUNNER_ARCH" != "X64" ]]; then
            echo "::error::P6D requires a Linux/X64 GitHub-hosted runner"
            exit 1
          fi
      - name: Probe GitHub checkout transports on dedicated P6D host
        id: source_transport
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          if curl -fIsS --connect-timeout 5 --max-time 8 https://github.com/ >/dev/null 2>&1; then
            echo "git=yes" >> "$GITHUB_OUTPUT"
          else
            echo "git=no" >> "$GITHUB_OUTPUT"
            echo "::warning::github.com unavailable; attempt verified REST fallback"
          fi
          if curl -fIsS --connect-timeout 5 --max-time 8 \
            -H "Authorization: Bearer $GH_TOKEN" -H "Accept: application/vnd.github+json" \
            "https://api.github.com/repos/$GITHUB_REPOSITORY" >/dev/null 2>&1; then
            echo "rest=yes" >> "$GITHUB_OUTPUT"
          else
            echo "rest=no" >> "$GITHUB_OUTPUT"
          fi
          if ! grep -Eq '^(git|rest)=yes$' "$GITHUB_OUTPUT"; then
            echo "::error::Both Git and REST source transports unavailable"; exit 1
          fi
      - name: Checkout P6D source if github.com is reachable
        id: p6d_checkout
        if: steps.source_transport.outputs.git == 'yes'
        continue-on-error: true
        uses: actions/checkout@v4
        with:
          filter: blob:none
          sparse-checkout: |
            native_cpp/modules/p6_calmet
            engine/vendor/src/CALMET_v6.5.0_L150223
            .github/actions/cteas-linux-toolchain
      - name: Restore immutable P6D source via authenticated REST
        if: (steps.source_transport.outputs.git != 'yes' || steps.p6d_checkout.outcome == 'failure') && steps.source_transport.outputs.rest == 'yes'
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          # Load bootstrap code from exact PR Git tree and verify before execution.
          python3 - <<'PY'
          import base64, hashlib, json, os
          from pathlib import Path
          from urllib.request import Request, urlopen
          api = "https://api.github.com/repos/" + os.environ["GITHUB_REPOSITORY"]
          headers = {"Authorization": "Bearer " + os.environ["GH_TOKEN"],
                     "Accept": "application/vnd.github+json",
                     "User-Agent": "CTEAS-P6D-bootstrap-verifier"}
          def read(path):
              with urlopen(Request(api + path, headers=headers), timeout=30) as r:
                  return json.load(r)
          commit = read("/git/commits/" + os.environ["GITHUB_SHA"])
          tree = read("/git/trees/" + commit["tree"]["sha"] + "?recursive=1")
          if tree.get("truncated"):
              raise RuntimeError("Source tree truncated")
          name = ".github/scripts/p6d_verified_checkout.py"
          matched = [x for x in tree["tree"] if x["path"] == name and x["type"] == "blob"]
          if len(matched) != 1:
              raise RuntimeError("Required verified source bootstrap missing")
          expected = matched[0]["sha"]
          blob = read("/git/blobs/" + expected)
          if blob.get("encoding") != "base64":
              raise RuntimeError("Bootstrap encoding mismatch")
          data = base64.b64decode(blob["content"])
          actual = hashlib.sha1(b"blob " + str(len(data)).encode() + b"\0" + data).hexdigest()
          if actual != expected:
              raise RuntimeError("Bootstrap SHA-1 integrity mismatch")
          out = Path(os.environ["RUNNER_TEMP"]) / "p6d_verified_checkout.py"
          out.write_bytes(data)
          print("P6D bootstrap source SHA-1 PASS: " + expected)
          PY
          python3 "$RUNNER_TEMP/p6d_verified_checkout.py"
      - name: Verify complete P6D source tree
        shell: bash
        run: |
          set -euo pipefail
          for p in native_cpp/modules/p6_calmet/CMakeLists.txt \
                   engine/vendor/src/CALMET_v6.5.0_L150223/calmet.for \
                   native_cpp/modules/p6_calmet/reference/compare_original_inter2.py \
                   .github/actions/cteas-linux-toolchain/action.yml; do
            test -s "$p" || { echo "::error::Missing source $p"; exit 1; }
          done
      - name: Resolve modern C++20 and Fortran toolchains on GitHub-hosted runner
        shell: bash
        run: |
          set -euo pipefail
          echo "runner=$RUNNER_NAME os=$RUNNER_OS arch=$RUNNER_ARCH"
          uname -a
          for tool in cmake python3; do command -v "$tool" || exit 1; done
          # Prefer already-installed Ubuntu 22.04 versioned packages.
          # Only use sudo non-interactively when compiler prerequisites are absent.
          find_cpp() {
            for binary in g++-13 g++-12 clang++-17 clang++-16 clang++-15; do
              if command -v "$binary" >/dev/null 2>&1; then
                echo "$binary"
                return 0
              fi
            done
            return 1
          }
          find_fortran() {
            for binary in gfortran-13 gfortran-12 gfortran-11; do
              if command -v "$binary" >/dev/null 2>&1; then
                echo "$binary"
                return 0
              fi
            done
            return 1
          }
          cpp="$(find_cpp || true)"
          fort="$(find_fortran || true)"
          if [[ -z "$cpp" || -z "$fort" ]]; then
            if ! sudo -n true 2>/dev/null; then
              echo "::error::Runner requires g++-12 and gfortran-11 (Ubuntu 22.04); sudo -n unavailable. Ask administrator to install them."
              exit 1
            fi
            sudo -n apt-get update -qq
            sudo -n DEBIAN_FRONTEND=noninteractive apt-get install -y -qq g++-12 gfortran-11
            cpp="$(find_cpp || true)"
            fort="$(find_fortran || true)"
          fi
          if [[ -z "$cpp" || -z "$fort" ]]; then
            echo "::error::Cannot resolve C++20 and modern Fortran compilers"
            exit 1
          fi
          command -v "$cpp"
          command -v "$fort"
          "$cpp" --version | head -1
          # g++-11 supports -std=c++20 but lacks the required libstdc++
          # calendar/sys_seconds API. Verify actual library support.
          printf '#include <chrono>\nint main(){std::chrono::sys_seconds a{}; (void)a;}\n' | "$cpp" -std=c++20 -x c++ -fsyntax-only -
          "$fort" --version | head -1
          cmake --version | head -1
          python3 --version
          # Source-verification Python scripts explicitly invoke 'gfortran'.
          # Use a job-private versioned compiler shim instead of rewriting code
          # or changing global /usr/bin/gfortran on the research host.
          mkdir -p "$RUNNER_TEMP/cteas-p6d-tools"
          ln -sfn "$(command -v "$fort")" "$RUNNER_TEMP/cteas-p6d-tools/gfortran"
          echo "$RUNNER_TEMP/cteas-p6d-tools" >> "$GITHUB_PATH"
          echo "CXX=$(command -v "$cpp")" >> "$GITHUB_ENV"
      - name: Strict C++20 build and all P6 regression CTests
        run: |
          # A self-hosted machine persists across jobs: never reuse a CMake cache
          # configured with the machine's older default GCC 9.
          build="$RUNNER_TEMP/cteas-inter2-build-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          cmake -S native_cpp/modules/p6_calmet -B "$build" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$build" --parallel 2
          # This frozen P6D parity job runs the original P6 suite only.
          # Newly introduced P6G source-deck tests require their own inputs
          # and are independently executed by p6g-accepted-baseline-multistation.
          ctest --test-dir "$build" --output-on-failure -E '^p6g_'
      - name: Original CALMET unchanged INTER2 against independent C++
        run: |
          python3 native_cpp/modules/p6_calmet/reference/compare_original_inter2.py \
            --vendor engine/vendor/src/CALMET_v6.5.0_L150223 \
            --cpp "$RUNNER_TEMP/cteas-inter2-build-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT/cteas_p6_inter2" \
            --out "$RUNNER_TEMP/cteas-original-inter2-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
      - name: Retain Fortran comparison evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: p6d-original-inter2-selected-evidence
          path: ${{ runner.temp }}/cteas-original-inter2-${{ github.run_id }}-${{ github.run_attempt }}/p6d-original-inter2-parity.json
          if-no-files-found: warn
          retention-days: 14