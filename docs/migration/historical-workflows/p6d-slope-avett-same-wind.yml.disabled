name: P6D SLOPE AVETMP real-wind same-input forensic

on:
  pull_request:
    paths:
      - scripts/p6d_avetmp_same_wind_forensic.py
      - .github/workflows/p6d-slope-avett-same-wind.yml
  workflow_dispatch:

permissions:
  contents: read

jobs:
  same-real-wind-original-avetmp:
    runs-on: ubuntu-22.04
    timeout-minutes: 35
    steps:
      - uses: actions/checkout@v4
        with:
          filter: blob:none
          sparse-checkout: |
            .github/actions/cteas-linux-toolchain
            engine/vendor/src/CALMET_v6.5.0_L150223
            native_cpp/modules/p6_calmet
            scripts/p6d_avetmp_same_wind_forensic.py
      - uses: ./.github/actions/cteas-linux-toolchain
      - name: Restore original actual study area and observations
        run: python3 native_cpp/modules/p6_calmet/reference/restore_frozen_case_from_git.py --mode grid
      - name: Build original production native WIND1 for 19 real hours
        shell: bash
        run: |
          set -euo pipefail
          cmake -S native_cpp/modules/p6_calmet -B "$RUNNER_TEMP/avett-build" -DCMAKE_BUILD_TYPE=Release
          cmake --build "$RUNNER_TEMP/avett-build" --target cteas_p6_realcase_wind_field --parallel 2
          "$RUNNER_TEMP/avett-build/cteas_p6_realcase_wind_field" \
            --case project/cases/hefei5km_2022_reference_case_20261011 \
            --hours 19 --out "$RUNNER_TEMP/avetmp-real-wind"
      - name: Compare unchanged vendor AVETMP and C++ AVETMP given same byte-identical real U/V
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/p6d_avetmp_same_wind_forensic.py \
            --vendor engine/vendor/src/CALMET_v6.5.0_L150223/calmet.for \
            --candidate "$RUNNER_TEMP/avetmp-real-wind" \
            --cpp-include native_cpp/modules/p6_calmet/p6e/include \
            --hours 2022-01-01_19 \
            --out "$RUNNER_TEMP/p6d-avett-same-wind.json"
      - name: Archive read-only same-U/V numerical comparison
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: p6d-avett-same-wind-forensic
          path: ${{ runner.temp }}/p6d-avett-same-wind.json
          if-no-files-found: warn
          retention-days: 14
