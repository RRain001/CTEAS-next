name: P7 original first-hour native GETCELL and ADVECT
on:
  pull_request:
    paths:
      - 'native_cpp/modules/p7_calpuff/**'
      - '.github/workflows/p7-original-getcell-advect.yml'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: p7-original-getcell-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
jobs:
  first-hour-metfm1:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 22
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
          filter: blob:none
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /native_cpp/modules/p7_calpuff/**
            /project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat
      - name: Require immutable original first-hour DGM and MET forcing
        shell: bash
        run: |
          set -euo pipefail
          dgm=native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/dgm_puffstep_hour202200100.bin
          met=project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat
          test -s "$dgm" && test -s "$met"
          echo 'b51d20d3cd1085902342d5b6d6b2f34c4a84c96d4966b63a2b1231c126087c89  '${dgm} | sha256sum -c -
          echo 'b1823cda92280888d70b00961ab39486036a3086e18637fff21efb4f4b237d30  '${met} | sha256sum -c -
          echo "P7_NATIVE_METFM1_RUNNER=${RUNNER_NAME} HOST=$(hostname)"
      - name: Compile and execute exact original first-hour wind/cell comparison
        shell: bash
        run: |
          set -euo pipefail
          if command -v g++-12 >/dev/null 2>&1; then cpp=$(command -v g++-12);
          elif command -v g++-11 >/dev/null 2>&1; then cpp=$(command -v g++-11);
          else cpp=$(command -v c++); fi
          build="${RUNNER_TEMP}/p7-getcell-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          cmake -S native_cpp/modules/p7_calpuff -B "$build" \
            -DCMAKE_CXX_COMPILER="$cpp" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$build" --parallel 2 --target cteas_p7_original_met_cell_trace
          ctest --test-dir "$build" -N -R '^cteas_p7_original_met_cell_advection_first_hour$' |
            grep -Eq 'Test[[:space:]]*#[0-9]+: cteas_p7_original_met_cell_advection_first_hour' || {
              echo "::error::Original DGM comparison test missing"; exit 1;
            }
          ctest --test-dir "$build" -R '^cteas_p7_original_met_cell_advection_first_hour$' --output-on-failure
          echo "P7_ORIGINAL_FIRST_HOUR_CELL_ADVECT=PASS"
