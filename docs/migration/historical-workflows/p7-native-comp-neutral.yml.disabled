name: P7 native COMP neutral continuity 1h 6h 143h
on:
  pull_request:
    paths:
      - 'native_cpp/modules/p7_calpuff/**'
      - '.github/workflows/p7-native-comp-neutral.yml'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: p7-native-comp-neutral-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
jobs:
  original-neutral-point-comp:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
          filter: blob:none
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /native_cpp/modules/p7_calpuff/**
      - name: Native original-ordered point-puff COMP (NO original DGM input)
        shell: bash
        run: |
          set -euo pipefail
          if command -v g++-12 >/dev/null 2>&1; then cpp=$(command -v g++-12);
          elif command -v g++-11 >/dev/null 2>&1; then cpp=$(command -v g++-11);
          else cpp=$(command -v c++); fi
          build="${RUNNER_TEMP}/p7-comp-neutral-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          cmake -S native_cpp/modules/p7_calpuff -B "$build" \
            -DCMAKE_CXX_COMPILER="$cpp" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$build" --parallel 2 --target cteas_p7_original_comp_neutral_tests
          ctest --test-dir "$build" -R '^cteas_p7_native_comp_neutral_((1|6|143)h|pg_(1|6|143)h)_persistent$' --output-on-failure
          echo 'P7_NATIVE_143H_NEUTRAL_COMP=PASS NO_DGM_SOLVER_INPUT=TRUE'
          echo 'P7_NATIVE_MD3_PG_SIGTY_SIGTZ=PASS SOURCE_PORTED'
          echo 'P7_FROZEN_HEFEI_WHOLE_CASE=NOT_YET_ACCEPTED'
