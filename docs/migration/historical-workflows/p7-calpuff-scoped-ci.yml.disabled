name: P7A P7B isolated CALPUFF source and control contracts
on:
  pull_request:
    paths:
      - 'native_cpp/modules/p7_calpuff/**'
      - '.github/workflows/p7-calpuff-scoped-ci.yml'
      - 'docs/reconstruction_cpp/P7_*'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: p7-scoped-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
jobs:
  # P7 QA and full original-source validation use separate GitHub-hosted Ubuntu VMs.
  p7-coordinate-qa:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 12
    steps:
      - name: Sparse checkout immutable P7 and original 2022 QA artifacts
        uses: actions/checkout@v4
        with:
          persist-credentials: false
          filter: blob:none
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /native_cpp/modules/p7_calpuff/**
            /project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp
            /project/cases/hefei5km_2022_reference_case_20261011/run/puff/qapnts.dat
            /project/cases/hefei5km_2022_reference_case_20261011/run/puff/qarecg.dat
            /project/cases/hefei5km_2022_reference_case_20261011/grid/grid.cmn
            /project/cases/hefei5km_2022_reference_case_20261011/grid/center_location
            /engine/preprocess/grid/center_location_to_utm.py
      - name: Require original vendor QA inputs (no skip)
        shell: bash
        run: |
          set -euo pipefail
          for name in puff.inp qapnts.dat qarecg.dat; do
            test -s "project/cases/hefei5km_2022_reference_case_20261011/run/puff/$name" || {
              echo "::error::Missing P7 original 2022 QA input: $name"
              exit 1
            }
          done
          for name in grid.cmn center_location; do
            test -s "project/cases/hefei5km_2022_reference_case_20261011/grid/$name" || {
              echo "::error::Missing original preprocessing grid input: $name"
              exit 1
            }
          done
          test -s "engine/preprocess/grid/center_location_to_utm.py"
          echo "P7_FAST_QA_RUNNER=${RUNNER_NAME}"
      - name: Compile and execute original REAL4 point and 2500 receptor QA parity
        shell: bash
        run: |
          set -euo pipefail
          if command -v g++-12 >/dev/null 2>&1; then
            compiler="$(command -v g++-12)"
          elif command -v g++-11 >/dev/null 2>&1; then
            compiler="$(command -v g++-11)"
          else
            compiler="$(command -v c++)"
          fi
          build="${RUNNER_TEMP}/p7-qa-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          cmake -S native_cpp/modules/p7_calpuff -B "$build" \
            -DCMAKE_CXX_COMPILER="$compiler" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$build" --target cteas_p7_original_grid_qa_tests --parallel 2
          ctest --test-dir "$build" -R '^cteas_p7_original_2022_qa_real4_coordinates$' --output-on-failure
          "$build/cteas_p7_original_grid_qa_tests" \
            project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp \
            project/cases/hefei5km_2022_reference_case_20261011/run/puff/qapnts.dat \
            project/cases/hefei5km_2022_reference_case_20261011/run/puff/qarecg.dat
          ctest --test-dir "$build" -N -R '^cteas_p7_original_grid_preprocess_contract$' |
            grep -Eq 'Test[[:space:]]*#[0-9]+: cteas_p7_original_grid_preprocess_contract'
          ctest --test-dir "$build" -R '^cteas_p7_original_grid_preprocess_contract$' --output-on-failure
          echo "P7_GRID_AUTHORING_TO_RUNTIME=PASS"
          echo "P7_FAST_QA_FLOAT32_ORIGINAL=PASS"

  p7-scoped:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 25
    steps:
      - name: Verify GitHub-hosted runner and toolchain
        shell: bash
        run: |
          set -euo pipefail
          test "${RUNNER_ENVIRONMENT:-}" = "github-hosted" || {
            echo "::error::P7 must use GitHub-hosted Actions, not a self-hosted runner."
            exit 1
          }
          for tool in git cmake c++ python3; do command -v "$tool"; done
          c++ --version | head -n 1
          cmake --version | head -n 1
          echo "P7_RUNNER_ENVIRONMENT=github-hosted"
      - name: Verify source transports on hosted runner
        id: transport
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          github=no
          api=no
          for try in 1 2; do
            if curl -fsSI --connect-timeout 6 --max-time 12 https://github.com/ >/dev/null; then
              github=yes
              break
            fi
          done
          for try in 1 2; do
            if curl -fsSI --connect-timeout 6 --max-time 12 \
                 -H "Authorization: Bearer $GH_TOKEN" \
                 -H "Accept: application/vnd.github+json" \
                 "https://api.github.com/repos/$GITHUB_REPOSITORY" >/dev/null; then
              api=yes
              break
            fi
          done
          echo "github=$github" >> "$GITHUB_OUTPUT"
          echo "api=$api" >> "$GITHUB_OUTPUT"
          echo "P7_SOURCE_TRANSPORT github.com=$github api.github.com=$api"
          if [ "$github" = no ] && [ "$api" = no ]; then
            echo "::error::Both Git and authenticated REST source transports unavailable; P7 physics NOT tested."
            exit 1
          fi
      - name: Checkout immutable PR source when git transport works
        id: checkout
        if: steps.transport.outputs.github == 'yes'
        continue-on-error: true
        uses: actions/checkout@v4
        with:
          persist-credentials: false
          filter: blob:none
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /native_cpp/modules/p7_calpuff/**
            /engine/vendor/src/CALPUFF_v7.2.1_L150618/**
            /project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp
            /project/cases/hefei5km_2022_reference_case_20261011/run/puff/qapnts.dat
            /project/cases/hefei5km_2022_reference_case_20261011/run/puff/qarecg.dat
            /project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat
            /project/cases/hefei5km_2022_reference_case_20261011/grid/grid.cmn
            /project/cases/hefei5km_2022_reference_case_20261011/grid/center_location
            /engine/preprocess/grid/center_location_to_utm.py
      - name: Bootstrap exact commit P7 source from authenticated GitHub REST
        if: (steps.transport.outputs.github != 'yes' || steps.checkout.outcome == 'failure') && steps.transport.outputs.api == 'yes'
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          python3 - <<'PY'
          import base64, concurrent.futures, hashlib, json, os, shutil
          from pathlib import Path
          from urllib.request import Request, urlopen
          repo = os.environ["GITHUB_REPOSITORY"]
          sha = os.environ["GITHUB_SHA"]
          token = os.environ["GH_TOKEN"]
          prefix = "native_cpp/modules/p7_calpuff/"
          vendor = "engine/vendor/src/CALPUFF_v7.2.1_L150618/"
          frozen_deck = "project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp"
          qa_points = "project/cases/hefei5km_2022_reference_case_20261011/run/puff/qapnts.dat"
          qa_receptors = "project/cases/hefei5km_2022_reference_case_20261011/run/puff/qarecg.dat"
          grid_cmn = "project/cases/hefei5km_2022_reference_case_20261011/grid/grid.cmn"
          grid_center = "project/cases/hefei5km_2022_reference_case_20261011/grid/center_location"
          grid_converter = "engine/preprocess/grid/center_location_to_utm.py"
          url_base = "https://api.github.com/repos/" + repo
          root = Path(os.environ["GITHUB_WORKSPACE"]).resolve()
          def get(path):
              req = Request(url_base + path, headers={
                  "Authorization": "Bearer " + token,
                  "Accept": "application/vnd.github+json",
                  "User-Agent": "CTEAS-P7-exact-GitHub-rest",
                  "X-GitHub-Api-Version": "2022-11-28",
              })
              with urlopen(req, timeout=30) as r:
                  return json.load(r)
          commit = get("/git/commits/" + sha)
          tree = get("/git/trees/" + commit["tree"]["sha"] + "?recursive=1")
          if tree.get("truncated"):
              raise RuntimeError("Incomplete Git tree: refusing source bootstrap")
          selected = [item for item in tree["tree"]
                      if item["type"] == "blob" and
                      (item["path"].startswith(prefix) or item["path"].startswith(vendor)
                        or item["path"] in (frozen_deck, qa_points, qa_receptors,
                                         grid_cmn, grid_center, grid_converter))]
          if len(selected) < 80:
              raise RuntimeError("P7 source tree unexpectedly incomplete: " + str(len(selected)))
          # Do not trust existing artifacts from a previous job/commit.
          for target in (root / prefix, root / vendor):
              if target.exists():
                  shutil.rmtree(target)
          def fetch_one(item):
              rel = Path(item["path"])
              if rel.is_absolute() or ".." in rel.parts:
                  raise RuntimeError("Unsafe source path")
              blob = get("/git/blobs/" + item["sha"])
              if blob.get("encoding") != "base64":
                  raise RuntimeError("Unrecognized blob encoding")
              raw = base64.b64decode(blob["content"], validate=False)
              got = hashlib.sha1(b"blob " + str(len(raw)).encode() + b"\0" + raw).hexdigest()
              if got != item["sha"]:
                  raise RuntimeError("Git source SHA mismatch: " + item["path"])
              out = (root / rel).resolve()
              if not out.is_relative_to(root):
                  raise RuntimeError("Source path escaped workspace")
              out.parent.mkdir(parents=True, exist_ok=True)
              out.write_bytes(raw)
              return item["path"]
          with concurrent.futures.ThreadPoolExecutor(max_workers=5) as pool:
              names = list(pool.map(fetch_one, selected))
          for must in (prefix+"CMakeLists.txt", prefix+"reference/source_audit.py",
                       vendor+"calpuff.for", vendor+"modules.for", vendor+"calpuff.inp",
                       frozen_deck, qa_points, qa_receptors,
                       grid_cmn, grid_center, grid_converter):
              if must not in names:
                  raise RuntimeError("Required original/P7 source missing: " + must)
          print("P7_SOURCE_BOOTSTRAP=PASS GIT_TREE_SHA=" + sha +
                " VERIFIED_BLOBS=" + str(len(names)))
          PY
      - name: Verify full P7 checkout before scientific tests
        shell: bash
        run: |
          set -euo pipefail
          for needed in native_cpp/modules/p7_calpuff/CMakeLists.txt \
                        native_cpp/modules/p7_calpuff/reference/source_audit.py \
                        native_cpp/modules/p7_calpuff/reference/run_original_calpuff_reference.py \
                        engine/vendor/src/CALPUFF_v7.2.1_L150618/calpuff.for \
                        engine/vendor/src/CALPUFF_v7.2.1_L150618/modules.for \
                        engine/vendor/src/CALPUFF_v7.2.1_L150618/calpuff.inp \
                        project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp \
                        project/cases/hefei5km_2022_reference_case_20261011/run/puff/qapnts.dat \
                        project/cases/hefei5km_2022_reference_case_20261011/run/puff/qarecg.dat \
                        project/cases/hefei5km_2022_reference_case_20261011/grid/grid.cmn \
                        project/cases/hefei5km_2022_reference_case_20261011/grid/center_location \
                        engine/preprocess/grid/center_location_to_utm.py; do
            test -s "$GITHUB_WORKSPACE/$needed" || {
              echo "::error::Missing mandatory P7 original or native source: $needed"
              exit 1
            }
          done
      - name: Assert immutable source identity and option inventory
        shell: bash
        run: |
          set -euo pipefail
          report="${RUNNER_TEMP}/p7-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}/source-audit.json"
          python3 native_cpp/modules/p7_calpuff/reference/source_audit.py --report "$report"
          test -s "$report"
      - name: Build isolated C++20 P7B control reader and CTest
        shell: bash
        run: |
          set -euo pipefail
          build="${RUNNER_TEMP}/p7-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}/build"
          if command -v g++-12 >/dev/null 2>&1; then
            compiler="$(command -v g++-12)"
          elif command -v g++-11 >/dev/null 2>&1; then
            compiler="$(command -v g++-11)"
          else
            compiler="$(command -v c++)"
          fi
          "$compiler" --version | head -n 1
          cmake -S native_cpp/modules/p7_calpuff -B "$build" \
            -DCMAKE_CXX_COMPILER="$compiler" \
            -DCMAKE_BUILD_TYPE=Debug \
            -DP7_ORIGINAL_CONTROL="${GITHUB_WORKSPACE}/engine/vendor/src/CALPUFF_v7.2.1_L150618/calpuff.inp"
          cmake --build "$build" --parallel 2
          ctest --test-dir "$build" --output-on-failure
          ctest --test-dir "$build" -N -R '^cteas_p7c_locked_original_point_input$' |
            grep -Eq 'Test[[:space:]]*#[0-9]+: cteas_p7c_locked_original_point_input'
          ctest --test-dir "$build" -R '^cteas_p7c_locked_original_point_input$' --output-on-failure
          ctest --test-dir "$build" -N -R '^cteas_p7_original_2022_qa_real4_coordinates$' |
            grep -Eq 'Test[[:space:]]*#[0-9]+: cteas_p7_original_2022_qa_real4_coordinates'
          ctest --test-dir "$build" -R '^cteas_p7_original_2022_qa_real4_coordinates$' --output-on-failure
          ctest --test-dir "$build" -N -R '^cteas_p7_original_grid_preprocess_contract$' |
            grep -Eq 'Test[[:space:]]*#[0-9]+: cteas_p7_original_grid_preprocess_contract'
          ctest --test-dir "$build" -R '^cteas_p7_original_grid_preprocess_contract$' --output-on-failure
          if [ -s "project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat" ]; then
            ctest --test-dir "$build" -N -R '^cteas_p7_original_2022_met_header_grid_qa$' |
              grep -Eq 'Test[[:space:]]*#[0-9]+: cteas_p7_original_2022_met_header_grid_qa'
            ctest --test-dir "$build" -R '^cteas_p7_original_2022_met_header_grid_qa$' --output-on-failure
            ctest --test-dir "$build" -N -R '^cteas_p7_original_2022_native_met_hourly_bytes$' |
              grep -Eq 'Test[[:space:]]*#[0-9]+: cteas_p7_original_2022_native_met_hourly_bytes' || {
                echo "::error::Mandatory original 143h native MET byte oracle absent"
                exit 1
              }
            ctest --test-dir "$build" -R '^cteas_p7_original_2022_native_met_hourly_bytes$' --output-on-failure
            echo "P7_ORIGINAL_MET_143H_TYPED_REAL4_BYTES=PASS"
            echo "P7_ORIGINAL_MET_BINARY_GRID_2500_QA=PASS"
          else
            echo "::error::Original frozen 2022 MET.DAT absent; P7 real binary grid QA NOT_ACCEPTED"
            exit 1
          fi
          echo "P7_MODE_A_GRID_AUTHORING_PROVENANCE=PASS"
          echo "P7_MODE_A_ORIGINAL_QA_2500_RECEPTORS=PASS"
          echo "P7_MODE_A_LOCKED_SOURCE_INPUT=PASS"
          echo "P7B_CONTROL_PARSER_CTEST=PASS"
      - name: Compile unchanged original CALPUFF reference (P7A; no physics-pass claim)
        shell: bash
        run: |
          set -euo pipefail
          echo "P7A_GFORTRAN_CANDIDATES_BEGIN"
          for candidate in gfortran-12 gfortran-11 gfortran; do
            if command -v "$candidate" >/dev/null 2>&1; then
              printf '%s: %s; ' "$candidate" "$(command -v "$candidate")"
              "$candidate" --version | head -n 1
            fi
          done
          echo "P7A_GFORTRAN_CANDIDATES_END"
          if command -v gfortran-12 >/dev/null 2>&1; then
            fc="$(command -v gfortran-12)"
          elif command -v gfortran-11 >/dev/null 2>&1; then
            fc="$(command -v gfortran-11)"
          elif command -v gfortran >/dev/null 2>&1; then
            fc="$(command -v gfortran)"
            major="$("$fc" -dumpversion | cut -d. -f1)"
            if ! [[ "$major" =~ ^[0-9]+$ ]] || (( major < 10 )); then
              echo "::error::Default gfortran is too old for -fallow-argument-mismatch; require gfortran 10+ (prefer gfortran-12/11)."
              exit 1
            fi
          else
            echo "::error::gfortran not installed on dedicated P7 runner."
            exit 1
          fi
          echo "P7A_FORTRAN_COMPILER=$fc"
          "$fc" --version | head -n 1
          python3 native_cpp/modules/p7_calpuff/reference/build_original_calpuff.py \
            --output "${RUNNER_TEMP}/p7-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}/original-fortran" \
            --compiler "$fc"
          python3 native_cpp/modules/p7_calpuff/reference/audit_original_precision.py \
            --compiler "$fc" \
            --report "${RUNNER_TEMP}/p7-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}/original-fortran/precision-audit.json"
          echo "P7_VENDOR_DEFAULT_REAL4_EXPLICIT_REAL8=PASS"
      - name: Get immutable historical 2023 MET.DAT / puff.inp / puff.con
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          python3 native_cpp/modules/p7_calpuff/reference/fetch_legacy_2023_case.py --root "$GITHUB_WORKSPACE"
      - name: Verify real original 2023 CALPUFF and P7B binary reader (NOT 2022)
        shell: bash
        run: |
          set -euo pipefail
          scratch="${RUNNER_TEMP}/p7-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          python3 native_cpp/modules/p7_calpuff/reference/legacy_2023_case.py \
            --repo "$GITHUB_WORKSPACE" \
            --original-binary "$scratch/original-fortran/calpuff-original.x" \
            --native-inspector "$scratch/build/cteas_p7_calmet21_inspect" \
            --output "$scratch/historical-2023" --timeout 600
      - name: P7C diagnose exact original 2023 MET.DAT timeline
        shell: bash
        run: |
          set -euo pipefail
          scratch="${RUNNER_TEMP}/p7-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          "$scratch/build/cteas_p7_calmet21_inspect" \
            project/cases/smoke5d_coldstart_20260701/run/met/met.dat
      - name: P7C real 2023 CALMET hourly prescribed-wind / conservation smoke
        shell: bash
        run: |
          set -euo pipefail
          scratch="${RUNNER_TEMP}/p7-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          "$scratch/build/cteas_p7c_met_replay" \
            project/cases/smoke5d_coldstart_20260701/run/puff/puff.inp \
            project/cases/smoke5d_coldstart_20260701/run/met/met.dat \
            --historical-2023
      - name: P7 2022 ledger refuses the real historical 2023 case (fail closed)
        shell: bash
        run: |
          set -euo pipefail
          scratch="${RUNNER_TEMP}/p7-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          python3 native_cpp/modules/p7_calpuff/tests/case_ledger_real_2023_tests.py \
            --binary "$scratch/build/cteas_p7_2022_case_ledger" \
            --report "$scratch/historical-2023/2022-ledger-refusal.json" --require
      - name: P7D MDISP=3 dispersion vendor source and Fortran parity (required)
        shell: bash
        run: |
          set -euo pipefail
          scratch="${RUNNER_TEMP}/p7-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          python3 native_cpp/modules/p7_calpuff/tests/sigma_fortran_parity_tests.py \
            --probe "$scratch/build/cteas_p7d_sigma_probe" \
            --repo-root "$GITHUB_WORKSPACE" --require
      - name: P7F MDRY=1 dry deposition vendor source and Fortran parity (required)
        shell: bash
        run: |
          set -euo pipefail
          scratch="${RUNNER_TEMP}/p7-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          python3 native_cpp/modules/p7_calpuff/tests/drydep_parity_tests.py \
            --probe "$scratch/build/cteas_p7f_drydep_probe" \
            --repo-root "$GITHUB_WORKSPACE" --require
      - name: P7E receptor geometry, sampling and CONC.DAT source parity (required)
        shell: bash
        run: |
          set -euo pipefail
          scratch="${RUNNER_TEMP}/p7-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          python3 native_cpp/modules/p7_calpuff/tests/p7e_parity_tests.py \
            --probe "$scratch/build/cteas_p7e_probe" \
            --repo-root "$GITHUB_WORKSPACE" --require
      - name: P7G CALMET static fields (Z0/ILANDU/ELEV/XLAI) decoded from the locked case
        shell: bash
        run: |
          set -euo pipefail
          scratch="${RUNNER_TEMP}/p7-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          met=project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat
          if [ ! -f "$met" ]; then
            echo "P7G_LOCKED_CASE_STATICS=SKIPPED_NOT_IN_SPARSE_CHECKOUT"
            exit 0
          fi
          "$scratch/build/cteas_p7_calmet21_tests" --met "$met"
      - name: P7G real-cell dry deposition velocity on locked case inputs
        shell: bash
        run: |
          set -euo pipefail
          scratch="${RUNNER_TEMP}/p7-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          case_dir=project/cases/hefei5km_2022_reference_case_20261011/run
          if [ ! -f "$case_dir/met/met.dat" ]; then
            echo "P7G_REAL_CELL_VD=SKIPPED_NOT_IN_SPARSE_CHECKOUT"
            exit 0
          fi
          "$scratch/build/cteas_p7f_drydep_probe" --real-cell \
            "$case_dir/met/met.dat" "$case_dir/puff/puff.inp" 25 25 0
      - name: P7H vertical coupling (VCBar/VCOUP/CTADJ) source parity (required)
        shell: bash
        run: |
          set -euo pipefail
          scratch="${RUNNER_TEMP}/p7-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          python3 native_cpp/modules/p7_calpuff/tests/p7h_parity_tests.py \
            --probe "$scratch/build/cteas_p7e_probe" \
            --repo-root "$GITHUB_WORKSPACE" --require
      - name: P7K CTSG kernel unit location (call-site anchor)
        shell: bash
        run: |
          set -euo pipefail
          python3 native_cpp/modules/p7_calpuff/reference/p7k_source_anchor.py \
            --check native_cpp/modules/p7_calpuff/reference/p7k_source_anchor.json
      - name: P7I CTSG support blocks (QATR/TFAC) source parity (required)
        shell: bash
        run: |
          set -euo pipefail
          scratch="${RUNNER_TEMP}/p7-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          python3 native_cpp/modules/p7_calpuff/tests/p7i_parity_tests.py \
            --probe "$scratch/build/cteas_p7i_tests" \
            --repo-root "$GITHUB_WORKSPACE" --require
      - name: P7H real receptor-grid coupling run (physical chain only)
        shell: bash
        run: |
          set -euo pipefail
          scratch="${RUNNER_TEMP}/p7-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          case_dir=project/cases/hefei5km_2022_reference_case_20261011/run
          if [ ! -f "$case_dir/met/met.dat" ]; then
            echo "P7H_REAL_GRID_RUN=SKIPPED_NOT_IN_SPARSE_CHECKOUT"
            exit 0
          fi
          "$scratch/build/cteas_p7e_probe" --real-grid \
            "$case_dir/met/met.dat" "$case_dir/puff/puff.inp" 0 2.63e13 \
            513.3846439571 3533.7689269678 70.8
      - name: P7E locked case receptors and frozen CONC.DAT structure
        shell: bash
        run: |
          set -euo pipefail
          scratch="${RUNNER_TEMP}/p7-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          control=project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp
          conc=project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.con
          if [ ! -f "$control" ]; then
            echo "P7E_LOCKED_CASE=SKIPPED_NOT_IN_SPARSE_CHECKOUT"
            exit 0
          fi
          "$scratch/build/cteas_p7e_probe" --receptors "$control"
          if [ -f "$conc" ]; then
            "$scratch/build/cteas_p7e_probe" --structure "$conc"
          fi
      - name: P7F locked Hefei 2022 deck dry deposition audit
        shell: bash
        run: |
          set -euo pipefail
          scratch="${RUNNER_TEMP}/p7-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          control=project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp
          if [ ! -f "$control" ]; then
            echo "P7F_LOCKED_CASE_AUDIT=SKIPPED_NOT_IN_SPARSE_CHECKOUT"
            exit 0
          fi
          "$scratch/build/cteas_p7f_drydep_probe" --audit "$control"
      - name: P7D real deck dispersion option audit (MDISP=3 is the real-case path)
        shell: bash
        run: |
          set -euo pipefail
          scratch="${RUNNER_TEMP}/p7-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          "$scratch/build/cteas_p7d_sigma_probe" --audit \
            project/cases/smoke5d_coldstart_20260701/run/puff/puff.inp
      - name: Selected 2022 real MET.DAT I/O parity (opt-in immutable input)
        shell: bash
        env:
          P7_FROZEN_MET_DAT: ${{ vars.P7_FROZEN_2022_MET_DAT }}
        run: |
          set -euo pipefail
          if [ -z "${P7_FROZEN_MET_DAT:-}" ]; then
            echo "P7B_REAL_MET21_REFERENCE=BLOCKED_NO_FROZEN_2022_INPUT"
            exit 0
          fi
          test -s "$P7_FROZEN_MET_DAT"
          build="${RUNNER_TEMP}/p7-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}/build"
          python3 native_cpp/modules/p7_calpuff/reference/compare_frozen_met21.py \
            --met "$P7_FROZEN_MET_DAT" \
            --native-bin "$build/cteas_p7_calmet21_inspect" \
            --report "${RUNNER_TEMP}/p7-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}/met21-reference.json"
      - name: P7 2022 frozen case execution ledger (opt-in immutable inputs)
        shell: bash
        env:
          P7_FROZEN_MET_DAT: ${{ vars.P7_FROZEN_2022_MET_DAT }}
          P7_FROZEN_PUFF_INP: ${{ vars.P7_FROZEN_2022_PUFF_INP }}
          P7_FROZEN_MET_SHA256: ${{ vars.P7_FROZEN_2022_MET_SHA256 }}
          P7_FROZEN_PUFF_SHA256: ${{ vars.P7_FROZEN_2022_PUFF_SHA256 }}
        run: |
          set -euo pipefail
          scratch="${RUNNER_TEMP}/p7-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          if [ -z "${P7_FROZEN_MET_DAT:-}" ] && [ -z "${P7_FROZEN_PUFF_INP:-}" ] && \
             [ -z "${P7_FROZEN_MET_SHA256:-}" ] && [ -z "${P7_FROZEN_PUFF_SHA256:-}" ]; then
            echo "P7_2022_EXECUTION_LEDGER=BLOCKED_NO_FROZEN_2022_CASE"
            exit 0
          fi
          for item in "$P7_FROZEN_MET_DAT" "$P7_FROZEN_PUFF_INP"; do test -s "$item"; done
          for sha in "$P7_FROZEN_MET_SHA256" "$P7_FROZEN_PUFF_SHA256"; do
            [[ "$sha" =~ ^[a-fA-F0-9]{64}$ ]] || {
              echo "::error::P7 2022 ledger requires both pinned input SHA256 values."
              exit 1
            }
          done
          "$scratch/build/cteas_p7_2022_case_ledger" \
            --met "$P7_FROZEN_MET_DAT" --control "$P7_FROZEN_PUFF_INP" \
            --expect-met-sha256 "$P7_FROZEN_MET_SHA256" \
            --expect-control-sha256 "$P7_FROZEN_PUFF_SHA256" \
            --report "$scratch/2022-execution-ledger.json"
          echo "P7_2022_EXECUTION_LEDGER_STATUS_ACCEPTED_NOT_A_PHYSICS_PARITY_TEST"
      - name: Original CALPUFF 143-interval reference run (only frozen 2022 inputs)
        shell: bash
        env:
          P7_FROZEN_MET_DAT: ${{ vars.P7_FROZEN_2022_MET_DAT }}
          P7_FROZEN_PUFF_INP: ${{ vars.P7_FROZEN_2022_PUFF_INP }}
          P7_FROZEN_MET_SHA256: ${{ vars.P7_FROZEN_2022_MET_SHA256 }}
          P7_FROZEN_PUFF_SHA256: ${{ vars.P7_FROZEN_2022_PUFF_SHA256 }}
        run: |
          set -euo pipefail
          if [ -z "${P7_FROZEN_MET_DAT:-}" ] && [ -z "${P7_FROZEN_PUFF_INP:-}" ] && \
             [ -z "${P7_FROZEN_MET_SHA256:-}" ] && [ -z "${P7_FROZEN_PUFF_SHA256:-}" ]; then
            echo "P7A_REAL_2022_ORIGINAL_REFERENCE=BLOCKED_NO_FROZEN_2022_CASE"
            exit 0
          fi
          for item in "$P7_FROZEN_MET_DAT" "$P7_FROZEN_PUFF_INP"; do test -s "$item"; done
          for sha in "$P7_FROZEN_MET_SHA256" "$P7_FROZEN_PUFF_SHA256"; do
            [[ "$sha" =~ ^[a-fA-F0-9]{64}$ ]] || { echo "::error::P7 original inputs require pinned SHA256"; exit 1; }
          done
          scratch="${RUNNER_TEMP}/p7-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          python3 native_cpp/modules/p7_calpuff/reference/run_original_calpuff_reference.py \
            --control "$P7_FROZEN_PUFF_INP" --met "$P7_FROZEN_MET_DAT" \
            --original-binary "$scratch/original-fortran/calpuff-original.x" \
            --expected-control-sha256 "$P7_FROZEN_PUFF_SHA256" \
            --expected-met-sha256 "$P7_FROZEN_MET_SHA256" \
            --output "$scratch/original-calpuff-2022" --max-seconds 900 --execute
          echo "P7A_ORIGINAL_2022_REFERENCE_RUN=PASS_NOT_CPP_PHYSICS_PARITY"
      - name: Preserve historical original CALPUFF replay evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: p7-historical-2023-reference
          path: |
            ${{ runner.temp }}/p7-${{ github.run_id }}-${{ github.run_attempt }}/historical-2023/historical-2023-reference.json
            ${{ runner.temp }}/p7-${{ github.run_id }}-${{ github.run_attempt }}/historical-2023/2022-ledger-refusal.json
            ${{ runner.temp }}/p7-${{ github.run_id }}-${{ github.run_attempt }}/historical-2023/original-2023-runtime.log
            ${{ runner.temp }}/p7-${{ github.run_id }}-${{ github.run_attempt }}/historical-2023/case/run/puff/puff.con
          retention-days: 7
          if-no-files-found: warn
