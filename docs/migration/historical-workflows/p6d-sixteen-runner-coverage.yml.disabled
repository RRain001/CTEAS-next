name: P6D GitHub-hosted independent module tests

on:
  push:
    branches: [audit/p6d-source-slope-drivers-143h-20261012]
    paths:
      - '.github/workflows/p6d-sixteen-runner-coverage.yml'
      - 'native_cpp/modules/p6_calmet/include/cteas/p6/wind1_selected_firstguess.hpp'
      - 'native_cpp/modules/p6_calmet/tests/p6_wind1_selected_firstguess_tests.cpp'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: p6d-sixteen-coverage-${{ github.ref }}
  cancel-in-progress: true

jobs:
  sixteen-independent-scopes:
    name: ${{ matrix.lane }} source-scoped C++ -Werror + CTest
    runs-on: ubuntu-22.04
    timeout-minutes: 20
    strategy:
      fail-fast: false
      max-parallel: 9
      matrix:
        include:
          - lane: p6d_wind1
            target: cteas_p6_wind1_firstguess_tests
            test: p6d8b_original_wind1_firstguess_selected_software
            module: p6d
          - lane: p6d_similt
            target: cteas_p6_similt_profile_tests
            test: p6d_original_similt_profile_software
            module: p6d
          - lane: p6d_inter2
            target: cteas_p6_inter2_tests
            test: p6d_original_inter2_selected_software
            module: p6d
          - lane: p6d_fradj
            target: cteas_p6_fradj_tests
            test: p6d_froude_adjust_software
            module: p6d
          - lane: p6d_slope
            target: cteas_p6_slope_tests
            test: p6d_original_slope_software
            module: p6d
          - lane: p6d_smooth
            target: cteas_p6_smooth_tests
            test: p6d_original_smooth_software
            module: p6d
          - lane: p6d_divcel
            target: cteas_p6_divcel_tests
            test: p6d_original_divcel_software
            module: p6d
          - lane: p6d_w_tail
            target: cteas_p6_final_segment_tests
            test: p6d_original_diagno_final_segment_software
            module: p6d
          - lane: p6d_d9a
            target: cteas_p6_d9a_bridge_tests
            test: p6d9a_wind1_inter2_diagno_selected_bridge_contract
            module: p6d
    steps:
      - uses: actions/checkout@v4
        with:
          filter: blob:none
          sparse-checkout: |
            .github/actions/cteas-linux-toolchain
            native_cpp/modules/p6_calmet
      - uses: ./.github/actions/cteas-linux-toolchain
      - name: Distinct source-scoped module compile and independent software regression
        shell: bash
        env:
          LANE: ${{ matrix.lane }}
          TARGET: ${{ matrix.target }}
          TEST: ${{ matrix.test }}
          MODULE: ${{ matrix.module }}
        run: |
          set -euo pipefail
          case "$MODULE" in
            p6d) root=native_cpp/modules/p6_calmet ;;
            p6e) root=native_cpp/modules/p6_calmet/p6e ;;
            *) echo "unknown module $MODULE"; exit 2 ;;
          esac
          build="$RUNNER_TEMP/p6d16-${{ github.run_id }}-$LANE"
          cmake -S "$root" -B "$build" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$build" --target "$TARGET" --parallel 2
          ctest --test-dir "$build" -R "^$TEST$" --no-tests=error --output-on-failure
          printf 'PASS_SOURCE_SCOPED_COMPILE_AND_TEST lane=%s target=%s ctest=%s\n' "$LANE" "$TARGET" "$TEST"
          printf '| %s | %s | PASS |\n' "$LANE" "$TEST" >> "$GITHUB_STEP_SUMMARY"
      - name: Clarify scope
        run: echo 'This checks only a separately selected C++ kernel. It does NOT certify complete CALMET/COMP, independent CALMET.DAT, or 143h U/V/W parity.'