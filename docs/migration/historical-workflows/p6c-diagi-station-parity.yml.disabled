name: P6C CALMET station geometry Fortran source parity
concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true
on:
  pull_request:
    paths:
      - 'native_cpp/modules/p6_calmet/include/cteas/p6/*station*'
      - 'native_cpp/modules/p6_calmet/src/station_geometry_main.cpp'
      - 'native_cpp/modules/p6_calmet/tests/p6_station_geometry_tests.cpp'
      - 'native_cpp/modules/p6_calmet/reference/compare_original_diagi_station.py'
      - 'docs/reconstruction_cpp/CI_FULL_REGRESSION_REQUEST.md'
      - '.github/workflows/p6c-diagi-station-parity.yml'
  workflow_dispatch:
permissions:
  contents: read
jobs:
  original-diagi-station-source-parity:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
      - name: Provision GitHub-hosted GCC12 and Fortran12
        shell: bash
        run: |
          set -euo pipefail
          sudo apt-get update -qq
          sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq g++-12 gfortran-12
      - name: Select isolated C++20 and Fortran compilers
        uses: ./.github/actions/cteas-linux-toolchain
      - name: Compile dependencies
        run: |
          set -euo pipefail
          gfortran --version | head -1
      - name: Build all isolated P6 C++20 tests with Werror
        run: |
          set -euo pipefail
          cmake -S native_cpp/modules/p6_calmet -B /tmp/p6c-diagi-build -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_FLAGS=-fno-strict-aliasing
          cmake --build /tmp/p6c-diagi-build --parallel 2
          ctest --test-dir /tmp/p6c-diagi-build --output-on-failure
      - name: Compare literal original DIAGI station code with P6C C++20
        run: |
          set -euo pipefail
          python3 -m native_cpp.modules.p6_calmet.reference.compare_original_diagi_station \
            --vendor engine/vendor/src/CALMET_v6.5.0_L150223 \
            --cpp /tmp/p6c-diagi-build/cteas_p6_stations \
            --out /tmp/p6c-station-parity
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: p6c-original-diagi-station-subsection-parity
          path: /tmp/p6c-station-parity/
          retention-days: 7
          if-no-files-found: warn
