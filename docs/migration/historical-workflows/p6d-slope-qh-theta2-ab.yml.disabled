name: P6D SLOPE QH theta2 cancellation A/B (forensic only)
# Negative-control experiment: source-incompatible 21,598 QH exceedances.
# Available on explicit dispatch; not part of the accepted PR scientific gate.
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  qh-theta2-stabilization-ab:
    name: Forensic A/B original QH vs analytic stable theta2 cancellation 143h
    runs-on: ubuntu-22.04
    timeout-minutes: 100
    steps:
      - uses: actions/checkout@v4
        with:
          filter: blob:none
          sparse-checkout: |
            .github/actions/cteas-linux-toolchain
            native_cpp/modules/p6_calmet
            scripts
            engine/vendor/src/CALMET_v6.5.0_L150223
      - uses: ./.github/actions/cteas-linux-toolchain
      # The current checkout's --mode grid restores scientific grid inputs,
      # but the coordinator also validates the frozen CALMET.DAT envelope.
      # Supply it from the immutable accepted Hefei case, never invent it.
      - uses: actions/checkout@v4
        with:
          ref: 3b94cdbfbb5f44146ba51a4ef112114f199d28b9
          filter: blob:none
          path: original_locked_case
          sparse-checkout: |
            project/cases/hefei5km_2022_reference_case_20261011
      - name: Restore immutable source case
        run: python3 native_cpp/modules/p6_calmet/reference/restore_frozen_case_from_git.py --mode grid
      - name: Prove unmodified original source and freeze original MET.DAT
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-qh-theta2-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          python3 native_cpp/modules/p6_calmet/reference/original_internal_state_dump.py audit \
            --vendor engine/vendor/src/CALMET_v6.5.0_L150223 \
            --case project/cases/hefei5km_2022_reference_case_20261011 \
            --out "$root/original" --compiler gfortran-11
      - name: Apply CI-only analytic cancellation experiment to stable ELUSTR
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY'
          from pathlib import Path
          p=Path("native_cpp/modules/p6_calmet/p6e/include/cteas/p6e/elustr_stable.hpp")
          s=p.read_text()
          needle="float cu2=std::max(0.f,ws*ws-4.f*u02/cdn);"
          assert s.count(needle)==1,"stable ELUSTR source drift"
          # The theta2=TEMP*CDN*WS^2/(184.428*ZM) branch makes
          # 4*U02/CDN equal WS^2 analytically. The difference is a REAL4
          # cancellation residual; this experiment zeroes it ONLY when
          # theta2 was the selected branch. Not an adopted physics change.
          candidate="float cu2=thetas==theta2 ? 0.f : std::max(0.f,ws*ws-4.f*u02/cdn);"
          p.write_text(s.replace(needle,candidate))
          print("EXPERIMENTAL_ELUSTR_THETA2_CANCELLATION_ZEROED_CI_ONLY")
          PY
      - name: Build previously accepted native physical hourly binaries
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-qh-theta2-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          cmake -S native_cpp/modules/p6_calmet -B "$root/p6d" -DCMAKE_BUILD_TYPE=Release
          cmake --build "$root/p6d" --parallel 2 \
            --target cteas_p6_realcase_wind_field cteas_p6_native_cgamma_grid_143h cteas_p6_native_hourly_driver
          cmake -S native_cpp/modules/p6_calmet/p6e -B "$root/p6e" -DCMAKE_BUILD_TYPE=Release
          cmake --build "$root/p6e" --parallel 2 \
            --target p6e_calmet_dat21 p6e_p6c_hourly_bridge
      - name: Produce fully causal 143 hours with native CGAMMA and previous COMP states
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-qh-theta2-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          "$root/p6d/cteas_p6_native_hourly_driver" \
            --case "$GITHUB_WORKSPACE/original_locked_case/project/cases/hefei5km_2022_reference_case_20261011" \
            --p6d "$root/p6d/cteas_p6_realcase_wind_field" \
            --p6e "$root/p6e/p6e_calmet_dat21" \
            --bridge "$root/p6e/p6e_p6c_hourly_bridge" \
            --cgamma "$root/p6d/cteas_p6_native_cgamma_grid_143h" \
            --work "$root/causal" --hours 143
          test -s "$root/causal/hour_142/diagno/produced_hours.txt"
      - name: Compare actual per-hour post-ELUSTR QH TEMP2D and TERSET with original SLOPE inputs
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-qh-theta2-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          python3 scripts/p6d_trace_and_compare_slope_drivers_143h.py \
            --original-dir "$root/original" \
            --vendor engine/vendor/src/CALMET_v6.5.0_L150223 \
            --case project/cases/hefei5km_2022_reference_case_20261011 \
            --candidate "$root/causal" \
            --compiler gfortran-11 \
            --out "$root/p6d_qh_theta2_driver_143h.json"
      - name: Print unmodified scientific tolerances and A/B trial exceedances
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-qh-theta2-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          python3 - "$root/p6d_qh_theta2_driver_143h.json" <<'PY'
          import json,sys
          r=json.load(open(sys.argv[1]))
          print("EXPERIMENT_CI_ONLY_THETA2",r["scientific_verdict"])
          print("SCIENTIFIC_QH_TEMP2D_AB",
                {k:{"exceedances":r["fields"][k]["exceedances"],
                    "max_abs":r["fields"][k]["max_abs"]}
                 for k in ("QH","TEMP2D")})
          print("NO_PRODUCTION_PHYSICS_OR_TOLERANCE_CHANGE")
          PY
      - name: Forensic source-stage QH bisection HEATFX vs ELUSTR (not acceptance)
        if: always()
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-qh-theta2-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          if test -d "$root/causal" && test -s "$root/original/dgm-audit.json"; then
            python3 scripts/p6d_qh_heatfx_elustr_source_audit.py \
              --original-dir "$root/original" \
              --vendor engine/vendor/src/CALMET_v6.5.0_L150223 \
              --case project/cases/hefei5km_2022_reference_case_20261011 \
              --candidate "$root/causal" --compiler gfortran-11 \
              --out "$root/qh_theta2_heatfx_elustr_143h.json"
          fi
      - name: Archive strict causal SLOPE driver evidence even when mismatched
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: p6d-qh-theta2-original-143h
          path: |
            ${{ runner.temp }}/p6d-qh-theta2-${{ github.run_id }}-${{ github.run_attempt }}/p6d_qh_theta2_driver_143h.json
            ${{ runner.temp }}/p6d-qh-theta2-${{ github.run_id }}-${{ github.run_attempt }}/qh_theta2_heatfx_elustr_143h.json
            ${{ runner.temp }}/p6d-qh-theta2-${{ github.run_id }}-${{ github.run_attempt }}/original/dgm-audit.json
          if-no-files-found: warn
          retention-days: 14

