name: P7 original SETPUF end CTADJ2 SIGTZ source audit
on:
  pull_request:
    paths:
      - '.github/workflows/p7-original-setpuf-end-source.yml'
  workflow_dispatch:
permissions:
  contents: read
jobs:
  source-audit:
    runs-on: ubuntu-22.04
    timeout-minutes: 8
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
          filter: blob:none
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /engine/vendor/src/CALPUFF_v7.2.1_L150618/calpuff.for
      - name: Verify immutable vendor source and print exact physical end-branch arithmetic
        shell: bash
        run: |
          python3 - <<'PY'
          from pathlib import Path
          import hashlib
          p=Path('engine/vendor/src/CALPUFF_v7.2.1_L150618/calpuff.for')
          raw=p.read_bytes()
          assert hashlib.sha256(raw).hexdigest()=='da40372cab1c181158d0ee5faac16f678e876fc14415073c38c8e3bdabfbc568'
          lines=raw.decode('latin-1').splitlines()
          for left,right,label in ((48465,48565,'SETPUF-BEGIN-END'),
                                   (48600,48685,'SETPUF-CTADJ2-END'),
                                   (20542,20845,'CTADJ2-FULL')):
              for i in range(left-1,right):
                  print(f'P7_VENDOR_{label} {i+1:6d} {lines[i]}')
          print('P7_ORIGINAL_SETPUF_END_SOURCE=PASS SHA256=PINNED')
          PY
