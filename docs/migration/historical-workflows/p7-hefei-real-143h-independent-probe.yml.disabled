name: P7 real Hefei 143h source REAL4 and puff.con strict parity
on:
  # Strict real-case science only for relevant P7 code, pinned inputs, or this gate.
  # Docs-only updates never consume a full Fortran 143-hour replay.
  pull_request:
    branches:
      - main
      - codex/cteas-p7-calpuff-20261011
      # C2 PR #69 stacks on accepted C1 PR #68; protect the exact
      # 2022 143h scientific gate while modifying shared P7 physics.
      - codex/p7-c1-c2-native-met-integration-20261015
    paths:
      - 'native_cpp/modules/p7_calpuff/**'
      - 'engine/vendor/src/CALPUFF_v7.2.1_L150618/**'
      - 'project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat'
      - 'project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp'
      - 'project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.con'
      - 'project/cases/hefei5km_2022_reference_case_20261011/geo/makegeo/makegeo.inp'
      - '.github/workflows/p7-hefei-real-143h-independent-probe.yml'
  push:
    branches:
      - main
      - codex/cteas-p7-calpuff-20261011
    paths:
      - 'native_cpp/modules/p7_calpuff/**'
      - 'engine/vendor/src/CALPUFF_v7.2.1_L150618/**'
      - 'project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat'
      - 'project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp'
      - 'project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.con'
      - 'project/cases/hefei5km_2022_reference_case_20261011/geo/makegeo/makegeo.inp'
      - '.github/workflows/p7-hefei-real-143h-independent-probe.yml'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: p7-real-full143-independent-${{ github.head_ref || github.ref_name }}
  cancel-in-progress: true
jobs:
  real-full143-scientific-probe:
    runs-on: ubuntu-22.04
    timeout-minutes: 180
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
          filter: blob:none
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /native_cpp/modules/p7_calpuff/**
            /engine/vendor/src/CALPUFF_v7.2.1_L150618/**
            /project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat
            /project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp
            /project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.con
            /project/cases/hefei5km_2022_reference_case_20261011/geo/makegeo/makegeo.inp
      - name: Verify original 143-hour sources and historical H3 concentration
        shell: bash
        run: |
          set -euo pipefail
          met=project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat
          con=project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.con
          test -s "$met" && test -s "$con"
          echo "b1823cda92280888d70b00961ab39486036a3086e18637fff21efb4f4b237d30  $met" | sha256sum -c -
          echo "0d51bdb68ff1a5798048bc41067107d3ffe10dc6222f25336df856bcbf48ba10  $con" | sha256sum -c -
      - name: Audit pinned vendor MCTADJ2 source statements (read-only)
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY'
          import hashlib
          from pathlib import Path
          p=Path("engine/vendor/src/CALPUFF_v7.2.1_L150618/calpuff.for")
          data=p.read_bytes()
          assert hashlib.sha256(data).hexdigest()=="da40372cab1c181158d0ee5faac16f678e876fc14415073c38c8e3bdabfbc568"
          source=data.decode("latin-1").splitlines()
          print("P7_H9_ORIGINAL_MCTADJ2_SOURCE_SHA256=PASS")
          for n in range(5310,5380):
              print(f"P7_H9_VENDOR_PUFRECS_L{n}: {source[n-1]}")
          PY
      - name: Inspect original H10 stable RLSMET and PRFIN source (read-only)
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY'
          from pathlib import Path
          import hashlib
          path=Path("engine/vendor/src/CALPUFF_v7.2.1_L150618/calpuff.for")
          raw=path.read_bytes()
          assert hashlib.sha256(raw).hexdigest()=="da40372cab1c181158d0ee5faac16f678e876fc14415073c38c8e3bdabfbc568"
          lines=raw.decode("latin-1").splitlines()
          for lo,hi in ((15365,15505),(15550,15617),(18180,18575),
                        (47075,47245),(10450,10530),(10820,10930),
                        (48445,48720)):
              print(f"P7_H10_VENDOR_SOURCE_BEGIN={lo}-{hi}")
              for index in range(lo-1,hi):
                  print(f"P7_H10_VENDOR_L{index+1}: {lines[index]}")
              print(f"P7_H10_VENDOR_SOURCE_END={lo}-{hi}")
          PY
      - name: Generate independent full 143h original Fortran DGM
        shell: bash
        run: |
          set -euo pipefail
          root="${RUNNER_TEMP}/p7-full143-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          mkdir -p "$root/frozen/run/puff" "$root/frozen/deliverables/met"
          cp project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp "$root/frozen/run/puff/puff.inp"
          ln -s "${GITHUB_WORKSPACE}/project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat" "$root/frozen/deliverables/met/met.dat"
          python3 native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/original_calcpf_receiver_oracle.py \
            --vendor engine/vendor/src/CALPUFF_v7.2.1_L150618 \
            --case "$root/frozen" --out "$root/vendor" --compiler /usr/bin/gfortran-11 \
            --hour 9 --receptor-i 42 --receptor-j 11 \
            --trace-h9-setpuf --allow-no-receptor-events
          test -s "$root/vendor/case/run/puff/dgm_puffstep.bin"
          test -s "$root/vendor/original-h9-puff588-setpuf-z.json"
          test -s "$root/vendor/original-h9-puff594-receptor21-1-sigtz.json"
          test -s "$root/vendor/original-h9-puff594-receptor21-1-szfloor.json"
          test -s "$root/vendor/original-h9-puff598-mass.json"
          test -s "$root/vendor/original-h9-puff598-vcbar.json"
          test -s "$root/vendor/original-h9-mctadj2-receptor42-11.json"
          test -s "$root/vendor/original-calcpf-h3-42-11-hour9.json"
          python3 - "$root/vendor/original-calcpf-h3-42-11-hour9.json" <<'PY'
          import json
          import sys
          from pathlib import Path
          audit=json.loads(Path(sys.argv[1]).read_text())
          assert audit["scope"].endswith("source-only")
          assert audit["records"] >= 0
          if audit["records"] == 0:
              assert audit["status"] == "NO_CALCPF_RECEIVER_EVENTS_RECORDED"
              assert audit["numeric_native_parity"] == "NOT_CLAIMED"
              print("P7_ORIGINAL_H9_H3_RECEPTOR42_11=NO_SOURCE_EVENTS_NO_PARITY_CLAIM")
          else:
              assert audit["numeric_native_parity"] == "NOT_CLAIMED"
              print("P7_ORIGINAL_H9_H3_RECEPTOR42_11=SOURCE_EVENTS_RECORDED")
          PY
          echo "P7_H9_ORIGINAL_SETPUF_7_PHASE_SOURCE_ONLY=PASS"
          echo "P7_EXTENDED_ORIGINAL_DGM=PINNED_VENDOR_FULL_143H_ORACLE"
      # An independently validated, fail-closed single 143-hour replay. The original
      # 8/24/48/72-hour gates run in a separate workflow/concurrency group.
      # One uninterrupted native COMP state machine retains all puff history.
      - name: Probe all 143 real hours in one stateful COMP replay
        shell: bash
        run: |
          set -euo pipefail
          root="${RUNNER_TEMP}/p7-full143-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          cmake -S native_cpp/modules/p7_calpuff -B "$root/build" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$root/build" --parallel 2 --target cteas_p7_hefei_sixhour_native_h3_receptors_tests cteas_p7_original_native_terrain_tests
          "$root/build/cteas_p7_original_native_terrain_tests"
          test -s "$root/vendor/case/run/puff/dgm_puffstep.bin"
          set +e
          CTEAS_P7_NATIVE_PUFF_CON="$root/native-full143-puff.con" \
          CTEAS_P7_MAKEGEO_INP=project/cases/hefei5km_2022_reference_case_20261011/geo/makegeo/makegeo.inp \
            CTEAS_P7_PROBE_HOURS=143 "$root/build/cteas_p7_hefei_sixhour_native_h3_receptors_tests" \
            project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat \
            project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp \
            project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.con \
            "$root/vendor/case/run/puff/dgm_puffstep.bin" >"$root/hour143-probe.log" 2>&1
          code=$?
          set -e
          grep -E 'P7_REAL_EXTENDED_PROBE_ENTER_HOUR|P7_HEFEI_6H_FIRST_ORIGINAL_DGM_DIFFERENCE|P7_HEFEI_REAL_EXTENDED_SOURCE_PROBE|P7_HEFEI_REAL_6H_COMPUTATION|P7_HEFEI_6H_NATIVE_ORIGINAL_HOURLY HOUR=(2[45]|4[89]|7[23]|10[0-9]|1[34][0-9])' \
            "$root/hour143-probe.log" | tail -n 100 || true
          # Full H-3 and DGM bits must match; an exploratory green run is
          # never interpreted as numerical acceptance without this line.
          if [ "$code" -eq 0 ] && grep -Fq \
            'P7_HEFEI_REAL_EXTENDED_SOURCE_PROBE=PASS HOURS=143 ORIGINAL_DGM_ROWS=254687 H3_REAL4_WORDS=357500/357500 FIRST_DIFFERENCE=NONE' \
            "$root/hour143-probe.log" && grep -Fq \
            'P7_NATIVE_PUFF_CON_FULL=PASS HOURS=143 RECORDS=3655 BYTES=1896056 BINARY_EXACT=YES' \
            "$root/hour143-probe.log"; then
            # Independent shell-level binary equality and pinned SHA256,
            # separate from native C++ in-process comparison/REAL4 ledger.
            original="project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.con"
            cmp --silent "$root/native-full143-puff.con" "$original"
            echo "0d51bdb68ff1a5798048bc41067107d3ffe10dc6222f25336df856bcbf48ba10  $root/native-full143-puff.con" | sha256sum -c -
            test "$(wc -c < "$root/native-full143-puff.con")" -eq 1896056
            echo "P7_REAL_FULL_143H_WROUT1_SHA256_GATE=PASS RECORDS=3655 BYTES=1896056 SHA256=0d51bdb68ff1a5798048bc41067107d3ffe10dc6222f25336df856bcbf48ba10"
            echo "P7_REAL_FULL_143H_SCIENTIFIC_PROBE=PASS HOURS=143 H3_REAL4=357500/357500 DGM=254687/254687 WROUT1=BINARY_EXACT"
          else
            echo "P7_REAL_FULL_143H_SCIENTIFIC_PROBE=BLOCKED STRICT_SCIENCE_AND_FILE_GATE=YES EXIT_CODE=$code"
            tail -n 60 "$root/hour143-probe.log"
            exit 1
          fi
          # Both independently source-verified 143h physics and complete
          # original Fortran sequential puff.con are fail-closed CI gates.
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: p7-real-full143-source-and-puffcon-parity
          path: |
            ${{ runner.temp }}/p7-full143-${{ github.run_id }}-${{ github.run_attempt }}/hour143-probe.log
            ${{ runner.temp }}/p7-full143-${{ github.run_id }}-${{ github.run_attempt }}/native-full143-puff.con
          retention-days: 7
          if-no-files-found: warn
