name: P5 NOAA ISD-Lite multistation wind-code research
concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true
on:
  pull_request:
    paths:
      - '.github/workflows/p5-isd-lite-multistation-wind-audit.yml'
jobs:
  audit:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 14
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4
      - name: Provision GitHub-hosted GCC12 and Fortran12
        shell: bash
        run: |
          set -euo pipefail
          sudo apt-get update -qq
          sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq g++-12 gfortran-12
      - name: Select isolated C++20 and Fortran compilers
        uses: ./.github/actions/cteas-linux-toolchain
      - name: Download actual NOAA gzip files and audit source wind values
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p evidence/raw
          python3 - <<'PY'
          import collections,concurrent.futures,datetime,gzip,hashlib,json,pathlib,time,urllib.request,urllib.error
          from calendar import isleap
          stations={
              "Hefei Luogang/Xinqiao":"583210-99999",
              "Huoshan":"583140-99999",
              "Los Angeles International":"722950-23174",
              "New York LaGuardia":"725030-14732",
              "Wakkanai Japan":"474010-99999",
          }
          years=[2021,2022,2023,2024]
          root=pathlib.Path('evidence')
          labels=[
              "valid_positive_pair","speed_only_positive","direction_only_positive",
              "both_missing","calm_zero_zero","positive_speed_zero_direction",
              "zero_speed_positive_direction","zero_speed_missing_direction",
              "zero_direction_missing_speed","speed_missing_direction360",
              "other"
          ]
          def decode(url):
              request=urllib.request.Request(url,headers={'User-Agent':'CTEAS-scientific-source-audit/1.0'})
              with urllib.request.urlopen(request,timeout=40) as resp:
                  binary=resp.read()
              if not binary.startswith(b'\x1f\x8b'): raise ValueError('not gzip data')
              raw=gzip.decompress(binary).decode('ascii')
              return binary,raw
          def analyze_one(req):
              name,station,year=req
              url=f'https://www.ncei.noaa.gov/pub/data/noaa/isd-lite/{year}/{station}-{year}.gz'
              err=None
              for attempt in range(3):
                  try:
                      binary,raw=decode(url)
                      break
                  except Exception as e:
                      err=str(e);time.sleep(0.4*(attempt+1))
              else:
                  return {'station':station,'station_name':name,'year':year,'status':'FAILED','url':url,'error':err}
              filename=root/'raw'/f'{station}-{year}.gz'
              filename.write_bytes(binary)
              totals=collections.Counter()
              examples={}
              seen_direction=False
              seen_speed=False
              seen_noncalm_direction=False
              rows=[]
              for lineno,line in enumerate(raw.splitlines(),start=1):
                  fields=line.split()
                  if len(fields)!=12: raise ValueError(f'{station}-{year}:{lineno} unexpected {len(fields)} fields')
                  yy,mm,dd,hh=map(int,fields[:4])
                  moment=datetime.datetime(yy,mm,dd,hh)
                  if yy!=year: raise ValueError(f'year mismatch {moment}')
                  direction=int(fields[7]); speed=int(fields[8])
                  if direction!=-9999 and not 0<=direction<=360: raise ValueError('unexpected wind direction '+str(direction))
                  if speed!=-9999 and not 0<=speed<=9000: raise ValueError('unexpected wind speed '+str(speed))
                  if direction in range(1,361) and speed>0:
                      label='valid_positive_pair'
                  elif direction==-9999 and speed>0:
                      label='speed_only_positive'
                  elif direction in range(1,361) and speed==-9999:
                      label='direction_only_positive'
                  elif direction==-9999 and speed==-9999:
                      label='both_missing'
                  elif direction==0 and speed==0:
                      label='calm_zero_zero'
                  elif direction==0 and speed>0:
                      label='positive_speed_zero_direction'
                  elif direction in range(1,361) and speed==0:
                      label='zero_speed_positive_direction'
                  elif direction==-9999 and speed==0:
                      label='zero_speed_missing_direction'
                  elif direction==0 and speed==-9999:
                      label='zero_direction_missing_speed'
                  else:
                      label='other'
                  totals[label]+=1
                  if len(examples.get(label,[]))<3:
                      examples.setdefault(label,[]).append({'datetime_utc':moment.isoformat()+'Z','raw_line':line,'wd_code':direction,'ws_code_tenths':speed})
                  if label=='speed_only_positive' and not seen_noncalm_direction:
                      totals['speed_only_no_prior_noncalm_direction_in_year']+=1
                      if len(examples.get('speed_only_no_prior_noncalm_direction_in_year',[]))<3:
                          examples.setdefault('speed_only_no_prior_noncalm_direction_in_year',[]).append({'datetime_utc':moment.isoformat()+'Z','raw_line':line})
                  if label in ('direction_only_positive','zero_direction_missing_speed') and not seen_speed:
                      totals['direction_only_no_prior_valid_speed_in_year']+=1
                  if direction in range(1,361) and speed>0: seen_noncalm_direction=True
                  if speed>=0: seen_speed=True
                  rows.append((moment,direction,speed))
              if len({r[0] for r in rows})!=len(rows):raise ValueError('duplicate hours')
              return {'station':station,'station_name':name,'year':year,'status':'PASS',
                      'url':url,'gzip_bytes':len(binary),'sha256':hashlib.sha256(binary).hexdigest(),
                      'hours':len(rows),'expected_hours':8784 if isleap(year) else 8760,
                      'count':dict(totals),'examples':examples,
                      'min_wd':min((r[1] for r in rows if r[1]!=-9999),default=None),
                      'max_wd':max((r[1] for r in rows if r[1]!=-9999),default=None),
                      'min_ws':min((r[2] for r in rows if r[2]!=-9999),default=None),
                      'max_ws':max((r[2] for r in rows if r[2]!=-9999),default=None)}
          tasks=[(name,st,yr) for name,st in stations.items() for yr in years]
          with concurrent.futures.ThreadPoolExecutor(max_workers=5) as pool:
              results=list(pool.map(analyze_one,tasks))
          overall=collections.Counter()
          for result in results:
              if result['status']=='PASS':overall.update(result['count'])
              print('ISD_LITE_AUDIT_CASE',json.dumps({
                  k:result.get(k) for k in ('station_name','station','year','status','hours','count','error')},
                  ensure_ascii=False),flush=True)
          manifest={'date':'2026-10-11','source':'NOAA original gz ISD-Lite',
                    'type':'count raw record codes, BEFORE any fill or interpolation',
                    'tests':len(results),'successes':sum(x['status']=='PASS' for x in results),
                    'fails':sum(x['status']!='PASS' for x in results),
                    'overall':dict(overall),'results':results}
          (root/'multistation_wind_code_results.json').write_text(json.dumps(manifest,indent=2,ensure_ascii=False)+'\n')
          with (root/'multistation_wind_code_summary.csv').open('w') as f:
              cols=['station_name','station','year','status','hours','expected_hours']+labels+[
                  'speed_only_no_prior_noncalm_direction_in_year','direction_only_no_prior_valid_speed_in_year']
              import csv
              writer=csv.DictWriter(f,fieldnames=cols)
              writer.writeheader()
              for row in results:
                  writer.writerow({k:row.get('count',{}).get(k,0) if k in labels or k.endswith('_in_year') else row.get(k,'') for k in cols})
          print('ISD_LITE_AUDIT_COMPLETE',json.dumps({
              'successes':manifest['successes'],'failures':manifest['fails'],
              'overall':manifest['overall']},ensure_ascii=False),flush=True)
          if manifest['successes']<10:
              raise SystemExit('too few independent NOAA case-year samples')
          PY
      - name: Independently replay final P5 wind stages on all twenty original NOAA files
        shell: bash
        run: |
          set -euo pipefail
          python3 -m pip install --disable-pip-version-check -q numpy pandas
          python3 - <<'PY'
          from pathlib import Path
          import json
          import pandas as pd
          from native_cpp.modules.p5_smerge.data_prep.isd_lite_wind import parse_lite_winds
          from native_cpp.modules.p5_smerge.data_prep.wind_policy_v2 import clean_then_replace_calms
          all_results=[]
          for p in sorted(Path("evidence/raw").glob("*.gz")):
              usaf,wban,year_text=p.name[:-3].split("-")
              year=int(year_text)
              wind=parse_lite_winds(p,year,usaf+wban,validate_filename=False)
              index=pd.date_range(f"{year}-01-01",f"{year}-12-31 23:00",freq="h")
              df=pd.DataFrame({"deg":9999.0,"ms-1":9999.0},index=index)
              presence=pd.Series(False,index=index)
              for when,observed in wind.items():
                  df.loc[when,"deg"] = 9999. if observed.direction_deg is None else observed.direction_deg
                  df.loc[when,"ms-1"] = 9999. if observed.speed_mps is None else observed.speed_mps
                  presence.loc[when]=True
              cleaned,model,audit,stats=clean_then_replace_calms(df,"deg","ms-1",presence)
              assert stats["raw_lite_record_hours"]==len(wind)
              assert stats["original_calm_hours"]==stats["original_calm_0_0_hours"]+stats["original_calm_360_0_hours"]
              assert stats["raw_absent_hours"]+stats["raw_lite_record_hours"]==len(index)
              assert stats["original_wind_invalid_hours_including_absent"]+stats["original_calm_hours"]+stats["original_valid_positive_hours"]==len(index)
              assert stats["cleaned_complete_wind_hours"]==stats["final_complete_wind_hours"]
              assert ((audit["original_calms_C3_C4"]) & ((model["deg"]<=0)|(model["deg"]>360)|(model["ms-1"]<=0))).sum()==0
              all_results.append({"station":usaf+"-"+wban,"year":year,"summary":stats})
              print("P5_V2_REAL_STATION_YEAR_PASS",usaf+"-"+wban,year,
                    "calms",stats["original_calm_hours"],
                    "absent",stats["raw_absent_hours"],
                    "invalid",stats["original_wind_invalid_hours_including_absent"],flush=True)
          assert len(all_results)==20,len(all_results)
          total=lambda key:sum(x["summary"][key] for x in all_results)
          summary={"station_year_tests":len(all_results),"original_hours":total("raw_lite_record_hours"),
                   "raw_absent_hours":total("raw_absent_hours"),
                   "original_calm_hours":total("original_calm_hours"),
                   "invalid_wind_hours_including_absent":total("original_wind_invalid_hours_including_absent"),
                   "tests":all_results}
          assert summary["original_hours"]==147503,summary["original_hours"]
          Path("evidence/p5_v2_twenty_real_station_year_results.json").write_text(
              json.dumps(summary,indent=2,ensure_ascii=False)+"\n")
          print("P5_V2_REAL20_NOAA_REPLAY=PASS",json.dumps({
              k:summary[k] for k in ("station_year_tests","original_hours",
                                    "raw_absent_hours","original_calm_hours",
                                    "invalid_wind_hours_including_absent")},sort_keys=True))
          PY
      - name: Upload evidence from original station-year gzip files
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: p5-isd-lite-multi-station-wind-audit
          path: evidence/
          if-no-files-found: error
          retention-days: 7
