name: P4 Hefei 2022 public met capture
concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true
on:
  pull_request:
    paths:
      - '.github/workflows/p4-hefei-2022-data-capture.yml'
      - 'native_cpp/modules/p4_read62/data_prep/**'
jobs:
  download:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 18
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4
      - name: Provision GitHub-hosted GCC12 and Fortran12
        shell: bash
        run: |
          set -euo pipefail
          sudo apt-get update -qq
          sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq g++-12 gfortran-12
      - name: Select isolated C++20 and Fortran compilers
        uses: ./.github/actions/cteas-linux-toolchain
      - name: Dependencies
        run: python3 -m pip install --disable-pip-version-check PyYAML
      - name: Stage isolated 5km 100m Hefei case
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p project/current/grid run-evidence
          cat > project/current/grid/center_location <<'EOF'
          latitude: 31.939774444
          longitude: 117.141610855
          EOF
          # Use source-pinned 50x50 WGS84 UTM 50N frozen Hefei grid.
          # The 3-key legacy fixture cannot pass strict P4/P5 station geometry.
          cp project/cases/hefei5km_2022_reference_case_20261011/grid/grid.cmn project/current/grid/grid.cmn
          python3 - <<'PY'
          from pathlib import Path
          from engine.run_met.station_grid import load_strict_utm_grid
          g = load_strict_utm_grid(Path("project/current/grid/grid.cmn"), context="P4 CI")
          assert (g.imap, g.iutmzn, g.lsohem, g.datum, g.nx, g.ny, g.nz) == (
              "UTM", 50, "N", "WGS-84", 50, 50, 9), g
          assert abs(g.dgridkm - 0.1) < 1e-9 and abs(g.xrefkm - 510.885) < 1e-9
          assert abs(g.yrefkm - 3531.269) < 1e-9
          print("P4_PUBLIC_CAPTURE_PINNED_FULL_UTM=PASS", g)
          PY
          cat > project/current/grid/research_time <<'EOF'
          BEGIN: 20220101-000000
          END: 20220106-230000
          EOF
      - name: Download IGRA and generate 2022 FSL using copied P4 Python
        shell: bash
        run: |
          set -euo pipefail
          python3 -m native_cpp.modules.p4_read62.data_prep.prepare_inputs --year 2022 --pstop 500 --execute 2>&1 | tee run-evidence/p4-download.log
          find project/current/met/upperair/2022/igra2fsl -maxdepth 1 -name '*.txt' -size +0c | grep -q .
          python3 - <<'PY'
          import csv,pathlib
          path=pathlib.Path("project/current/met/upperair/2022/upperair_station_used_list.txt")
          rows=list(csv.DictReader(path.open()))
          assert len(rows)==1, rows
          row=rows[0]
          assert row["site_type"]=="VIRTUAL_RELOCATED", row
          assert float(row["raw_coverage"])>0.80, row
          assert row["id"]=="CHM00058424", row
          assert row["source_lat"]!=row["lat"],row
          print("P4_HEFEI_ONE_PROXY_GT80=PASS",row["id"],row["raw_coverage"])
          PY
      - name: Record public-source provenance and checksums
        if: always()
        shell: bash
        run: |
          mkdir -p run-evidence
          python3 - <<'PY'
          import hashlib,json,pathlib
          root=pathlib.Path('project/current/met/upperair/2022')
          files=sorted(p for p in root.rglob('*') if p.is_file()) if root.exists() else []
          items=[{'path':str(p),'bytes':p.stat().st_size,'sha256':hashlib.sha256(p.read_bytes()).hexdigest()} for p in files]
          result={'stage':'P4','source':'NOAA IGRA2 data-por','source_ref':'RRain001/CTEAS main 66e30ffb1ff4638a97af8a060748ce30b7578350','year':2022,'pstop_hpa':500,'domain_km':[5,5],'model_grid_m':100,'files':items,'fsl_count':sum('/igra2fsl/' in p['path'] and p['path'].endswith('.txt') for p in items),'caveat':'P4 annual >80% cleaned ORIGINAL sounding gate; one external proxy moved horizontally only, original coords tracked; FSL remains fixed-width 2 decimals'}
          pathlib.Path('run-evidence/p4-provenance.json').write_text(json.dumps(result,indent=2,ensure_ascii=False)+'\n')
          print('P4_CAPTURE_SUMMARY',json.dumps({'file_count':len(items),'fsl_count':result['fsl_count'],'total_bytes':sum(p['bytes'] for p in items)}))
          PY
      - name: Upload isolated public-input evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: p4-hefei-2022-inputs
          path: |
            run-evidence/
            project/current/met/upperair/2022/upperair_station_used_list.txt
            project/current/met/upperair/2022/p4_station_selection_audit.json
            project/current/met/upperair/2022/*-data.txt
            project/current/met/upperair/2022/igra2fsl/*.txt
            project/current/met/upperair/2022/pstop_hpa.txt
          if-no-files-found: warn
          retention-days: 7
