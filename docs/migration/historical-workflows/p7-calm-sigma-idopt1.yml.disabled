name: P7 CALPUFF original calm SIGTY SIGTZ IDOPT1 numerical gate
on:
  pull_request:
    paths:
      - 'native_cpp/modules/p7_calpuff/**'
      - '.github/workflows/p7-calm-sigma-idopt1.yml'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: p7-calm-sigma-idopt1-${{ github.sha }}
  cancel-in-progress: false
jobs:
  calm-fortran-source-parity:
    runs-on: ubuntu-22.04
    timeout-minutes: 16
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
          filter: blob:none
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /native_cpp/modules/p7_calpuff/**
            /engine/vendor/src/CALPUFF_v7.2.1_L150618/**
            /project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp
            /project/cases/hefei5km_2022_reference_case_20261011/geo/makegeo/makegeo.inp
            /project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat
      - name: Verify original IDOPT1 and source-derived TURBSET
        shell: bash
        run: |
          set -euo pipefail
          test -n "$(command -v gfortran || true)"
          build="${RUNNER_TEMP}/p7-calm-idopt1-${GITHUB_RUN_ID}"
          cmake -S native_cpp/modules/p7_calpuff -B "$build" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$build" --parallel 2 --target cteas_p7_calm_sigma_probe cteas_p7_calm_sigma_tests cteas_p7_original_turbset_mdisp3_tests
          ctest --test-dir "$build" -R '^(cteas_p7_calm_idopt1_(native_subset|original_fortran_subset)|cteas_p7_original_turbset_mdisp3_hefei_minima)$' --output-on-failure -V
