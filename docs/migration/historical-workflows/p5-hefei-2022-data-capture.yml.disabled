name: P5 Hefei 2022 public met capture
concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true
on:
  pull_request:
    paths:
      - '.github/workflows/p5-hefei-2022-data-capture.yml'
      - 'native_cpp/modules/p5_smerge/data_prep/**'
jobs:
  download:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 18
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4
      - name: Provision GitHub-hosted GCC12 and Fortran12
        shell: bash
        run: |
          set -euo pipefail
          sudo apt-get update -qq
          sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq g++-12 gfortran-12
      - name: Select isolated C++20 and Fortran compilers
        uses: ./.github/actions/cteas-linux-toolchain
      - name: Dependencies
        run: python3 -m pip install --disable-pip-version-check PyYAML numpy pandas
      - name: Stage isolated 5km domain (station fallback independent)
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p project/current/grid run-evidence
          cat > project/current/grid/center_location <<'EOF'
          latitude: 31.939774444
          longitude: 117.141610855
          EOF
          # Canonical pinned 2022 UTM grid (with projection, origin, datum, layers).
          # A 3-key mock grid fails the accepted P4/P5 strict UTM reader.
          cp project/cases/hefei5km_2022_reference_case_20261011/grid/grid.cmn project/current/grid/grid.cmn
          python3 - <<'PY'
          from pathlib import Path
          from engine.run_met.station_grid import load_strict_utm_grid
          g = load_strict_utm_grid(Path("project/current/grid/grid.cmn"), context="P5 CI")
          assert (g.imap, g.iutmzn, g.lsohem, g.datum, g.nx, g.ny, g.nz) == (
              "UTM", 50, "N", "WGS-84", 50, 50, 9), g
          assert abs(g.dgridkm - 0.1) < 1e-9 and abs(g.xrefkm - 510.885) < 1e-9
          assert abs(g.yrefkm - 3531.269) < 1e-9
          print("P5_PUBLIC_CAPTURE_PINNED_FULL_UTM=PASS", g)
          PY
          cat > project/current/grid/research_time <<'EOF'
          BEGIN: 20220101-000000
          END: 20220106-230000
          EOF
      - name: Check nearest station annual raw coverage and capture one virtual station
        shell: bash
        run: |
          set -euo pipefail
          python3 -m native_cpp.modules.p5_smerge.data_prep.download_isd_by_grid \
            --year 2022 --stack-lat 31.939774444 --stack-lon 117.141610855 \
            --timeout 30 --retries 2 2>&1 | tee run-evidence/p5-download.log
          python3 - <<'PY'
          import json,pathlib
          raw=pathlib.Path('project/current/met/surface/isd_raw')
          m=json.loads((raw/'station_selection_2022.json').read_text())
          assert m['mode']=='VIRTUAL_RELOCATED',m['mode']
          assert len(m['stations'])==1,len(m['stations'])
          assert m['stations'][0]['relocated']
          assert abs(m['stations'][0]['lat']-31.939774444)<1e-9
          assert abs(m['stations'][0]['lon']-117.141610855)<1e-9
          print('P5_EXACTLY_ONE_NEAREST_QUALIFIED_VIRTUAL_STATION=PASS',m['stations'][0]['sid'])
          PY
      - name: Prepare GENERIC input with copied P5 processing
        shell: bash
        run: |
          set -euo pipefail
          python3 -m native_cpp.modules.p5_smerge.data_prep.prepare_inputs \
            --expected-year 2022 --skip-download --execute 2>&1 | tee run-evidence/p5-process.log
          find project/current/met/surface/isd2smerge_ready -maxdepth 1 -name '*.csv' -size +0c | grep -q .
      - name: Assert v2 clean-and-replace wind policy on actual 2022 NOAA observations
        shell: bash
        run: |
          set -euo pipefail
          python3 -m native_cpp.modules.p5_smerge.data_prep.validate_scheme_c_capture \
            --case-root project/current --expected-hours 144 \
            --report run-evidence/p5-wind-v2-stages.json
      - name: Independently reconcile all 2022 decoded wind-source hours against ISD-Lite
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY'
          from datetime import datetime
          from pathlib import Path
          from native_cpp.modules.p5_smerge.data_prep.isd_lite_wind import parse_lite_winds
          import csv,json
          base=Path("project/current/met/surface")
          ids=json.loads((base/"isd_raw/station_selection_2022.json").read_text())["stations"]
          assert len(ids)==1
          sid=ids[0]["sid"]
          lite=base/"isd_raw/isd_lite"/f"{sid[:6]}-{sid[6:]}-2022.gz"
          wind=parse_lite_winds(lite,2022,sid)
          processed=base/"isd2smerge_and_fill"/f"{sid[:6]}-{sid[6:]}-2022_isd_lite_source_audit.csv"
          with processed.open(newline="") as file:
              rows=list(csv.DictReader(file))
          bytime={}
          for row in rows:
              t=datetime.fromisoformat(row["at_utc"].rstrip("Z"))
              assert t not in bytime
              bytime[t]=row
          assert len(wind)>=7008,len(wind)
          checks=0
          for t,record in wind.items():
              row=bytime[t]
              expected_speed=record.speed_mps if record.speed_mps is not None else 9999.
              expected_dir=record.direction_deg if record.direction_deg is not None else 9999.
              assert abs(float(row['wind_speed_mps'])-expected_speed)<1e-6,(t,row['wind_speed_mps'],expected_speed)
              assert abs(float(row['wind_direction_deg'])-expected_dir)<1e-6,(t,row['wind_direction_deg'],expected_dir)
              checks+=1
          result={"wind_source":"NOAA_ISD_LITE","original_hours_checked":checks,
                  "unmatched_hours":0,"silent_full_isd_wnd_fallback":False,
                  "station":sid,"year":2022}
          Path("run-evidence/p5-hybrid-wind-source.json").write_text(
              json.dumps(result,indent=2)+"\n")
          print("P5_LITE_ONLY_ANNUAL_WIND_SOURCE=PASS",json.dumps(result))
          PY
      - name: Record public-source provenance and checksums
        if: always()
        shell: bash
        run: |
          mkdir -p run-evidence
          python3 - <<'PY'
          import hashlib,json,pathlib
          root=pathlib.Path('project/current/met/surface')
          files=sorted(p for p in root.rglob('*') if p.is_file()) if root.exists() else []
          items=[{'path':str(p),'bytes':p.stat().st_size,'sha256':hashlib.sha256(p.read_bytes()).hexdigest()} for p in files]
          ready=[p for p in items if '/isd2smerge_ready/' in p['path'] and p['path'].endswith('.csv')]
          raw=[p for p in items if '/isd_raw/' in p['path'] and p['path'].endswith('-2022.csv')]
          result={'stage':'P5','source':'NOAA NCEI Global Hourly 2022','source_ref':'RRain001/CTEAS main 66e30ffb1ff4638a97af8a060748ce30b7578350','model_domain_km':[5,5],'model_grid_m':100,'selection_rule':'all in domain, otherwise one nearest with annual raw coverage >=80%','raw_station_files':len(raw),'generic_ready_files':len(ready),'files':items,'caveat':'search area applies only to surface meteorological station discovery, not model computation; derived/interpolated wind is not direct observation'}
          pathlib.Path('run-evidence/p5-provenance.json').write_text(json.dumps(result,indent=2,ensure_ascii=False)+'\n')
          print('P5_CAPTURE_SUMMARY',json.dumps({'file_count':len(items),'raw_count':len(raw),'ready_count':len(ready),'total_bytes':sum(p['bytes'] for p in items)}))
          PY
      - name: Upload isolated public-input evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: p5-hefei-2022-inputs
          path: |
            run-evidence/
            project/current/met/surface/isd_raw/station_selection_*.json
            project/current/met/surface/isd_raw/download_report_*.json
            project/current/met/surface/isd_raw/surf_station_list_*.txt
            project/current/met/surface/isd_raw/*2022*
            project/current/met/surface/isd_raw/isd_lite/*.gz
            project/current/met/surface/isd2smerge_and_fill/*isd_lite_source*
            project/current/met/surface/isd2smerge_and_fill/*_cleaned.csv
            project/current/met/surface/isd2smerge_and_fill/*_calm_interpolated.csv
            project/current/met/surface/isd2smerge_and_fill/*.stage.json
            project/current/met/surface/isd2smerge_ready/*.csv
            project/current/met/surface/isd2smerge_and_fill/*wind_audit*
          if-no-files-found: warn
          retention-days: 7
