name: P6G multistation on accepted single-station baseline
on:
  push:
    branches: [codex/p6g-multistation-on-accepted-p6a-p6f-20261014]
  pull_request:
    paths:
      - 'native_cpp/modules/p6_calmet/**'
      - '.github/workflows/p6g-accepted-baseline-multistation.yml'
  workflow_dispatch:
permissions:
  contents: read
jobs:
  frozen-science-ownership:
    runs-on: ubuntu-22.04
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - name: Verify all 163 accepted P6 physics files retain exact #53 blobs
        shell: bash
        run: |
          set -euo pipefail
          base=8d6642272d0abb77153880591e150f93e14d4479
          git merge-base --is-ancestor "$base" HEAD
          # Derive the complete immutable file set from the ACCEPTED parent,
          # rather than a hand-selected 9-file list that misses future changes.
          # Newly added P6G test adapters are not baseline physics.
          mapfile -t accepted_files < <(git ls-tree -r --name-only "$base" -- \
            native_cpp/modules/p6_calmet/src \
            native_cpp/modules/p6_calmet/include/cteas/p6 \
            native_cpp/modules/p6_calmet/p6e \
            native_cpp/modules/p6_calmet/p6f \
            scripts/p6_run_native_causal_hourly.py)
          if [ "${#accepted_files[@]}" -ne 163 ]; then
            echo "::error::Accepted #53 P6 core inventory drift: expected 163, found ${#accepted_files[@]}"
            exit 1
          fi
          if ! git diff --quiet "$base" HEAD -- "${accepted_files[@]}"; then
            echo "::error::PR #63 changed existing accepted P6 physics or scheduler files"
            git diff --name-status "$base" HEAD -- "${accepted_files[@]}"
            exit 1
          fi
          echo "PASS_P6G_INHERITS_ALL_163_ACCEPTED_P6_CORE_FILES"
  selected-multisite-tests:
    name: G6-G13 10km selected tests (${{ matrix.mode }})
    runs-on: ubuntu-22.04
    timeout-minutes: 45
    strategy:
      fail-fast: false
      matrix:
        mode: [Debug, Release]
    steps:
      - uses: actions/checkout@v4
      - name: Check vendor source and compilers
        run: |
          test -s engine/vendor/src/CALMET_v6.5.0_L150223/calmet.for
          command -v gfortran
          command -v g++
      - name: Build multi-station kernels without altering Hefei source
        run: |
          cmake -S native_cpp/modules/p6_calmet -B "$RUNNER_TEMP/p6g" -DCMAKE_BUILD_TYPE=${{ matrix.mode }}
          cmake --build "$RUNNER_TEMP/p6g" --target \
            cteas_p6g_dynamic_geo_tests cteas_p6g_station_set_tests \
            cteas_p6g_surface_dynamic_tests cteas_p6g_upper_dynamic_tests \
            cteas_p6g_observation_input_tests cteas_p6g_g8_10km_year_tests \
            cteas_p6g_g9_multi_wind1_tests cteas_p6g_g11_terrain_tests \
            cteas_p6g_g12_thermal_tests cteas_p6g_g13_surfvar_10km_reference \
            cteas_p6g_g14_unified_hourly_tests \
            cteas_p6g_g19_file_backed_case_tests \
            cteas_p6g_g19_source_case_preflight \
            cteas_p6g_g20_source_wind1_probe \
            cteas_p6g_g21_source_fradj_probe \
            cteas_p6g_g15_original_controls_tests \
            cteas_p6g_g16_staged_wind_tests \
            cteas_p6g_g17_staged_terrain_tests \
            cteas_p6g_g17b_observed_solar_heat_tests \
            cteas_p6g_g17b_setcom_airden_reference \
            cteas_p6g_g18b6_setcom_nearu_reference \
            cteas_p6g_g18b8_gamma_grid_reference \
            cteas_p6g_g18c1_avemix_reference \
            cteas_p6g_g18d3_hflux_defaults_reference \
            cteas_p6g_g18d6_nearu_reference \
            cteas_p6g_g18d7_diagi_cell_reference \
            cteas_p6g_g17b4_iavet_two_pass_tests \
            cteas_p6g_g17b4_avetmp_reference --parallel 2
      - name: G19 file-backed source preflight CLI and unsupported source guard
        run: |
          "$RUNNER_TEMP/p6g/cteas_p6g_g19_source_case_preflight" --help
          if "$RUNNER_TEMP/p6g/cteas_p6g_g19_source_case_preflight" \
             project/cases/hefei5km_2022_reference_case_20261011/run/met/met.inp \
             missing-GEO.DAT missing-SURF.DAT missing-UP1.DAT missing-UP2.DAT; then
            echo "::error::G19 promoted an unsupported single-station deck"
            exit 1
          fi
      - name: G20 native first-hour WIND1 diagnostics CLI rejects unsupported Hefei 1SS source
        run: |
          "$RUNNER_TEMP/p6g/cteas_p6g_g20_source_wind1_probe" --help
          if "$RUNNER_TEMP/p6g/cteas_p6g_g20_source_wind1_probe" \
              project/cases/hefei5km_2022_reference_case_20261011/run/met/met.inp \
              invalid-GEO.DAT invalid-SURF.DAT invalid-US1.DAT invalid-US2.DAT \
              --output "$RUNNER_TEMP/g20-must-not-exist.csv"; then
            echo "::error::G20 promoted single-station baseline to multi-site WIND1"
            exit 1
          fi
          test ! -e "$RUNNER_TEMP/g20-must-not-exist.csv"
      - name: G21 source-file FRADJ selected CLI rejects unsupported original Hefei 1SS
        run: |
          "$RUNNER_TEMP/p6g/cteas_p6g_g21_source_fradj_probe" --help
          if "$RUNNER_TEMP/p6g/cteas_p6g_g21_source_fradj_probe" \
              project/cases/hefei5km_2022_reference_case_20261011/run/met/met.inp \
              invalid-GEO.DAT invalid-SURF.DAT invalid-US1.DAT invalid-US2.DAT \
              --output "$RUNNER_TEMP/g21-must-not-exist.csv" \
              --source-stage "$RUNNER_TEMP/g21-must-not-exist.dat"; then
            echo "::error::G21 accepted unsupported one-station Hefei deck as multi-station FRADJ"
            exit 1
          fi
          test ! -e "$RUNNER_TEMP/g21-must-not-exist.csv"
          test ! -e "$RUNNER_TEMP/g21-must-not-exist.dat"
      - name: Run 2SS+2US cross-year and 8784h CTest
        run: ctest --test-dir "$RUNNER_TEMP/p6g" --output-on-failure -R '^p6g_'
      - name: Original CALMET Fortran 2SS 10km SURFVAR 72-case strict parity
        run: |
          python3 native_cpp/modules/p6_calmet/reference/compare_g13_original_surfvar_10km.py \
            --vendor engine/vendor/src/CALMET_v6.5.0_L150223/calmet.for \
            --cpp "$RUNNER_TEMP/p6g/cteas_p6g_g13_surfvar_10km_reference" \
            --out "$RUNNER_TEMP/surfvar-${{ matrix.mode }}.json"
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: g13-source-10km-${{ matrix.mode }}
          path: ${{ runner.temp }}/surfvar-${{ matrix.mode }}.json
          if-no-files-found: warn
