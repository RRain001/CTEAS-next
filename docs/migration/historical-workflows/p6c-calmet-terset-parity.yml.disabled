name: P6C-D CALMET original TERSET and FRADJ numerical parity
concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true
on:
  pull_request:
    paths:
      - 'native_cpp/modules/p6_calmet/src/terrain_envelope_main.cpp'
      - 'native_cpp/modules/p6_calmet/src/froude_adjust_main.cpp'
      - 'native_cpp/modules/p6_calmet/include/cteas/p6/*terrain*'
      - 'native_cpp/modules/p6_calmet/include/cteas/p6/*froude*'
      - 'native_cpp/modules/p6_calmet/reference/compare_original_terset.py'
      - 'native_cpp/modules/p6_calmet/reference/compare_original_fradj.py'
      - 'docs/reconstruction_cpp/CI_FULL_REGRESSION_REQUEST.md'
      - '.github/workflows/p6c-calmet-terset-parity.yml'
  workflow_dispatch:
permissions:
  contents: read
jobs:
  terset-original-fortran-parity:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - name: Provision GitHub-hosted GCC12 and Fortran12
        shell: bash
        run: |
          set -euo pipefail
          sudo apt-get update -qq
          sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq g++-12 gfortran-12
      - name: Select isolated C++20 and Fortran compilers
        uses: ./.github/actions/cteas-linux-toolchain
      - name: Pin isolated P3 source capture without merging its branch
        run: |
          set -euo pipefail
          git fetch --no-tags origin 5b1013baea10c0b3c3946e62ab77428dff05455e
          git restore --source=FETCH_HEAD -- native_cpp/reference/capture_p3_makegeo.py
      - name: Compiler and real case original GEO.DAT
        run: |
          set -euo pipefail
          if ! pkg-config --exists gdal; then
            sudo -n apt-get update -qq
            sudo -n DEBIAN_FRONTEND=noninteractive apt-get install -y -qq libgdal-dev
          fi
          gfortran --version | head -1
          python3 native_cpp/reference/capture_p1_p2.py --output /tmp/p6c-real-p3
          python3 native_cpp/reference/capture_p3_makegeo.py --output /tmp/p6c-real-p3
          test -s /tmp/p6c-real-p3/p3/geo.dat
      - name: Build independent C++20 terrain kernel and software checks
        run: |
          set -euo pipefail
          cmake -S native_cpp/modules/p6_calmet -B /tmp/p6c-build -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_FLAGS=-fno-strict-aliasing
          cmake --build /tmp/p6c-build -j2
          ctest --test-dir /tmp/p6c-build --output-on-failure
      - name: Compare original TERSET and modern C++ across 60,000 physical fields
        run: |
          set -euo pipefail
          python3 native_cpp/modules/p6_calmet/reference/compare_original_terset.py \
            --vendor engine/vendor/src/CALMET_v6.5.0_L150223 \
            --geo /tmp/p6c-real-p3/p3/geo.dat \
            --cpp /tmp/p6c-build/cteas_p6_terset \
            --output /tmp/p6c-compare
      - name: Compare original TERSET+FRADJ against 315000 wind components
        run: |
          set -euo pipefail
          python3 -m native_cpp.modules.p6_calmet.reference.compare_original_fradj \
            --vendor engine/vendor/src/CALMET_v6.5.0_L150223 \
            --geo /tmp/p6c-real-p3/p3/geo.dat \
            --cpp /tmp/p6c-build/cteas_p6_fradj \
            --out /tmp/p6d-compare
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: p6c-calmet-original-terset-vs-cpp-2022
          path: |
            /tmp/p6c-compare/
            /tmp/p6d-compare/
          retention-days: 7
          if-no-files-found: warn
