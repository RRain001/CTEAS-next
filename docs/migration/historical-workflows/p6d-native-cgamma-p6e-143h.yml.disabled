name: P6D Native P6E ZICONV CGAMMA 143h original numerical gate

on:
  pull_request:
    paths:
      - 'native_cpp/modules/p6_calmet/src/cgamma_from_p6e_143h_main.cpp'
      - 'native_cpp/modules/p6_calmet/CMakeLists.txt'
      - 'scripts/p6d_compare_native_cgamma_grid_143h.py'
      - '.github/workflows/p6d-native-cgamma-p6e-143h.yml'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: p6d-native-cgamma-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

jobs:
  native-build-contract:
    name: Rebuilt native CGAMMA source and fail-closed missing-input contract
    runs-on: ubuntu-22.04
    timeout-minutes: 25
    steps:
      - uses: actions/checkout@v4
        with:
          filter: blob:none
          sparse-checkout: |
            .github/actions/cteas-linux-toolchain
            native_cpp/modules/p6_calmet
      - uses: ./.github/actions/cteas-linux-toolchain
      - name: Compile strict C++20 and run original CGAMMA + new missing-state contracts
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-cgamma-light-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          cmake -S native_cpp/modules/p6_calmet -B "$root" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$root" --target cteas_p6_native_cgamma_grid_143h cteas_p6_cgamma_tests --parallel 2
          ctest --test-dir "$root" \
            -R '^(p6_native_cgamma_grid_rejects_missing_state|p6_cgamma_.*)$' \
            --no-tests=error --output-on-failure --timeout 300

  actual-143h-p6e-to-p6d:
    name: Independent original Fortran vs native P6E driven CGAMMA 143h
    runs-on: ubuntu-22.04
    timeout-minutes: 75
    steps:
      - uses: actions/checkout@v4
        with:
          filter: blob:none
          sparse-checkout: |
            .github/actions/cteas-linux-toolchain
            native_cpp/modules/p6_calmet
            scripts
            engine/vendor/src/CALMET_v6.5.0_L150223
      - uses: actions/checkout@v4
        with:
          ref: 3b94cdbfbb5f44146ba51a4ef112114f199d28b9
          path: frozen_original_checkout
          filter: blob:none
          sparse-checkout: |
            project/cases/hefei5km_2022_reference_case_20261011
      - uses: ./.github/actions/cteas-linux-toolchain
      - name: Validate SHA-pinned original Hefei meteorological input
        shell: bash
        run: |
          set -euo pipefail
          case_dir="frozen_original_checkout/project/cases/hefei5km_2022_reference_case_20261011"
          test -s "$case_dir/run/met/met.dat"
          printf '%s  %s\n' b1823cda92280888d70b00961ab39486036a3086e18637fff21efb4f4b237d30 "$case_dir/run/met/met.dat" | sha256sum --check
      - name: Build native P6E state producer and new P6D CGAMMA grid driver
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-cgamma-coupled-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          cmake -S native_cpp/modules/p6_calmet -B "$root/build-p6d" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$root/build-p6d" --target cteas_p6_native_cgamma_grid_143h --parallel 2
          cmake -S native_cpp/modules/p6_calmet/p6e -B "$root/build-p6e" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$root/build-p6e" --target p6e_p6c_hourly_bridge p6e_calmet_dat21 --parallel 2
      - name: Emit strictly native P6E internal ZICONV using the frozen 2022 original wind as declared coupling drive
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-cgamma-coupled-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          case_dir="frozen_original_checkout/project/cases/hefei5km_2022_reference_case_20261011"
          "$root/build-p6e/p6e_p6c_hourly_bridge" \
            "$case_dir/met/surface/final/surf.dat" \
            "$case_dir/met/upperair/final/up_58424.dat" 58424 \
            "$root/observations.csv"
          "$root/build-p6e/p6e_calmet_dat21" emit-realcase \
            --reference "$case_dir/run/met/met.dat" \
            --observations "$root/observations.csv" \
            --wind-file "$case_dir/run/met/met.dat" \
            --geo-file "$case_dir/geo/makegeo/geo.dat" \
            --state-prefix "$root/p6e-native" \
            --out "$root/p6e-native.dat"
          test -s "$root/p6e-native.ziconv.f32"
          test -s "$root/p6e-native.state.json"
      - name: Emit 143 native CGAMMA 50 by 50 fields using previous-hour native P6E ZICONV
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-cgamma-coupled-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          "$root/build-p6d/cteas_p6_native_cgamma_grid_143h" \
            --up frozen_original_checkout/project/cases/hefei5km_2022_reference_case_20261011/met/upperair/final/up_58424.dat \
            --p6e-state-prefix "$root/p6e-native" \
            --out "$root/native-gamma" --station-id 58424 --zupt 200 \
            --upper-i 25 --upper-j 26
      - name: Independently instrument unmodified CALMET source for original REAL4 pre-FRADJ 143h GAMMA
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-cgamma-coupled-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          python3 scripts/p6d_trace_original_gamma.py \
            --vendor engine/vendor/src/CALMET_v6.5.0_L150223 \
            --case frozen_original_checkout/project/cases/hefei5km_2022_reference_case_20261011 \
            --out "$root/original-gamma" --compiler gfortran-11 --hours 143
      - name: Strict numeric acceptance of ALL 357500 native versus original gridded GAMMA values
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-cgamma-coupled-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          python3 scripts/p6d_compare_native_cgamma_grid_143h.py \
            --original "$root/original-gamma" --native "$root/native-gamma" \
            --out "$root/native-gamma-143h-verdict.json" --require-numeric-parity
      - name: Archive scientific result even when numerical parity fails
        if: always()
        uses: actions/upload-artifact@v4
        continue-on-error: true
        with:
          name: p6d-native-cgamma-ziconv-143h
          path: |
            ${{ runner.temp }}/p6d-cgamma-coupled-${{ github.run_id }}-${{ github.run_attempt }}/native-gamma-143h-verdict.json
            ${{ runner.temp }}/p6d-cgamma-coupled-${{ github.run_id }}-${{ github.run_attempt }}/native-gamma/native_cgamma_manifest.json
            ${{ runner.temp }}/p6d-cgamma-coupled-${{ github.run_id }}-${{ github.run_attempt }}/native-gamma/native_cgamma_143h.csv
            ${{ runner.temp }}/p6d-cgamma-coupled-${{ github.run_id }}-${{ github.run_attempt }}/original-gamma/gamma_source_manifest.json
            ${{ runner.temp }}/p6d-cgamma-coupled-${{ github.run_id }}-${{ github.run_attempt }}/p6e-native.state.json
          if-no-files-found: warn
          retention-days: 7