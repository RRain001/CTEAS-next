name: P7 original RLSMET release-wind source inspection
on:
  pull_request:
    paths:
      - 'native_cpp/modules/p7_calpuff/reference/rlsmet_source_audit.py'
      - '.github/workflows/p7-rlsmet-original-source.yml'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: p7-rlsmet-source-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
jobs:
  original-rlsmet-source:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 12
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
          filter: blob:none
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /native_cpp/modules/p7_calpuff/reference/rlsmet_source_audit.py
            /engine/vendor/src/CALPUFF_v7.2.1_L150618/**
      - name: Pin and locate untouched original RLSMET, POINTS1 and WSNEW
        shell: bash
        run: |
          set -euo pipefail
          root="${RUNNER_TEMP}/p7-rlsmet-${GITHUB_RUN_ID}"
          python3 native_cpp/modules/p7_calpuff/reference/rlsmet_source_audit.py \
            --vendor engine/vendor/src/CALPUFF_v7.2.1_L150618 \
            --report "$root/rlsmet-source.json" \
            --source-extract "$root/rlsmet-source.txt"
          echo "P7_ORIGINAL_RLSMET_SOURCE_EXCERPT_BEGIN"
          sed -n '1,220p' "$root/rlsmet-source.txt"
          echo "P7_WINDSET_SOURCE_BEGIN"
          sed -n '/^WINDSET original /,/^ZFIND original /p' "$root/rlsmet-source.txt" | head -n 280
          echo "P7_WINDSET_SOURCE_END"
          echo "P7_ORIGINAL_RLSMET_SOURCE_EXCERPT_END"
          echo "P7_REAL_CASE_WSNEW_NUMERICAL_PARITY=NOT_PASS"
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: p7-original-rlsmet-source-inspection
          path: ${{ runner.temp }}/p7-rlsmet-${{ github.run_id }}/
          retention-days: 14
          if-no-files-found: warn
