name: P1 P2 original reference capture
concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true
on:
  pull_request:
    paths:
      - 'native_cpp/reference/**'
      - '.github/workflows/fortran-reference-p1-p2.yml'
jobs:
  capture:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 12
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4
      - name: Provision GitHub-hosted GCC12 and Fortran12
        shell: bash
        run: |
          set -euo pipefail
          sudo apt-get update -qq
          sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq g++-12 gfortran-12
      - name: Select isolated C++20 and Fortran compilers
        uses: ./.github/actions/cteas-linux-toolchain
      - name: Reset self-hosted scratch directories
        shell: bash
        run: |
          rm -rf ${{ runner.temp }}/cteas-reference-p1-p2
      - name: Install gfortran
        run: gfortran --version | head -1
      - name: Generate and run original P1/P2 in isolated path
        run: python3 native_cpp/reference/capture_p1_p2.py --output ${{ runner.temp }}/cteas-reference-p1-p2
      - name: Independently parse exact original field content
        run: python3 native_cpp/reference/analyze_p1_p2.py --reference-dir ${{ runner.temp }}/cteas-reference-p1-p2 --summary ${{ runner.temp }}/cteas-reference-p1-p2/original_decoded_summary.json
      - name: Archive evidence on success or failure
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: p1-p2-original-reference
          path: ${{ runner.temp }}/cteas-reference-p1-p2
          if-no-files-found: warn
          retention-days: 7
