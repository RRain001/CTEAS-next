name: P7 real Hefei first 48h accepted and next 72h divergence
on:
  # Strict real-case science only for relevant P7 code, pinned inputs, or this gate.
  # Docs-only updates never consume a full Fortran 143-hour replay.
  pull_request:
    branches:
      - main
      - codex/cteas-p7-calpuff-20261011
    paths:
      - 'native_cpp/modules/p7_calpuff/**'
      - 'engine/vendor/src/CALPUFF_v7.2.1_L150618/**'
      - 'project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat'
      - 'project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp'
      - 'project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.con'
      - 'project/cases/hefei5km_2022_reference_case_20261011/geo/makegeo/makegeo.inp'
      - '.github/workflows/p7-hefei-real-hour7-probe.yml'
  push:
    branches:
      - main
      - codex/cteas-p7-calpuff-20261011
    paths:
      - 'native_cpp/modules/p7_calpuff/**'
      - 'engine/vendor/src/CALPUFF_v7.2.1_L150618/**'
      - 'project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat'
      - 'project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp'
      - 'project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.con'
      - 'project/cases/hefei5km_2022_reference_case_20261011/geo/makegeo/makegeo.inp'
      - '.github/workflows/p7-hefei-real-hour7-probe.yml'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: p7-real-hour7-probe-${{ github.head_ref || github.ref_name }}
  cancel-in-progress: true
jobs:
  real-hour7-probe:
    runs-on: ubuntu-22.04
    timeout-minutes: 100
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
          filter: blob:none
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /native_cpp/modules/p7_calpuff/**
            /engine/vendor/src/CALPUFF_v7.2.1_L150618/**
            /project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat
            /project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp
            /project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.con
            /project/cases/hefei5km_2022_reference_case_20261011/geo/makegeo/makegeo.inp
      - name: Verify original 143-hour sources and historical H3 concentration
        shell: bash
        run: |
          set -euo pipefail
          met=project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat
          con=project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.con
          test -s "$met" && test -s "$con"
          echo "b1823cda92280888d70b00961ab39486036a3086e18637fff21efb4f4b237d30  $met" | sha256sum -c -
          echo "0d51bdb68ff1a5798048bc41067107d3ffe10dc6222f25336df856bcbf48ba10  $con" | sha256sum -c -
      - name: Audit pinned vendor MCTADJ2 source statements (read-only)
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY'
          import hashlib
          from pathlib import Path
          p=Path("engine/vendor/src/CALPUFF_v7.2.1_L150618/calpuff.for")
          data=p.read_bytes()
          assert hashlib.sha256(data).hexdigest()=="da40372cab1c181158d0ee5faac16f678e876fc14415073c38c8e3bdabfbc568"
          source=data.decode("latin-1").splitlines()
          print("P7_H9_ORIGINAL_MCTADJ2_SOURCE_SHA256=PASS")
          for n in range(5310,5380):
              print(f"P7_H9_VENDOR_PUFRECS_L{n}: {source[n-1]}")
          PY
      - name: Inspect original H10 stable RLSMET and PRFIN source (read-only)
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY'
          from pathlib import Path
          import hashlib
          path=Path("engine/vendor/src/CALPUFF_v7.2.1_L150618/calpuff.for")
          raw=path.read_bytes()
          assert hashlib.sha256(raw).hexdigest()=="da40372cab1c181158d0ee5faac16f678e876fc14415073c38c8e3bdabfbc568"
          lines=raw.decode("latin-1").splitlines()
          for lo,hi in ((15365,15505),(15550,15617),(18180,18575),
                        (47075,47245),(10450,10530),(10820,10930),
                        (48445,48720)):
              print(f"P7_H10_VENDOR_SOURCE_BEGIN={lo}-{hi}")
              for index in range(lo-1,hi):
                  print(f"P7_H10_VENDOR_L{index+1}: {lines[index]}")
              print(f"P7_H10_VENDOR_SOURCE_END={lo}-{hi}")
          PY
      - name: Generate independent full 143h original Fortran DGM
        shell: bash
        run: |
          set -euo pipefail
          root="${RUNNER_TEMP}/p7-hour7-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          mkdir -p "$root/frozen/run/puff" "$root/frozen/deliverables/met"
          cp project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp "$root/frozen/run/puff/puff.inp"
          ln -s "${GITHUB_WORKSPACE}/project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat" "$root/frozen/deliverables/met/met.dat"
          python3 native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/original_calcpf_receiver_oracle.py \
            --vendor engine/vendor/src/CALPUFF_v7.2.1_L150618 \
            --case "$root/frozen" --out "$root/vendor" --compiler /usr/bin/gfortran-11 \
            --hour 9 --receptor-i 42 --receptor-j 11 \
            --trace-h9-setpuf --allow-no-receptor-events
          test -s "$root/vendor/case/run/puff/dgm_puffstep.bin"
          test -s "$root/vendor/original-h9-puff588-setpuf-z.json"
          test -s "$root/vendor/original-h9-puff594-receptor21-1-sigtz.json"
          test -s "$root/vendor/original-h9-puff594-receptor21-1-szfloor.json"
          test -s "$root/vendor/original-h9-puff598-mass.json"
          test -s "$root/vendor/original-h9-puff598-vcbar.json"
          test -s "$root/vendor/original-h9-mctadj2-receptor42-11.json"
          test -s "$root/vendor/original-calcpf-h3-42-11-hour9.json"
          python3 - "$root/vendor/original-calcpf-h3-42-11-hour9.json" <<'PY'
          import json
          import sys
          from pathlib import Path
          audit=json.loads(Path(sys.argv[1]).read_text())
          assert audit["scope"].endswith("source-only")
          assert audit["records"] >= 0
          if audit["records"] == 0:
              assert audit["status"] == "NO_CALCPF_RECEIVER_EVENTS_RECORDED"
              assert audit["numeric_native_parity"] == "NOT_CLAIMED"
              print("P7_ORIGINAL_H9_H3_RECEPTOR42_11=NO_SOURCE_EVENTS_NO_PARITY_CLAIM")
          else:
              assert audit["numeric_native_parity"] == "NOT_CLAIMED"
              print("P7_ORIGINAL_H9_H3_RECEPTOR42_11=SOURCE_EVENTS_RECORDED")
          PY
          echo "P7_H9_ORIGINAL_SETPUF_7_PHASE_SOURCE_ONLY=PASS"
          echo "P7_EXTENDED_ORIGINAL_DGM=PINNED_VENDOR_FULL_143H_ORACLE"
      - name: Decode original H9 P585 KSAM1 calm stage without native state injection
        shell: bash
        run: |
          set -euo pipefail
          root="${RUNNER_TEMP}/p7-hour7-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          python3 native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/audit_original_h9_calm.py \
            --original-dgm "$root/vendor/case/run/puff/dgm_puffstep.bin" \
            --out "$root/original-h9-calm.json"
      - name: Preserve strict original 48h parity and diagnose first mismatch through 72h
        shell: bash
        run: |
          set -euo pipefail
          root="${RUNNER_TEMP}/p7-hour7-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          cmake -S native_cpp/modules/p7_calpuff -B "$root/build" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$root/build" --parallel 2 --target cteas_p7_hefei_sixhour_native_h3_receptors_tests cteas_p7_original_native_terrain_tests
          "$root/build/cteas_p7_original_native_terrain_tests"
          echo "P7_H9_REAL4_DGRIDI_RECEPTOR_REGRESSION=PASS"
          # Keep previously accepted H1-H8 and H1-H24 independent strict
          # regression gates before the newly promoted 48h source parity.
          # No fitted tolerance and no historical state supplied to native.
          # Early fail-closed native WROUT1 prefix smoke:
          # source-only 3,226-record header + first 8*3 hourly DATA records.
          CTEAS_P7_NATIVE_PUFF_CON="$root/native-8h-puff.con" \
          CTEAS_P7_MAKEGEO_INP=project/cases/hefei5km_2022_reference_case_20261011/geo/makegeo/makegeo.inp \
            CTEAS_P7_PROBE_HOURS=8 "$root/build/cteas_p7_hefei_sixhour_native_h3_receptors_tests" \
            project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat \
            project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp \
            project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.con \
            "$root/vendor/case/run/puff/dgm_puffstep.bin" >"$root/eighthour-strict.log" 2>&1
          grep -F 'P7_HEFEI_REAL_EXTENDED_SOURCE_PROBE=PASS HOURS=8' "$root/eighthour-strict.log"
          grep -F 'P7_NATIVE_PUFF_CON_PREFIX=PASS HOURS=8 RECORDS=3250' "$root/eighthour-strict.log"
          echo "P7_REAL_FIRST_8H_SCIENTIFIC_GATE=PASS H3_WORDS=20000/20000 DGM=BITWISE 143H=OPEN"
          # The original/native H1-H24 equality is now confirmed on hosted
          # Ubuntu. Promote it to a fail-closed regression gate, independently
          # of the exploratory next-day extension. Preserve hourly puff state.
          CTEAS_P7_MAKEGEO_INP=project/cases/hefei5km_2022_reference_case_20261011/geo/makegeo/makegeo.inp \
            CTEAS_P7_PROBE_HOURS=24 "$root/build/cteas_p7_hefei_sixhour_native_h3_receptors_tests" \
            project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat \
            project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp \
            project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.con \
            "$root/vendor/case/run/puff/dgm_puffstep.bin" >"$root/twentyfourhour-strict.log" 2>&1
          grep -F 'P7_HEFEI_REAL_EXTENDED_SOURCE_PROBE=PASS HOURS=24' "$root/twentyfourhour-strict.log"
          echo "P7_REAL_FIRST_24H_SCIENTIFIC_GATE=PASS H3_WORDS=60000/60000 DGM=BITWISE 143H=OPEN"
          # After hosted original/native H1-H48 verification on
          # Actions #38674251404, promote the full 48h real case to a
          # fail-closed gate (120,000 H-3 REAL4 words; all DGM rows).
          CTEAS_P7_NATIVE_PUFF_CON="$root/native-48h-puff.con" \
          CTEAS_P7_H9_PUFF598_MASS_TRACE="$root/native-h9-puff598-mass.tsv" \
          CTEAS_P7_H9_RECEIVER_CELL0=541 \
          CTEAS_P7_H9_RECEIVER_TRACE="$root/native-h9-42-11.tsv" \
            CTEAS_P7_MAKEGEO_INP=project/cases/hefei5km_2022_reference_case_20261011/geo/makegeo/makegeo.inp \
            CTEAS_P7_PROBE_HOURS=48 "$root/build/cteas_p7_hefei_sixhour_native_h3_receptors_tests" \
            project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat \
            project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp \
            project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.con \
            "$root/vendor/case/run/puff/dgm_puffstep.bin" >"$root/hour48-strict.log" 2>&1
          grep -F 'P7_HEFEI_REAL_EXTENDED_SOURCE_PROBE=PASS HOURS=48' "$root/hour48-strict.log"
          grep -F 'P7_NATIVE_PUFF_CON_PREFIX=PASS HOURS=48 RECORDS=3370' "$root/hour48-strict.log"
          echo "P7_REAL_FIRST_48H_SCIENTIFIC_GATE=PASS H3_WORDS=120000/120000 DGM=BITWISE 143H=OPEN"
          grep -E 'P7_NATIVE_H9_PUFF598_VCBAR|P7_REAL_EXTENDED_PROBE|P7_REAL_EXTENDED_PRFIN_INPUT|P7_REAL_EXTENDED_CALM_SOURCE_DECK|P7_HEFEI_REAL_EXTENDED|P7_HEFEI_REAL_6H_COMPUTATION|P7_HEFEI_6H_NATIVE_ORIGINAL_HOURLY|P7_HEFEI_6H_FIRST_ORIGINAL_DGM_DIFFERENCE|P7_REAL_H9_CALM_SIGTZ_FIRST_DIVERGENCE|P7_REAL_H9_CALM_SIGTZ_MET_AUTHORITIES|P7_REAL_H9_NATIVE_CALCPF_CELL12|P7_NATIVE_H9_RECEPTOR_SIGTZ_INPUT' "$root/hour48-strict.log" || true
          # Source-pinned same-step terrain operands for the three H9
          # ZRPOLE residuals. Diagnostic only: original state is not injected.
          grep -E 'P7_NATIVE_H9_MCTADJ2_TERRAIN PUFF=(596|597|598)' \
            "$root/hour48-strict.log" | head -n 24 || true
          # Compare the actual first remaining H9 receptor same-step stages.
          # This is read-only and diagnostic: a mismatch cannot turn into PASS.
          original_h9="$root/vendor/case/run/puff/dgm_calcpf_h3_42_11_hour9.bin"
          native_h9="$root/native-h9-42-11.tsv"
          if [ -s "$original_h9" ] && [ -s "$native_h9" ]; then
            python3 native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/compare_hour2_h3_calcpf.py \
              --hour 9 --receptor-i 42 --receptor-j 11 \
              --original "$original_h9" --native "$native_h9" \
              --out "$root/h9-same-step-audit.json" >"$root/h9-compare.log" 2>&1 || true
            grep -E 'P7_HEFEI_HOUR9|P7_HEFEI_HOUR9_42_11_STAGE_BITWISE' "$root/h9-compare.log" || \
              { echo "P7_H9_STAGE_COMPARISON=DIAGNOSTIC_ERROR"; cat "$root/h9-compare.log"; }
          else
            echo "P7_H9_STAGE_COMPARISON=NO_ALIGNED_EVENTS ORIGINAL_FILE_PRESENT=$([ -s "$original_h9" ] && echo YES || echo NO) NATIVE_FILE_PRESENT=$([ -s "$native_h9" ] && echo YES || echo NO)"
          fi
          # Pure after-the-fact comparator; no original mass enters C++.
          old_mass="$root/vendor/case/run/puff/dgm_h9_puff598_mass.bin"
          new_mass="$root/native-h9-puff598-mass.tsv"
          # Mass regression is now separately source-accepted. Reject any
          # future recurrence even while full H9 concentration remains open.
          test -s "$old_mass" && test -s "$new_mass"
          python3 native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/compare_h9_puff598_mass.py \
            --original "$old_mass" --native "$new_mass" \
            --out "$root/h9-puff598-mass-audit.json" --require-bitwise \
            >"$root/h9-puff598-mass-compare.log" 2>&1 || \
              { cat "$root/h9-puff598-mass-compare.log"; exit 1; }
          grep -F "P7_H9_PUFF598_MASS_BITWISE=PASS" "$root/h9-puff598-mass-compare.log"
          echo "P7_REAL_H9_PUFF598_MASS_GATE=PASS QOLD_QNEW_FRACDRY_VD_TSAMP_ALL_8_REAL4 H9_CONCENTRATION=OPEN"
          # H1-H48 source/REAL4 parity and H9 puff598 mass are now strict.
          # H49-H72 is deliberately exploratory, never an automatic 143h claim.
          set +e
          CTEAS_P7_NATIVE_PUFF_CON="$root/native-72h-puff.con" \
          CTEAS_P7_MAKEGEO_INP=project/cases/hefei5km_2022_reference_case_20261011/geo/makegeo/makegeo.inp \
            CTEAS_P7_PROBE_HOURS=72 "$root/build/cteas_p7_hefei_sixhour_native_h3_receptors_tests" \
            project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat \
            project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp \
            project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.con \
            "$root/vendor/case/run/puff/dgm_puffstep.bin" >"$root/hour72-probe.log" 2>&1
          code72=$?
          set -e
          grep -E 'P7_REAL_EXTENDED_PROBE_ENTER_HOUR|P7_HEFEI_REAL_EXTENDED_SOURCE_PROBE|P7_HEFEI_6H_FIRST_ORIGINAL_DGM_DIFFERENCE|P7_HEFEI_REAL_6H_COMPUTATION|P7_HEFEI_6H_NATIVE_ORIGINAL_HOURLY HOUR=(4[89]|5[0-9]|6[0-9]|7[0-2])' "$root/hour72-probe.log" || true
          if [ "$code72" -eq 0 ] && grep -Fq 'P7_HEFEI_REAL_EXTENDED_SOURCE_PROBE=PASS HOURS=72' "$root/hour72-probe.log"; then
            echo "P7_EXTENDED_PROBE_STATUS=SEVENTY_TWO_HOURS_BITWISE_ACCEPTED 143H=OPEN WROUT1=OPEN"
          else
            echo "P7_EXTENDED_PROBE_STATUS=BLOCKED HOURS=72 DIAGNOSTIC_ONLY=YES EXIT_CODE=$code72"
            tail -n 30 "$root/hour72-probe.log"
          fi
          # Strict gates: H1-H8, H1-H24, H1-H48 REAL4/DGM, H9 mass 8x5.
          # The 72h scientific probe is not a workflow-failing acceptance gate.
          exit 0
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: p7-real-first-48h-hour72-divergence-log
          path: |
            ${{ runner.temp }}/p7-hour7-${{ github.run_id }}-${{ github.run_attempt }}/eighthour-strict.log
            ${{ runner.temp }}/p7-hour7-${{ github.run_id }}-${{ github.run_attempt }}/twentyfourhour-strict.log
            ${{ runner.temp }}/p7-hour7-${{ github.run_id }}-${{ github.run_attempt }}/hour48-strict.log
            ${{ runner.temp }}/p7-hour7-${{ github.run_id }}-${{ github.run_attempt }}/hour72-probe.log
            ${{ runner.temp }}/p7-hour7-${{ github.run_id }}-${{ github.run_attempt }}/native-8h-puff.con
            ${{ runner.temp }}/p7-hour7-${{ github.run_id }}-${{ github.run_attempt }}/native-48h-puff.con
            ${{ runner.temp }}/p7-hour7-${{ github.run_id }}-${{ github.run_attempt }}/native-72h-puff.con
            ${{ runner.temp }}/p7-hour7-${{ github.run_id }}-${{ github.run_attempt }}/h9-compare.log
            ${{ runner.temp }}/p7-hour7-${{ github.run_id }}-${{ github.run_attempt }}/h9-same-step-audit.json
            ${{ runner.temp }}/p7-hour7-${{ github.run_id }}-${{ github.run_attempt }}/h9-puff598-mass-audit.json
            ${{ runner.temp }}/p7-hour7-${{ github.run_id }}-${{ github.run_attempt }}/h9-puff598-mass-compare.log
            ${{ runner.temp }}/p7-hour7-${{ github.run_id }}-${{ github.run_attempt }}/native-h9-puff598-mass.tsv
            ${{ runner.temp }}/p7-hour7-${{ github.run_id }}-${{ github.run_attempt }}/vendor/original-h9-puff598-mass.json
            ${{ runner.temp }}/p7-hour7-${{ github.run_id }}-${{ github.run_attempt }}/vendor/original-h9-puff598-vcbar.json
            ${{ runner.temp }}/p7-hour7-${{ github.run_id }}-${{ github.run_attempt }}/vendor/original-h9-mctadj2-receptor42-11.json
            ${{ runner.temp }}/p7-hour7-${{ github.run_id }}-${{ github.run_attempt }}/native-h9-42-11.tsv
            ${{ runner.temp }}/p7-hour7-${{ github.run_id }}-${{ github.run_attempt }}/vendor/original-h9-puff594-receptor21-1-sigtz.json
            ${{ runner.temp }}/p7-hour7-${{ github.run_id }}-${{ github.run_attempt }}/vendor/original-h9-puff594-receptor21-1-szfloor.json
            ${{ runner.temp }}/p7-hour7-${{ github.run_id }}-${{ github.run_attempt }}/original-h9-calm.json
          retention-days: 7
          if-no-files-found: warn
