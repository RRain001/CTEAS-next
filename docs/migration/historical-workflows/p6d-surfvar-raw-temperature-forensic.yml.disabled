name: P6D original SURFVAR raw temperature before AVETMP
on:
  pull_request:
    paths:
      - scripts/p6d_surfvar_raw_temperature_forensic.py
      - .github/workflows/p6d-surfvar-raw-temperature-forensic.yml
  workflow_dispatch:
permissions:
  contents: read
jobs:
  original-surfvar-pre-avetmp:
    name: Original Fortran single-station TEMP2D real4 rounding in 143 hours
    runs-on: ubuntu-22.04
    timeout-minutes: 75
    steps:
      - uses: actions/checkout@v4
        with:
          filter: blob:none
          sparse-checkout: |
            .github/actions/cteas-linux-toolchain
            engine/vendor/src/CALMET_v6.5.0_L150223
            native_cpp/modules/p6_calmet/reference
            scripts/p6d_surfvar_raw_temperature_forensic.py
      - uses: ./.github/actions/cteas-linux-toolchain
      - name: Restore immutable met inputs and verify original original-vs-instrumented output
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-surfvar-raw-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          python3 native_cpp/modules/p6_calmet/reference/restore_frozen_case_from_git.py --mode grid
          python3 native_cpp/modules/p6_calmet/reference/original_internal_state_dump.py audit \
            --vendor engine/vendor/src/CALMET_v6.5.0_L150223 \
            --case project/cases/hefei5km_2022_reference_case_20261011 \
            --out "$root/original" --compiler gfortran-11
      - name: Compare original pre-AVETMP single-station grid value distribution
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-surfvar-raw-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          python3 scripts/p6d_surfvar_raw_temperature_forensic.py \
            --original-dir "$root/original" \
            --case project/cases/hefei5km_2022_reference_case_20261011 \
            --compiler gfortran-11 \
            --out "$root/source_raw_surfvar_temp_143h.json"
      - name: Archive non-intrusive original CALMET SURFVAR evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: p6d-original-raw-surfvar-143h
          path: |
            ${{ runner.temp }}/p6d-surfvar-raw-${{ github.run_id }}-${{ github.run_attempt }}/source_raw_surfvar_temp_143h.json
            ${{ runner.temp }}/p6d-surfvar-raw-${{ github.run_id }}-${{ github.run_attempt }}/original/dgm-audit.json
          if-no-files-found: warn
          retention-days: 14
