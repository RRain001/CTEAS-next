name: P6D original 143h station ELUSTR2 physics

on:
  push:
    branches: [audit/p6d-source-slope-drivers-143h-20261012]
    paths:
      - 'scripts/p6d_compare_original_station_elustr2_143h.py'
      - 'native_cpp/modules/p6_calmet/include/cteas/p6/station_elustr2.hpp'
      - 'native_cpp/modules/p6_calmet/src/realcase_wind_field_main.cpp'
      - '.github/workflows/p6d-original-station-elustr2-143h.yml'
  pull_request:
    paths:
      - 'scripts/p6d_compare_original_station_elustr2_143h.py'
      - 'native_cpp/modules/p6_calmet/include/cteas/p6/station_elustr2.hpp'
      - 'native_cpp/modules/p6_calmet/src/realcase_wind_field_main.cpp'
      - '.github/workflows/p6d-original-station-elustr2-143h.yml'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: p6d-station-elustr2-${{ github.ref }}
  cancel-in-progress: true

jobs:
  source-143h-station-elustr2:
    name: Native 143h original ELUSTR2 QQH USTAR EL without oracle input
    runs-on: ubuntu-22.04
    timeout-minutes: 25
    steps:
      - uses: actions/checkout@v4
        with:
          filter: blob:none
          sparse-checkout: |
            .github/actions/cteas-linux-toolchain
            native_cpp/modules/p6_calmet
            scripts
      - uses: ./.github/actions/cteas-linux-toolchain
      - name: Restore SHA-locked 2022 reference inputs
        run: python3 native_cpp/modules/p6_calmet/reference/restore_frozen_case_from_git.py --mode grid
      - name: Build and produce 143h native station ELUSTR2
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-station-elustr2-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          cmake -S native_cpp/modules/p6_calmet -B "$root/build" -DCMAKE_BUILD_TYPE=Release
          cmake --build "$root/build" --target cteas_p6_realcase_wind_field --parallel 1
          "$root/build/cteas_p6_realcase_wind_field" \
            --case project/cases/hefei5km_2022_reference_case_20261011 \
            --hours 143 --out "$root/native"
      - name: Source compare original ELUSTR2 station QH USTAR EL RHO Z0
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-station-elustr2-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          python3 scripts/p6d_compare_original_station_elustr2_143h.py \
            --reference native_cpp/modules/p6_calmet/reference/dgm_p6d_requests_2022/dgm_cell.json \
            --source-bin native_cpp/modules/p6_calmet/reference/dgm_p6d_requests_2022/dgm_cell.bin \
            --native "$root/native/station_elustr2.csv" \
            --out "$root/station_elustr2_report.json" --require-parity
      - name: Archive original station ELUSTR2 parity evidence
        if: always()
        uses: actions/upload-artifact@v4
        continue-on-error: true
        with:
          name: p6d-station-elustr2-143h
          path: ${{ runner.temp }}/p6d-station-elustr2-${{ github.run_id }}-${{ github.run_attempt }}/station_elustr2_report.json
          if-no-files-found: warn
          retention-days: 14