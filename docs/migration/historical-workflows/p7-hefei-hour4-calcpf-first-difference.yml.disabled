name: P7 real Hefei hour4 first original CALCPF divergence
on:
  pull_request:
    paths:
      - 'native_cpp/modules/p7_calpuff/**'
      - '.github/workflows/p7-hefei-hour4-calcpf-first-difference.yml'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: p7-hefei-hour4-first-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
jobs:
  original-vendor-native-hour4:
    runs-on: ubuntu-22.04
    timeout-minutes: 55
    steps:
      - name: Ensure original Fortran 11 is installed
        shell: bash
        run: |
          set -euo pipefail
          if ! command -v gfortran-11 >/dev/null 2>&1; then
            sudo apt-get update -qq
            sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq gfortran-11
          fi
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
          filter: blob:none
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /native_cpp/modules/p7_calpuff/**
            /engine/vendor/src/CALPUFF_v7.2.1_L150618/**
            /project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat
            /project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp
            /project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.con
      - name: Capture original source-only hour4 receptor (47,13)
        shell: bash
        run: |
          set -euo pipefail
          root="${RUNNER_TEMP}/p7-hour4-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          mkdir -p "$root/frozen/run/puff" "$root/frozen/deliverables/met"
          cp project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp \
            "$root/frozen/run/puff/puff.inp"
          ln -s "${GITHUB_WORKSPACE}/project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat" \
            "$root/frozen/deliverables/met/met.dat"
          python3 native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/original_calcpf_receiver_oracle.py \
            --vendor engine/vendor/src/CALPUFF_v7.2.1_L150618 \
            --case "$root/frozen" --out "$root/vendor" \
            --compiler "$(command -v gfortran-11)" \
            --hour 4 --receptor-i 47 --receptor-j 13
          python3 native_cpp/modules/p7_calpuff/reference/extract_original_six_hours.py \
            --full "$root/vendor/case/run/puff/dgm_puffstep.bin" \
            --metadata native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/dgm_puffstep.json \
            --out "$root/original-sixhour-dgm.bin"
      - name: Compare same actual old-puff COMP substeps and CALCPF H3 source stages
        shell: bash
        run: |
          set -euo pipefail
          root="${RUNNER_TEMP}/p7-hour4-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          cmake -S native_cpp/modules/p7_calpuff -B "$root/build" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$root/build" --parallel 2 \
            --target cteas_p7_hefei_sixhour_native_h3_receptors_tests
          "$root/build/cteas_p7_hefei_sixhour_native_h3_receptors_tests" \
            project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat \
            project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp \
            project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.con \
            "$root/original-sixhour-dgm.bin" \
            "$root/native-hour2-25-28.tsv" \
            "$root/native-hour4-47-13.tsv"
          python3 native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/compare_hour2_h3_calcpf.py \
            --hour 4 \
            --original "$root/vendor/case/run/puff/dgm_calcpf_h3_47_13_hour4.bin" \
            --native "$root/native-hour4-47-13.tsv" \
            --out "$root/original-hour4-first-difference.json"
          echo "P7_HOUR4_PHYSICAL_STAGE_DIAGNOSTIC=CAPTURED FULL_6H_H3_PARITY=OPEN"
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: p7-hour4-same-source-first-calcpf-difference
          path: |
            ${{ runner.temp }}/p7-hour4-${{ github.run_id }}-${{ github.run_attempt }}/original-hour4-first-difference.json
            ${{ runner.temp }}/p7-hour4-${{ github.run_id }}-${{ github.run_attempt }}/native-hour4-47-13.tsv
            ${{ runner.temp }}/p7-hour4-${{ github.run_id }}-${{ github.run_attempt }}/vendor/original-calcpf-h3-47-13-hour4.json
          retention-days: 7
          if-no-files-found: warn
