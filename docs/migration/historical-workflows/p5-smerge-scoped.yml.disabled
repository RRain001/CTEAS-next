name: P5 SMERGE scoped C++20
concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true
on:
  pull_request:
    paths:
      - 'native_cpp/include/cteas/met_input/**'
      - 'native_cpp/tests/**'
      - 'native_cpp/modules/p5_smerge/**'
      - '.github/workflows/p5-smerge-scoped.yml'
jobs:
  unit:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 8
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4
      - name: Provision GitHub-hosted GCC12 and Fortran12
        shell: bash
        run: |
          set -euo pipefail
          sudo apt-get update -qq
          sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq g++-12 gfortran-12
      - name: Select isolated C++20 and Fortran compilers
        uses: ./.github/actions/cteas-linux-toolchain
      - name: Reset self-hosted scratch directories
        shell: bash
        run: |
          rm -rf ${{ runner.temp }}/cteas-p5-build ${{ runner.temp }}/cteas-p5-release
      - name: Configure
        run: cmake -S native_cpp/modules/p5_smerge -B ${{ runner.temp }}/cteas-p5-build -DCMAKE_BUILD_TYPE=Debug
      - name: Build
        run: cmake --build ${{ runner.temp }}/cteas-p5-build -j2
      - name: Test
        run: ctest --test-dir ${{ runner.temp }}/cteas-p5-build --output-on-failure

      - name: Release build and real runtime asserts
        shell: bash
        run: |
          set -euo pipefail
          cmake -S native_cpp/modules/p5_smerge -B ${{ runner.temp }}/cteas-p5-release -DCMAKE_BUILD_TYPE=Release
          cmake --build ${{ runner.temp }}/cteas-p5-release -j2
          ctest --test-dir ${{ runner.temp }}/cteas-p5-release --output-on-failure

      - name: Validate scoped NOAA station/field/missing policies
        run: |
          python3 -m pip install --disable-pip-version-check pandas numpy
          python3 -m unittest discover -s native_cpp/modules/p5_smerge/data_prep/tests -p 'test_*.py' -v
      - name: Verify original CTEAS sources untouched and scoped Python changes
        shell: bash
        run: |
          set -euo pipefail
          python3 -m compileall -q native_cpp/modules/p5_smerge/data_prep
          python3 -m native_cpp.modules.p5_smerge.data_prep.prepare_inputs --expected-year 2022
          python3 - <<'PY'
          from pathlib import Path
          old=Path("engine/preprocess/smerge_surf_data")
          new=Path("native_cpp/modules/p5_smerge/data_prep")
          # Original source scripts remain unchanged in their canonical
          # engine/preprocess location; scoped copies evolve independently.
          # Stage-specific P5 logic intentionally changes the copied scripts.
          import subprocess
          subprocess.run(["git","fetch","--quiet","--depth=1","origin","main"],check=True)
          for name in ("clean_merge_filled_by_research_time.py",
                       "convert_cleaned_to_smerge_ready.py"):
              source="engine/preprocess/smerge_surf_data/"+name
              baseline=subprocess.check_output(["git","show","FETCH_HEAD:"+source])
              assert (old/name).read_bytes()==baseline,name
          assert (old/"README.md").read_bytes()==(new/"upstream_README.md").read_bytes()
          # Edited copies are kept in a separate directory, never in engine.
          assert "standardize_sparse_station" in (new/"interpolate.py").read_text()
          assert "P5_CALMET_PRIMARY_WIND_GAP" in (new/"clean_merge_filled_by_research_time.py").read_text()
          assert "station_selection_" in (new/"isd_to_smerge_and_fill.py").read_text()
          assert "station_selection_" in (new/"download_isd_by_grid.py").read_text()
          assert "source-selection manifest" in (new/"isd_to_smerge_and_fill.py").read_text()
          assert "resolve_ifstn" in (new/"generate_smerge_input_sections.py").read_text()
          assert (new/"run_smerge_and_monitor.py").is_file()
          print("P5_ORIGINAL_UNCHANGED_AND_SCOPED_REFACTOR=PASS")
          PY
