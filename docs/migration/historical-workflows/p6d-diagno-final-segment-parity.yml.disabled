name: P6D original DIAGNO final 3D W segment parity
concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true
on:
  pull_request:
    paths:
      - '.github/scripts/p6d_verified_checkout.py'
      - 'native_cpp/modules/p6_calmet/include/cteas/p6/*diagno*'
      - 'native_cpp/modules/p6_calmet/src/diagno_segment_main.cpp'
      - 'native_cpp/modules/p6_calmet/reference/*diagno*'
      - 'native_cpp/modules/p6_calmet/include/cteas/p6/*smooth*'
      - 'native_cpp/modules/p6_calmet/include/cteas/p6/*divcel*'
      - 'native_cpp/modules/p6_calmet/include/cteas/p6/*wind*'
      - 'native_cpp/modules/p6_calmet/tests/p6_diagno_segment_tests.cpp'
      - 'docs/reconstruction_cpp/CI_FULL_REGRESSION_REQUEST.md'
  workflow_dispatch:
permissions:
  contents: read
jobs:
  original-diagno-segment:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 14
    steps:
      - name: Verify GitHub-hosted P6D environment
        shell: bash
        run: |
          echo "P6D runner=$RUNNER_NAME os=$RUNNER_OS arch=$RUNNER_ARCH"
          if [[ "$RUNNER_OS" != "Linux" || "$RUNNER_ARCH" != "X64" ]]; then
            echo "::error::P6D requires a Linux/X64 GitHub-hosted runner"
            exit 1
          fi
      - name: Probe GitHub checkout transports on dedicated P6D host
        id: source_transport
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          if curl -fIsS --connect-timeout 5 --max-time 8 https://github.com/ >/dev/null 2>&1; then
            echo "git=yes" >> "$GITHUB_OUTPUT"
          else
            echo "git=no" >> "$GITHUB_OUTPUT"
            echo "::warning::github.com unavailable; attempt verified REST fallback"
          fi
          if curl -fIsS --connect-timeout 5 --max-time 8 \
            -H "Authorization: Bearer $GH_TOKEN" -H "Accept: application/vnd.github+json" \
            "https://api.github.com/repos/$GITHUB_REPOSITORY" >/dev/null 2>&1; then
            echo "rest=yes" >> "$GITHUB_OUTPUT"
          else
            echo "rest=no" >> "$GITHUB_OUTPUT"
          fi
          if ! grep -Eq '^(git|rest)=yes$' "$GITHUB_OUTPUT"; then
            echo "::error::Both Git and REST source transports unavailable"; exit 1
          fi
      - name: Checkout P6D source if github.com is reachable
        id: p6d_checkout
        if: steps.source_transport.outputs.git == 'yes'
        continue-on-error: true
        uses: actions/checkout@v4
        with:
          filter: blob:none
          sparse-checkout: |
            native_cpp/modules/p6_calmet
            engine/vendor/src/CALMET_v6.5.0_L150223
            .github/actions/cteas-linux-toolchain
      - name: Restore immutable P6D source via authenticated REST
        if: (steps.source_transport.outputs.git != 'yes' || steps.p6d_checkout.outcome == 'failure') && steps.source_transport.outputs.rest == 'yes'
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          # Load bootstrap code from exact PR Git tree and verify before execution.
          python3 - <<'PY'
          import base64, hashlib, json, os
          from pathlib import Path
          from urllib.request import Request, urlopen
          api = "https://api.github.com/repos/" + os.environ["GITHUB_REPOSITORY"]
          headers = {"Authorization": "Bearer " + os.environ["GH_TOKEN"],
                     "Accept": "application/vnd.github+json",
                     "User-Agent": "CTEAS-P6D-bootstrap-verifier"}
          def read(path):
              with urlopen(Request(api + path, headers=headers), timeout=30) as r:
                  return json.load(r)
          commit = read("/git/commits/" + os.environ["GITHUB_SHA"])
          tree = read("/git/trees/" + commit["tree"]["sha"] + "?recursive=1")
          if tree.get("truncated"):
              raise RuntimeError("Source tree truncated")
          name = ".github/scripts/p6d_verified_checkout.py"
          matched = [x for x in tree["tree"] if x["path"] == name and x["type"] == "blob"]
          if len(matched) != 1:
              raise RuntimeError("Required verified source bootstrap missing")
          expected = matched[0]["sha"]
          blob = read("/git/blobs/" + expected)
          if blob.get("encoding") != "base64":
              raise RuntimeError("Bootstrap encoding mismatch")
          data = base64.b64decode(blob["content"])
          actual = hashlib.sha1(b"blob " + str(len(data)).encode() + b"\0" + data).hexdigest()
          if actual != expected:
              raise RuntimeError("Bootstrap SHA-1 integrity mismatch")
          out = Path(os.environ["RUNNER_TEMP"]) / "p6d_verified_checkout.py"
          out.write_bytes(data)
          print("P6D bootstrap source SHA-1 PASS: " + expected)
          PY
          python3 "$RUNNER_TEMP/p6d_verified_checkout.py"
      - name: Verify complete P6D source tree
        shell: bash
        run: |
          set -euo pipefail
          for p in native_cpp/modules/p6_calmet/CMakeLists.txt \
                   engine/vendor/src/CALMET_v6.5.0_L150223/calmet.for \
                   native_cpp/modules/p6_calmet/reference/compare_original_inter2.py \
                   .github/actions/cteas-linux-toolchain/action.yml; do
            test -s "$p" || { echo "::error::Missing source $p"; exit 1; }
          done
      - name: Select GitHub-hosted C++20 and Fortran tools
        uses: ./.github/actions/cteas-linux-toolchain
      - name: Install unchanged Fortran reference compiler
        run: gfortran --version | head -1
      - name: C++20 build and all prior P6 CTests
        run: |
          cmake -S native_cpp/modules/p6_calmet -B "$RUNNER_TEMP/cteas-p6d-final-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$RUNNER_TEMP/cteas-p6d-final-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT" --parallel 2
          ctest --test-dir "$RUNNER_TEMP/cteas-p6d-final-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT" --output-on-failure -E '^p6g_'
      - name: Literal DIAGNO source L6119–6148 and vendor Fortran against C++
        run: |
          python3 native_cpp/modules/p6_calmet/reference/compare_original_diagno_final_segment.py \
            --vendor engine/vendor/src/CALMET_v6.5.0_L150223 \
            --cpp "$RUNNER_TEMP/cteas-p6d-final-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"/cteas_p6_final_segment \
            --out "$RUNNER_TEMP/cteas-diagno-original-segment-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
      - name: Record comparison
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: p6d-original-diagno-selected-segment
          path: ${{ runner.temp }}/cteas-diagno-original-segment-${{ github.run_id }}-${{ github.run_attempt }}/p6d-final-segment-parity.json
          if-no-files-found: warn
          retention-days: 14