name: P6 C++ hourly causal coordinator byte parity

on:
  push:
    branches: [codex/p6-hourly-stateful-scheduler-20261013]
    paths:
      - native_cpp/modules/p6_calmet/src/native_hourly_driver_main.cpp
      - native_cpp/modules/p6_calmet/CMakeLists.txt
      - native_cpp/modules/p6_calmet/include/cteas/p6/native_comp_history.hpp
      - native_cpp/modules/p6_calmet/tests/p6_native_comp_history_tests.cpp
      - .github/workflows/p6-native-cpp-driver-parity.yml
  pull_request:
    paths:
      - native_cpp/modules/p6_calmet/src/native_hourly_driver_main.cpp
      - native_cpp/modules/p6_calmet/CMakeLists.txt
      - native_cpp/modules/p6_calmet/include/cteas/p6/native_comp_history.hpp
      - native_cpp/modules/p6_calmet/tests/p6_native_comp_history_tests.cpp
      - .github/workflows/p6-native-cpp-driver-parity.yml
  workflow_dispatch:

permissions:
  contents: read

jobs:
  hefei-cpp-vs-python:
    name: Existing P6D/P6E chain vs C++ coordinator, 6h then 143h
    runs-on: ubuntu-22.04
    timeout-minutes: 120
    steps:
      - uses: actions/checkout@v4
        with:
          filter: blob:none
          sparse-checkout: |
            native_cpp/modules/p6_calmet
            scripts/p6_run_native_causal_hourly.py
      - uses: actions/checkout@v4
        with:
          ref: 3b94cdbfbb5f44146ba51a4ef112114f199d28b9
          path: original_locked_case
          filter: blob:none
          sparse-checkout: |
            project/cases/hefei5km_2022_reference_case_20261011
      - name: Build unmodified physics binaries and C++ coordinator (GCC12, Werror)
        shell: bash
        run: |
          set -euo pipefail
          cmake -S native_cpp/modules/p6_calmet \
            -B "$RUNNER_TEMP/native-p6d" -DCMAKE_BUILD_TYPE=Release \
            -DCMAKE_CXX_COMPILER=g++-12
          cmake --build "$RUNNER_TEMP/native-p6d" \
            --target cteas_p6_realcase_wind_field \
                     cteas_p6_native_cgamma_grid_143h \
                     cteas_p6_native_hourly_driver \
                     cteas_p6_native_comp_history_tests --parallel 2
          cmake -S native_cpp/modules/p6_calmet/p6e \
            -B "$RUNNER_TEMP/native-p6e" -DCMAKE_BUILD_TYPE=Release \
            -DCMAKE_CXX_COMPILER=g++-12
          cmake --build "$RUNNER_TEMP/native-p6e" \
            --target p6e_calmet_dat21 p6e_p6c_hourly_bridge --parallel 2
      - name: Fail-closed coordinator contract (no reference, no outputs)
        shell: bash
        run: |
          set -euo pipefail
          ctest --test-dir "$RUNNER_TEMP/native-p6d" --output-on-failure \
            -R '^p6_native_cpp_(hourly_driver_fail_closed_missing_case|comp_history_state_and_rollback)$'
      - name: "Control-variable replay: 6h first, then full 143h"
        shell: bash
        run: |
          set -euo pipefail
          reference="$GITHUB_WORKSPACE/original_locked_case/project/cases/hefei5km_2022_reference_case_20261011"
          p6d="$RUNNER_TEMP/native-p6d/cteas_p6_realcase_wind_field"
          p6e="$RUNNER_TEMP/native-p6e/p6e_calmet_dat21"
          gamma="$RUNNER_TEMP/native-p6d/cteas_p6_native_cgamma_grid_143h"
          bridge="$RUNNER_TEMP/native-p6e/p6e_p6c_hourly_bridge"
          mkdir -p "$RUNNER_TEMP/coordinator-parity"
          for n in 6 143; do
            py="$RUNNER_TEMP/coordinator-parity/python-$n"
            cpp="$RUNNER_TEMP/coordinator-parity/cpp-$n"
            extra=()
            if [ "$n" -eq 143 ]; then extra=(--emit-source-stage-trace); fi
            python3 scripts/p6_run_native_causal_hourly.py \
              --case "$reference" --p6d "$p6d" --p6e "$p6e" \
              --cgamma "$gamma" --bridge "$bridge" \
              --hours "$n" --work "$py" "${extra[@]}" > "$RUNNER_TEMP/coordinator-parity/python-$n.log"
            "$RUNNER_TEMP/native-p6d/cteas_p6_native_hourly_driver" \
              --case "$reference" --p6d "$p6d" --p6e "$p6e" \
              --cgamma "$gamma" --bridge "$bridge" \
              --hours "$n" --work "$cpp" "${extra[@]}" > "$RUNNER_TEMP/coordinator-parity/cpp-$n.log"
            cmp "$py/native_causal_calmet.dat" "$cpp/native_causal_calmet.dat"
            cmp "$py/native_station_flux.csv" "$cpp/native_station_flux.csv"
            cmp "$py/observations.csv" "$cpp/observations.csv"
            for ((h=0; h<n; h++)); do
              printf -v suffix '%03d' "$h"
              for field in zi ziconv dptt; do
                cmp "$py/hour_$suffix/comp.$field.f32" \
                    "$cpp/hour_$suffix/comp.$field.f32"
              done
              cmp "$py/hour_$suffix/met_native_1h.dat" \
                  "$cpp/hour_$suffix/met_native_1h.dat"
            done
            if [ "$n" -eq 143 ]; then
              py_stage="$py/native_source_stage_143h"
              cpp_stage="$cpp/native_source_stage_143h"
              find "$py_stage" -maxdepth 1 -type f -printf "%f\n" | sort > "$py/stage_names.txt"
              find "$cpp_stage" -maxdepth 1 -type f -printf "%f\n" | sort > "$cpp/stage_names.txt"
              cmp "$py/stage_names.txt" "$cpp/stage_names.txt"
              while IFS= read -r file; do
                cmp "$py_stage/$file" "$cpp_stage/$file"
              done < "$py/stage_names.txt"
            fi
            digest="$(sha256sum "$cpp/native_causal_calmet.dat" | cut -d' ' -f1)"
            echo "hours=$n P6D/P6E_CXX_DRIVER_BYTE_PARITY=PASS sha256=$digest" |
              tee -a "$RUNNER_TEMP/coordinator-parity/acceptance.txt"
          done
          echo 'CXX_DRIVER_ACCEPTANCE=PASS_BYTE_IDENTICAL_6H_143H; ORIGINAL_45_FIELD_SCIENCE=SEPARATE_GATE' |
            tee -a "$RUNNER_TEMP/coordinator-parity/acceptance.txt"
      - name: Archive reproducible coordinator parity evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: p6-cpp-hourly-coordinator-parity
          path: |
            ${{ runner.temp }}/coordinator-parity/acceptance.txt
            ${{ runner.temp }}/coordinator-parity/*-6.log
            ${{ runner.temp }}/coordinator-parity/*-143.log
            ${{ runner.temp }}/coordinator-parity/cpp-6/native_cpp_hourly_manifest.json
            ${{ runner.temp }}/coordinator-parity/cpp-143/native_cpp_hourly_manifest.json
          retention-days: 14
          if-no-files-found: warn
