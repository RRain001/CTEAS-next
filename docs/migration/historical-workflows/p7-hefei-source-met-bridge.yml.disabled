name: P7 real Hefei point source and 143h native stack WINDSET
on:
  pull_request:
    paths:
      - 'native_cpp/modules/p7_calpuff/**'
      - '.github/workflows/p7-hefei-source-met-bridge.yml'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: p7-hefei-source-met-${{ github.sha }}
  cancel-in-progress: false
jobs:
  real-source-stack-wind:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
          filter: blob:none
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /native_cpp/modules/p7_calpuff/**
            /project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat
            /project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp
      - name: Check genuine frozen source and 143 hourly native WINDSET samples
        shell: bash
        run: |
          set -euo pipefail
          build="${RUNNER_TEMP}/p7-hefei-source-${GITHUB_RUN_ID}"
          cmake -S native_cpp/modules/p7_calpuff -B "$build" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$build" --target cteas_p7_original_hefei_source_met_bridge_tests --parallel 2
          ctest --test-dir "$build" -R '^cteas_p7_hefei_source_met_stack_bridge$' --output-on-failure -V
          echo 'P7_HEFEI_FULL_NATIVE_PRFIN_COMP_DRY_CALCPF=NOT_ACCEPTED'
