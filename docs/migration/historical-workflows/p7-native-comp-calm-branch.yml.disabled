name: P7 original COMP calm transport and hour-atomic gate
on:
  pull_request:
    paths:
      - 'native_cpp/modules/p7_calpuff/**'
      - '.github/workflows/p7-native-comp-calm-branch.yml'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: p7-native-comp-calm-${{ github.sha }}
  cancel-in-progress: false
jobs:
  original-calm-production-gate:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 18
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
          filter: blob:none
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /native_cpp/modules/p7_calpuff/**
      - name: Build native rising COMP WSCALM boundary and original IDOPT1 state
        shell: bash
        run: |
          set -euo pipefail
          build="${RUNNER_TEMP}/p7-calm-${GITHUB_RUN_ID}"
          cmake -S native_cpp/modules/p7_calpuff -B "$build" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$build" --parallel 2 --target cteas_p7_original_comp_calm_tests cteas_p7_original_comp_calm_integrated_tests
          ctest --test-dir "$build" -R '^cteas_p7_native_comp_calm_(branch_atomic|idopt1_transaction)$' --output-on-failure -V
          echo 'P7_CALM_SOURCE_ORDER_AND_ATOMICITY=PASS'
          echo 'P7_HEFEI_ORIGINAL_989_CALM_SUBSTEPS=NOT_YET_ACCEPTED'
