name: P7 original first-hour H3 CALCPF receptor intermediates
on:
  pull_request:
    paths:
      - 'native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/original_calcpf_receiver_oracle.py'
      - '.github/workflows/p7-hefei-original-calcpf-receiver-trace.yml'
      - 'native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/compare_h3_calcpf_receiver_traces.py'
      - 'native_cpp/modules/p7_calpuff/tests/original_hefei_firsthour_native_receptors_tests.cpp'
      - 'native_cpp/modules/p7_calpuff/src/original_flat_calcpf.cpp'
      - 'native_cpp/modules/p7_calpuff/include/cteas/puff/original_flat_calcpf.hpp'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: p7-original-calcpf-h3-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
jobs:
  vendor-first-hour-h3:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 45
    steps:
      - name: Verify original Fortran 11 is available on hosted Ubuntu
        shell: bash
        run: |
          set -euo pipefail
          if ! command -v gfortran-11 >/dev/null 2>&1; then
            sudo apt-get update -qq
            sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq gfortran-11
          fi
          gfortran-11 --version | head -n 1
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
          filter: blob:none
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /native_cpp/modules/p7_calpuff/**
            /engine/vendor/src/CALPUFF_v7.2.1_L150618/**
            /project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp
            /project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat
      - name: Replay unchanged original physical case with write-only CALCPF trace
        shell: bash
        run: |
          set -euo pipefail
          root="${RUNNER_TEMP}/p7-h3-calcpf-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          mkdir -p "$root/frozen/run/puff" "$root/frozen/deliverables/met"
          cp project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp \
            "$root/frozen/run/puff/puff.inp"
          ln -s "${GITHUB_WORKSPACE}/project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat" \
            "$root/frozen/deliverables/met/met.dat"
          python3 native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/original_calcpf_receiver_oracle.py \
            --vendor engine/vendor/src/CALPUFF_v7.2.1_L150618 \
            --case "$root/frozen" --out "$root/reference" \
            --compiler "$(command -v gfortran-11)"
          echo "P7_ORIGINAL_PUFRECS_H3_INTERMEDIATES=CAPTURED_ORIGINAL_FIRST_HOUR"
          echo "P7_NATIVE_CALCPF_PARITY=NOT_YET_ACCEPTED"
      - name: Compile native C++ and compare the same first-hour physical stage
        shell: bash
        run: |
          set -euo pipefail
          root="${RUNNER_TEMP}/p7-h3-calcpf-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          native="$root/native"
          cmake -S native_cpp/modules/p7_calpuff -B "$native" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$native" --parallel 2 --target cteas_p7_hefei_firsthour_native_h3_receptors_tests
          "$native/cteas_p7_hefei_firsthour_native_h3_receptors_tests" \
            project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat \
            "$root/frozen/run/puff/puff.inp" \
            "$root/reference/case/run/puff/puff.con" \
            "$root/reference/native-h3-calcpf-19-50.tsv"
          python3 native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/compare_h3_calcpf_receiver_traces.py \
            --original "$root/reference/case/run/puff/dgm_calcpf_h3_19_50.bin" \
            --native "$root/reference/native-h3-calcpf-19-50.tsv" \
            --out "$root/reference/h3-calcpf-first-divergence.json"
          echo "P7_H3_CALCPF_FIRST_DIVERGENCE_CAPTURED=YES SCIENTIFIC_PARITY=OPEN"
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: p7-vendor-firsthour-h3-calcpf-stage
          path: |
            ${{ runner.temp }}/p7-h3-calcpf-${{ github.run_id }}-${{ github.run_attempt }}/reference/original-calcpf-h3-19-50.json
            ${{ runner.temp }}/p7-h3-calcpf-${{ github.run_id }}-${{ github.run_attempt }}/reference/h3-calcpf-first-divergence.json
            ${{ runner.temp }}/p7-h3-calcpf-${{ github.run_id }}-${{ github.run_attempt }}/reference/native-h3-calcpf-19-50.tsv
            ${{ runner.temp }}/p7-h3-calcpf-${{ github.run_id }}-${{ github.run_attempt }}/reference/case/run/puff/dgm_calcpf_h3_19_50.bin
            ${{ runner.temp }}/p7-h3-calcpf-${{ github.run_id }}-${{ github.run_attempt }}/reference/case/run/puff/puff_runtime.log
          retention-days: 7
          if-no-files-found: warn
