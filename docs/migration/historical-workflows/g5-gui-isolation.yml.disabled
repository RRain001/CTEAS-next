name: G5 copied GUI isolation and native dispatcher

on:
  pull_request:
    paths:
      - "engine/gui_g5/**"
      - "engine/run_met/station_grid.py"
      - ".github/workflows/g5-gui-isolation.yml"
      - "cteas-g5gui"
  push:
    branches:
      - codex/p6g-multistation-on-accepted-p6a-p6f-20261014
  workflow_dispatch:

permissions:
  contents: read

jobs:
  g5-isolated-native-wiring:
    runs-on: ubuntu-22.04
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - name: Install YAML dependency (no GUI required for source smoke)
        run: python3 -m pip install --disable-pip-version-check PyYAML
      - name: Compile every new G5 Python module
        run: python3 -m compileall -q engine/gui_g5
      - name: Verify copied GUI has no legacy orchestration entrypoint
        run: python3 -m unittest discover -s engine/gui_g5/tests -p 'test_*.py' -v
      - name: Show supported stage matrix (read-only, no native execution)
        run: |
          python3 - <<'PY'
          from engine.gui_g5.pipeline import STAGES, BLOCKED
          assert set(STAGES) == {'preprocess', 'upperair', 'surface', 'met', 'puff', 'all'}
          assert all(stage in BLOCKED for stage in ('preprocess', 'upperair', 'met', 'puff', 'all'))
          print("G5_NATIVE_ONLY_NO_FORTRAN_FALLBACK=PASS")
          PY

  g5-offscreen-smoke:
    runs-on: ubuntu-22.04
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - name: Install Qt runtime libraries for Ubuntu headless desktop test
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y -qq libegl1 libopengl0 libgl1 libxkbcommon-x11-0 libxcb-cursor0
      - name: Install PySide6 and YAML
        run: python3 -m pip install --disable-pip-version-check PySide6 PyYAML
      - name: Instantiate independent G5 GUI (headless Qt)
        env:
          QT_QPA_PLATFORM: offscreen
        run: |
          timeout 120 python3 - <<'PY'
          from PySide6.QtWidgets import QApplication
          from engine.gui_g5.workbench import MainWindow, SOFTWARE_TITLE
          app = QApplication([])
          window = MainWindow()
          assert "G5" in window.windowTitle()
          assert SOFTWARE_TITLE == window.windowTitle()
          assert window.pages.count() >= 3, "G5 workflow pages absent"
          assert window.field_widgets, "G5 editable case form absent"
          print("G5_SEPARATE_PYSIDE_WORKBENCH_STARTUP=PASS", window.pages.count())
          window.close()
          app.quit()
          PY
