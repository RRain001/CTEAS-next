name: P7 vendor precision and independent parallel physics gates
on:
  pull_request:
    paths:
      - 'native_cpp/modules/p7_calpuff/**'
      - '.github/workflows/p7-precision-and-parallel.yml'
      - 'docs/reconstruction_cpp/P7_*'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: p7-parallel-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
jobs:
  # Kind proof is independent of the expensive original CALPUFF compilation.
  precision-kind-audit:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 12
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
          filter: blob:none
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /native_cpp/modules/p7_calpuff/**
            /engine/vendor/src/CALPUFF_v7.2.1_L150618/**
      - name: Record actual runner and resource topology
        shell: bash
        run: |
          echo "P7_PARALLEL_RUNNER=${RUNNER_NAME} HOST=$(hostname) CORES=$(nproc)"
          grep -E '^MemTotal:|^MemAvailable:' /proc/meminfo || true
      - name: Audit Fortran declarations, compiler kinds and C++ COMMON precision
        shell: bash
        run: |
          set -euo pipefail
          for compiler in gfortran-12 gfortran-11 gfortran; do
            if command -v "$compiler" >/dev/null 2>&1; then
              fc="$(command -v "$compiler")"
              break
            fi
          done
          test -n "${fc:-}" || { echo "::error::No gfortran compiler"; exit 1; }
          output="${RUNNER_TEMP}/p7-precision-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          python3 native_cpp/modules/p7_calpuff/reference/audit_original_precision.py \
            --compiler "$fc" --report "$output/precision-audit.json"
          python3 native_cpp/modules/p7_calpuff/reference/original_internal_coordinate_inventory.py \
            --source engine/vendor/src/CALPUFF_v7.2.1_L150618/calpuff.for \
            --report "$output/internal-grid-inventory.json"
          if command -v g++-12 >/dev/null 2>&1; then
            cpp="$(command -v g++-12)"
          elif command -v g++-11 >/dev/null 2>&1; then
            cpp="$(command -v g++-11)"
          else
            cpp="$(command -v c++)"
          fi
          cmake -S native_cpp/modules/p7_calpuff -B "$output/cpp" \
            -DCMAKE_CXX_COMPILER="$cpp" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$output/cpp" --target cteas_p7_precision_contract_tests --parallel 2
          ctest --test-dir "$output/cpp" -R '^cteas_p7_original_fortran_cpp_precision_contract$' --output-on-failure
          echo "P7_ORIGINAL_PRECISION_AUDIT=PASS"
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: p7-vendor-precision-kind-audit
          path: |
            ${{ runner.temp }}/p7-precision-${{ github.run_id }}-${{ github.run_attempt }}/precision-audit.json
            ${{ runner.temp }}/p7-precision-${{ github.run_id }}-${{ github.run_attempt }}/internal-grid-inventory.json
          retention-days: 7
          if-no-files-found: warn

  # Independent original-source parity modules can run on *different* idle
  # self-hosted runner instances. Do not pin this matrix to desktop-3.
  # 14 independent source physics lanes on fresh GitHub-hosted Ubuntu VMs.
  # Preserve max-parallel=16 (no shared self-hosted machine).
  # The pinned six/143-hour original replay runs in its own VM.
  source-parity-shards:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    strategy:
      fail-fast: false
      max-parallel: 16
      matrix:
        include:
          - lane: release-inject
          - lane: step-bookkeeping
          - lane: advection
          - lane: dispersion
          - lane: sigma-update
          - lane: terrain-constraints
          - lane: terrain-relief
          - lane: valley-width
          - lane: plume-rise
          - lane: receptor-sampling
          - lane: vertical-coupling
          - lane: ctsg-kernels
          - lane: dry-removal
          - lane: wind-step-output
    runs-on: ubuntu-22.04
    timeout-minutes: 18
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
          filter: blob:none
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /native_cpp/modules/p7_calpuff/**
            /engine/vendor/src/CALPUFF_v7.2.1_L150618/**
            /project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp
            /project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.con
      - name: Pin lane to immutable source and log host
        shell: bash
        run: |
          set -euo pipefail
          echo "P7_PARITY_LANE=${{ matrix.lane }} RUNNER=${RUNNER_NAME} HOST=$(hostname)"
          fc=""
          for candidate in gfortran-13 gfortran-12 gfortran-11 gfortran; do
            if command -v "$candidate" >/dev/null 2>&1; then
              fc="$(command -v "$candidate")"
              break
            fi
          done
          test -n "$fc" || { echo "::error::Source parity requires actual gfortran oracle"; exit 1; }
          major="$("$fc" -dumpversion | cut -d. -f1)"
          [[ "$major" =~ ^[0-9]+$ ]] && (( major >= 10 )) || {
            echo "::error::Original Fortran parity requires gfortran 10+"
            exit 1
          }
          echo "P7_SOURCE_PARITY_FORTRAN=$fc"
          git rev-parse HEAD
          test -s native_cpp/modules/p7_calpuff/CMakeLists.txt
          test -s engine/vendor/src/CALPUFF_v7.2.1_L150618/calpuff.for
      - name: Compile only this lane's original-precision physics modules
        shell: bash
        run: |
          set -euo pipefail
          lane="${{ matrix.lane }}"
          build="${RUNNER_TEMP}/p7-shard-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}-${lane}"
          if command -v g++-12 >/dev/null 2>&1; then
            cpp="$(command -v g++-12)"
          elif command -v g++-11 >/dev/null 2>&1; then
            cpp="$(command -v g++-11)"
          else
            cpp="$(command -v c++)"
          fi
          cmake -S native_cpp/modules/p7_calpuff -B "$build" \
            -DCMAKE_CXX_COMPILER="$cpp" -DCMAKE_BUILD_TYPE=Debug
          case "$lane" in
            release-inject)
              targets=(cteas_p7o_tests cteas_p7o_probe)
              match='^cteas_p7o_'
              required=(
                cteas_p7o_release_scheduler_contract
                cteas_p7o_source_parity
              )
              ;;
            step-bookkeeping)
              targets=(cteas_p7p_tests cteas_p7p_probe)
              match='^cteas_p7p_'
              required=(
                cteas_p7p_step_bookkeeping_contract
                cteas_p7p_source_parity
              )
              ;;
            advection)
              targets=(cteas_p7v_tests cteas_p7v_probe)
              match='^cteas_p7v_'
              required=(
                cteas_p7v_advection_contract
                cteas_p7v_source_parity
              )
              ;;
            dispersion)
              targets=(cteas_p7_dispersion_tests cteas_p7d_sigma_probe)
              match='^cteas_p7d_'
              required=(
                cteas_p7d_dispersion_contract
                cteas_p7d_sigma_source_parity
              )
              ;;
            plume-rise)
              targets=(cteas_p7n_tests cteas_p7n_probe)
              match='^cteas_p7n_'
              required=(
                cteas_p7n_plume_rise_contract
                cteas_p7n_source_parity
              )
              ;;
            sigma-update)
              targets=(cteas_p7q_tests cteas_p7q_probe)
              match='^cteas_p7q_'
              required=(
                cteas_p7q_sigma_update_contract
                cteas_p7q_source_parity
              )
              ;;
            terrain-constraints)
              targets=(cteas_p7r_tests cteas_p7r_probe)
              match='^cteas_p7r_'
              required=(
                cteas_p7r_terrain_constraints_contract
                cteas_p7r_source_parity
              )
              ;;
            terrain-relief)
              targets=(cteas_p7s_tests cteas_p7s_probe)
              match='^cteas_p7s_'
              required=(
                cteas_p7s_terrain_state_contract
                cteas_p7s_source_parity
              )
              ;;
            valley-width)
              targets=(cteas_p7t_tests cteas_p7t_probe)
              match='^cteas_p7t_'
              required=(
                cteas_p7t_valley_width_contract
                cteas_p7t_source_parity
              )
              ;;
            receptor-sampling)
              targets=(cteas_p7e_tests cteas_p7e_probe cteas_p7_hourly_conc_tests)
              match='^cteas_p7e_'
              required=(
                cteas_p7e_receptor_sampling_conc_contract
                cteas_p7e_native_143h_hourly_data_writer_contract
                cteas_p7e_source_parity
              )
              ;;
            vertical-coupling)
              targets=(cteas_p7h_tests cteas_p7e_probe)
              match='^cteas_p7h_'
              required=(
                cteas_p7h_vertical_coupling_contract
                cteas_p7h_source_parity
              )
              ;;
            ctsg-kernels)
              targets=(cteas_p7i_tests cteas_p7m_tests cteas_p7m_probe)
              match='^cteas_p7(i|m)_'
              required=(
                cteas_p7i_ctsg_support_contract
                cteas_p7i_source_parity
                cteas_p7m_ctsg_kernel_contract
                cteas_p7m_source_parity
              )
              ;;
            dry-removal)
              targets=(cteas_p7_dry_deposition_tests cteas_p7f_drydep_probe)
              match='^cteas_p7f_'
              required=(
                cteas_p7f_dry_deposition_contract
                cteas_p7f_locked_case_dry_deposition
                cteas_p7f_drydep_source_parity
              )
              ;;
            wind-step-output)
              targets=(cteas_p7w_tests cteas_p7w_probe cteas_p7x_tests cteas_p7e_probe)
              match='^cteas_p7(w|x|g)_'
              required=(
                cteas_p7w_rise_wind_contract
                cteas_p7w_source_parity
                cteas_p7x_step_integration_contract
                cteas_p7g_conc_structure
              )
              ;;
            *) echo "::error::Unexpected parity lane $lane"; exit 1 ;;
          esac
          # The 13 managed workers share a 56-physical-core Linux host;
          # one compile thread per lane avoids GPU/CPU and RAM contention.
          echo "P7_HOST_COMPUTE=START HOST=$(hostname) RUNNER=${RUNNER_NAME} LANE=$lane CORES=$(nproc)"
          grep -E '^MemTotal:|^MemAvailable:' /proc/meminfo || true
          cmake --build "$build" --parallel 1 --target "${targets[@]}"
          inventory="$(ctest --test-dir "$build" -N -R "$match")"
          printf '%s\n' "$inventory"
          printf '%s\n' "$inventory" | grep -Eq 'Test[[:space:]]*#[0-9]+:'
          count=0
          for test in "${required[@]}"; do
            # Fail closed if a conditionally registered test was silently
            # excluded by a missing original input; prove each component.
            ctest --test-dir "$build" -N -R "^$test$" |
              grep -Eq "Test[[:space:]]*#[0-9]+: $test$" || {
                echo "::error::Required P7 original-parity test not registered: $test"
                exit 1
              }
            echo "P7_STAGE_BEGIN LANE=$lane TEST=$test"
            ctest --test-dir "$build" -R "^$test$" --output-on-failure
            echo "P7_STAGE_PASS LANE=$lane TEST=$test"
            count=$((count+1))
          done
          echo "P7_PARALLEL_SOURCE_PARITY=PASS LANE=$lane CHECKS=$count"


  original-execution-order:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
          filter: blob:none
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /native_cpp/modules/p7_calpuff/**
            /engine/vendor/src/CALPUFF_v7.2.1_L150618/calpuff.for
            /project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp
            /project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.con
            /project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat
      - name: Require pinned original source and first-hour puff state
        shell: bash
        run: |
          set -euo pipefail
          echo "P7_ORDER_RUNNER=${RUNNER_NAME} HOST=$(hostname) CORES=$(nproc)"
          for path in \
            native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/dgm_puffstep.json \
            native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/dgm-audit.json \
            native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/dgm_puffstep_hour202200100.bin \
            engine/vendor/src/CALPUFF_v7.2.1_L150618/calpuff.for \
            project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp; do
            test -s "$path" || { echo "::error::Missing original $path"; exit 1; }
          done
      - name: Compile and execute source order and internal grid gates
        shell: bash
        run: |
          set -euo pipefail
          if command -v g++-12 >/dev/null 2>&1; then
            cpp="$(command -v g++-12)"
          elif command -v g++-11 >/dev/null 2>&1; then
            cpp="$(command -v g++-11)"
          else
            cpp="$(command -v c++)"
          fi
          build="${RUNNER_TEMP}/p7-order-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          cmake -S native_cpp/modules/p7_calpuff -B "$build" \
            -DCMAKE_CXX_COMPILER="$cpp" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$build" --parallel 2 \
            --target cteas_p7_vendor_order_tests cteas_p7_initial_dgm_tests cteas_p7_first_hour_advance_tests cteas_p7_first_hour_lifecycle_tests cteas_p7_hourly_conc_tests
          for name in cteas_p7_vendor_substep_order_contract \
                      cteas_p7_original_initial_internal_xy \
                      cteas_p7_original_first_hour_advance_real4 \
                      cteas_p7_first_hour_state_persistence_real4 \
                      cteas_p7_original_source_dgm_execution_order \
                      cteas_p7_original_wrout1_header_avefactor_audit \
                      cteas_p7e_original_wrout1_full_native_header; do
            ctest --test-dir "$build" -N -R "^${name}$" |
              grep -Eq "Test[[:space:]]*#[0-9]+: ${name}" || {
                echo "::error::Original CALPUFF order gate absent: $name"
                exit 1
              }
            ctest --test-dir "$build" -R "^${name}$" --output-on-failure
          done
          python3 native_cpp/modules/p7_calpuff/reference/audit_vendor_order_and_dgm.py \
            --vendor engine/vendor/src/CALPUFF_v7.2.1_L150618/calpuff.for \
            --dgm-tool native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/original_puff_step_dump.py \
            --metadata native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/dgm_puffstep.json \
            --first-hour native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/dgm_puffstep_hour202200100.bin \
            --control project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp \
            --audit-record native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/dgm-audit.json \
            --report "$build/P7_ORIGINAL_ORDER_DGM_AUDIT.json"
          python3 native_cpp/modules/p7_calpuff/reference/audit_vendor_wrout1_output.py \
            --vendor engine/vendor/src/CALPUFF_v7.2.1_L150618/calpuff.for \
            --control project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp \
            --original-con project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.con \
            --original-met project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat \
            --report "$build/P7_ORIGINAL_WROUT1_INVENTORY.json"
          echo "P7_ORDER_ORIGINAL_AND_CPP_INITIAL=PASS"
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: p7-original-comp-order-and-first-hour
          path: |
            ${{ runner.temp }}/p7-order-${{ github.run_id }}-${{ github.run_attempt }}/P7_ORIGINAL_ORDER_DGM_AUDIT.json
            ${{ runner.temp }}/p7-order-${{ github.run_id }}-${{ github.run_attempt }}/P7_ORIGINAL_WROUT1_INVENTORY.json
          retention-days: 7
          if-no-files-found: warn


  native-first-six-hours:
    # A genuinely new native multi-substep test: retain C++ puff state between
    # steps within each hour; six-hour original DGM MUST be regenerated using
    # unmodified CALPUFF and verified against frozen 143h binary SHA first.
    # This is not yet full across-hour SWAP/ROLLDN or autonomous met forcing.
    # Independent frozen input SHA and vendor-output invariants make this
    # an autonomous scientific gate, not blocked by another runner's order job.
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 45
    steps:
      - name: Ensure exact original Fortran 11 compiler on GitHub-hosted Ubuntu
        shell: bash
        run: |
          set -euo pipefail
          if ! command -v gfortran-11 >/dev/null 2>&1; then
            sudo apt-get update -qq
            sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq gfortran-11
          fi
          gfortran-11 --version | head -n 1
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
          filter: blob:none
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /native_cpp/modules/p7_calpuff/**
            /engine/vendor/src/CALPUFF_v7.2.1_L150618/**
            /project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp
            /project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat
      - name: Verify exact vendor and frozen case availability
        shell: bash
        run: |
          set -euo pipefail
          echo "P7_6H_RUNNER=${RUNNER_NAME} HOST=$(hostname) CORES=$(nproc)"
          for file in \
            engine/vendor/src/CALPUFF_v7.2.1_L150618/calpuff.for \
            engine/vendor/src/CALPUFF_v7.2.1_L150618/modules.for \
            native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/dgm_puffstep.json \
            project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp \
            project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat; do
            test -s "$file" || { echo "::error::Missing required original: $file"; exit 1; }
          done
          command -v gfortran-11 >/dev/null 2>&1 || {
            echo "::error::Require original pinned gfortran-11 to regenerate DGM"
            exit 1
          }
      - name: Independently reproduce original 143h DGM then extract six-hour oracle
        shell: bash
        run: |
          set -euo pipefail
          base="${RUNNER_TEMP}/p7-six-hours-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          mkdir -p "$base/frozen/run/puff" "$base/frozen/deliverables/met"
          cp project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp \
            "$base/frozen/run/puff/puff.inp"
          ln -s "${GITHUB_WORKSPACE}/project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat" \
            "$base/frozen/deliverables/met/met.dat"
          python3 native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/original_puff_step_dump.py \
            audit --vendor engine/vendor/src/CALPUFF_v7.2.1_L150618 \
            --case "$base/frozen" --out "$base/oracle" --compiler "$(command -v gfortran-11)"
          six="native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/dgm_first_six_hours.bin"
          python3 native_cpp/modules/p7_calpuff/reference/extract_original_six_hours.py \
            --full "$base/oracle/case/run/puff/dgm_puffstep.bin" \
            --metadata native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/dgm_puffstep.json \
            --out "$six"
          test -s "$six"
          # The full original 143h DGM has already been SHA verified by the
          # extractor. Keep the 89MB data in RUNNER_TEMP, never commit it.
          ln -s "$base/oracle/case/run/puff/dgm_puffstep.bin" \
            native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/dgm_full_143hours.bin
          # Read-only scientific inventory of ORIGINAL 143h FSTEP behavior.
          # The vendor SHA is pinned and the audit must never feed solver state.
          python3 native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/audit_original_fstep_143h.py \
            --dgm "$base/oracle/case/run/puff/dgm_puffstep.bin" \
            --report "$base/P7_ORIGINAL_FSTEP_143H_AUDIT.json"
          if command -v g++-12 >/dev/null 2>&1; then
            cpp="$(command -v g++-12)"
          elif command -v g++-11 >/dev/null 2>&1; then
            cpp="$(command -v g++-11)"
          else
            cpp="$(command -v c++)"
          fi
          cmake -S native_cpp/modules/p7_calpuff -B "$base/cpp" \
            -DCMAKE_CXX_COMPILER="$cpp" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$base/cpp" --parallel 2 --target cteas_p7_first_hour_lifecycle_tests cteas_p7_original_met_cell_trace cteas_p7_puffdz_state_trace cteas_p7_original_release_wind_tests cteas_p7_original_comp_cadence_trace cteas_p7_original_fstep_trace
          # Strict source-controller trace: all original 1h, 6h, 143h
          # records, with read-only WS/NSAM/REFTSAMP as inputs. Real TSAMP
          # and TLEFT must be computed by native C++, never DGM-fed.
          for selected in cteas_p7_original_first_hour_fstep_controller cteas_p7_original_six_hour_fstep_controller cteas_p7_original_143_hour_fstep_controller; do
            ctest --test-dir "$base/cpp" -N -R "^$selected$" |
              grep -Eq "Test[[:space:]]*#[0-9]+: $selected$" || {
                echo "::error::Required original FSTEP gate not registered: $selected"
                exit 1
              }
            ctest --test-dir "$base/cpp" -R "^$selected$" --output-on-failure
          done
          "$base/cpp/cteas_p7_original_fstep_trace" "$base/oracle/case/run/puff/dgm_puffstep.bin" 143
          echo "P7_NATIVE_ORIGINAL_143H_FSTEP_STEP_CONTROLLER=PASS FULL_COMP=NOT_YET_ACCEPTED"
          name=cteas_p7_first_six_hour_state_persistence_real4
          ctest --test-dir "$base/cpp" -N -R "^${name}$" |
            grep -Eq "Test[[:space:]]*#[0-9]+: ${name}$" || {
              echo "::error::Six-hour C++ lifecycle test not registered"
              exit 1
            }
          ctest --test-dir "$base/cpp" -R "^${name}$" --output-on-failure
          "$base/cpp/cteas_p7_first_hour_lifecycle_tests" \
            project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp "$six" 6
          echo "P7_SIX_HOUR_NATIVE_LIFECYCLE=PASS"
          fulltest=cteas_p7_143_hour_oracle_fed_motion_state_real4
          ctest --test-dir "$base/cpp" -N -R "^${fulltest}$" |
            grep -Eq "Test[[:space:]]*#[0-9]+: ${fulltest}$" || {
              echo "::error::143h original-fed motion-state test not registered"
              exit 1
            }
          ctest --test-dir "$base/cpp" -R "^${fulltest}$" --output-on-failure
          "$base/cpp/cteas_p7_first_hour_lifecycle_tests" \
            project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp \
            "$base/oracle/case/run/puff/dgm_puffstep.bin" 143
          echo "P7_143H_ORACLE_FED_MOTION=PASS SELF_CONTAINED_MET_AND_OUTPUT=NO"
          # Original wind sampled from native full 143h CALMET hourly fields.
          # The upstream vertical PUFFDZ bounds are explicitly oracle-fed:
          # this is full-case native GETCELL-cell and ADVECT/ADVWND parity,
          # not an autonomous multi-physics COMP acceptance.
          "$base/cpp/cteas_p7_original_met_cell_trace" \
            project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat \
            "$base/oracle/case/run/puff/dgm_puffstep.bin" 143
          echo "P7_143H_NATIVE_METFM1_ADVECT_DGM=PASS ZBOT_ZTOP_ORACLE_FED=YES"
          "$base/cpp/cteas_p7_puffdz_state_trace" \
            "$base/oracle/case/run/puff/dgm_puffstep.bin" 143
          echo "P7_143H_DETERMINATE_NATIVE_PUFFDZ=PASS PREVIOUS_SIGZ_ORACLE_FED=YES"
          # Exact native WINDSET/RLSMET for all 143h against unmodified
          # original DGM first new-puff height/wind/cadence each hour.
          # PRFIN HEFF is explicitly original-fed and cannot prove a
          # fully autonomous original source plume-rise setup.
          "$base/cpp/cteas_p7_original_release_wind_tests" \
            project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat \
            "$base/oracle/case/run/puff/dgm_puffstep.bin" 143
          echo "P7_143H_NATIVE_RELEASE_WIND_ORIGINAL_HEIGHT_FED=PASS"
          # Source-ported C++ POINTS1 / COMP NEW NSAM, NSSTR, REFTSAMP
          # from native release_cadence(WSVAR) for 11,985 original releases.
          # Original DGM is READ-ONLY and never solver input.
          "$base/cpp/cteas_p7_original_comp_cadence_trace" \
            "$base/oracle/case/run/puff/dgm_puffstep.bin" 143
          echo "P7_143H_NATIVE_COMP_NEW_CADENCE=PASS OLD_MXSAM99_INTEGRATION=NOT_YET_ACCEPTED"

      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: p7-pinned-original-first-six-hours
          path: |
            native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/dgm_first_six_hours.bin
            native_cpp/modules/p7_calpuff/reference/dgm_p7_advection_2022/dgm_first_six_hours_provenance.json
            ${{ runner.temp }}/p7-six-hours-${{ github.run_id }}-${{ github.run_attempt }}/P7_ORIGINAL_FSTEP_143H_AUDIT.json
          if-no-files-found: warn
          retention-days: 7
