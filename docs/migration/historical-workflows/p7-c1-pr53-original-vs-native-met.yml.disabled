name: P7 C1 PR53 two MET inputs four-arm science (single station)
on:
  push:
    branches: [codex/p7-c1-c2-native-met-integration-20261015]
    paths:
      - '.github/workflows/p7-c1-pr53-original-vs-native-met.yml'
      - 'native_cpp/modules/p7_calpuff/reference/*p7_hourly_concentrations.py'
      - 'native_cpp/modules/p7_calpuff/reference/run_c1_original_calpuff_pair.py'
      - 'native_cpp/modules/p7_calpuff/include/cteas/puff/original_wrout1_hefei.hpp'
      - 'native_cpp/modules/p7_calpuff/tests/original_hefei_sixhour_native_receptors_tests.cpp'
  pull_request:
    branches: [codex/cteas-p7-calpuff-20261011]
    paths:
      - '.github/workflows/p7-c1-pr53-original-vs-native-met.yml'
      - 'native_cpp/modules/p7_calpuff/reference/*p7_hourly_concentrations.py'
      - 'native_cpp/modules/p7_calpuff/reference/run_c1_original_calpuff_pair.py'
      - 'native_cpp/modules/p7_calpuff/include/cteas/puff/original_wrout1_hefei.hpp'
      - 'native_cpp/modules/p7_calpuff/tests/original_hefei_sixhour_native_receptors_tests.cpp'
  workflow_dispatch:
permissions:
  contents: read
  actions: read
concurrency:
  group: p7-c1-pr53-science-${{ github.head_ref || github.ref_name }}
  cancel-in-progress: true

jobs:
  c1-pinned-single-station:
    runs-on: ubuntu-22.04
    timeout-minutes: 150
    steps:
      - name: Checkout immutable 2022 P7 baseline plus isolated C1 integration driver
        uses: actions/checkout@v4
        with:
          persist-credentials: false
      - name: Run independent authentic Fortran CONC.DAT comparator negative controls
        shell: bash
        run: |
          set -euo pipefail
          python3 native_cpp/modules/p7_calpuff/reference/test_compare_p7_hourly_concentrations.py -v

      - name: Checkout exactly accepted PR53 P6 native meteorology producer scripts
        uses: actions/checkout@v4
        with:
          ref: 8d6642272d0abb77153880591e150f93e14d4479
          path: pr53
          persist-credentials: false

      - name: Retrieve exact approved PR53 143-hour P6D/P6E/P6F weather artifact
        uses: actions/download-artifact@v4
        with:
          name: p6-causal-original-case-143h
          run-id: 38417406969
          github-token: ${{ secrets.GITHUB_TOKEN }}
          path: ${{ runner.temp }}/p7-c1/pr53
      - name: Fail closed on incomplete source weather
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p7-c1/pr53"
          test -s "$root/native_causal_independent_header_calmet.dat"
          test -s "$root/native_cpp_hourly_manifest.json"
          test -s "project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat"
          test -s "project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.con"
          echo 'b1823cda92280888d70b00961ab39486036a3086e18637fff21efb4f4b237d30  project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat' | sha256sum -c -
          sha256sum "$root/native_causal_independent_header_calmet.dat" | tee "$root/C1-native-weather-sha256.txt"
          echo 'P7_C1_PR53_HISTORICAL_INPUTS=PINNED P6_SHA=8d664227 RUN_ID=38417406969'

      - name: Execute unchanged original CALPUFF A and C on original and PR53 native MET.DAT
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/p7-c1/results"
          python3 native_cpp/modules/p7_calpuff/reference/run_c1_original_calpuff_pair.py \
            --vendor engine/vendor/src/CALPUFF_v7.2.1_L150618 \
            --puff-control project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp \
            --original-met project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat \
            --native-met "$RUNNER_TEMP/p7-c1/pr53/native_causal_independent_header_calmet.dat" \
            --original-puff-con project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.con \
            --p6-helper pr53/native_cpp/modules/p6_calmet/p6f/tests/verify_original_calpuff_reads_written_calmet.py \
            --compiler /usr/bin/gfortran-11 \
            --out "$RUNNER_TEMP/p7-c1/results" | tee "$RUNNER_TEMP/p7-c1/results/C1-vendor-pair.log"

      - name: Build original P7 source-faithful native COMP without modifying physics
        shell: bash
        run: |
          set -euo pipefail
          cmake -S native_cpp/modules/p7_calpuff -B "$RUNNER_TEMP/p7-c1/build" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$RUNNER_TEMP/p7-c1/build" --parallel 2 \
            --target cteas_p7_hefei_sixhour_native_h3_receptors_tests cteas_p7_original_native_terrain_tests
          "$RUNNER_TEMP/p7-c1/build/cteas_p7_original_native_terrain_tests"

      - name: Execute full 143h native P7 D on genuine PR53 meteorology; compare same-MET C
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p7-c1"
          set +e
          CTEAS_P7_INTEGRATION_C1=1 \
          CTEAS_P7_PROBE_HOURS=143 \
          CTEAS_P7_NATIVE_PUFF_CON="$root/results/D-native-p7-native-met.con" \
          CTEAS_P7_MAKEGEO_INP=project/cases/hefei5km_2022_reference_case_20261011/geo/makegeo/makegeo.inp \
            "$root/build/cteas_p7_hefei_sixhour_native_h3_receptors_tests" \
              "$root/pr53/native_causal_independent_header_calmet.dat" \
              project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.inp \
              "$root/results/C-original-calpuff.con" \
              > "$root/results/C1-native-P7-D-143h.log" 2>&1
          rc=$?
          set -e
          grep -E 'P7_C1_|P7_REAL_EXTENDED_PROBE_ENTER_HOUR|FAIL' "$root/results/C1-native-P7-D-143h.log" | tail -n 25 || true
          exit "$rc"

      - name: Compare vendor C / native D same MET and original B / native D weather sensitivity
        if: always()
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p7-c1/results"
          if test -s "$root/D-native-p7-native-met.con" && test -s "$root/C-original-calpuff.con"; then
            python3 native_cpp/modules/p7_calpuff/reference/compare_p7_hourly_concentrations.py \
              --a "$root/C-original-calpuff.con" --b "$root/D-native-p7-native-met.con" \
              --nx 50 --ny 50 --hours 143 --report "$root/C1-same-native-MET-C-vs-D.json"
            python3 native_cpp/modules/p7_calpuff/reference/compare_p7_hourly_concentrations.py \
              --a project/cases/hefei5km_2022_reference_case_20261011/run/puff/puff.con \
              --b "$root/D-native-p7-native-met.con" --nx 50 --ny 50 --hours 143 \
              --report "$root/C1-different-MET-B-vs-D.json"
          else
            echo 'P7_C1_C_D_DIAGNOSTIC=BLOCKED missing full native P7 output'
          fi

      - name: Upload C1 full scientific evidence including failures
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: p7-c1-pr53-original-native-met-143h
          path: |
            ${{ runner.temp }}/p7-c1/pr53/C1-native-weather-sha256.txt
            ${{ runner.temp }}/p7-c1/results/
          retention-days: 14
          if-no-files-found: warn
