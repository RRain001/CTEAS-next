name: P6D-P6E source-ordered hourly COMP scheduler contract

on:
  push:
    branches:
      - codex/p6-hourly-stateful-scheduler-20261013
    paths:
      - native_cpp/modules/p6_calmet/include/cteas/p6/hourly_comp_scheduler.hpp
      - native_cpp/modules/p6_calmet/p6e/include/cteas/p6e/native_hourly_comp_steps.hpp
      - native_cpp/modules/p6_calmet/p6e/src/calmet_dat21_tool_main.cpp
      - scripts/p6e_verify_native_hour_comp_143h.py
      - scripts/p6d_verify_single_hour_windows.py
      - native_cpp/modules/p6_calmet/src/realcase_wind_field_main.cpp
      - native_cpp/modules/p6_calmet/tests/p6_hourly_native_comp_integration_tests.cpp
      - native_cpp/modules/p6_calmet/tests/p6_hourly_comp_scheduler_tests.cpp
      - native_cpp/modules/p6_calmet/include/cteas/p6/native_comp_history.hpp
      - native_cpp/modules/p6_calmet/tests/p6_native_comp_history_tests.cpp
      - .github/workflows/p6d-p6e-hourly-scheduler.yml
  pull_request:
    paths:
      - native_cpp/modules/p6_calmet/include/cteas/p6/hourly_comp_scheduler.hpp
      - native_cpp/modules/p6_calmet/p6e/include/cteas/p6e/native_hourly_comp_steps.hpp
      - native_cpp/modules/p6_calmet/p6e/src/calmet_dat21_tool_main.cpp
      - scripts/p6e_verify_native_hour_comp_143h.py
      - scripts/p6d_verify_single_hour_windows.py
      - native_cpp/modules/p6_calmet/src/realcase_wind_field_main.cpp
      - native_cpp/modules/p6_calmet/tests/p6_hourly_native_comp_integration_tests.cpp
      - native_cpp/modules/p6_calmet/tests/p6_hourly_comp_scheduler_tests.cpp
      - native_cpp/modules/p6_calmet/include/cteas/p6/native_comp_history.hpp
      - native_cpp/modules/p6_calmet/tests/p6_native_comp_history_tests.cpp
      - .github/workflows/p6d-p6e-hourly-scheduler.yml
  workflow_dispatch:

permissions:
  contents: read

jobs:
  single-pass-order-contract:
    name: Native hourly scheduler build and state machine (NOT science parity)
    runs-on: ubuntu-22.04
    timeout-minutes: 12
    steps:
      - uses: actions/checkout@v4
        with:
          filter: blob:none
          sparse-checkout: |
            native_cpp/modules/p6_calmet/include
            native_cpp/modules/p6_calmet/p6e/include
            native_cpp/modules/p6_calmet/tests
            native_cpp/modules/p6_calmet/src/native_hourly_driver_main.cpp
            native_cpp/modules/p6_calmet/p6f/src/sha256.cpp
            native_cpp/modules/p6_calmet/p6f/include
            scripts/run_p6_end_to_end.py
      - name: Compile actual C++20 scheduler, strict
        shell: bash
        run: |
          set -euo pipefail
          g++ -std=c++20 -O2 -Wall -Wextra -Werror -pedantic -ffp-contract=off \
            -I native_cpp/modules/p6_calmet/include \
            native_cpp/modules/p6_calmet/tests/p6_hourly_comp_scheduler_tests.cpp \
            -o "${RUNNER_TEMP}/p6-hourly-comp-scheduler-contract"
      - name: Execute all 143 ordered hours; reject reference-backfill and missing outputs
        shell: bash
        run: |
          set -euo pipefail
          "${RUNNER_TEMP}/p6-hourly-comp-scheduler-contract"
      - name: Compile native COMP physics bound to six-hour single-pass state
        shell: bash
        run: |
          set -euo pipefail
          g++ -std=c++20 -O2 -Wall -Wextra -Werror -pedantic -ffp-contract=off \
            -I native_cpp/modules/p6_calmet/include \
            -I native_cpp/modules/p6_calmet/p6e/include \
            native_cpp/modules/p6_calmet/tests/p6_hourly_native_comp_integration_tests.cpp \
            -o "${RUNNER_TEMP}/p6-hourly-native-comp-integration"
      - name: Run native COMP MIXHT-AVEMIX-WSTARR-TEMP3D in hour clock
        shell: bash
        run: |
          set -euo pipefail
          "${RUNNER_TEMP}/p6-hourly-native-comp-integration"
      - name: Compile transitional C++ process coordinator with -Werror; reject missing case
        shell: bash
        run: |
          set -euo pipefail
          g++ -std=c++20 -O2 -Wall -Wextra -Wpedantic -Werror \
            -I native_cpp/modules/p6_calmet/p6f/include \
            -I native_cpp/modules/p6_calmet/include \
            native_cpp/modules/p6_calmet/src/native_hourly_driver_main.cpp \
            native_cpp/modules/p6_calmet/p6f/src/sha256.cpp \
            -o "$RUNNER_TEMP/p6-native-cpp-coordinator"
          if "$RUNNER_TEMP/p6-native-cpp-coordinator" \
              --case does-not-exist --p6d does-not-exist \
              --p6e does-not-exist --bridge does-not-exist \
              --cgamma does-not-exist --work "$RUNNER_TEMP/bad-case" \
              > "$RUNNER_TEMP/native-cpp-reject.log" 2>&1; then
            echo "::error::Native C++ coordinator accepted invalid source"
            exit 1
          fi
          grep -q "FAIL_CPP_HOURLY_COORDINATOR" "$RUNNER_TEMP/native-cpp-reject.log"
          g++ -std=c++20 -O2 -Wall -Wextra -Wpedantic -Werror \
            -I native_cpp/modules/p6_calmet/include \
            native_cpp/modules/p6_calmet/tests/p6_native_comp_history_tests.cpp \
            -o "$RUNNER_TEMP/p6-native-comp-history-tests"
          "$RUNNER_TEMP/p6-native-comp-history-tests" "$RUNNER_TEMP/comp-history-rollback-ctest"
      - name: Compile legacy forensic CLI and assert strict acceptance rejection
        shell: bash
        run: |
          set -euo pipefail
          python3 -m py_compile scripts/run_p6_end_to_end.py
          if python3 scripts/run_p6_end_to_end.py --require-native-single-pass \
              > "${RUNNER_TEMP}/native-reject.log" 2>&1; then
            echo "::error::Legacy forensic script falsely certified native one-pass"
            exit 1
          fi
          grep -q 'cannot certify an independently native single-pass' \
            "${RUNNER_TEMP}/native-reject.log"
      - name: Explicit scientific boundary
        shell: bash
        run: |
          echo "SCHEDULER_CONTRACT: compiler/test evidence only"
          echo "P6E_COMP_KERNEL_STEP_ADAPTER: IMPLEMENTED"
          echo "P6D_DIAGNO_STEP_ADAPTER: NOT_IMPLEMENTED"
          echo "P6D_FULL_UVW: NOT_PASS"
          echo "P6G_45_FIELDS: NOT_PASS"

  p6e-realcase-143h-regression:
    name: Build real P6E executable and replay frozen 143h original-wind E42 gate
    runs-on: ubuntu-22.04
    timeout-minutes: 55
    steps:
      - uses: actions/checkout@v4
        with:
          filter: blob:none
          sparse-checkout: |
            native_cpp/modules/p6_calmet/include
            native_cpp/modules/p6_calmet/p6e
      - uses: actions/checkout@v4
        with:
          ref: 3b94cdbfbb5f44146ba51a4ef112114f199d28b9
          path: frozen_original_checkout
          filter: blob:none
          sparse-checkout: |
            project/cases/hefei5km_2022_reference_case_20261011
      - name: Verify pinned original frozen reference and stage case path
        shell: bash
        run: |
          set -euo pipefail
          case_dir="$GITHUB_WORKSPACE/frozen_original_checkout/project/cases/hefei5km_2022_reference_case_20261011"
          printf '%s  %s\n' b1823cda92280888d70b00961ab39486036a3086e18637fff21efb4f4b237d30 "$case_dir/run/met/met.dat" | sha256sum -c -
          echo "CTEAS_P6E_REAL_CASE=$case_dir" >> "$GITHUB_ENV"
      - name: Compile ACTUAL production P6E emit-realcase (not just header adapter)
        shell: bash
        run: |
          set -euo pipefail
          build_dir="$RUNNER_TEMP/p6e-realcase-143h"
          cmake -S native_cpp/modules/p6_calmet/p6e -B "$build_dir" \
                -DCMAKE_BUILD_TYPE=Debug -DCMAKE_CXX_COMPILER=g++-12
          cmake --build "$build_dir" --target p6e_calmet_dat21 p6e_p6c_hourly_bridge --parallel 2
      - name: Preserve old E42 143h strict 18-field scientific control
        shell: bash
        run: |
          set -euo pipefail
          build_dir="$RUNNER_TEMP/p6e-realcase-143h"
          python3 native_cpp/modules/p6_calmet/p6e/tests/verify_real_2022_full_field_reference.py \
            --repo-root "$GITHUB_WORKSPACE" \
            --tool "$build_dir/p6e_calmet_dat21" \
            --bridge "$build_dir/p6e_p6c_hourly_bridge" \
            --work "$RUNNER_TEMP/p6e-e42-143h-baseline"
      - name: Archive strict reference evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: p6e-143h-original-wind-regression
          path: ${{ runner.temp }}/p6e-e42-143h-baseline/
          if-no-files-found: warn
          retention-days: 7

  p6e-native-comp-hour-migration:
    name: Real P6D station input to P6E 143h native COMP vs prior COMP byte parity
    runs-on: ubuntu-22.04
    timeout-minutes: 70
    steps:
      - uses: actions/checkout@v4
        with:
          filter: blob:none
          sparse-checkout: |
            native_cpp/modules/p6_calmet
            scripts/p6e_verify_native_hour_comp_143h.py
            scripts/p6d_verify_single_hour_windows.py
      - uses: actions/checkout@v4
        with:
          ref: 3b94cdbfbb5f44146ba51a4ef112114f199d28b9
          path: frozen_original_checkout
          filter: blob:none
          sparse-checkout: |
            project/cases/hefei5km_2022_reference_case_20261011
      - name: Compile actual P6D wind and P6E COMP executables
        shell: bash
        run: |
          set -euo pipefail
          cmake -S native_cpp/modules/p6_calmet \
                -B "$RUNNER_TEMP/p6d-hourly" \
                -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_COMPILER=g++-12
          cmake --build "$RUNNER_TEMP/p6d-hourly" \
                --target cteas_p6_realcase_wind_field --parallel 2
          cmake -S native_cpp/modules/p6_calmet/p6e \
                -B "$RUNNER_TEMP/p6e-hourly" \
                -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_COMPILER=g++-12
          cmake --build "$RUNNER_TEMP/p6e-hourly" \
                --target p6e_calmet_dat21 p6e_p6c_hourly_bridge --parallel 2
      - name: Replay all 143 original-wind hours with same P6D native station source
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/p6e_verify_native_hour_comp_143h.py \
            --case "$GITHUB_WORKSPACE/frozen_original_checkout/project/cases/hefei5km_2022_reference_case_20261011" \
            --p6d "$RUNNER_TEMP/p6d-hourly/cteas_p6_realcase_wind_field" \
            --p6e "$RUNNER_TEMP/p6e-hourly/p6e_calmet_dat21" \
            --bridge "$RUNNER_TEMP/p6e-hourly/p6e_p6c_hourly_bridge" \
            --work "$RUNNER_TEMP/p6e-native-comp-143h"
      - name: Require P6D hour-1/hour-6/hour-12/hour-143 native windows equal whole-period route
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/p6d_verify_single_hour_windows.py \
            --case "$GITHUB_WORKSPACE/frozen_original_checkout/project/cases/hefei5km_2022_reference_case_20261011" \
            --p6d "$RUNNER_TEMP/p6d-hourly/cteas_p6_realcase_wind_field" \
            --comp-state-prefix "$RUNNER_TEMP/p6e-native-comp-143h/native_comp_state" \
            --work "$RUNNER_TEMP/p6e-native-comp-143h/p6d_single_hour"
      - name: Archive actual 143h COMP migration evidence, never label full G2
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: p6e-native-comp-realcode-143h
          path: ${{ runner.temp }}/p6e-native-comp-143h/
          if-no-files-found: warn
          retention-days: 7

  native-cpp-coordinator-parity:
    needs: single-pass-order-contract
    name: Existing P6D/P6E chain vs C++ coordinator, 6h then 143h
    runs-on: ubuntu-22.04
    timeout-minutes: 120
    steps:
      - uses: actions/checkout@v4
        with:
          filter: blob:none
          sparse-checkout: |
            native_cpp/modules/p6_calmet
            scripts/p6_run_native_causal_hourly.py
      - uses: actions/checkout@v4
        with:
          ref: 3b94cdbfbb5f44146ba51a4ef112114f199d28b9
          path: original_locked_case
          filter: blob:none
          sparse-checkout: |
            project/cases/hefei5km_2022_reference_case_20261011
      - name: Build unmodified physics binaries and C++ coordinator (GCC12, Werror)
        shell: bash
        run: |
          set -euo pipefail
          cmake -S native_cpp/modules/p6_calmet \
            -B "$RUNNER_TEMP/native-p6d" -DCMAKE_BUILD_TYPE=Release \
            -DCMAKE_CXX_COMPILER=g++-12
          cmake --build "$RUNNER_TEMP/native-p6d" \
            --target cteas_p6_realcase_wind_field \
                     cteas_p6_native_cgamma_grid_143h \
                     cteas_p6_native_hourly_driver \
                     cteas_p6_native_comp_history_tests --parallel 2
          cmake -S native_cpp/modules/p6_calmet/p6e \
            -B "$RUNNER_TEMP/native-p6e" -DCMAKE_BUILD_TYPE=Release \
            -DCMAKE_CXX_COMPILER=g++-12
          cmake --build "$RUNNER_TEMP/native-p6e" \
            --target p6e_calmet_dat21 p6e_p6c_hourly_bridge --parallel 2
      - name: Fail-closed coordinator contract (no reference, no outputs)
        shell: bash
        run: |
          set -euo pipefail
          ctest --test-dir "$RUNNER_TEMP/native-p6d" --output-on-failure \
            -R '^p6_native_cpp_(hourly_driver_fail_closed_missing_case|comp_history_state_and_rollback)$'
      - name: "Control-variable replay: 6h first, then full 143h"
        shell: bash
        run: |
          set -euo pipefail
          reference="$GITHUB_WORKSPACE/original_locked_case/project/cases/hefei5km_2022_reference_case_20261011"
          p6d="$RUNNER_TEMP/native-p6d/cteas_p6_realcase_wind_field"
          p6e="$RUNNER_TEMP/native-p6e/p6e_calmet_dat21"
          gamma="$RUNNER_TEMP/native-p6d/cteas_p6_native_cgamma_grid_143h"
          bridge="$RUNNER_TEMP/native-p6e/p6e_p6c_hourly_bridge"
          mkdir -p "$RUNNER_TEMP/coordinator-parity"
          for n in 6 143; do
            py="$RUNNER_TEMP/coordinator-parity/python-$n"
            cpp="$RUNNER_TEMP/coordinator-parity/cpp-$n"
            extra=()
            if [ "$n" -eq 143 ]; then extra=(--emit-source-stage-trace); fi
            python3 scripts/p6_run_native_causal_hourly.py \
              --case "$reference" --p6d "$p6d" --p6e "$p6e" \
              --cgamma "$gamma" --bridge "$bridge" \
              --hours "$n" --work "$py" "${extra[@]}" > "$RUNNER_TEMP/coordinator-parity/python-$n.log"
            "$RUNNER_TEMP/native-p6d/cteas_p6_native_hourly_driver" \
              --case "$reference" --p6d "$p6d" --p6e "$p6e" \
              --cgamma "$gamma" --bridge "$bridge" \
              --hours "$n" --work "$cpp" "${extra[@]}" > "$RUNNER_TEMP/coordinator-parity/cpp-$n.log"
            cmp "$py/native_causal_calmet.dat" "$cpp/native_causal_calmet.dat"
            cmp "$py/native_station_flux.csv" "$cpp/native_station_flux.csv"
            cmp "$py/observations.csv" "$cpp/observations.csv"
            for ((h=0; h<n; h++)); do
              printf -v suffix '%03d' "$h"
              for field in zi ziconv dptt; do
                cmp "$py/hour_$suffix/comp.$field.f32" \
                    "$cpp/hour_$suffix/comp.$field.f32"
              done
              cmp "$py/hour_$suffix/met_native_1h.dat" \
                  "$cpp/hour_$suffix/met_native_1h.dat"
            done
            if [ "$n" -eq 143 ]; then
              py_stage="$py/native_source_stage_143h"
              cpp_stage="$cpp/native_source_stage_143h"
              find "$py_stage" -maxdepth 1 -type f -printf "%f\n" | sort > "$py/stage_names.txt"
              find "$cpp_stage" -maxdepth 1 -type f -printf "%f\n" | sort > "$cpp/stage_names.txt"
              cmp "$py/stage_names.txt" "$cpp/stage_names.txt"
              while IFS= read -r file; do
                cmp "$py_stage/$file" "$cpp_stage/$file"
              done < "$py/stage_names.txt"
            fi
            digest="$(sha256sum "$cpp/native_causal_calmet.dat" | cut -d' ' -f1)"
            echo "hours=$n P6D/P6E_CXX_DRIVER_BYTE_PARITY=PASS sha256=$digest" |
              tee -a "$RUNNER_TEMP/coordinator-parity/acceptance.txt"
          done
          echo 'CXX_DRIVER_ACCEPTANCE=PASS_BYTE_IDENTICAL_6H_143H; ORIGINAL_45_FIELD_SCIENCE=SEPARATE_GATE' |
            tee -a "$RUNNER_TEMP/coordinator-parity/acceptance.txt"
      - name: Archive reproducible coordinator parity evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: p6-cpp-hourly-coordinator-parity
          path: |
            ${{ runner.temp }}/coordinator-parity/acceptance.txt
            ${{ runner.temp }}/coordinator-parity/*-6.log
            ${{ runner.temp }}/coordinator-parity/*-143.log
            ${{ runner.temp }}/coordinator-parity/cpp-6/native_cpp_hourly_manifest.json
            ${{ runner.temp }}/coordinator-parity/cpp-143/native_cpp_hourly_manifest.json
          retention-days: 14
          if-no-files-found: warn
