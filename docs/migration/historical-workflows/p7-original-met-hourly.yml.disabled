name: P7 original 2022 native hourly meteorology parity
on:
  pull_request:
    paths:
      - 'native_cpp/modules/p7_calpuff/**'
      - '.github/workflows/p7-original-met-hourly.yml'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: p7-native-met-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
jobs:
  native-met-143h:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    # Independent of the full original CALPUFF and P6 workers. This job
    # takes one compute slot rather than building every P7 physics kernel.
    runs-on: ubuntu-22.04
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
          filter: blob:none
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /native_cpp/modules/p7_calpuff/**
            /project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat
      - name: Require true original meteorological forcing
        shell: bash
        run: |
          set -euo pipefail
          met=project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat
          test -s "$met" || { echo "::error::missing frozen original 2022 MET.DAT"; exit 1; }
          echo "P7_MET_ORACLE_RUNNER=${RUNNER_NAME} HOST=$(hostname)"
          stat -c 'P7_MET_ORACLE_BYTES=%s' "$met"
      - name: Build and test hourly native REAL4 input against raw Fortran records
        shell: bash
        run: |
          set -euo pipefail
          if command -v g++-12 >/dev/null 2>&1; then cxx=$(command -v g++-12);
          elif command -v g++-11 >/dev/null 2>&1; then cxx=$(command -v g++-11);
          else cxx=$(command -v c++); fi
          build="${RUNNER_TEMP}/p7-original-met-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          cmake -S native_cpp/modules/p7_calpuff -B "$build" \
            -DCMAKE_CXX_COMPILER="$cxx" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$build" --parallel 2 \
            --target cteas_p7_native_met_hours cteas_p7_calmet21_tests
          ctest --test-dir "$build" -N -R '^cteas_p7_original_2022_native_met_hourly_bytes$' |
            grep -Eq 'Test[[:space:]]*#[0-9]+: cteas_p7_original_2022_native_met_hourly_bytes' || {
              echo "::error::Original MET scientific parity not registered"; exit 1;
            }
          ctest --test-dir "$build" -R '^cteas_p7_calmet21_typed_field_contract$' --output-on-failure
          ctest --test-dir "$build" -R '^cteas_p7_original_2022_native_met_hourly_bytes$' --output-on-failure
          echo "P7_NATIVE_MET_143H_INPUT_PARITY=PASS NOT_COMP_PARITY"
