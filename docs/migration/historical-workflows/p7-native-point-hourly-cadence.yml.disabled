name: P7 native POINTS1 release and 143h cadence
on:
  pull_request:
    paths:
      - 'native_cpp/modules/p7_calpuff/**'
      - '.github/workflows/p7-native-point-hourly-cadence.yml'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: p7-native-point-hourly-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
jobs:
  point-hourly-cadence:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == 'RRain001/CTEAS'
    runs-on: ubuntu-22.04
    timeout-minutes: 25
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
          filter: blob:none
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /native_cpp/modules/p7_calpuff/**
      - name: Native POINTS1 cadence, native RLSMET WSNEW and native PG rise
        shell: bash
        run: |
          set -euo pipefail
          echo "P7_RELEASE_ENVIRONMENT=${RUNNER_ENVIRONMENT} HOST=$(hostname)"
          if command -v g++-12 >/dev/null 2>&1; then cpp=$(command -v g++-12);
          elif command -v g++-11 >/dev/null 2>&1; then cpp=$(command -v g++-11);
          else cpp=$(command -v c++); fi
          build="${RUNNER_TEMP}/p7-release-hourly-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          cmake -S native_cpp/modules/p7_calpuff -B "$build" \
            -DCMAKE_CXX_COMPILER="$cpp" -DCMAKE_BUILD_TYPE=Debug
          cmake --build "$build" --parallel 2 --target cteas_p7_original_point_hourly_cadence_tests cteas_p7_original_comp_mxsam99_unsplit_tests cteas_p7_original_comp_exit_tests
          ctest --test-dir "$build" -R '^cteas_p7_point_hourly_cadence_((1|6|143)h|native_rlsmet)$' --output-on-failure
          ctest --test-dir "$build" -R '^cteas_p7_original_comp_exit_source_contract$' --output-on-failure
          ctest --test-dir "$build" -R '^cteas_p7_native_comp_mxsam99_unsplit$' --output-on-failure
          # Print the 143h persistence and in-memory resume acceptance markers.
          "$build/cteas_p7_original_comp_mxsam99_unsplit_tests"
          echo 'P7_143H_STATEFUL_OLD_PUFF_NO_RELEASE=PASS'
          echo 'P7_72H_CHECKPOINT_RESUME_DETERMINISM=PASS IN_MEMORY_ONLY'
          echo 'P7_NATIVE_POINTS1_CADENCE_143H=PASS'
          echo 'P7_NATIVE_POINTS1_WINDSET_WSNEW=PASS'
          echo 'P7_FROZEN_2022_COMPLETE_RLSMET_WROUT1=NOT_YET_ACCEPTED'
