name: P6F independent OUTHD header source
on:
  push:
    branches: [codex/p6-hourly-stateful-scheduler-20261013]
    paths:
      - .github/workflows/p6f-independent-header-source.yml
      - scripts/p6f_independent_header_control_audit.py
  workflow_dispatch:
permissions:
  contents: read
jobs:
  header-controls-independent:
    name: "Source-only 176-byte OUTHD controls; mutated-deck fail-closed"
    runs-on: ubuntu-22.04
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
        with:
          filter: blob:none
          sparse-checkout: |
            scripts/p6f_independent_header_control_audit.py
            project/cases/hefei5km_2022_reference_case_20261011/geo/makegeo/geo.dat
            project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat
            project/cases/hefei5km_2022_reference_case_20261011/run/met/met.inp
      - name: Pinned original candidate checksum
        shell: bash
        run: |
          set -euo pipefail
          case_root=project/cases/hefei5km_2022_reference_case_20261011
          printf '%s  %s\n' b1823cda92280888d70b00961ab39486036a3086e18637fff21efb4f4b237d30 \
            "$case_root/run/met/met.dat" | sha256sum -c -
      - name: Independently derive run controls and projection from deck plus GEO
        shell: bash
        run: |
          set -euo pipefail
          root=project/cases/hefei5km_2022_reference_case_20261011
          python3 scripts/p6f_independent_header_control_audit.py \
            --deck "$root/run/met/met.inp" \
            --geo "$root/geo/makegeo/geo.dat" \
            --candidate "$root/run/met/met.dat" \
            --out "$RUNNER_TEMP/p6f-header-independent.json"
      - name: Reject tampered source time, UTM and GEO zone
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY'
          import pathlib,os
          root=pathlib.Path("project/cases/hefei5km_2022_reference_case_20261011")
          deck=(root/"run/met/met.inp").read_text()
          geo=(root/"geo/makegeo/geo.dat").read_text()
          out=pathlib.Path(os.environ["RUNNER_TEMP"])
          values={
            "timezone":("! ABTZ = UTC+0000 !","! ABTZ = UTC+0800 !"),
            "run-clock":("! IEHR = 23 !","! IEHR = 22 !"),
            "grid":("! NX = 50 !","! NX = 49 !"),
          }
          for name,(original,mutated) in values.items():
              assert deck.count(original)==1,(name,"anchor drift")
              (out/f"p6f-header-{name}-bad.inp").write_text(deck.replace(original,mutated))
          assert geo.count("  50N   ")==1
          (out/"p6f-header-utm-bad.geo").write_text(geo.replace("  50N   ","  49N   "))
          PY
          for case in timezone run-clock grid; do
            if python3 scripts/p6f_independent_header_control_audit.py \
                --deck "$RUNNER_TEMP/p6f-header-$case-bad.inp" \
                --geo project/cases/hefei5km_2022_reference_case_20261011/geo/makegeo/geo.dat \
                --candidate project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat \
                > "$RUNNER_TEMP/p6f-header-$case-rejected.log" 2>&1; then
              echo "::error::tampered $case deck accepted"; exit 1
            fi
            grep -q P6F_HEADER_SOURCE_NOT_PASS "$RUNNER_TEMP/p6f-header-$case-rejected.log"
          done
          if python3 scripts/p6f_independent_header_control_audit.py \
              --deck project/cases/hefei5km_2022_reference_case_20261011/run/met/met.inp \
              --geo "$RUNNER_TEMP/p6f-header-utm-bad.geo" \
              --candidate project/cases/hefei5km_2022_reference_case_20261011/run/met/met.dat \
              > "$RUNNER_TEMP/p6f-header-utm-rejected.log" 2>&1; then
            echo "::error::tampered GEO UTM zone accepted"; exit 1
          fi
          grep -q P6F_HEADER_SOURCE_NOT_PASS "$RUNNER_TEMP/p6f-header-utm-rejected.log"
          echo "PASS_P6F_HEADER_DECK_GEO_MUTATION_REJECTION"
      - name: Archive provenance proof
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: p6f-independent-header-source
          path: |
            ${{ runner.temp }}/p6f-header-independent.json
            ${{ runner.temp }}/p6f-header-*-rejected.log
          if-no-files-found: warn
          retention-days: 14
