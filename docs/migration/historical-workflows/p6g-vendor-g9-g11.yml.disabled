        # Science PASS has no failing original residual to diagnose.
        # Science FAIL still runs the original forensic, preserving its
        # diagnostics and never relaxing the frozen P6E comparator.
        if: ${{ always() && steps.g31_science.outcome == 'failure' }}
        run: |
          if test -s "$RUNNER_TEMP/g32-daylight-${{ matrix.mode }}/instrumented-original-case/dgm_fields.bin" \
             && test -s "$RUNNER_TEMP/g32-daylight-${{ matrix.mode }}/instrumented-original-case/met.dat" \
             && test -s "$RUNNER_TEMP/g31-daylight-${{ matrix.mode }}/original-met.dat" \
             && test -s "$RUNNER_TEMP/g31-daylight-${{ matrix.mode }}/g31-frozen-45field-verdict.json" \
             && test -s "$RUNNER_TEMP/g22-daylight-fradj.csv" \
             && test -s "$RUNNER_TEMP/g22-daylight-slope.csv"; then
            python3 native_cpp/modules/p6_calmet/reference/g32b_trace_original_multisite_slope_first_divergence.py \
