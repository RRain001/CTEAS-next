name: P6G original-vendor G9 G10 G11 source parity
on:
  push:
    branches: [codex/p6g-multistation-on-accepted-p6a-p6f-20261014]
    paths:
      - '.github/workflows/p6g-vendor-g9-g11.yml'
      - 'native_cpp/modules/p6_calmet/reference/compare_g9_original_wind1_multisite.py'
      - 'native_cpp/modules/p6_calmet/reference/compare_g20_file_backed_original_wind1.py'
      - 'native_cpp/modules/p6_calmet/reference/compare_g21_file_backed_original_fradj.py'
      - 'native_cpp/modules/p6_calmet/reference/compare_g22_file_backed_original_slope.py'
      - 'native_cpp/modules/p6_calmet/reference/compare_g23_source_original_inter2.py'
      - 'native_cpp/modules/p6_calmet/reference/compare_g23_source_original_diagi_similt.py'
      - 'native_cpp/modules/p6_calmet/reference/compare_g24_source_original_diagno.py'
      - 'native_cpp/modules/p6_calmet/reference/compare_g25_source_original_station_elustr2.py'
      - 'native_cpp/modules/p6_calmet/reference/compare_g25_source_original_stable_mixhtst.py'
      - 'native_cpp/modules/p6_calmet/reference/compare_g25_source_original_daytime_mixhtst.py'
      - 'native_cpp/modules/p6_calmet/reference/compare_g27_source_original_setcom_nearu.py'
      - 'native_cpp/modules/p6_calmet/reference/compare_g28_source_original_avemix_wstarr.py'
      - 'native_cpp/modules/p6_calmet/reference/compare_g29_source_original_mixht.py'
      - 'native_cpp/modules/p6_calmet/reference/compare_g29_source_original_temp3d.py'
      - 'native_cpp/modules/p6_calmet/reference/verify_g30_source_p6f_candidate.py'
      - 'native_cpp/modules/p6_calmet/reference/test_g30_source_p6f_fail_closed.py'
      - 'native_cpp/modules/p6_calmet/reference/g31_run_literal_original_calmet_multisite.py'
      - 'native_cpp/modules/p6_calmet/reference/g34_verify_original_six_hour_oracle.py'
      - 'native_cpp/modules/p6_calmet/src/p6g_g34b_six_hour_selected_gate_main.cpp'
      - 'native_cpp/modules/p6_calmet/include/cteas/p6/p6g_g26_file_backed_g14_diagno_bridge.hpp'
      - 'native_cpp/modules/p6_calmet/reference/g31_extract_original_science_hour.py'
      - 'native_cpp/modules/p6_calmet/reference/g31_diagnose_multistation_45field_residuals.py'
      - 'native_cpp/modules/p6_calmet/reference/g32_probe_original_multistation_diagno.py'
      - 'native_cpp/modules/p6_calmet/reference/g32b_trace_original_multisite_slope_first_divergence.py'
      - 'native_cpp/modules/p6_calmet/reference/g32c_trace_original_multisite_post_inter2.py'
      - 'native_cpp/modules/p6_calmet/reference/g32d_compare_original_multisite_inter2_station_profiles.py'
      - 'native_cpp/modules/p6_calmet/reference/g32f_first_comp_input_original_state_trace.py'
      - 'native_cpp/modules/p6_calmet/reference/g33a_trace_original_multisite_two_pass_surfvar.py'
      - 'native_cpp/modules/p6_calmet/reference/g33b_trace_original_multisite_comp_third_surfvar.py'
      - 'native_cpp/modules/p6_calmet/CMakeLists.txt'
      - 'native_cpp/modules/p6_calmet/src/p6g_g21_source_fradj_probe_main.cpp'
      - 'native_cpp/modules/p6_calmet/src/p6g_g20_source_wind1_probe_main.cpp'
      - 'native_cpp/modules/p6_calmet/tests/p6g_g19_file_backed_case_tests.cpp'
      - 'native_cpp/modules/p6_calmet/reference/compare_g10_original_diagno_10km.py'
      - 'native_cpp/modules/p6_calmet/reference/compare_g11_original_terrain_10km.py'
      - 'native_cpp/modules/p6_calmet/include/cteas/p6/p6g_*.hpp'
      - 'native_cpp/modules/p6_calmet/tests/p6g_g9_*'
  pull_request:
    paths:
      - '.github/workflows/p6g-vendor-g9-g11.yml'
      - 'native_cpp/modules/p6_calmet/reference/compare_g9_original_wind1_multisite.py'
      - 'native_cpp/modules/p6_calmet/reference/compare_g20_file_backed_original_wind1.py'
      - 'native_cpp/modules/p6_calmet/reference/compare_g21_file_backed_original_fradj.py'
      - 'native_cpp/modules/p6_calmet/reference/compare_g22_file_backed_original_slope.py'
      - 'native_cpp/modules/p6_calmet/reference/compare_g23_source_original_inter2.py'
      - 'native_cpp/modules/p6_calmet/reference/compare_g23_source_original_diagi_similt.py'
      - 'native_cpp/modules/p6_calmet/reference/compare_g24_source_original_diagno.py'
      - 'native_cpp/modules/p6_calmet/reference/compare_g25_source_original_station_elustr2.py'
      - 'native_cpp/modules/p6_calmet/reference/compare_g25_source_original_stable_mixhtst.py'
      - 'native_cpp/modules/p6_calmet/reference/compare_g25_source_original_daytime_mixhtst.py'
      - 'native_cpp/modules/p6_calmet/reference/compare_g27_source_original_setcom_nearu.py'
      - 'native_cpp/modules/p6_calmet/reference/compare_g28_source_original_avemix_wstarr.py'
      - 'native_cpp/modules/p6_calmet/reference/compare_g29_source_original_mixht.py'
      - 'native_cpp/modules/p6_calmet/reference/compare_g29_source_original_temp3d.py'
      - 'native_cpp/modules/p6_calmet/reference/verify_g30_source_p6f_candidate.py'
      - 'native_cpp/modules/p6_calmet/reference/test_g30_source_p6f_fail_closed.py'
      - 'native_cpp/modules/p6_calmet/reference/g31_run_literal_original_calmet_multisite.py'
      - 'native_cpp/modules/p6_calmet/reference/g34_verify_original_six_hour_oracle.py'
      - 'native_cpp/modules/p6_calmet/src/p6g_g34b_six_hour_selected_gate_main.cpp'
      - 'native_cpp/modules/p6_calmet/include/cteas/p6/p6g_g26_file_backed_g14_diagno_bridge.hpp'
      - 'native_cpp/modules/p6_calmet/reference/g31_extract_original_science_hour.py'
      - 'native_cpp/modules/p6_calmet/reference/g31_diagnose_multistation_45field_residuals.py'
      - 'native_cpp/modules/p6_calmet/reference/g32_probe_original_multistation_diagno.py'
      - 'native_cpp/modules/p6_calmet/reference/g32b_trace_original_multisite_slope_first_divergence.py'
      - 'native_cpp/modules/p6_calmet/reference/g32c_trace_original_multisite_post_inter2.py'
      - 'native_cpp/modules/p6_calmet/reference/g32d_compare_original_multisite_inter2_station_profiles.py'
      - 'native_cpp/modules/p6_calmet/reference/g32f_first_comp_input_original_state_trace.py'
      - 'native_cpp/modules/p6_calmet/reference/g33a_trace_original_multisite_two_pass_surfvar.py'
      - 'native_cpp/modules/p6_calmet/reference/g33b_trace_original_multisite_comp_third_surfvar.py'
      - 'native_cpp/modules/p6_calmet/CMakeLists.txt'
      - 'native_cpp/modules/p6_calmet/src/p6g_g21_source_fradj_probe_main.cpp'
      - 'native_cpp/modules/p6_calmet/src/p6g_g20_source_wind1_probe_main.cpp'
      - 'native_cpp/modules/p6_calmet/tests/p6g_g19_file_backed_case_tests.cpp'
      - 'native_cpp/modules/p6_calmet/reference/compare_g10_original_diagno_10km.py'
      - 'native_cpp/modules/p6_calmet/reference/compare_g11_original_terrain_10km.py'
  workflow_dispatch:
permissions:
  contents: read
jobs:
  selected-vendor-parity:
    name: literal CALMET G9-G11 selected 10km (${{ matrix.mode }})
    runs-on: ubuntu-22.04
    timeout-minutes: 45
    strategy:
      fail-fast: false
      matrix:
        mode: [Debug, Release]
    steps:
      - uses: actions/checkout@v4
      - name: Verify original CALMET source and hosted compiler
        run: |
          test -s engine/vendor/src/CALMET_v6.5.0_L150223/calmet.for
          command -v gfortran
          command -v g++
          command -v cmake
      - name: Strict build on accepted Hefei P6A-P6F branch
        run: |
          cmake -S native_cpp/modules/p6_calmet -B "$RUNNER_TEMP/p6g-vendor" -DCMAKE_BUILD_TYPE=${{ matrix.mode }}
          cmake --build "$RUNNER_TEMP/p6g-vendor" --target \
            cteas_p6g_g10_diagno_reference cteas_p6g_g9_multi_wind1_tests \
            cteas_p6g_g11_terrain_tests \
            cteas_p6g_g19_file_backed_case_tests \
            cteas_p6g_g20_source_wind1_probe \
            cteas_p6g_g21_source_fradj_probe \
            cteas_p6g_g34b_six_hour_selected_gate --parallel 2
      - name: Original Fortran WIND1 G9 10km multi-station
        run: python3 native_cpp/modules/p6_calmet/reference/compare_g9_original_wind1_multisite.py --mode ${{ matrix.mode }}
      - name: Original literal CALMET WIND1 with G20 disk-backed SURF/UP station profiles
        run: |
          mkdir -p "$RUNNER_TEMP/g20-source"
          "$RUNNER_TEMP/p6g-vendor/cteas_p6g_g19_file_backed_case_tests" \
            --export-case project/cases/hefei5km_2022_reference_case_20261011/run/met/met.inp \
            "$RUNNER_TEMP/g20-source"
          "$RUNNER_TEMP/p6g-vendor/cteas_p6g_g20_source_wind1_probe" \
            "$RUNNER_TEMP/g20-source/met.inp" "$RUNNER_TEMP/g20-source/GEO.DAT" \
            "$RUNNER_TEMP/g20-source/SURF.DAT" \
            "$RUNNER_TEMP/g20-source/UP1.DAT" "$RUNNER_TEMP/g20-source/UP2.DAT" \
            --output "$RUNNER_TEMP/g20-native-wind1.csv" \
            --wind1-profiles "$RUNNER_TEMP/g20-station-columns.dat"
          python3 native_cpp/modules/p6_calmet/reference/compare_g20_file_backed_original_wind1.py \
            --mode ${{ matrix.mode }} \
            --source-columns "$RUNNER_TEMP/g20-station-columns.dat" \
            --candidate "$RUNNER_TEMP/g20-native-wind1.csv" \
            --out "$RUNNER_TEMP/g20-vendor-${{ matrix.mode }}.json"
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: g20-vendor-source-parity-${{ matrix.mode }}
          path: ${{ runner.temp }}/g20-vendor-${{ matrix.mode }}.json
      - name: Literal vendor TERSET FRADJ on actual G21 file-backed CGAMMA and TEMP2D
        run: |
          "$RUNNER_TEMP/p6g-vendor/cteas_p6g_g21_source_fradj_probe" \
            "$RUNNER_TEMP/g20-source/met.inp" "$RUNNER_TEMP/g20-source/GEO.DAT" \
            "$RUNNER_TEMP/g20-source/SURF.DAT" \
            "$RUNNER_TEMP/g20-source/UP1.DAT" "$RUNNER_TEMP/g20-source/UP2.DAT" \
            --output "$RUNNER_TEMP/g21-native-fradj.csv" \
            --source-stage "$RUNNER_TEMP/g21-original-input.dat" \
            --slope-output "$RUNNER_TEMP/g22-native-slope.csv" \
            --slope-stage "$RUNNER_TEMP/g22-original-input.dat" \
            --inter2-output "$RUNNER_TEMP/g23-original-inter2.csv" \
            --inter2-original-stage-prefix "$RUNNER_TEMP/g23-original-stage" \
            --diagi-similt-prefix "$RUNNER_TEMP/g23-original-diagi" \
            --nearu-prefix "$RUNNER_TEMP/g27-original-nearu" \
            --comp-original-prefix "$RUNNER_TEMP/g28-original-comp" \
            --mixht-original-prefix "$RUNNER_TEMP/g29-original-mixht" \
            --temp3d-original-prefix "$RUNNER_TEMP/g29-original-temp3d" \
            --p6f-candidate-file "$RUNNER_TEMP/g30-normal-candidate.calmet.dat" \
            --station-flux-prefix "$RUNNER_TEMP/g25-original-flux" \
            --wind-tail-stage "$RUNNER_TEMP/g24-original-stage.dat" \
            --wind-tail-output "$RUNNER_TEMP/g24-original-native.csv" \
            --wind-tail-boundaries "$RUNNER_TEMP/g24-original-boundaries.txt"
          python3 native_cpp/modules/p6_calmet/reference/compare_g21_file_backed_original_fradj.py \
            --mode ${{ matrix.mode }} \
            --source-stage "$RUNNER_TEMP/g21-original-input.dat" \
            --candidate "$RUNNER_TEMP/g21-native-fradj.csv" \
            --out "$RUNNER_TEMP/g21-vendor-${{ matrix.mode }}.json"
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: g21-vendor-fradj-${{ matrix.mode }}
          path: ${{ runner.temp }}/g21-vendor-${{ matrix.mode }}.json
      - name: Literal vendor G21 corrected FRADJ on steep source GEO and legal CRITFN TERRAD
        run: |
          mkdir -p "$RUNNER_TEMP/g21-steep-source"
          "$RUNNER_TEMP/p6g-vendor/cteas_p6g_g19_file_backed_case_tests" \
            --export-case project/cases/hefei5km_2022_reference_case_20261011/run/met/met.inp \
            "$RUNNER_TEMP/g21-steep-source" --fradj-stress
          "$RUNNER_TEMP/p6g-vendor/cteas_p6g_g21_source_fradj_probe" \
            "$RUNNER_TEMP/g21-steep-source/met.inp" \
            "$RUNNER_TEMP/g21-steep-source/GEO.DAT" \
            "$RUNNER_TEMP/g21-steep-source/SURF.DAT" \
            "$RUNNER_TEMP/g21-steep-source/UP1.DAT" \
            "$RUNNER_TEMP/g21-steep-source/UP2.DAT" \
            --output "$RUNNER_TEMP/g21-steep-native-fradj.csv" \
            --source-stage "$RUNNER_TEMP/g21-steep-original-input.dat" \
            --slope-output "$RUNNER_TEMP/g22-steep-native-slope.csv" \
            --slope-stage "$RUNNER_TEMP/g22-steep-original-input.dat" \
            --inter2-output "$RUNNER_TEMP/g23-steep-inter2.csv" \
            --inter2-original-stage-prefix "$RUNNER_TEMP/g23-steep-stage" \
            --diagi-similt-prefix "$RUNNER_TEMP/g23-steep-diagi" \
            --nearu-prefix "$RUNNER_TEMP/g27-steep-nearu" \
            --comp-original-prefix "$RUNNER_TEMP/g28-steep-comp" \
            --mixht-original-prefix "$RUNNER_TEMP/g29-steep-mixht" \
            --temp3d-original-prefix "$RUNNER_TEMP/g29-steep-temp3d" \
            --p6f-candidate-file "$RUNNER_TEMP/g30-steep-candidate.calmet.dat" \
            --station-flux-prefix "$RUNNER_TEMP/g25-steep-flux" \
            --wind-tail-stage "$RUNNER_TEMP/g24-steep-stage.dat" \
            --wind-tail-output "$RUNNER_TEMP/g24-steep-native.csv" \
            --wind-tail-boundaries "$RUNNER_TEMP/g24-steep-boundaries.txt"
          python3 native_cpp/modules/p6_calmet/reference/compare_g21_file_backed_original_fradj.py \
            --mode ${{ matrix.mode }} \
            --source-stage "$RUNNER_TEMP/g21-steep-original-input.dat" \
            --candidate "$RUNNER_TEMP/g21-steep-native-fradj.csv" \
            --require-nontrivial \
            --out "$RUNNER_TEMP/g21-nontrivial-${{ matrix.mode }}.json"
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: g21-vendor-fradj-nontrivial-${{ matrix.mode }}
          path: ${{ runner.temp }}/g21-nontrivial-${{ matrix.mode }}.json
      - name: Original CALMET SLOPE with source original-format post-ELUSTR QH and TEMP2D
        run: |
          python3 native_cpp/modules/p6_calmet/reference/compare_g22_file_backed_original_slope.py \
            --mode ${{ matrix.mode }} \
            --source-stage "$RUNNER_TEMP/g22-original-input.dat" \
            --candidate "$RUNNER_TEMP/g22-native-slope.csv" \
            --out "$RUNNER_TEMP/g22-vendor-${{ matrix.mode }}.json"
          python3 native_cpp/modules/p6_calmet/reference/compare_g22_file_backed_original_slope.py \
            --mode ${{ matrix.mode }} \
            --source-stage "$RUNNER_TEMP/g22-steep-original-input.dat" \
            --candidate "$RUNNER_TEMP/g22-steep-native-slope.csv" \
            --require-nontrivial \
            --out "$RUNNER_TEMP/g22-steep-vendor-${{ matrix.mode }}.json"
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: g22-vendor-slope-${{ matrix.mode }}
          path: |
            ${{ runner.temp }}/g22-vendor-${{ matrix.mode }}.json
            ${{ runner.temp }}/g22-steep-vendor-${{ matrix.mode }}.json
      - name: G22 independent daylight ELUSTR plus real nonzero vendor FRADJ SLOPE
        run: |
          mkdir -p "$RUNNER_TEMP/g22-daylight-source"
          "$RUNNER_TEMP/p6g-vendor/cteas_p6g_g19_file_backed_case_tests" \
            --export-case project/cases/hefei5km_2022_reference_case_20261011/run/met/met.inp \
            "$RUNNER_TEMP/g22-daylight-source" --fradj-stress --daylight-first-hour
          "$RUNNER_TEMP/p6g-vendor/cteas_p6g_g21_source_fradj_probe" \
            "$RUNNER_TEMP/g22-daylight-source/met.inp" \
            "$RUNNER_TEMP/g22-daylight-source/GEO.DAT" \
            "$RUNNER_TEMP/g22-daylight-source/SURF.DAT" \
            "$RUNNER_TEMP/g22-daylight-source/UP1.DAT" \
            "$RUNNER_TEMP/g22-daylight-source/UP2.DAT" \
            --output "$RUNNER_TEMP/g22-daylight-fradj.csv" \
            --surfvar-two-pass-output "$RUNNER_TEMP/g33-daylight-two-pass-native.csv" \
            --comp-third-surfvar-output "$RUNNER_TEMP/g33-daylight-third-pass-native.csv" \
            --source-stage "$RUNNER_TEMP/g22-daylight-fradj-input.dat" \
            --slope-output "$RUNNER_TEMP/g22-daylight-slope.csv" \
            --slope-stage "$RUNNER_TEMP/g22-daylight-slope-input.dat" \
            --inter2-output "$RUNNER_TEMP/g23-daylight-inter2.csv" \
            --inter2-original-stage-prefix "$RUNNER_TEMP/g23-daylight-stage" \
            --diagi-similt-prefix "$RUNNER_TEMP/g23-daylight-diagi" \
            --nearu-prefix "$RUNNER_TEMP/g27-daylight-nearu" \
            --comp-original-prefix "$RUNNER_TEMP/g28-daylight-comp" \
            --mixht-original-prefix "$RUNNER_TEMP/g29-daylight-mixht" \
            --temp3d-original-prefix "$RUNNER_TEMP/g29-daylight-temp3d" \
            --p6f-candidate-file "$RUNNER_TEMP/g30-daylight-candidate.calmet.dat" \
            --station-flux-prefix "$RUNNER_TEMP/g25-daylight-flux" \
            --wind-tail-stage "$RUNNER_TEMP/g24-daylight-stage.dat" \
            --wind-tail-output "$RUNNER_TEMP/g24-daylight-native.csv" \
            --wind-tail-boundaries "$RUNNER_TEMP/g24-daylight-boundaries.txt" \
            | tee "$RUNNER_TEMP/g22-daylight-native-log.txt"
          grep -Eq 'DAYTIME_CELLS=[1-9][0-9]*' "$RUNNER_TEMP/g22-daylight-native-log.txt"
          python3 native_cpp/modules/p6_calmet/reference/compare_g21_file_backed_original_fradj.py \
            --mode ${{ matrix.mode }} \
            --source-stage "$RUNNER_TEMP/g22-daylight-fradj-input.dat" \
            --candidate "$RUNNER_TEMP/g22-daylight-fradj.csv" \
            --require-nontrivial \
            --out "$RUNNER_TEMP/g22-daylight-fradj-${{ matrix.mode }}.json"
          python3 native_cpp/modules/p6_calmet/reference/compare_g22_file_backed_original_slope.py \
            --mode ${{ matrix.mode }} \
            --source-stage "$RUNNER_TEMP/g22-daylight-slope-input.dat" \
            --candidate "$RUNNER_TEMP/g22-daylight-slope.csv" \
            --require-nontrivial \
            --out "$RUNNER_TEMP/g22-daylight-slope-${{ matrix.mode }}.json"
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: g22-daylight-source-vendor-${{ matrix.mode }}
          path: |
            ${{ runner.temp }}/g22-daylight-fradj-${{ matrix.mode }}.json
            ${{ runner.temp }}/g22-daylight-slope-${{ matrix.mode }}.json
            ${{ runner.temp }}/g22-daylight-native-log.txt
      - name: Source G23 STHEOR DIAGI INTER2 generates complete 1296-cell candidate
        run: |
          for file in "$RUNNER_TEMP/g23-original-inter2.csv" \
                      "$RUNNER_TEMP/g23-steep-inter2.csv" \
                      "$RUNNER_TEMP/g23-daylight-inter2.csv"; do
            test -s "$file"
            test "$(wc -l < "$file")" -eq 1297
          done
          echo "PASS_G23_SOURCE_ORIGINAL_FORMAT_2SS2US_INTER2_OUTPUT_SHAPES"
      - name: Literal original CALMET INTER2 from G23 actual 2SS 2US capped DIAGI source files
        run: |
          python3 native_cpp/modules/p6_calmet/reference/compare_g23_source_original_inter2.py \
            --mode ${{ matrix.mode }} \
            --source-prefix "$RUNNER_TEMP/g23-original-stage" \
            --candidate "$RUNNER_TEMP/g23-original-inter2.csv" \
            --out "$RUNNER_TEMP/g23-vendor-${{ matrix.mode }}.json"
          python3 native_cpp/modules/p6_calmet/reference/compare_g23_source_original_inter2.py \
            --mode ${{ matrix.mode }} \
            --source-prefix "$RUNNER_TEMP/g23-steep-stage" \
            --candidate "$RUNNER_TEMP/g23-steep-inter2.csv" \
            --out "$RUNNER_TEMP/g23-steep-vendor-${{ matrix.mode }}.json"
          python3 native_cpp/modules/p6_calmet/reference/compare_g23_source_original_inter2.py \
            --mode ${{ matrix.mode }} \
            --source-prefix "$RUNNER_TEMP/g23-daylight-stage" \
            --candidate "$RUNNER_TEMP/g23-daylight-inter2.csv" \
            --out "$RUNNER_TEMP/g23-daylight-vendor-${{ matrix.mode }}.json"
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: g23-literal-inter2-source-${{ matrix.mode }}
          path: |
            ${{ runner.temp }}/g23-vendor-${{ matrix.mode }}.json
            ${{ runner.temp }}/g23-steep-vendor-${{ matrix.mode }}.json
            ${{ runner.temp }}/g23-daylight-vendor-${{ matrix.mode }}.json
      - name: Literal original SIMILT on G23 actual STHEOR MIXHTST DIAGI station columns
        run: |
          python3 native_cpp/modules/p6_calmet/reference/compare_g23_source_original_diagi_similt.py \
            --mode ${{ matrix.mode }} \
            --source-prefix "$RUNNER_TEMP/g23-original-diagi" \
            --out "$RUNNER_TEMP/g23-source-diagi-${{ matrix.mode }}.json"
          python3 native_cpp/modules/p6_calmet/reference/compare_g23_source_original_diagi_similt.py \
            --mode ${{ matrix.mode }} \
            --source-prefix "$RUNNER_TEMP/g23-steep-diagi" \
            --out "$RUNNER_TEMP/g23-steep-diagi-${{ matrix.mode }}.json"
          python3 native_cpp/modules/p6_calmet/reference/compare_g23_source_original_diagi_similt.py \
            --mode ${{ matrix.mode }} \
            --source-prefix "$RUNNER_TEMP/g23-daylight-diagi" \
            --out "$RUNNER_TEMP/g23-daylight-diagi-${{ matrix.mode }}.json"
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: g23-literal-diagi-similt-${{ matrix.mode }}
          path: |
