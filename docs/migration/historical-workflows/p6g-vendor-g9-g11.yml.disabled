              --frozen-verdict "$RUNNER_TEMP/g31-daylight-${{ matrix.mode }}/g31-frozen-45field-verdict.json" \
              --out "$RUNNER_TEMP/g31-daylight-${{ matrix.mode }}/g31c-residual-diagnosis.json"
          else
            echo "G31C BLOCKED: no complete original/native/comparator evidence"
          fi
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: g31b-original-full-hour-45field-numeric-${{ matrix.mode }}
          path: |
            ${{ runner.temp }}/g31-daylight-${{ matrix.mode }}/g31b-evidence.json
            ${{ runner.temp }}/g31-daylight-${{ matrix.mode }}/g31-frozen-45field-verdict.json
            ${{ runner.temp }}/g31-daylight-${{ matrix.mode }}/original-met.dat
            ${{ runner.temp }}/g31-daylight-${{ matrix.mode }}/original-first-hour.dat
            ${{ runner.temp }}/g31-daylight-${{ matrix.mode }}/g31c-residual-diagnosis.json
            ${{ runner.temp }}/g30-daylight-candidate.calmet.dat
            ${{ runner.temp }}/g24-daylight-native.csv
            ${{ runner.temp }}/g28-daylight-comp.native.csv
            ${{ runner.temp }}/g29-daylight-temp3d.native.csv
      - name: G32A write-only true original DIAGNO kpt10 U V W and literal output hash proof
        if: always()
        run: |
          if test -s "$RUNNER_TEMP/g31-daylight-${{ matrix.mode }}/original-met.dat" \
            && test -s "$RUNNER_TEMP/g31-daylight-${{ matrix.mode }}/run/met.dat" \
            && test -s "$RUNNER_TEMP/g24-daylight-native.csv"; then
            python3 native_cpp/modules/p6_calmet/reference/g32_probe_original_multistation_diagno.py \
              --source-run-dir "$RUNNER_TEMP/g31-daylight-${{ matrix.mode }}/run" \
