              --untouched-met "$RUNNER_TEMP/g31-daylight-${{ matrix.mode }}/original-met.dat" \
              --write-only-met "$RUNNER_TEMP/g32-daylight-${{ matrix.mode }}/instrumented-original-case/met.dat" \
              --frozen-verdict "$RUNNER_TEMP/g31-daylight-${{ matrix.mode }}/g31-frozen-45field-verdict.json" \
