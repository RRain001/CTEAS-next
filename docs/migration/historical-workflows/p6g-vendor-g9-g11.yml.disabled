            ${{ runner.temp }}/g34-original-six-hours-${{ matrix.mode }}/g34a-evidence.json
            ${{ runner.temp }}/g34-original-six-hours-${{ matrix.mode }}/g31a-evidence.json
            ${{ runner.temp }}/g34-original-six-hours-${{ matrix.mode }}/original-met.lst
          if-no-files-found: warn
          retention-days: 14
      # G34B is now an enforced scientific gate after genuine independent
      # original 6x45 parity passed in BOTH hosted Debug and Release.
      # Any failed native stage, memory/CGAMMA transaction, incomplete output,
      # or frozen P6E comparator exceedance MUST fail the workflow.
      - name: G34B strict native six-hour G14 transaction and original 270-field science
        id: g34b_sixhour
        run: |
          set -euo pipefail
          "$RUNNER_TEMP/p6g-vendor/cteas_p6g_g34b_six_hour_selected_gate" \
            "$RUNNER_TEMP/g22-daylight-source/met.inp" \
            "$RUNNER_TEMP/g22-daylight-source/GEO.DAT" \
            "$RUNNER_TEMP/g22-daylight-source/SURF.DAT" \
            "$RUNNER_TEMP/g22-daylight-source/UP1.DAT" \
            "$RUNNER_TEMP/g22-daylight-source/UP2.DAT" \
            "$RUNNER_TEMP/g34b-native-six-hour-${{ matrix.mode }}.calmet.dat"
          "$RUNNER_TEMP/g31-p6e-comparator/p6e_calmet_dat21" compare \
            --reference "$RUNNER_TEMP/g34-original-six-hours-${{ matrix.mode }}/original-met.dat" \
            --candidate "$RUNNER_TEMP/g34b-native-six-hour-${{ matrix.mode }}.calmet.dat" \
            --out "$RUNNER_TEMP/g34b-native-frozen-270-field-${{ matrix.mode }}.json"
          echo "PASS_G34B_REAL_6H_NATIVE_VS_INDEPENDENT_ORIGINAL_270_FIELDS"
      - name: Report G34B scientific gate disposition
        if: always()
        run: |
          if [ "${{ steps.g34b_sixhour.outcome }}" = "success" ]; then
