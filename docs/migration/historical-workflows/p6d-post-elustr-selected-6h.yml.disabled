name: P6D post-ELUSTR selected source U V W

on:
  push:
    branches: [audit/p6d-source-slope-drivers-143h-20261012]
    paths:
      - 'scripts/p6d_probe_selected_source_u_v_w_post_elustr.py'
      - '.github/workflows/p6d-post-elustr-selected-6h.yml'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: p6d-elustr-source-6h-${{ github.ref }}
  cancel-in-progress: true

jobs:
  source-six-hour:
    runs-on: ubuntu-22.04
    timeout-minutes: 25
    steps:
      - uses: actions/checkout@v4
        with:
          filter: blob:none
          sparse-checkout: |
            .github/actions/cteas-linux-toolchain
            native_cpp/modules/p6_calmet
            scripts
      - uses: ./.github/actions/cteas-linux-toolchain
      - name: Restore frozen source-identified Hefei inputs
        run: python3 native_cpp/modules/p6_calmet/reference/restore_frozen_case_from_git.py --mode grid
      - name: Build and autonomously produce through hour 83
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-elustr-6h-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          cmake -S native_cpp/modules/p6_calmet -B "$root/build" -DCMAKE_BUILD_TYPE=Release
          cmake --build "$root/build" --target cteas_p6_realcase_wind_field --parallel 1
          "$root/build/cteas_p6_realcase_wind_field" \
            --case project/cases/hefei5km_2022_reference_case_20261011 \
            --hours 83 --out "$root/native"
      - name: Strict six-hour source SLOPE and final U V W diagnosis
        shell: bash
        run: |
          set -euo pipefail
          root="$RUNNER_TEMP/p6d-elustr-6h-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          python3 scripts/p6d_probe_selected_source_u_v_w_post_elustr.py \
            --source native_cpp/modules/p6_calmet/reference/dgm_p6d_requests_2022/dgm_fields_hours.bin \
            --candidate "$root/native" \
            --out "$root/p6d_elustr_source_6h.json" \
            --enforce-acceptance
      - name: Upload forensic values even when strict acceptance fails
        if: always()
        uses: actions/upload-artifact@v4
        continue-on-error: true
        with:
          name: p6d-elustr-source-6h
          path: ${{ runner.temp }}/p6d-elustr-6h-${{ github.run_id }}-${{ github.run_attempt }}/p6d_elustr_source_6h.json
          if-no-files-found: warn
          retention-days: 14